# ═══════════════════════════════════════════════════════════════════════════════
# PLAYWRIGHT FRAMEWORK - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────

# Server port for the API
PORT=4000

# Node environment (development | production)
NODE_ENV=development

# CORS configuration (comma-separated domains or * for all)
CORS_ORIGIN=*

# ───────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────

# Base URL for tests (the application being tested)
BASE_URL=

# API timeout (milliseconds)
TIMEOUT=30000

# Customer name for dashboard display
Customer=My Test Organization

# ───────────────────────────────────────────────────────────────────────────────
# PLAYWRIGHT CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────

# Run browsers in headless mode (true for server, false for debugging)
PLAYWRIGHT_HEADLESS=true

# Browser download directory
PLAYWRIGHT_BROWSERS_DIR=./browsers

# Debug mode (shows browser UI)
DEBUG=false

# Playwright retries for each test attempt (2 means up to 3 executions)
PLAYWRIGHT_RETRIES=2

# Automation Studio repair-and-rerun cycles after a failed test (2 means up to 3 cycles)
HEALER_MAX_RETRIES=2

# Maximum test executions per case: (PLAYWRIGHT_RETRIES + 1) * (HEALER_MAX_RETRIES + 1)
TOTAL_RETRIES_PER_TESTCASE=9

# ───────────────────────────────────────────────────────────────────────────────
# JIRA INTEGRATION
# ───────────────────────────────────────────────────────────────────────────────

# Jira base URL
JIRA_BASE_URL=https://your-instance.atlassian.net

# Jira email/username
JIRA_EMAIL=your-email@company.com

# Jira API token (generate from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-api-token

# Jira story to track
JIRA_STORY1_STORY=KAN-1

# ───────────────────────────────────────────────────────────────────────────────
# AZURE DEVOPS (ADO) INTEGRATION
# ───────────────────────────────────────────────────────────────────────────────

# ADO organization URL
ADO_ORG_URL=https://dev.azure.com/your-organization

# ADO project name
ADO_PROJECT=your-project

# ADO Personal Access Token
ADO_PAT=your-personal-access-token

# Test management tool (Jira | ADO)
TestManagementTool=Jira

# ───────────────────────────────────────────────────────────────────────────────
# AI INTEGRATION
# ───────────────────────────────────────────────────────────────────────────────

# Legacy provider settings. Dashboard generation uses LLM_PROVIDER below.
AI_PROVIDER=

# Legacy API key for integrations that still use AI_PROVIDER.
AI_API_KEY=

# Provider selected for dashboard Planner, Generator, and Healer requests:
# openai, groq, ollama, claude, or copilot.
# Provider credentials stay on the backend and are never returned to the React app.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Groq credentials may also be configured and selected in User Settings.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Cloud credentials.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Optional Copilot SDK model; blank uses the Copilot CLI runtime's default.
COPILOT_MODEL=

# ───────────────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ───────────────────────────────────────────────────────────────────────────────

# Log level (error | warn | info | debug | trace)
LOG_LEVEL=info

# Enable request logging
REQUEST_LOGGING=true

# ───────────────────────────────────────────────────────────────────────────────
# PRODUCTION ONLY
# ───────────────────────────────────────────────────────────────────────────────

# Database URL (if using database instead of JSON files)
DATABASE_URL=

# Redis URL (for caching and queuing)
REDIS_URL=

# JWT secret key
JWT_SECRET=

# API rate limit (requests per 15 minutes)
RATE_LIMIT=100
