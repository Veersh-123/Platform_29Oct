# Observability MCP Server Configuration

# ─────────────────────────────────────────────────────────────
# Ollama Configuration
# ─────────────────────────────────────────────────────────────

# Base URL for Ollama service
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use for AI analysis
# Options: mistral, neural-chat, codellama, llama2
# Default: mistral
OLLAMA_MODEL=mistral

# Maximum tokens for Ollama responses
# Higher values = more detailed responses (but slower)
# Default: 2000
OLLAMA_MAX_TOKENS=2000

# Temperature for Ollama responses (0-2)
# Lower = more focused, Higher = more creative
# Default: 0.1 (more deterministic)
OLLAMA_TEMPERATURE=0.1

# ─────────────────────────────────────────────────────────────
# OpenAI Configuration (Optional)
# ─────────────────────────────────────────────────────────────

# OpenAI API key (for GPT-powered features)
# If set, will use OpenAI for analysis instead of Ollama
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-api-key-here

# OpenAI model to use
# Default: gpt-3.5-turbo
# OPENAI_MODEL=gpt-3.5-turbo

# ─────────────────────────────────────────────────────────────
# Logging & Debug
# ─────────────────────────────────────────────────────────────

# Logging level
# Options: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Paths & Directories
# ─────────────────────────────────────────────────────────────

# Path to cucumber test results
# Used as default if no path provided to tools
# CUCUMBER_RESULTS_PATH=../data/cucumber-results.json

# Path to JUnit test results
# Used as default if no path provided to tools
# JUNIT_RESULTS_PATH=../data/junit-results.xml

# Output path for generated dashboards
# Default: ../dashboard/
# DASHBOARD_OUTPUT_PATH=../dashboard/

# ─────────────────────────────────────────────────────────────
# Dashboard Configuration
# ─────────────────────────────────────────────────────────────

# Auto-open dashboard in browser after generation
# Default: false
# DASHBOARD_AUTO_OPEN=false

# Generate dashboard after AI analysis
# Default: true
# DASHBOARD_GENERATE=true

# Custom dashboard title
# Default: "Test Automation Report"
# DASHBOARD_TITLE=Test Automation Report

# Dashboard logo URL
# Default: empty
# DASHBOARD_LOGO_URL=https://example.com/logo.png

# ─────────────────────────────────────────────────────────────
# Analysis Configuration
# ─────────────────────────────────────────────────────────────

# Include AI analysis by default
# Default: true
# INCLUDE_AI_ANALYSIS=true

# Timeout for AI analysis (milliseconds)
# Default: 60000 (60 seconds)
# AI_TIMEOUT=60000

# ─────────────────────────────────────────────────────────────
# Advanced
# ─────────────────────────────────────────────────────────────

# Server port (if running as standalone server)
# Default: 3001
# SERVER_PORT=3001

# Enable MCP server mode
# Default: true
# MCP_MODE=true

# Connection mode for different environments
# Options: local, docker, remote
# Default: local
# CONNECTION_MODE=local

# ─────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────

# 1. Copy this file to .env and update values as needed
#    cp .env.example .env
#
# 2. For production, use environment variables or secrets management
#
# 3. Never commit .env with sensitive information to version control
#
# 4. Keep .env in .gitignore
#
# 5. For team development, share .env.example, not .env
