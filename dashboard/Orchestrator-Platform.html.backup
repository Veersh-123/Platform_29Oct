            <!-- ── User Settings Modal ── -->
            <div id="userSettingsModal" onclick="if(event.target===this)closeUserSettingsModal()"
                 style="display:none;position:fixed;inset:0;z-index:9500;background:rgba(5,14,26,0.92);
                        backdrop-filter:blur(6px);flex-direction:column;align-items:center;justify-content:center;overflow-y:auto;">
                <div style="background:#0a1628;border:1px solid #1e3a5a;border-radius:12px;
                            width:calc(100vw - 48px);max-width:900px;
                            display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,0.7);
                            overflow:hidden;animation:userSettingsIn 0.22s ease;margin:24px 0;">
                    <!-- Header bar -->
                    <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:14px 24px;
                                display:flex;align-items:center;gap:14px;flex-shrink:0;">
                        <span style="font-size:22px;line-height:1;">⚙️</span>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:white;">User Settings</div>
                            <div style="font-size:11px;color:#64748b;">Manage your profile, connections, and environment</div>
                        </div>
                        <button onclick="closeUserSettingsModal()"
                                style="margin-left:auto;background:none;border:1px solid #2a3f5a;color:#64748b;
                                       width:32px;height:32px;border-radius:6px;font-size:16px;cursor:pointer;
                                       display:flex;align-items:center;justify-content:center;transition:all 0.2s;"
                                onmouseenter="this.style.borderColor='#f87171';this.style.color='#f87171'"
                                onmouseleave="this.style.borderColor='#2a3f5a';this.style.color='#64748b'"
                                title="Close">✕</button>
                    </div>
                    <!-- Content area -->
                    <div style="flex:1;overflow-y:auto;padding:24px;">
                        <!-- Profile Settings -->
                        <div style="margin-bottom:32px;">
                            <div style="font-size:14px;font-weight:700;color:white;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                                <span>👤</span> Profile Settings
                            </div>
                            <div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:10px;padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                                <div>
                                    <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">First Name</label>
                                    <input id="userFirstName" type="text" placeholder="Enter first name" 
                                           style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                           onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                </div>
                                <div>
                                    <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Last Name</label>
                                    <input id="userLastName" type="text" placeholder="Enter last name"
                                           style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                           onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                </div>
                                <div>
                                    <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Role</label>
                                    <select id="userRole" style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                            onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'">
                                        <option value="">Select role</option>
                                        <option value="qa-engineer">QA Engineer</option>
                                        <option value="qa-lead">QA Lead</option>
                                        <option value="devops">DevOps Engineer</option>
                                        <option value="admin">Admin</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Email</label>
                                    <input id="userEmail" type="email" placeholder="Enter email"
                                           style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                           onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                </div>
                                <div style="grid-column:1/-1;">
                                    <div style="font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:12px;letter-spacing:0.4px;">Change Password</div>
                                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                                        <input id="userNewPassword" type="password" placeholder="New password"
                                               style="background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                               onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                        <input id="userConfirmPassword" type="password" placeholder="Confirm password"
                                               style="background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                               onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                    </div>
                                    <button onclick="userUpdateProfile()"
                                            style="background:linear-gradient(135deg,#60a5fa,#3b82f6);border:none;color:white;padding:10px 24px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;"
                                            onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
                                        💾 Update Profile
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- MCP & LLM Configuration -->
                        <div style="margin-bottom:32px;">
                            <div style="font-size:14px;font-weight:700;color:white;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                                <span>🔌</span> MCP & LLM Configuration
                            </div>
                            <div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:10px;padding:20px;">
                                <!-- MCP Configuration -->
                                <div style="margin-bottom:20px;">
                                    <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:10px;letter-spacing:0.4px;">MCP Configuration Path</label>
                                    <div style="display:flex;gap:8px;margin-bottom:12px;">
                                        <input id="mcpConfigPath" type="text" placeholder="Path to MCP config"
                                               style="flex:1;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;"
                                               onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                        <button onclick="userBrowseMcpConfig()"
                                                style="background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.3);color:#60a5fa;padding:8px 14px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;">
                                            📁 Browse
                                        </button>
                                    </div>
                                    <div id="mcpCheckboxList" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:12px;">
                                        <!-- Checkboxes will be populated by JS -->
                                    </div>
                                    <button onclick="userConnectMcp()"
                                            style="background:linear-gradient(135deg,#10b981,#059669);border:none;color:white;padding:10px 24px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;"
                                            onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
                                        🔗 Connect Selected MCPs
                                    </button>
                                </div>

                                <!-- LLM Configuration -->
                                <div style="border-top:1px solid #1a2f4a;padding-top:20px;">
                                    <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:10px;letter-spacing:0.4px;">LLM Provider</label>
                                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                                        <select id="userLlmProvider" style="background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;"
                                                onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'">
                                            <option value="">Select LLM Provider</option>
                                            <option value="openai">OpenAI (GPT-4)</option>
                                            <option value="anthropic">Anthropic (Claude)</option>
                                            <option value="azure">Azure OpenAI</option>
                                        </select>
                                        <input id="userLlmApiKey" type="password" placeholder="API Key"
                                               style="background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;"
                                               onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                    </div>
                                    <button onclick="userConnectLlm()"
                                            style="background:linear-gradient(135deg,#7c3aed,#6d28d9);border:none;color:white;padding:10px 24px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;"
                                            onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
                                        🔐 Connect LLM
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Environment Settings -->
                        <div>
                            <div style="font-size:14px;font-weight:700;color:white;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                                <span>🌍</span> Environment Settings
                            </div>
                            <div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:10px;padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                                <div>
                                    <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Environment URL</label>
                                    <input id="userEnvUrl" type="url" placeholder="https://your-app.com"
                                           style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                           onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                </div>
                                <div>
                                    <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Browser</label>
                                    <select id="userBrowser" style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                            onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'">
                                        <option value="">Select browser</option>
                                        <option value="chromium">Chromium</option>
                                        <option value="firefox">Firefox</option>
                                        <option value="webkit">WebKit</option>
                                    </select>
                                </div>
                                <button onclick="userUpdateEnvironment()" style="grid-column:1/-1;
                                        background:linear-gradient(135deg,#f59e0b,#d97706);border:none;color:white;padding:10px 24px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;justify-self:start;"
                                        onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
                                    🌐 Update Environment
                                </button>
                            </div>
                        </div>

                        <!-- Test Management & LLM Configuration (writes to .env) -->
                        <div style="margin-top:24px;">
                            <div style="font-size:14px;font-weight:700;color:white;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                                <span>🔧</span> Test Management &amp; LLM Configuration
                                <span style="font-size:10px;color:#64748b;font-weight:400;margin-left:4px;">(saved to .env — takes effect immediately)</span>
                            </div>
                            <div id="envConfigStatus" style="display:none;margin-bottom:12px;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:600;"></div>

                            <!-- Test Management Tool -->
                            <div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:10px;padding:20px;margin-bottom:16px;">
                                <div style="font-size:12px;font-weight:700;color:#60a5fa;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:14px;">🗂 Test Management Tool</div>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                                    <div style="grid-column:1/-1;">
                                        <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Tool</label>
                                        <select id="envToolType" onchange="envOnToolChange(this.value)"
                                                style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'">
                                            <option value="Jira">🟦 Jira</option>
                                            <option value="ADO">☁️ Azure DevOps</option>
                                        </select>
                                    </div>

                                    <!-- Jira fields -->
                                    <div id="envJiraFields" style="display:contents;">
                                        <div>
                                            <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Jira Base URL</label>
                                            <input id="envJiraUrl" type="url" placeholder="https://yourorg.atlassian.net"
                                                   style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                        </div>
                                        <div>
                                            <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Jira Email</label>
                                            <input id="envJiraEmail" type="email" placeholder="you@company.com"
                                                   style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                        </div>
                                        <div style="grid-column:1/-1;">
                                            <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Jira API Token</label>
                                            <div style="position:relative;">
                                                <input id="envJiraToken" type="password" placeholder="Paste your Jira API token"
                                                       style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 40px 10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                       onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                                <button onclick="envToggleSecret('envJiraToken',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:#64748b;cursor:pointer;font-size:14px;padding:0;" title="Show/hide">👁</button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ADO fields -->
                                    <div id="envAdoFields" style="display:none;grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                                        <div>
                                            <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">ADO Org URL</label>
                                            <input id="envAdoUrl" type="url" placeholder="https://dev.azure.com/yourorg"
                                                   style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                        </div>
                                        <div>
                                            <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">ADO Project</label>
                                            <input id="envAdoProject" type="text" placeholder="MyProject"
                                                   style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                        </div>
                                        <div style="grid-column:1/-1;">
                                            <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">ADO PAT (Personal Access Token)</label>
                                            <div style="position:relative;">
                                                <input id="envAdoPat" type="password" placeholder="Paste your ADO PAT"
                                                       style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 40px 10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                       onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                                <button onclick="envToggleSecret('envAdoPat',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:#64748b;cursor:pointer;font-size:14px;padding:0;" title="Show/hide">👁</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <button onclick="envSaveTestManagement()" style="margin-top:16px;background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:10px 24px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:opacity 0.2s;"
                                        onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
                                    💾 Save Test Management Config
                                </button>
                            </div>

                            <!-- LLM / AI Provider -->
                            <div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:10px;padding:20px;">
                                <div style="font-size:12px;font-weight:700;color:#a78bfa;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:14px;">🤖 LLM / AI Provider</div>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                                    <div>
                                        <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Provider</label>
                                        <select id="envLlmProvider" onchange="envOnLlmChange(this.value)"
                                                style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'">
                                            <option value="">— Select Provider —</option>
                                            <option value="openai">OpenAI</option>
                                            <option value="anthropic">Anthropic (Claude)</option>
                                            <option value="groq">Groq</option>
                                            <option value="deepseek">DeepSeek</option>
                                            <option value="gemini">Google Gemini</option>
                                            <option value="openrouter">OpenRouter</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">Model</label>
                                        <input id="envLlmModel" type="text" placeholder="e.g. gpt-4o, claude-3-5-sonnet"
                                               style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                               onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                    </div>
                                    <div style="grid-column:1/-1;">
                                        <label style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:6px;letter-spacing:0.4px;">API Key</label>
                                        <div style="position:relative;">
                                            <input id="envLlmApiKey" type="password" placeholder="Paste your API key"
                                                   style="width:100%;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;padding:10px 40px 10px 12px;color:#e2e8f0;font-size:12px;outline:none;box-sizing:border-box;"
                                                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1a2f4a'"/>
                                            <button onclick="envToggleSecret('envLlmApiKey',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:#64748b;cursor:pointer;font-size:14px;padding:0;" title="Show/hide">👁</button>
                                        </div>
                                        <div style="margin-top:6px;font-size:10px;color:#475569;">Keys are saved to <code style="background:#0a1628;padding:1px 5px;border-radius:3px;">.env</code> on the server and excluded from Git.</div>
                                    </div>
                                </div>
                                <button onclick="envSaveLlm()" style="margin-top:16px;background:linear-gradient(135deg,#7c3aed,#6d28d9);border:none;color:white;padding:10px 24px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:opacity 0.2s;"
                                        onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
                                    💾 Save LLM Config
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <style>
                @keyframes userSettingsIn {
                    from { opacity:0; transform:scale(0.97) translateY(-12px); }
                    to   { opacity:1; transform:scale(1) translateY(0); }
                }
            </style>

            <!-- ── Jira Board Tab (hidden — board shown via popup modal) ── -->
            <div class="jira-board-content" id="jira" style="display:none;">
                <div class="jira-board-toolbar">
                    <div class="jira-board-title">🗂 Jira Board</div>
                    <div id="jiraInstanceBadge" style="font-size:11px;color:#60a5fa;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);padding:3px 10px;border-radius:10px;">Loading…</div>
                    <div class="jira-view-label">Project</div>
                    <select class="jira-view-select" id="jiraProjectSelect" onchange="onJiraProjectChange(this.value)" style="min-width:160px;">
                        <option value="">Loading projects…</option>
                    </select>
                    <div class="jira-view-label">View</div>
                    <select class="jira-view-select" id="jiraBoardViewSelect" onchange="onJiraSelectChange(this.value)">
                        <option value="all">All Issues</option>
                        <option value="mine">My Issues</option>
                        <option value="inprogress">In Progress</option>
                        <option value="done">Done</option>
                        <option value="backlog">Backlog</option>
                        <option value="sprint">Active Sprint</option>
                    </select>
                    <button class="jira-refresh-btn" id="jiraRefreshBtn" onclick="loadJiraBoard(true)" title="Refresh board">
                        <svg id="jiraRefreshIcon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M23 4v6h-6"/><path d="M1 20v-6h6"/>
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                        </svg> Refresh
                    </button>
                    <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
                        <span style="font-size:11px;color:#475569;" id="jiraBoardViewLabel">Showing: All Issues</span>
                        <span style="font-size:11px;color:#475569;" id="jiraFetchedAt"></span>
                    </div>
                </div>
                <div class="jira-board-inner" id="jiraBoardInner">
                    <div class="jira-state"><div class="icon">🗂</div><div class="msg">Select the Jira Board tab to load issues</div></div>
                </div>
            </div>

            <!-- Jira Board Popup Modal -->
            <div id="jiraBoardModal" onclick="if(event.target===this)closeJiraBoardModal()">
                <div class="jira-board-modal-card">
                    <div class="jira-board-modal-header">
                        <div class="jira-board-modal-title">🗂 Jira Board</div>
                        <div id="jiraBoardModalBadge" style="font-size:11px;color:#60a5fa;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);padding:3px 10px;border-radius:10px;"></div>
                        <select class="jira-view-select" id="jiraBoardModalProjectSelect" onchange="onJiraBoardModalProjectChange(this.value)" style="font-size:11px;padding:4px 8px;min-width:150px;">
                            <option value="">Loading…</option>
                        </select>
                        <select class="jira-view-select" id="jiraBoardModalViewSelect" onchange="onJiraBoardModalViewChange(this.value)" style="font-size:11px;padding:4px 8px;min-width:130px;">
                            <option value="all">All Issues</option>
                            <option value="sprint">Active Sprint</option>
                            <option value="backlog">Backlog</option>
                            <option value="inprogress">In Progress</option>
                            <option value="done">Done</option>
                        </select>
                        <button class="jira-refresh-btn" onclick="loadJiraBoardModal(true)" title="Refresh" style="padding:5px 10px;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        </button>
                        <span style="font-size:11px;color:#475569;" id="jiraBoardModalFetchedAt"></span>
                        <button class="jira-board-modal-close" onclick="closeJiraBoardModal()" title="Close">✕</button>
                    </div>
                    <div class="jira-board-modal-body" id="jiraBoardModalBody">
                        <div class="jira-state"><div class="icon">⏳</div><div class="msg">Loading board…</div></div>
                    </div>
                </div>
            </div>

            <!-- Jira Issue Modal -->
            <div id="jiraModal" role="dialog" aria-modal="true" aria-labelledby="jiraModalTitle" onclick="if(event.target===this)closeJiraModal()">
                <div class="jira-modal-card">
                    <div class="jira-modal-header">
                        <div><div class="jira-modal-key" id="jiraModalKey"></div><div class="jira-modal-title" id="jiraModalTitle"></div></div>
                        <button class="jira-modal-close" onclick="closeJiraModal()" aria-label="Close">✕</button>
                    </div>
                    <div class="jira-modal-body" id="jiraModalBody"><div class="jira-state"><div class="icon">⏳</div><div class="msg">Loading…</div></div></div>
                    <div class="jira-modal-footer" id="jiraModalFooter">
                        <span style="font-size:11px;color:#475569;" id="jiraModalUpdated"></span>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <button id="jiraModalDesignBtn" onclick="selectTicketForDesign(document.getElementById('jiraModalKey').textContent)" style="background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:7px 14px;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;">⚡ Generate Tests</button>
                            <a class="jira-open-btn" id="jiraModalOpenLink" href="#" target="_blank" rel="noopener">Open in Jira ↗</a>
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- end .content -->
    </div><!-- end .main-section -->
</div><!-- end .container -->

<!-- New Suite Modal -->
<div id="newSuiteModal" onclick="if(event.target===this)closeNewSuiteModal()">
    <div class="new-suite-card">
        <h3>➕ Create New Test Suite</h3>
        <input class="new-suite-input" id="newSuiteInput" type="text" placeholder="Suite name…" maxlength="60"
               onkeydown="if(event.key==='Enter')confirmNewSuite()"/>
        <div class="new-suite-actions">
            <button class="new-suite-cancel" onclick="closeNewSuiteModal()">Cancel</button>
            <button class="new-suite-create" onclick="confirmNewSuite()">Create Suite</button>
        </div>
    </div>
</div>

<!-- Script Viewer Modal -->
<div id="scriptModal" role="dialog" aria-modal="true" aria-labelledby="scriptModalFilename" onclick="if(event.target===this)closeScriptModal()">
    <div class="script-modal-card">
        <div class="script-modal-header">
            <div class="script-modal-filename" id="scriptModalFilename"></div>
            <button class="script-modal-close" onclick="closeScriptModal()" aria-label="Close">✕</button>
        </div>
        <div class="script-modal-body">
            <pre id="scriptModalContent"></pre>
        </div>
    </div>
</div>

<script>
// ── Config ────────────────────────────────────────────────────────────────────
const SERVER = 'http://localhost:4000';
let projectRoot = ''; // populated on init from /api/project-root

// ── Tab switching ─────────────────────────────────────────────────────────────
const tabs = document.querySelectorAll('.nav-tab');

/** Single source of truth for switching tabs — handles both class AND inline style */
function switchToTab(tabId) {
    // Deactivate all nav tabs
    tabs.forEach(t => t.classList.remove('active'));
    document.getElementById('jiraTabBtn')?.classList.remove('active');
    document.getElementById('jiraDropdownToggle')?.classList.remove('active');

    // Hide ALL tab-content divs — remove class AND clear any inline display style
    document.querySelectorAll('.tab-content').forEach(c => {
        c.classList.remove('active');
        c.style.display = '';   // let CSS .tab-content rule apply (display:none)
    });

    // Activate the target tab nav button
    const navBtn = [...tabs].find(t => t.dataset.tab === tabId);
    if (navBtn) navBtn.classList.add('active');

    // Show the target content
    const target = document.getElementById(tabId);
    if (target) {
        target.classList.add('active');
        target.style.display = ''; // let CSS .tab-content.active rule apply (display:flex)
    }

    // Lazy-load on first visit
    if (tabId === 'history')      loadResults();
    if (tabId === 'data')         loadTestData();
    if (tabId === 'explorer')     loadTestExplorer();
    if (tabId === 'testdesign')   loadTdTickets();
    if (tabId === 'manualtests')  loadMtTickets();
    if (tabId === 'vas')          vasRenderCards();
    if (tabId === 'requirements') {
        // Do NOT reset the tool selection — preserve whatever the user had selected
        reqLoadDocList();
    }
}

tabs.forEach(tab => {
    tab.addEventListener('click', function () {
        switchToTab(this.dataset.tab);
    });
});

// ── Helpers ───────────────────────────────────────────────────────────────────
function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function setStatus(text, cls) {
    const el = document.getElementById('runStatus');
    el.textContent = text; el.className = 'status-badge ' + cls;
}
function setProgress(pct, cls='') {
    const bar = document.getElementById('progressBar');
    bar.style.width = pct + '%'; bar.className = 'progress-bar ' + cls;
}
function appendLog(text, cls='') {
    const body = document.getElementById('logBody');
    const line = document.createElement('div');
    line.className = 'log-line ' + cls; line.textContent = text;
    body.appendChild(line); body.scrollTop = body.scrollHeight;
}
function classifyLine(line) {
    if (/passed|✓|✔/.test(line)) return 'pass';
    if (/failed|✗|✘|error/i.test(line)) return 'fail';
    if (/running|started|playwright/i.test(line)) return 'info';
    return '';
}
function toggleSuite(header) {
    const cases = header.nextElementSibling;
    const arrow = header.querySelector('.suite-arrow');
    const hidden = cases.style.display === 'none';
    cases.style.display = hidden ? '' : 'none';
    if (arrow) arrow.textContent = hidden ? '▾' : '▸';
}

// ── Dashboard stats ───────────────────────────────────────────────────────────
async function loadDashboard() {
    try {
        const res  = await fetch(`${SERVER}/api/stats`);
        if (!res.ok) throw new Error('Server error');
        const data = await res.json();

        // ── Work Summary ──
        const passed   = data.passed  ?? 0;
        const failed   = data.failed  ?? 0;
        const skipped  = data.skipped ?? 0;
        const total    = data.total   ?? 0;
        const totalTests = data.totalTests ?? (data.mdTestCases ?? 0);
        const passRate = total > 0 ? Math.round((passed / total) * 100) : null;
        const rateColor = passRate === null ? '#64748b' : passRate === 100 ? '#10b981' : passRate >= 50 ? '#f59e0b' : '#f87171';

        document.getElementById('dashTotalTests').textContent = totalTests || '–';
        document.getElementById('dashCardPassed').textContent = total > 0 ? passed : '–';
        document.getElementById('dashCardFailed').textContent = total > 0 ? failed : '–';

        const passRateEl = document.getElementById('dashPassRateVal');
        const passBarEl  = document.getElementById('dashPassRateBar');
        if (passRate !== null) {
            passRateEl.textContent     = passRate + '%';
            passRateEl.style.color     = rateColor;
            passBarEl.style.width      = passRate + '%';
            passBarEl.style.background = rateColor;
        } else {
            passRateEl.textContent = 'No runs';
            passRateEl.style.color = '#475569';
        }

        // ── Metrics Overview ──
        document.getElementById('dashCardSpecs').textContent  = data.specFiles   ?? '–';
        document.getElementById('dashCardSuites').textContent = data.suiteCount  ?? (Array.isArray(data.suites) ? data.suites.length : '–');
        document.getElementById('dashCardPages').textContent  = data.pageObjects ?? '–';
        document.getElementById('dashCardTests').textContent  = totalTests        || '–';

        // Automation Coverage: automated vs total spec test cases
        const coverageEl  = document.getElementById('dashCoverage');
        const coverageBar = document.getElementById('dashCoverageBar');
        const mdTotal = data.mdTestCases ?? 0;
        const autoTotal = data.totalTests ?? 0;
        const coverage = mdTotal > 0 && autoTotal > 0
            ? Math.min(100, Math.round((autoTotal / mdTotal) * 100))
            : (passRate !== null ? passRate : null);
        if (coverage !== null) {
            const covColor = coverage === 100 ? '#10b981' : coverage >= 75 ? '#10b981' : coverage >= 50 ? '#f59e0b' : '#f87171';
            coverageEl.textContent      = coverage + '%';
            coverageEl.style.color      = covColor;
            coverageBar.style.width     = coverage + '%';
            coverageBar.style.background = covColor;
        } else {
            coverageEl.textContent = 'N/A';
            coverageEl.style.color = '#475569';
        }

        // Execution Trend
        const trendEl = document.getElementById('dashTrend');
        if (total > 0 && passRate !== null) {
            if (passRate === 100)      { trendEl.textContent = '✅ All Passing';        trendEl.style.color = '#10b981'; }
            else if (passRate >= 75)   { trendEl.textContent = '📈 Mostly Passing';    trendEl.style.color = '#10b981'; }
            else if (passRate >= 50)   { trendEl.textContent = '⚠ Partially Passing'; trendEl.style.color = '#f59e0b'; }
            else                       { trendEl.textContent = '📉 High Failure Rate'; trendEl.style.color = '#f87171'; }
        } else {
            trendEl.textContent = 'No runs yet';
            trendEl.style.color = '#475569';
        }

        // Last Run timestamp
        const lastRunEl = document.getElementById('dashLastRun');
        if (data.lastRun) {
            lastRunEl.textContent = 'Last: ' + new Date(data.lastRun).toLocaleString();
        } else {
            lastRunEl.textContent = 'No runs recorded';
        }

        // Token / AI info
        const tokensEl   = document.getElementById('dashTokens');
        const tokensHint = document.getElementById('dashTokensHint');
        
        // Calculate token utilization percentage
        const usage = tokenGetUsage();
        let totalConsumed = 0;
        let totalBudget = 0;
        Object.keys(TOKEN_BUDGETS).forEach(function(stage) {
            const used = (usage[stage] && usage[stage].total) || 0;
            const budget = TOKEN_BUDGETS[stage];
            totalConsumed += used;
            totalBudget += budget;
        });
        const utilizationPercent = totalBudget > 0 ? Math.round((totalConsumed / totalBudget) * 100) : 0;
        
        if (tokensEl) {
            tokensEl.textContent = utilizationPercent + '%';
            // Update color based on utilization
            if (utilizationPercent > 80) {
                tokensEl.style.color = '#f87171';
            } else if (utilizationPercent > 50) {
                tokensEl.style.color = '#fbbf24';
            } else {
                tokensEl.style.color = '#a78bfa';
            }
        }
        if (tokensHint) {
            tokensHint.textContent = `${totalConsumed.toLocaleString()} / ${totalBudget.toLocaleString()} tokens used`;
        }

        // ── Project Info panel (if elements exist) ──
        const setIf = (id, val, fallback) => { const el = document.getElementById(id); if (el) el.textContent = val || fallback || '–'; };
        const setHrefIf = (id, href, text) => {
            const el = document.getElementById(id);
            if (!el) return;
            if (href) { el.innerHTML = `<a href="${href}" target="_blank" style="color:#3b82f6;text-decoration:none;">${text || href}</a>`; }
            else { el.textContent = text || '–'; }
        };
        setIf('dashProjStoryId',    data.storyId);
        setIf('dashProjStoryName',  data.storyName);
        setIf('dashProjPlatform',   data.platform);
        setIf('dashProjFramework',  data.framework   + ' · ' + (data.language || 'TypeScript'));
        setIf('dashProjBaseUrl',    data.baseUrl);
        setIf('dashProjDataFiles',  data.testDataFiles);
        setIf('dashProjSkipped',    total > 0 ? skipped : '–');
        setHrefIf('dashProjJiraUrl', data.jiraUrl, data.storyId ? 'Open in Jira ↗' : null);

        document.getElementById('dashServerWarn').style.display = 'none';
    } catch (e) {
        document.getElementById('dashServerWarn').style.display = 'block';
    }
}

// ── Test Execution ────────────────────────────────────────────────────────────
const specRunState = {}; // { [file]: 'running' | 'passed' | 'failed' }

// ── Suite Management (localStorage) ──────────────────────────────────────────
const SUITES_KEY = 'pw_test_suites';
let _allSpecs    = [];   // raw spec files from /api/tests (for running)
let _allCases    = [];   // parsed test cases from /api/specs
let _activeSuite = null; // null = show all

function loadSuites() {
    try { return JSON.parse(localStorage.getItem(SUITES_KEY)) || []; }
    catch(_) { return []; }
}
function saveSuites(suites) {
    localStorage.setItem(SUITES_KEY, JSON.stringify(suites));
}

function renderSuiteList() {
    const suites = loadSuites();
    const listEl = document.getElementById('suiteList');
    if (!listEl) return;

    // "All Test Cases" is always the first item
    const specTestCount = _allSpecs.reduce(function(sum, s) { return sum + (s.tests ? s.tests.length : 0); }, 0);
    const totalCount = _allCases.length || specTestCount;
    let html = `<div class="suite-item ${_activeSuite===null?'active':''}" onclick="selectSuite(null)" style="border-bottom:1px solid rgba(255,255,255,0.06);">
        <span class="suite-item-name" title="All Test Cases" style="color:${_activeSuite===null?'#60a5fa':'#94a3b8'};">📋 All Test Cases</span>
        <span class="suite-item-count">${totalCount}</span>
    </div>`;

    if (!suites.length) {
        html += `<div style="padding:14px 12px;font-size:11px;color:#334155;text-align:center;line-height:1.6;">No suites yet.<br>Click <strong style="color:#60a5fa;">+ New Suite</strong> to create one.</div>`;
    } else {
        for (const s of suites) {
            const count = (s.caseIds || []).length;
            html += `<div class="suite-item ${_activeSuite===s.id?'active':''}" onclick="selectSuite('${s.id}')">
                <span class="suite-item-name" title="${escHtml(s.name)}">${escHtml(s.name)}</span>
                <span class="suite-item-count">${count}</span>
                <button class="suite-delete-btn" onclick="event.stopPropagation();deleteSuite('${s.id}')" title="Delete suite">✕</button>
            </div>`;
        }
    }
    listEl.innerHTML = html;

    // Rebuild the header suite dropdown
    const sel = document.getElementById('addToSuiteSelect');
    if (sel) {
        sel.innerHTML = '<option value="">Add to suite…</option>'
            + suites.map(s => `<option value="${s.id}">${escHtml(s.name)}</option>`).join('');
    }
}

function selectSuite(id) {
    _activeSuite = id;
    renderSuiteList();
    renderCases();
    const rsBtn = document.getElementById('runSuiteBtn');
    if (rsBtn) rsBtn.style.display = id ? 'flex' : 'none';
    // Also filter Generated Scripts test case panels
    execFilterBySuite(id);
}
function deleteSuite(id) {
    const suites = loadSuites().filter(s => s.id !== id);
    saveSuites(suites);
    if (_activeSuite === id) _activeSuite = null;
    renderSuiteList();
    renderCases();
}

function openNewSuiteModal() {
    const modal = document.getElementById('newSuiteModal');
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    document.getElementById('newSuiteInput').value = '';
    setTimeout(() => document.getElementById('newSuiteInput').focus(), 50);
}
function closeNewSuiteModal() {
    document.getElementById('newSuiteModal').classList.remove('open');
    document.body.style.overflow = '';
}
function confirmNewSuite() {
    const name = document.getElementById('newSuiteInput').value.trim();
    if (!name) return;
    const suites = loadSuites();
    const id = 'suite_' + Date.now();
    suites.push({ id, name, caseIds: [] });
    saveSuites(suites);
    closeNewSuiteModal();
    renderSuiteList();
    selectSuite(id);
}

/** Build suite dropdown options for inline selector */
function buildSuiteOptions(selectedId) {
    const suites = loadSuites();
    if (!suites.length) return '<option value="">— No suites yet —</option>';
    return suites.map(s =>
        `<option value="${s.id}" ${s.id===selectedId?'selected':''}>${escHtml(s.name)}</option>`
    ).join('');
}

function addCaseToSuite(caseId, suiteId) {
    if (!suiteId) return;
    const suites = loadSuites();
    const suite  = suites.find(s => s.id === suiteId);
    if (!suite) return;
    if (!suite.caseIds.includes(caseId)) suite.caseIds.push(caseId);
    saveSuites(suites);
    renderSuiteList();
    renderCases();
}

function removeCaseFromSuite(caseId, suiteId) {
    const suites = loadSuites();
    const suite  = suites.find(s => s.id === suiteId);
    if (!suite) return;
    suite.caseIds = suite.caseIds.filter(id => id !== caseId);
    saveSuites(suites);
    renderSuiteList();
    renderCases();
}

function syncSelectionButtons() {
    const checked   = document.querySelectorAll('.tc-checkbox:checked').length;
    const execChecked = document.querySelectorAll('.exec-tc-cb:checked').length;
    const totalChecked = checked + execChecked;
    const runSelBtn = document.getElementById('runSelectedBtn');
    const addBtn    = document.getElementById('addToSuiteBtn');
    if (runSelBtn) runSelBtn.disabled = totalChecked === 0;
    if (addBtn)    addBtn.disabled    = totalChecked === 0;
}

/** Called when checkboxes in Generated Scripts section are toggled */
function execSyncSelection() {
    syncSelectionButtons();
}

/**
 * Filter the Generated Scripts test case panels by active suite.
 * If no suite is active (id=null), show all test cases.
 * If a suite is active, show only test cases whose names are in that suite's caseIds.
 */
function execFilterBySuite(suiteId) {
    const allCards = document.querySelectorAll('.exec-tc-cb');
    if (!suiteId) {
        // Show all
        allCards.forEach(function(cb) {
            const card = cb.closest('div[style*="background:#0a1628"]');
            if (card) card.style.display = '';
        });
        return;
    }
    const suites = loadSuites();
    const suite = suites.find(function(s){ return s.id === suiteId; });
    const caseIds = suite ? new Set(suite.caseIds || []) : new Set();

    allCards.forEach(function(cb) {
        const tcName = cb.getAttribute('data-tc-name');
        const card = cb.closest('div[style*="background:#0a1628"]');
        if (!card) return;
        if (caseIds.has(tcName)) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}

function addSelectedToSuite() {
    const sel = document.getElementById('addToSuiteSelect');
    if (!sel || !sel.value) { showToast('Please select a suite from the dropdown first.', 'warn'); return; }
    const suiteId = sel.value;

    const suites = loadSuites();
    const suite  = suites.find(s => s.id === suiteId);
    if (!suite) return;

    let added = 0;

    // Handle main panel checkboxes (.tc-checkbox)
    const mainChecked = [...document.querySelectorAll('.tc-checkbox:checked')];
    mainChecked.forEach(cb => {
        const caseId = cb.getAttribute('data-case-id');
        if (caseId && !suite.caseIds.includes(caseId)) {
            suite.caseIds.push(caseId);
            added++;
        }
    });

    // Handle Generated Scripts checkboxes (.exec-tc-cb)
    const execChecked = [...document.querySelectorAll('.exec-tc-cb:checked')];
    execChecked.forEach(cb => {
        const tcName = cb.getAttribute('data-tc-name');
        const tcFile = cb.getAttribute('data-tc-file');
        if (tcName && !suite.caseIds.includes(tcName)) {
            suite.caseIds.push(tcName);
            if (!suite.fileMap) suite.fileMap = {};
            suite.fileMap[tcName] = tcFile;
            added++;
        }
    });

    saveSuites(suites);

    mainChecked.forEach(cb => { cb.checked = false; });
    execChecked.forEach(cb => { cb.checked = false; });
    sel.value = '';
    syncSelectionButtons();
    renderSuiteList();
    renderCases();

    showToast(`${added} test case${added !== 1 ? 's' : ''} added to "${suite.name}"`, 'success');
}

function showToast(msg, type) {
    let t = document.getElementById('kiroToast');
    if (!t) {
        t = document.createElement('div');
        t.id = 'kiroToast';
        t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;padding:10px 18px;border-radius:8px;font-size:12px;font-weight:600;color:#fff;box-shadow:0 4px 16px rgba(0,0,0,0.4);transition:opacity 0.3s;pointer-events:none;';
        document.body.appendChild(t);
    }
    t.textContent = msg;
    t.style.background = type === 'success' ? '#059669' : type === 'warn' ? '#d97706' : '#dc2626';
    t.style.opacity = '1';
    clearTimeout(t._timer);
    t._timer = setTimeout(() => { t.style.opacity = '0'; }, 2800);
}

function renderCases() {
    const list   = document.getElementById('testsList');
    const toolbar = document.getElementById('casesToolbarTitle');
    if (!list) return;

    const suites      = loadSuites();
    const activeSuite = suites.find(s => s.id === _activeSuite);
    const suiteIds    = activeSuite ? new Set((activeSuite.caseIds||[]).map(id => (id||'').trim())) : null;

    // Apply ticket filter from the dropdown
    let cases = suiteIds
        ? _allCases.filter(c => suiteIds.has((c.id||'').trim()) || [...suiteIds].some(sid => sid.includes((c.id||'').trim()) || (c.id||'').trim().includes(sid.split(':')[0])))
        : _allCases;

    if (_execTicketFilter) {
        cases = cases.filter(c => (c.issueKey||'').toUpperCase() === _execTicketFilter.toUpperCase());
    }

    const specTestTotal = _allSpecs.reduce(function(sum, s) { return sum + (s.tests ? s.tests.length : 0); }, 0);
    const displayTotal = _allCases.length || specTestTotal;
    if (toolbar) toolbar.textContent = activeSuite
        ? `Suite: ${activeSuite.name} (${cases.length || (activeSuite.caseIds||[]).length} cases)`
        : _execTicketFilter
            ? `${_execTicketFilter} — Test Cases (${cases.length})`
            : `All Test Cases (${displayTotal})`;

    if (!cases.length && suiteIds) {
        // Check if suite has test cases from Generated Scripts (stored by full name)
        const suiteHasExecTests = activeSuite && (activeSuite.caseIds||[]).length > 0;
        if (suiteHasExecTests) {
            list.innerHTML = '<div class="no-results"><div class="icon">🧪</div><p>Suite tests are displayed in the Generated Scripts section below.<br><small>Expand a .spec.ts file to see the filtered test cases.</small></p></div>';
        } else {
            list.innerHTML = '<div class="no-results"><div class="icon">📭</div><p>No test cases in this suite yet.<br><small>Check test cases in "All Test Cases" view, select a suite and click <strong>+ Add</strong>.</small></p></div>';
        }
        return;
    }
    if (!cases.length) {
        list.innerHTML = '<div class="no-results"><div class="icon">🧪</div><p>No test cases found in specs/ folder.</p></div>';
        return;
    }

    // Group by issueKey
    const groups = {};
    for (const c of cases) {
        if (!groups[c.issueKey]) groups[c.issueKey] = [];
        groups[c.issueKey].push(c);
    }

    // Persist collapsed state across re-renders
    if (!window._collapsedGroups) window._collapsedGroups = {};

    list.innerHTML = '';
    for (const [issueKey, groupCases] of Object.entries(groups)) {
        const isCollapsed = !!window._collapsedGroups[issueKey];

        // Group header
        const header = document.createElement('div');
        header.style.cssText = 'font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#475569;padding:8px 8px 6px;margin-top:4px;display:flex;align-items:center;gap:6px;cursor:pointer;user-select:none;border-radius:4px;transition:background 0.15s;';
        header.onmouseenter = () => header.style.background = 'rgba(255,255,255,0.04)';
        header.onmouseleave = () => header.style.background = '';
        header.innerHTML = `<span style="font-size:10px;color:#64748b;transition:transform 0.2s;display:inline-block;transform:rotate(${isCollapsed?'-90deg':'0deg'})" id="chevron-${issueKey}">▼</span><span>📁 ${issueKey} <span style="color:#64748b;font-weight:500;">(${groupCases.length} cases)</span></span>`;

        // Cases container
        const groupBody = document.createElement('div');
        groupBody.id = `group-${issueKey}`;
        groupBody.style.display = isCollapsed ? 'none' : '';

        header.onclick = () => {
            const collapsed = groupBody.style.display === 'none';
            groupBody.style.display = collapsed ? '' : 'none';
            window._collapsedGroups[issueKey] = !collapsed;
            const chevron = document.getElementById(`chevron-${issueKey}`);
            if (chevron) chevron.style.transform = collapsed ? 'rotate(0deg)' : 'rotate(-90deg)';
        };

        list.appendChild(header);
        list.appendChild(groupBody);

        for (const tc of groupCases) {
            const inSuites = suites.filter(s => (s.caseIds||[]).includes(tc.id));
            const typeColor = tc.type==='Positive'?'#10b981':tc.type==='Negative'?'#f87171':'#a78bfa';
            const prioColor = tc.priority==='High'?'#f87171':tc.priority==='Medium'?'#f59e0b':'#64748b';
            const inActiveSuite = activeSuite && (activeSuite.caseIds||[]).includes(tc.id);

            const item = document.createElement('div');
            item.className = 'test-item' + (inActiveSuite ? ' in-suite' : '');
            item.dataset.caseId = tc.id;

            const suiteOpts = buildSuiteOptions('');
            const inSuiteTags = inSuites.length
                ? inSuites.map(s => `<span class="test-in-suite-badge" title="In suite: ${escHtml(s.name)}">${escHtml(s.name)}</span>`).join('')
                : '';

            item.innerHTML = `
                <div class="test-item-header">
                    <div class="test-item-left">
                        <input type="checkbox" class="test-item-cb tc-checkbox" data-source="${escHtml(tc.source||'')}" onchange="syncSelectionButtons()">
                        <div style="min-width:0;flex:1;">
                            <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:3px;">
                                <span style="font-size:10px;font-weight:700;color:#60a5fa;font-family:monospace;">${escHtml(tc.id)}</span>
                                <span style="font-size:10px;padding:1px 7px;border-radius:8px;font-weight:600;background:${typeColor}22;color:${typeColor};border:1px solid ${typeColor}44;">${escHtml(tc.type)}</span>
                                <span style="font-size:10px;padding:1px 7px;border-radius:8px;font-weight:600;background:#1a2f4a;color:${prioColor};">${escHtml(tc.priority)}</span>
                                ${inSuiteTags}
                            </div>
                            <div class="test-name" style="font-size:12px;">${escHtml(tc.title)}</div>
                            ${tc.expected ? `<div style="font-size:11px;color:#475569;margin-top:3px;">✓ ${escHtml(tc.expected)}</div>` : ''}
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
                        <span class="test-status-badge idle" id="badge-${btoa(tc.source||tc.id).replace(/=/g,'')}"></span>
                        <button id="runbtn-${btoa(tc.source||tc.id).replace(/=/g,'')}" onclick="runSingleSpec('${escHtml(tc.source||'')}')" class="run-single-btn" style="padding:3px 10px;font-size:10px;">▶ Run</button>
                    </div>
                </div>
                <div style="font-size:10px;color:#334155;margin-top:4px;">📄 ${escHtml(tc.source)}</div>`;
            // Set data-case-id directly on the DOM element to avoid any HTML encoding issues
            const cb = item.querySelector('.tc-checkbox');
            if (cb) cb.setAttribute('data-case-id', tc.id);
            groupBody.appendChild(item);
        }
    }
}

function addCaseFromInline(caseId) {
    const sel = document.querySelector(`.suite-select-inline[data-case-id="${caseId}"]`);
    if (!sel || !sel.value) return;
    addCaseToSuite(caseId, sel.value);
}

async function loadTestExplorer() {
    const list = document.getElementById('testsList');
    list.innerHTML = '<div class="no-results"><div class="icon">⏳</div><p>Loading test cases…</p></div>';
    try {
        // Load spec markdown test cases, playwright spec files, AND generated scripts in parallel
        const [specsRes, testsRes] = await Promise.all([
            fetch(`${SERVER}/api/specs`),
            fetch(`${SERVER}/api/tests`),
        ]);
        const specsData = specsRes.ok ? await specsRes.json() : { testCases: [] };
        const testsData = testsRes.ok ? await testsRes.json() : { specs: [] };
        _allCases = specsData.testCases || [];
        _allSpecs = testsData.specs    || [];
        renderSuiteList();
        renderCases();
        // Load generated scripts section (async, non-blocking)
        loadGeneratedTests();
    } catch (e) {
        list.innerHTML = `<div class="no-results"><div class="icon">⚠️</div><p>Cannot connect to server.<br><small>Run: <code>node server/index.js</code></small></p></div>`;
    }
}

function runSingleSpec(file) {
    const id = btoa(file).replace(/=/g,'');
    const badge = document.getElementById('badge-' + id);
    const btn   = document.getElementById('runbtn-' + id);
    if (!btn || !badge) return;
    btn.disabled = true;
    badge.textContent = 'Running…';
    badge.className = 'test-status-badge running';

    // Show global log panel
    const logPanel = document.getElementById('logPanel');
    const logBody  = document.getElementById('logBody');
    const logStatus = document.getElementById('logStatus');
    if (logPanel) { logPanel.style.display = 'flex'; logPanel.style.flexDirection = 'column'; }
    if (logBody)  logBody.innerHTML = '';
    if (logStatus) logStatus.textContent = `Running ${file}…`;

    fetch(`${SERVER}/api/run-tests/file`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ file })
    }).then(async response => {
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let exitCode = 1;
        let logCount = 0;
        
        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            for (const part of parts) {
                const dl = part.split('\n').find(l => l.startsWith('data:'));
                if (!dl) continue;
                try {
                    const msg = JSON.parse(dl.slice(5));
                    if (msg.type === 'log') {
                        logCount++;
                        appendLog(msg.data, classifyLine(msg.data));
                    } else if (msg.type === 'error') {
                        appendLog('❌ ' + msg.data, 'fail');
                    } else if (msg.type === 'done') {
                        exitCode = msg.data.exitCode;
                        const passed = msg.data.passed || 0;
                        const failed = msg.data.failed || 0;
                        const skipped = msg.data.skipped || 0;
                        appendLog('');
                        appendLog(`Result Summary: ${passed} passed, ${failed} failed, ${skipped} skipped`, exitCode === 0 ? 'pass' : 'fail');
                    }
                } catch(_) {}
            }
        }
        
        badge.textContent = exitCode === 0 ? 'Passed' : 'Failed';
        badge.className = 'test-status-badge ' + (exitCode === 0 ? 'passed' : 'failed');
        if (logStatus) logStatus.textContent = exitCode === 0 ? '✅ Test passed' : '❌ Test failed';
        btn.disabled = false;
    }).catch((err) => {
        badge.textContent = 'Error';
        badge.className = 'test-status-badge failed';
        appendLog('❌ Network error: ' + err.message, 'fail');
        if (logStatus) logStatus.textContent = '❌ Error running test';
        btn.disabled = false;
    });
}
</script>

<script>
// ── Run Suite / Selected Tests ────────────────────────────────────────────────
async function runSuiteTests() {
    if (!_activeSuite) return;
    const suites = loadSuites();
    const suite  = suites.find(s => s.id === _activeSuite);
    if (!suite || !(suite.caseIds||[]).length) return;
    // Resolve case IDs to source files
    const files = [...new Set(
        _allCases
            .filter(c => suite.caseIds.includes(c.id) && c.source)
            .map(c => c.source)
    )];
    for (const file of files) {
        runSingleSpec(file);
    }
}

async function runSelectedTests() {
    // Handle checkboxes from main cases panel
    const mainChecked = [...document.querySelectorAll('.tc-checkbox:checked')]
        .map(cb => cb.dataset.source)
        .filter(Boolean);
    for (const file of mainChecked) {
        runSingleSpec(file);
    }

    // Handle checkboxes from Generated Scripts test cases
    const execChecked = [...document.querySelectorAll('.exec-tc-cb:checked')];
    if (execChecked.length > 0) {
        for (const cb of execChecked) {
            const tcFile = cb.getAttribute('data-tc-file');
            const tcName = cb.getAttribute('data-tc-name');
            if (tcFile && tcName) {
                // Find the corresponding Run button and trigger it
                const card = cb.closest('div[style*="background:#0a1628"]');
                if (card) {
                    const runBtn = card.querySelector('button[id^="testrun-"]');
                    if (runBtn && !runBtn.disabled) {
                        runBtn.click();
                    }
                }
            }
            cb.checked = false;
        }
        syncSelectionButtons();
    }
}

// ── Run All Tests (SSE streaming) ─────────────────────────────────────────────
async function runAllTests() {
    const btn = document.getElementById('runBtn');
    const logPanel = document.getElementById('logPanel');
    const logBody  = document.getElementById('logBody');
    const logStatus = document.getElementById('logStatus');

    btn.disabled = true;
    logBody.innerHTML = '';
    logPanel.style.display = 'flex';
    logPanel.style.flexDirection = 'column';
    setStatus('Running…', 'running');
    setProgress(5);
    logStatus.textContent = 'Connecting…';

    let lineCount = 0;
    try {
        const response = await fetch(`${SERVER}/api/run-tests`, { method: 'POST' });
        if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            appendLog('Error: ' + (err.error || 'Unknown error'), 'fail');
            setStatus('Error', 'failed'); setProgress(100, 'error'); btn.disabled = false; return;
        }
        const reader  = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        logStatus.textContent = 'Running tests…';
        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            for (const part of parts) {
                const dl = part.split('\n').find(l => l.startsWith('data:'));
                if (!dl) continue;
                try {
                    const msg = JSON.parse(dl.slice(5));
                    if (msg.type === 'start') {
                        appendLog('▶ ' + msg.data, 'info');
                    } else if (msg.type === 'log') {
                        lineCount++;
                        appendLog(msg.data, classifyLine(msg.data));
                        setProgress(Math.min(85, 5 + lineCount * 1.5));
                    } else if (msg.type === 'done') {
                        const ok = msg.data.exitCode === 0;
                        setProgress(100, ok ? 'done' : 'error');
                        setStatus(ok ? 'Passed' : 'Failed', ok ? 'passed' : 'failed');
                        logStatus.textContent = ok ? '✅ Tests completed' : '❌ Some tests failed';
                        appendLog('─'.repeat(60));
                        appendLog(ok ? '✅ All tests passed!' : `❌ Exit code ${msg.data.exitCode}`, ok ? 'pass' : 'fail');
                        await loadResults();
                        await loadDashboard();
                    } else if (msg.type === 'error') {
                        appendLog('❌ ' + msg.data, 'fail');
                        setStatus('Error', 'failed'); setProgress(100, 'error');
                    }
                } catch(_) {}
            }
        }
    } catch(e) {
        appendLog('❌ Could not connect to server: ' + e.message, 'fail');
        appendLog('Make sure the backend is running: cd server && node index.js', 'info');
        setStatus('Error', 'failed'); setProgress(100, 'error');
    }
    btn.disabled = false;
}

// ── History & Trends ──────────────────────────────────────────────────────────
async function loadResults() {
    const container = document.getElementById('historyInner');
    container.innerHTML = '<div class="no-results"><div class="icon">⏳</div><p>Loading results…</p></div>';
    try {
        const res  = await fetch(`${SERVER}/api/results`);
        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            container.innerHTML = `<div class="no-results"><div class="icon">📊</div><p>${escHtml(err.error || 'No results yet. Run tests first.')}</p></div>`;
            return;
        }
        const data     = await res.json();
        const passRate = data.total > 0 ? Math.round((data.passed / data.total) * 100) : 0;
        const barColor = passRate === 100 ? '#10b981' : passRate >= 50 ? '#f59e0b' : '#f87171';

        let html = `
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
            <div class="timestamp-info">Last run: ${new Date(data.generatedAt).toLocaleString()}</div>
            <button onclick="loadResults()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:5px 12px;border-radius:5px;font-size:11px;cursor:pointer;">↻ Refresh</button>
        </div>
        <div class="summary-cards">
            <div class="summary-card"><div class="val total">${data.total}</div><div class="lbl">Total</div></div>
            <div class="summary-card"><div class="val pass">${data.passed}</div><div class="lbl">Passed</div></div>
            <div class="summary-card"><div class="val fail">${data.failed}</div><div class="lbl">Failed</div></div>
            <div class="summary-card"><div class="val skip">${data.skipped}</div><div class="lbl">Skipped</div></div>
        </div>
        <div style="background:#1a2f4a;border-radius:8px;overflow:hidden;margin-bottom:8px;height:12px;">
            <div style="height:100%;background:${barColor};width:${passRate}%;transition:width 0.6s;"></div>
        </div>
        <div style="font-size:12px;color:#64748b;margin-bottom:24px;">Pass rate: <strong style="color:${barColor}">${passRate}%</strong></div>`;

        if (data.suites && data.suites.length > 0) {
            html += `<div class="section-title" style="font-size:15px;">Test Suites</div>`;
            for (const suite of data.suites) {
                const suitePass = suite.tests - suite.failures - suite.skipped;
                html += `
                <div class="suite-block">
                    <div class="suite-header" onclick="toggleSuite(this)">
                        <span class="suite-name">📁 ${escHtml(suite.name)}</span>
                        <div class="suite-meta">
                            <span style="color:#10b981">✓ ${suitePass}</span>
                            ${suite.failures > 0 ? `<span style="color:#f87171">✗ ${suite.failures}</span>` : ''}
                            ${suite.skipped  > 0 ? `<span style="color:#f59e0b">⏭ ${suite.skipped}</span>`  : ''}
                            <span>${suite.time.toFixed(2)}s</span>
                            <span class="suite-arrow">▾</span>
                        </div>
                    </div>
                    <div class="suite-cases">`;
                for (const tc of suite.cases) {
                    const icon  = tc.status === 'passed' ? '✅' : tc.status === 'failed' ? '❌' : '⏭';
                    const nameColor = tc.status === 'passed' ? '#cbd5e1' : tc.status === 'failed' ? '#f87171' : '#f59e0b';
                    html += `
                    <div class="case-row">
                        <span class="case-icon">${icon}</span>
                        <div style="flex:1;">
                            <div class="case-name" style="color:${nameColor}">${escHtml(tc.name)}</div>
                            ${tc.failureMessage ? `<div class="case-err">${escHtml(tc.failureMessage.slice(0,200))}${tc.failureMessage.length>200?'…':''}</div>` : ''}
                        </div>
                        <span class="case-time">${tc.time.toFixed(2)}s</span>
                    </div>`;
                }
                html += `</div></div>`;
            }
        } else {
            html += '<div class="no-results"><div class="icon">📭</div><p>No suite details found in results.</p></div>';
        }
        container.innerHTML = html;
    } catch(e) {
        container.innerHTML = `<div class="no-results"><div class="icon">⚠️</div><p>Failed to load results: ${escHtml(e.message)}</p></div>`;
    }
}

// ── Test Data tab ─────────────────────────────────────────────────────────────
let testDataContents = {};
async function loadTestData() {
    const fileList = document.getElementById('testdataFileList');
    fileList.innerHTML = '<div style="font-size:12px;color:#475569;">Loading…</div>';
    try {
        const res  = await fetch(`${SERVER}/api/testdata`);
        if (!res.ok) throw new Error('Server error');
        const data = await res.json();
        testDataContents = data.contents || {};
        const files = data.files || [];
        if (!files.length) {
            fileList.innerHTML = '<div style="font-size:12px;color:#475569;">No data files found</div>';
            return;
        }
        fileList.innerHTML = '';
        for (const f of files) {
            const el = document.createElement('div');
            el.className = 'testdata-file-item';
            el.textContent = '📄 ' + f;
            el.onclick = () => selectTestDataFile(f);
            fileList.appendChild(el);
        }
        // Auto-select first
        if (files.length) selectTestDataFile(files[0]);
    } catch(e) {
        fileList.innerHTML = `<div style="font-size:12px;color:#f87171;">Cannot reach server</div>`;
    }
}

function selectTestDataFile(file) {
    // Update sidebar active state
    document.querySelectorAll('.testdata-file-item').forEach(el => {
        el.classList.toggle('active', el.textContent.includes(file));
    });
    window._currentTestDataFile = file;
    const toolbar = document.getElementById('testdataToolbar');
    const view = document.getElementById('testdataView');
    if (toolbar) toolbar.style.display = 'flex';
    const data = testDataContents[file];
    if (data === null || data === undefined) {
        view.innerHTML = '<div style="color:#f87171;font-size:13px;">⚠ Could not parse file</div>';
        return;
    }
    renderTestDataView(file, data);
}

function renderTestDataView(file, data) {
    const view = document.getElementById('testdataView');
    let html = `<div style="font-family:monospace;font-size:11px;color:#475569;margin-bottom:16px;">Test_Data/${escHtml(file)}</div>`;

    // Check if data has a "dataSets" array (multi-set format)
    if (data && data.dataSets && Array.isArray(data.dataSets)) {
        const count = data.dataSets.length;
        html += `<div style="font-size:12px;font-weight:600;color:#e0e0e0;margin-bottom:12px;">📊 ${count} Data Set(s)</div>`;
        data.dataSets.forEach((ds, idx) => {
            html += `<div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:8px;padding:14px 18px;margin-bottom:12px;">`;
            html += `<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                <span style="font-size:11px;font-weight:700;color:#60a5fa;">Data Set ${idx + 1}</span>
                <span style="font-size:10px;color:#475569;">${escHtml(ds.label || '')}</span>
                <div style="margin-left:auto;display:flex;gap:6px;">
                    <button onclick="tdEditDataSet(${idx})" style="background:none;border:1px solid #2a3f5a;color:#60a5fa;padding:2px 8px;border-radius:4px;font-size:10px;cursor:pointer;">✏️ Edit</button>
                    ${count > 1 ? `<button onclick="tdRemoveDataSet(${idx})" style="background:none;border:1px solid rgba(248,113,113,0.3);color:#f87171;padding:2px 8px;border-radius:4px;font-size:10px;cursor:pointer;">🗑 Delete</button>` : ''}
                </div>
            </div>`;
            if (typeof ds === 'object') {
                const entries = Object.entries(ds).filter(([k]) => k !== 'label');
                for (const [k, v] of entries) {
                    html += `<div class="testdata-kv"><div class="testdata-key">${escHtml(k)}</div><div class="testdata-val">${escHtml(typeof v === 'object' ? JSON.stringify(v) : String(v))}</div></div>`;
                }
            }
            html += `</div>`;
        });
    } else if (typeof data === 'object' && !Array.isArray(data)) {
        // Single data set (legacy format) - display all keys
        html += `<div style="font-size:12px;font-weight:600;color:#e0e0e0;margin-bottom:12px;">📊 Single Data Set</div>`;
        html += `<div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:8px;padding:14px 18px;margin-bottom:12px;">`;
        html += `<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
            <span style="font-size:11px;font-weight:700;color:#60a5fa;">Data Set 1</span>
            <button onclick="tdEditLegacyData()" style="margin-left:auto;background:none;border:1px solid #2a3f5a;color:#60a5fa;padding:2px 8px;border-radius:4px;font-size:10px;cursor:pointer;">✏️ Edit</button>
        </div>`;
        for (const [k, v] of Object.entries(data)) {
            html += `<div class="testdata-kv"><div class="testdata-key">${escHtml(k)}</div><div class="testdata-val">${escHtml(typeof v === 'object' ? JSON.stringify(v) : String(v))}</div></div>`;
        }
        html += `</div>`;
    } else if (Array.isArray(data) && data.length > 0) {
        const headers = typeof data[0] === 'object' ? Object.keys(data[0]) : ['value'];
        html += `<table style="width:100%;border-collapse:collapse;font-size:12px;">
            <thead><tr>${headers.map(h => `<th style="text-align:left;padding:8px 12px;color:#64748b;border-bottom:1px solid #1a2f4a;font-size:10px;text-transform:uppercase;">${escHtml(h)}</th>`).join('')}</tr></thead>
            <tbody>`;
        for (const row of data) {
            const cells = typeof row === 'object' ? Object.values(row) : [row];
            html += `<tr style="border-bottom:1px solid #0d1e30;">${cells.map(c=>`<td style="padding:8px 12px;color:#94a3b8;font-family:monospace;">${escHtml(String(c))}</td>`).join('')}</tr>`;
        }
        html += '</tbody></table>';
    } else {
        html += `<pre style="font-family:monospace;font-size:12px;color:#94a3b8;background:#0f1f35;padding:16px;border-radius:6px;overflow:auto;">${escHtml(JSON.stringify(data, null, 2))}</pre>`;
    }
    view.innerHTML = html;
}

/** Download a JSON template for multi-set test data */
function tdDownloadTemplate() {
    const template = {
        storyId: "STORY-ID",
        summary: "Test case description",
        appUrl: "https://your-app-url.com",
        dataSets: [
            {
                label: "Data Set 1 - Valid",
                username: "user1",
                password: "pass1",
                expectedResult: "success"
            },
            {
                label: "Data Set 2 - Invalid",
                username: "invalid_user",
                password: "wrong_pass",
                expectedResult: "error"
            }
        ],
        metadata: {
            generatedOn: new Date().toISOString(),
            note: "Add more data sets to the dataSets array for data-driven testing"
        }
    };
    const blob = new Blob([JSON.stringify(template, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'test-data-template.json';
    a.click();
    URL.revokeObjectURL(url);
    tdShowMsg('✅ Template downloaded');
}

/** Export current file data as JSON for editing */
function tdExportJson() {
    const file = window._currentTestDataFile;
    if (!file) { alert('Select a data file first'); return; }
    const data = testDataContents[file];
    if (!data) return;
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = file;
    a.click();
    URL.revokeObjectURL(url);
    tdShowMsg('✅ Exported: ' + file);
}

/** Upload edited JSON back to the server */
async function tdUploadJson(input) {
    const file = window._currentTestDataFile;
    if (!file) { alert('Select a data file first'); input.value = ''; return; }
    const f = input.files[0];
    if (!f) return;
    try {
        const text = await f.text();
        const parsed = JSON.parse(text); // validate JSON
        // Save to server
        const res = await fetch(`${SERVER}/api/testdata/${encodeURIComponent(file)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: JSON.stringify(parsed, null, 2) })
        });
        if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || 'Save failed');
        }
        // Update local cache and re-render
        testDataContents[file] = parsed;
        renderTestDataView(file, parsed);
        tdShowMsg('✅ Data uploaded successfully');
    } catch(e) {
        alert('Upload failed: ' + e.message);
    }
    input.value = '';
}

/** Add a new empty data set to the current file */
async function tdAddDataSet() {
    const file = window._currentTestDataFile;
    if (!file) { alert('Select a data file first'); return; }
    let data = testDataContents[file];
    if (!data || typeof data !== 'object') return;

    // Convert to multi-set format if not already
    if (!data.dataSets) {
        // Preserve ALL original data as the first data set
        const firstSet = JSON.parse(JSON.stringify(data)); // deep clone
        data = {
            dataSets: [{ label: 'Data Set 1', ...firstSet }]
        };
    }

    // Add new data set with same keys as first set (empty values)
    const firstSet = data.dataSets[0] || {};
    const newSet = { label: `Data Set ${data.dataSets.length + 1}` };
    Object.keys(firstSet).forEach(k => {
        if (k === 'label') return;
        const v = firstSet[k];
        if (typeof v === 'string') newSet[k] = '';
        else if (typeof v === 'number') newSet[k] = 0;
        else if (typeof v === 'boolean') newSet[k] = false;
        else if (typeof v === 'object' && v !== null) newSet[k] = Array.isArray(v) ? [] : {};
        else newSet[k] = '';
    });
    data.dataSets.push(newSet);

    // Save to server
    try {
        const res = await fetch(`${SERVER}/api/testdata/${encodeURIComponent(file)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: JSON.stringify(data, null, 2) })
        });
        if (!res.ok) throw new Error('Save failed');
        testDataContents[file] = data;
        renderTestDataView(file, data);
        tdShowMsg('✅ New data set added');
    } catch(e) {
        alert('Error: ' + e.message);
    }
}

/** Remove a data set by index (not allowed if only one remains) */
async function tdRemoveDataSet(idx) {
    const file = window._currentTestDataFile;
    if (!file) return;
    const data = testDataContents[file];
    if (!data || !data.dataSets) return;
    if (data.dataSets.length <= 1) { alert('Cannot delete the last data set.'); return; }
    if (!confirm(`Remove Data Set ${idx + 1}?`)) return;

    data.dataSets.splice(idx, 1);
    try {
        await fetch(`${SERVER}/api/testdata/${encodeURIComponent(file)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: JSON.stringify(data, null, 2) })
        });
        testDataContents[file] = data;
        renderTestDataView(file, data);
        tdShowMsg('✅ Data set removed');
    } catch(e) { alert('Error: ' + e.message); }
}

/** Edit a data set inline (opens JSON editor modal) */
function tdEditDataSet(idx) {
    const file = window._currentTestDataFile;
    if (!file) return;
    const data = testDataContents[file];
    if (!data || !data.dataSets || !data.dataSets[idx]) return;

    const ds = data.dataSets[idx];
    const json = JSON.stringify(ds, null, 2);
    const newJson = prompt('Edit Data Set (JSON):', json);
    if (newJson === null) return; // cancelled
    try {
        const parsed = JSON.parse(newJson);
        data.dataSets[idx] = parsed;
        // Save
        fetch(`${SERVER}/api/testdata/${encodeURIComponent(file)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: JSON.stringify(data, null, 2) })
        }).then(res => {
            if (res.ok) {
                testDataContents[file] = data;
                renderTestDataView(file, data);
                tdShowMsg('✅ Data set updated');
            }
        });
    } catch(e) {
        alert('Invalid JSON: ' + e.message);
    }
}

/** Edit legacy (non-dataSets) data */
function tdEditLegacyData() {
    const file = window._currentTestDataFile;
    if (!file) return;
    const data = testDataContents[file];
    if (!data) return;

    const json = JSON.stringify(data, null, 2);
    const newJson = prompt('Edit Test Data (JSON):', json);
    if (newJson === null) return;
    try {
        const parsed = JSON.parse(newJson);
        fetch(`${SERVER}/api/testdata/${encodeURIComponent(file)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: JSON.stringify(parsed, null, 2) })
        }).then(res => {
            if (res.ok) {
                testDataContents[file] = parsed;
                renderTestDataView(file, parsed);
                tdShowMsg('✅ Data updated');
            }
        });
    } catch(e) {
        alert('Invalid JSON: ' + e.message);
    }
}

/** Show a brief message in the toolbar */
function tdShowMsg(text) {
    const el = document.getElementById('testdataMsg');
    if (!el) return;
    el.textContent = text;
    el.style.display = 'inline';
    setTimeout(() => { el.style.display = 'none'; }, 3000);
}
</script>

<script>
// ── Jira Board ────────────────────────────────────────────────────────────────
const JIRA_CONFIG = { project: '', view: 'all', baseUrl: '', toolType: 'Jira', adoOrgUrl: '', adoProject: '' };
const JIRA_VIEW_LABELS = { all:'All Issues', mine:'My Issues', inprogress:'In Progress', done:'Done', backlog:'Backlog', sprint:'Active Sprint' };

/**
 * Apply the correct tool name (Jira / Azure DevOps) to every label in the UI
 * that refers to the work-item tracking system.
 * Called once after initJiraConfig resolves.
 */
function applyToolLabel(toolType) {
    const isADO  = toolType === 'ADO';
    const icon   = isADO ? '☁️' : '🗂';
    const label  = isADO ? 'Azure DevOps' : 'Jira';
    const short  = isADO ? 'ADO' : 'Jira';
    const ticket = isADO ? 'Work Items' : 'Tickets';
    const board  = isADO ? `${icon} Azure DevOps` : `${icon} Jira Board`;
    const hint = `Click a ticket from the board, or select one below to generate tests`;
    const emptyHint = isADO
        ? `Select an Azure DevOps work item from the left panel<br>or click any card on the board`
        : `Select a Jira ticket from the left panel<br>or click any card on the Jira Board`;

    // Nav tab button
    const tabBtn = document.getElementById('jiraTabBtn');
    if (tabBtn) tabBtn.textContent = board;

    // Nav tab aria-label on dropdown toggle
    const toggle = document.getElementById('jiraDropdownToggle');
    if (toggle) toggle.setAttribute('aria-label', `${label} Board views`);

    // Inline board toolbar title
    const boardTitle = document.querySelector('.jira-board-title');
    if (boardTitle) boardTitle.textContent = board;

    // Popup modal title
    const modalTitle = document.querySelector('.jira-board-modal-title');
    if (modalTitle) modalTitle.textContent = board;

    // Instance badge prefix
    const badge = document.getElementById('jiraInstanceBadge');
    if (badge && !badge.dataset.labelSet) {
        badge.dataset.labelSet = '1';
    }

    // Test Design sidebar title + hint
    document.querySelectorAll('.testdesign-sidebar-title').forEach(el => {
        el.textContent = `📋 Work Items`;
    });
    document.querySelectorAll('.testdesign-sidebar-hint').forEach(el => {
        if (el.textContent.toLowerCase().includes('ticket') ||
            el.textContent.toLowerCase().includes('work item') ||
            el.textContent.toLowerCase().includes('jira')) {
            el.textContent = hint;
        }
    });

    // Empty-state hint inside Test Design panel
    const tdHint = document.querySelector('.td-hint');
    if (tdHint) tdHint.innerHTML = emptyHint;

    // Static board state message
    document.querySelectorAll('.jira-state .msg').forEach(el => {
        if (el.textContent.includes('Jira Board') || el.textContent.includes('Azure DevOps')) {
            el.textContent = `Select the ${label} Board tab to load issues`;
        }
    });
}
const COL_COLORS = { 'To Do':'#64748b','In Progress':'#3b82f6','In Review':'#f59e0b','Done':'#10b981' };

function colColor(n) { return COL_COLORS[n] || '#94a3b8'; }
function priorityClass(p) {
    if (!p) return 'unknown';
    const l = p.toLowerCase();
    return ['critical','highest','high','medium','low','lowest'].includes(l) ? l : 'unknown';
}
function timeAgo(iso) {
    if (!iso) return '';
    const diff = Date.now() - new Date(iso).getTime();
    const m = Math.floor(diff/60000);
    if (m < 2) return 'just now';
    if (m < 60) return `${m}m ago`;
    const h = Math.floor(m/60);
    if (h < 24) return `${h}h ago`;
    const d = Math.floor(h/24);
    return d < 30 ? `${d}d ago` : new Date(iso).toLocaleDateString();
}

/**
 * Called when the user changes the Source dropdown in the nav bar.
 * Switches JIRA_CONFIG.toolType, reloads projects and clears the board cache.
 */
async function onToolSourceChange(toolType) {
    JIRA_CONFIG.toolType  = toolType;
    JIRA_CONFIG.project   = '';
    JIRA_BOARD_MODAL.loaded = false;

    applyToolLabel(toolType);

    // Reload projects for the new source
    try {
        const isADO = toolType === 'ADO';
        const data  = await fetch(`${SERVER}/api/${isADO ? 'ado' : 'jira'}/projects`).then(r => r.json());
        const projects = data.projects || [];

        function buildOptions(cur) {
            return projects.map(p => {
                const lbl = isADO ? `☁️ ${p.name}` : `📁 ${p.key} — ${p.name}`;
                return `<option value="${p.key}"${p.key===cur?' selected':''}>${lbl}</option>`;
            }).join('');
        }

        if (projects.length) JIRA_CONFIG.project = projects[0].key;

        ['jiraProjectSelect','mtProjectSelect','tdProjectSelect','jiraBoardModalProjectSelect'].forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.innerHTML = buildOptions(JIRA_CONFIG.project); el.value = JIRA_CONFIG.project; }
        });

        // Show/hide project+view wrap based on tool
        ['mt','td'].forEach(prefix => {
            const wrap = document.getElementById(`${prefix}ProjectViewWrap`);
            if (wrap) wrap.style.display = (toolType === 'LocalHost' || !toolType) ? 'none' : 'block';
        });
    } catch(_) {}

    // Reload sidebar lists for currently visible tabs
    loadMtTickets().catch(()=>{});
    loadTdTickets().catch(()=>{});
}

async function initJiraConfig() {
    try {
        const cfg = await fetch(`${SERVER}/api/jira/config`).then(r => r.json());
        JIRA_CONFIG.project  = cfg.projectKey || '';
        JIRA_CONFIG.baseUrl  = cfg.baseUrl || '';
        JIRA_CONFIG.toolType = cfg.toolType  || 'Jira';
        JIRA_CONFIG.adoOrgUrl = cfg.adoOrgUrl || '';
        JIRA_CONFIG.adoProject = cfg.adoProject || '';

        // Apply branding
        const label = cfg.customerLabel || 'HexaPlay Orchestrator';
        const initial = label.charAt(0).toUpperCase();
        ['logoTitle','authLogoTitle'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.textContent = label;
        });
        ['logoIcon','authLogoIcon'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.textContent = initial;
        });
        const headerTitle = document.getElementById('headerTitle');
        if (headerTitle) headerTitle.textContent = label;
        document.title = label;

        // Apply tool-specific labels across the entire UI
        applyToolLabel(JIRA_CONFIG.toolType);

        // Sidebar tool selects always start blank — user picks explicitly
        ['mtToolSelect','tdToolSelect'].forEach(id => {
            const sel = document.getElementById(id);
            if (sel) sel.value = '';
        });

        const isADO = JIRA_CONFIG.toolType === 'ADO';
        const badge = document.getElementById('jiraInstanceBadge');
        if (badge) {
            badge.textContent = isADO
                ? (cfg.adoProject || cfg.adoOrgUrl || 'Azure DevOps')
                : (cfg.baseUrl || '').replace('https://', '');
            badge.title = isADO
                ? `Org: ${cfg.adoOrgUrl}`
                : `Email: ${cfg.email}`;
        }
        const modalBadge = document.getElementById('jiraBoardModalBadge');
        if (modalBadge && !modalBadge.textContent) {
            modalBadge.textContent = isADO
                ? (cfg.adoProject || 'Azure DevOps')
                : (cfg.baseUrl || '').replace('https://', '');
        }
    } catch(e) {
        const badge = document.getElementById('jiraInstanceBadge');
        if (badge) { badge.textContent = 'Config unavailable'; badge.style.color = '#f87171'; }
    }

    // Load all projects into all project dropdowns (Jira or ADO)
    try {
        const isADO = JIRA_CONFIG.toolType === 'ADO';
        const data  = await fetch(`${SERVER}/api/${isADO ? 'ado' : 'jira'}/projects`).then(r => r.json());
        const projects = data.projects || [];

        function buildOptions(currentProject) {
            return projects.map(p => {
                const label = isADO ? `☁️ ${p.name}` : `📁 ${p.key} — ${p.name}`;
                const sel   = p.key === currentProject ? ' selected' : '';
                return `<option value="${p.key}"${sel}>${label}</option>`;
            }).join('');
        }

        if (!JIRA_CONFIG.project && projects.length) {
            JIRA_CONFIG.project = projects[0].key;
        }

        ['jiraProjectSelect', 'mtProjectSelect', 'tdProjectSelect',
         'jiraBoardModalProjectSelect'].forEach(id => {
            const sel = document.getElementById(id);
            if (!sel) return;
            sel.innerHTML = buildOptions(JIRA_CONFIG.project);
            sel.value = JIRA_CONFIG.project;
        });

        // Sync the tool source dropdown (Requirements tab) and trigger its UI
        const toolSel = document.getElementById('reqToolSelect');
        if (toolSel) {
            // Always start with no tool selected on login — user must pick explicitly
            toolSel.value = '';
            reqOnToolChange('');
        }

        // Pre-load board data in background
        if (JIRA_CONFIG.project) {
            loadJiraBoard(true);
        }
    } catch(e) { /* projects list unavailable */ }
}

function openJiraBoardPopup(url) {
    const w = Math.min(1200, screen.availWidth  - 80);
    const h = Math.min(800,  screen.availHeight - 80);
    const left = Math.round((screen.availWidth  - w) / 2);
    const top  = Math.round((screen.availHeight - h) / 2);
    window.open(url, 'JiraBoardPopup',
        `width=${w},height=${h},left=${left},top=${top},` +
        `resizable=yes,scrollbars=yes,toolbar=no,menubar=no,location=no,status=no`
    );
}

// ── Jira Board Modal (popup) ──────────────────────────────────────────────────
const JIRA_BOARD_MODAL = { view: 'all', loaded: false };

function openJiraBoardModal() {
    const modal = document.getElementById('jiraBoardModal');
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    // Sync project select value
    const sel = document.getElementById('jiraBoardModalProjectSelect');
    if (sel) sel.value = JIRA_CONFIG.project;
    if (!JIRA_BOARD_MODAL.loaded) loadJiraBoardModal();
}

function closeJiraBoardModal() {
    document.getElementById('jiraBoardModal').classList.remove('open');
    document.body.style.overflow = '';
}

function onJiraBoardModalProjectChange(key) {
    JIRA_CONFIG.project = key;
    // Sync all other project selects
    ['jiraProjectSelect','mtProjectSelect','tdProjectSelect'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = key;
    });
    JIRA_BOARD_MODAL.loaded = false;
    loadJiraBoardModal(true);
}

function onJiraBoardModalViewChange(view) {
    JIRA_BOARD_MODAL.view = view;
    loadJiraBoardModal(true);
}

async function loadJiraBoardModal(force = false) {
    const body = document.getElementById('jiraBoardModalBody');
    if (!force && JIRA_BOARD_MODAL.loaded) return;
    const isADO = JIRA_CONFIG.toolType === 'ADO';
    const toolName = isADO ? 'Azure DevOps' : 'Jira';
    body.innerHTML = `<div class="jira-state"><div class="icon">⏳</div><div class="msg">Fetching from ${toolName}…</div></div>`;
    try {
        const url = isADO
            ? `${SERVER}/api/ado/board?view=${JIRA_BOARD_MODAL.view}`
            : `${SERVER}/api/jira/board?project=${JIRA_CONFIG.project}&view=${JIRA_BOARD_MODAL.view}`;
        const res  = await fetch(url);
        const data = await res.json();
        if (!res.ok) {
            body.innerHTML = `<div class="jira-state"><div class="icon">⚠️</div><div class="msg">Failed to load board</div><div class="detail">${escHtml(data.error||'Unknown error')}</div><button class="retry-btn" onclick="loadJiraBoardModal(true)">Retry</button></div>`;
            return;
        }
        renderBoardInto(body, data);
        JIRA_BOARD_MODAL.loaded = true;
        const badge = document.getElementById('jiraBoardModalBadge');
        if (badge) badge.textContent = data.project + ' · ' + data.total + ' item' + (data.total!==1?'s':'');
        const fa = document.getElementById('jiraBoardModalFetchedAt');
        if (fa && data.fetchedAt) fa.textContent = 'Updated: ' + new Date(data.fetchedAt).toLocaleTimeString();
    } catch(e) {
        body.innerHTML = `<div class="jira-state"><div class="icon">📡</div><div class="msg">Backend not running</div><div class="detail">Start server: <code>node server/index.js</code></div><button class="retry-btn" onclick="loadJiraBoardModal(true)">Retry</button></div>`;
    }
}

/** Renders board columns into any container element (shared by tab + modal) */
function renderBoardInto(container, data) {
    if (!data.columns || !data.columns.length) {
        container.innerHTML = `<div class="jira-state"><div class="icon">📭</div><div class="msg">No issues found</div></div>`;
        return;
    }
    let html = `<div class="jira-meta-bar">
        <span class="jira-meta-badge">${data.project}</span>
        <span>${data.total} issue${data.total!==1?'s':''}</span>
        <a class="jira-link" href="#" onclick="openJiraBoardPopup('${escHtml(data.baseUrl)}/jira/software/projects/${data.project}/boards');return false;">Open in Jira ↗</a>
    </div><div class="jira-columns">`;
    for (const col of data.columns) {
        const color = colColor(col.name);
        html += `<div class="jira-column"><div class="jira-col-header" style="border-top:3px solid ${color};"><span class="jira-col-title" style="color:${color};">${escHtml(col.name)}</span><span class="jira-col-count">${col.issues.length}</span></div><div class="jira-col-body">`;
        if (!col.issues.length) {
            html += `<div style="font-size:11px;color:#475569;text-align:center;padding:16px 0;">No issues</div>`;
        } else {
            for (const issue of col.issues) {
                const pc = priorityClass(issue.priority);
                const av = issue.assigneeAvatar ? `<img src="${escHtml(issue.assigneeAvatar)}" alt="" loading="lazy"/>` : (issue.assigneeInitials||'?');
                html += `<div class="jira-card" onclick="openJiraIssue('${issue.key}')" title="Click to view details">
                    <div class="jira-card-top">${issue.issueTypeIcon?`<img class="jira-type-icon" src="${escHtml(issue.issueTypeIcon)}" alt=""/>`:''}<span class="jira-card-key">${escHtml(issue.key)}</span></div>
                    <div class="jira-card-title">${escHtml(issue.summary)}</div>
                    <div class="jira-card-meta">
                        ${issue.priority?`<span class="jira-priority ${pc}">${escHtml(issue.priority)}</span>`:''}
                        ${issue.labels?.length?`<span class="jira-card-label">${escHtml(issue.labels[0])}</span>`:''}
                        ${issue.updated?`<span class="jira-updated">${timeAgo(issue.updated)}</span>`:''}
                        <span class="jira-assignee-avatar">${av}</span>
                    </div>
                    <div style="margin-top:8px;padding-top:8px;border-top:1px solid #2a3f5a;">
                        <button onclick="event.stopPropagation();selectTicketForDesign('${issue.key}')" style="width:100%;background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:5px 10px;border-radius:4px;font-size:10px;font-weight:700;cursor:pointer;">⚡ Generate Tests</button>
                    </div>
                </div>`;
            }
        }
        html += `</div></div>`;
    }
    html += `</div>`;
    container.innerHTML = html;
}

function onJiraProjectChange(projectKey) {
    JIRA_CONFIG.project = projectKey;
    // Sync the other two dropdowns
    ['mtProjectSelect','tdProjectSelect'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = projectKey;
    });
    document.getElementById('jira').dataset.loaded = '';
    loadJiraBoard(true);
}

function mtChangeProject(projectKey) {
    JIRA_CONFIG.project = projectKey;
    // Sync the other two dropdowns
    ['jiraProjectSelect','tdProjectSelect'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = projectKey;
    });
    loadMtTickets();
}

function tdChangeProject(projectKey) {
    JIRA_CONFIG.project = projectKey;
    // Sync the other two dropdowns
    ['jiraProjectSelect','mtProjectSelect'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = projectKey;
    });
    loadTdTickets();
}

function tdChangeView(view) {
    tdCurrentView = view;
    loadTdTickets();
}

/**
 * Swap view-select options to match the chosen tool.
 * ADO uses state-based views; Jira uses sprint/backlog views.
 */
function updateViewSelectOptions(selectId, toolType) {
    const sel = document.getElementById(selectId);
    if (!sel) return;
    const currentVal = sel.value;
    if (toolType === 'ADO') {
        sel.innerHTML = `
            <option value="all">All</option>
            <option value="new">New</option>
            <option value="inprogress">Active</option>
            <option value="design">Design</option>
            <option value="resolved">Resolved</option>
            <option value="done">Closed</option>
            <option value="todo">To Do</option>
            <option value="removed">Removed</option>`;
    } else {
        sel.innerHTML = `
            <option value="all">All Issues</option>
            <option value="sprint">Active Sprint</option>
            <option value="backlog">Backlog</option>
            <option value="inprogress">In Progress</option>
            <option value="mine">My Issues</option>
            <option value="done">Done</option>`;
    }
    // Keep the current value if it still exists, otherwise reset to 'all'
    sel.value = [...sel.options].some(o => o.value === currentVal) ? currentVal : 'all';
}

async function tdOnToolChange(toolType) {
    const projectWrap = document.getElementById('tdProjectViewWrap');
    if (projectWrap) projectWrap.style.display = (toolType === 'LocalHost' || !toolType) ? 'none' : 'block';
    updateViewSelectOptions('tdViewSelect', toolType);
    if (toolType && toolType !== 'LocalHost') {
        await onToolSourceChange(toolType);
    }
    loadTdTickets();
}

function tdToggleSection(bodyId, chevronId) {
    const body    = document.getElementById(bodyId);
    const chevron = document.getElementById(chevronId);
    if (!body) return;
    const collapsed = body.style.display === 'none';
    body.style.display    = collapsed ? '' : 'none';
    if (chevron) chevron.style.transform = collapsed ? 'rotate(0deg)' : 'rotate(-90deg)';
}

function tdCodeEditorToggleExpand(forceExpanded) {
    const section = document.getElementById('tdCodeEditorSection');
    const button = document.getElementById('tdCodeEditorExpandBtn');
    if (!section || !button) return;
    const expanded = typeof forceExpanded === 'boolean'
        ? forceExpanded
        : !section.classList.contains('td-code-editor-expanded');
    section.classList.toggle('td-code-editor-expanded', expanded);
    button.textContent = expanded ? '↙ Restore' : '⛶ Enlarge';
    button.title = expanded ? 'Restore the Code Editor to the Automation Studio layout' : 'Expand the Code Editor to fill the window';
}

document.addEventListener('keydown', event => {
    if (event.key === 'Escape') tdCodeEditorToggleExpand(false);
});

// ── Code Editor Functions ─────────────────────────────────────────────────────
let _tdCodeCurrentFile = null;
let _tdCodeOrigContent = '';
let _tdCodeEditMode = false;

async function tdLoadCodeTree() {
    const treeEl = document.getElementById('tdCodeTree');
    if (!treeEl) return;
    treeEl.innerHTML = '<div style="text-align:center;color:#475569;padding:20px;font-size:11px;">Loading...</div>';
    try {
        const res = await fetch(SERVER + '/api/automation-tree');
        const data = await res.json();
        if (!data.tree || !data.tree.length) {
            treeEl.innerHTML = '<div style="color:#475569;padding:12px;font-size:11px;">No automation files found.</div>';
            return;
        }
        treeEl.innerHTML = '';
        // Create parent folder with ticket ID
        const ticketId = (tdCurrentIssue && tdCurrentIssue.key) ? tdCurrentIssue.key : 'Project';
        const parentNode = { name: ticketId, type: 'folder', path: '', children: data.tree };
        tdRenderTreeNode(parentNode, treeEl, 0, true);
    } catch(e) {
        treeEl.innerHTML = '<div style="color:#f87171;padding:12px;font-size:11px;">Error loading files</div>';
    }
}

function tdRenderTreeNode(node, parent, depth, isRoot) {
    const el = document.createElement('div');
    if (node.type === 'folder') {
        el.style.cssText = 'user-select:none;';
        const header = document.createElement('div');
        header.style.cssText = 'padding:4px ' + (4 + depth * 12) + 'px;color:#94a3b8;font-weight:600;display:flex;align-items:center;gap:4px;border-radius:3px;cursor:pointer;';
        header.onmouseenter = function() { header.style.background = 'rgba(255,255,255,0.04)'; };
        header.onmouseleave = function() { header.style.background = ''; };
        const arrow = document.createElement('span');
        arrow.textContent = '▾';
        arrow.style.cssText = 'font-size:9px;transition:transform 0.2s;display:inline-block;';
        const icon = document.createElement('span');
        icon.textContent = isRoot ? '📂' : '📁';
        icon.style.fontSize = '11px';
        const name = document.createElement('span');
        name.textContent = node.name;
        name.style.cssText = 'font-size:11px;flex:1;';
        if (isRoot) { name.style.color = '#60a5fa'; name.style.fontWeight = '700'; }
        header.appendChild(arrow);
        header.appendChild(icon);
        header.appendChild(name);

        // Action buttons for folders (not root)
        if (!isRoot) {
            const actions = document.createElement('span');
            actions.style.cssText = 'display:none;gap:2px;align-items:center;';
            actions.innerHTML = '<span title="New File" onclick="event.stopPropagation();tdTreeNewFile(\'' + (node.path||node.name) + '\')" style="cursor:pointer;font-size:10px;padding:1px 3px;border-radius:2px;color:#64748b;" onmouseenter="this.style.color=\'#60a5fa\'" onmouseleave="this.style.color=\'#64748b\'">+📄</span>'
                + '<span title="New Folder" onclick="event.stopPropagation();tdTreeNewFolder(\'' + (node.path||node.name) + '\')" style="cursor:pointer;font-size:10px;padding:1px 3px;border-radius:2px;color:#64748b;" onmouseenter="this.style.color=\'#60a5fa\'" onmouseleave="this.style.color=\'#64748b\'">+📁</span>'
                + '<span title="Rename" onclick="event.stopPropagation();tdTreeRename(\'' + (node.path||node.name) + '\',\'folder\')" style="cursor:pointer;font-size:10px;padding:1px 3px;border-radius:2px;color:#64748b;" onmouseenter="this.style.color=\'#f59e0b\'" onmouseleave="this.style.color=\'#64748b\'">✏️</span>'
                + '<span title="Delete" onclick="event.stopPropagation();tdTreeDelete(\'' + (node.path||node.name) + '\',\'folder\')" style="cursor:pointer;font-size:10px;padding:1px 3px;border-radius:2px;color:#64748b;" onmouseenter="this.style.color=\'#f87171\'" onmouseleave="this.style.color=\'#64748b\'">🗑</span>';
            header.appendChild(actions);
            header.onmouseenter = function() { header.style.background = 'rgba(255,255,255,0.04)'; actions.style.display = 'flex'; };
            header.onmouseleave = function() { header.style.background = ''; actions.style.display = 'none'; };
        } else {
            // Root gets New File and New Folder buttons only
            const actions = document.createElement('span');
            actions.style.cssText = 'display:none;gap:2px;align-items:center;';
            actions.innerHTML = '<span title="New File" onclick="event.stopPropagation();tdTreeNewFile(\'\')" style="cursor:pointer;font-size:10px;padding:1px 3px;color:#64748b;" onmouseenter="this.style.color=\'#60a5fa\'" onmouseleave="this.style.color=\'#64748b\'">+📄</span>'
                + '<span title="New Folder" onclick="event.stopPropagation();tdTreeNewFolder(\'\')" style="cursor:pointer;font-size:10px;padding:1px 3px;color:#64748b;" onmouseenter="this.style.color=\'#60a5fa\'" onmouseleave="this.style.color=\'#64748b\'">+📁</span>';
            header.appendChild(actions);
            header.onmouseenter = function() { header.style.background = 'rgba(255,255,255,0.04)'; actions.style.display = 'flex'; };
            header.onmouseleave = function() { header.style.background = ''; actions.style.display = 'none'; };
        }

        const childContainer = document.createElement('div');
        childContainer.style.display = isRoot ? '' : '';
        header.onclick = function(e) {
            if (e.target.closest('span[title]')) return;
            const hidden = childContainer.style.display === 'none';
            childContainer.style.display = hidden ? '' : 'none';
            arrow.style.transform = hidden ? '' : 'rotate(-90deg)';
        };
        el.appendChild(header);
        el.appendChild(childContainer);
        if (node.children) {
            node.children.forEach(function(child) { tdRenderTreeNode(child, childContainer, depth + 1, false); });
        }
    } else {
        el.style.cssText = 'padding:3px ' + (16 + depth * 12) + 'px;color:#64748b;cursor:pointer;border-radius:3px;display:flex;align-items:center;gap:5px;';
        const ext = (node.name.split('.').pop() || '').toLowerCase();
        const icon = ext === 'ts' ? '🔷' : ext === 'json' ? '📄' : ext === 'feature' ? '🥒' : '📃';
        el.innerHTML = '<span style="font-size:10px;">' + icon + '</span><span style="font-size:11px;flex:1;">' + node.name + '</span>';
        // Action buttons for files
        const fileActions = document.createElement('span');
        fileActions.style.cssText = 'display:none;gap:2px;align-items:center;';
        fileActions.innerHTML = '<span title="Rename" onclick="event.stopPropagation();tdTreeRename(\'' + (node.path||node.name) + '\',\'file\')" style="cursor:pointer;font-size:9px;color:#64748b;" onmouseenter="this.style.color=\'#f59e0b\'" onmouseleave="this.style.color=\'#64748b\'">✏️</span>'
            + '<span title="Delete" onclick="event.stopPropagation();tdTreeDelete(\'' + (node.path||node.name) + '\',\'file\')" style="cursor:pointer;font-size:9px;color:#64748b;" onmouseenter="this.style.color=\'#f87171\'" onmouseleave="this.style.color=\'#64748b\'">🗑</span>';
        el.appendChild(fileActions);
        el.onmouseenter = function() { el.style.background = 'rgba(59,130,246,0.08)'; el.style.color = '#60a5fa'; fileActions.style.display = 'flex'; };
        el.onmouseleave = function() { if (_tdCodeCurrentFile !== node.path) { el.style.background = ''; el.style.color = '#64748b'; } fileActions.style.display = 'none'; };
        el.onclick = function(e) { if (e.target.closest('span[title]')) return; tdCodeOpenFile(node.path, el); };
    }
    parent.appendChild(el);
}

// ── Tree CRUD operations ──────────────────────────────────────────────────────
function tdTreeNewFile(folderPath) {
    const name = prompt('Enter new file name (e.g. MyPage.ts):');
    if (!name || !name.trim()) return;
    const fullPath = folderPath ? folderPath + '/' + name.trim() : name.trim();
    // Create file with empty content
    fetch(SERVER + '/api/save-file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: fullPath, content: '' })
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) {
            tdCodeAddLog('✅ Created: ' + fullPath, 'ok');
            tdLoadCodeTree();
        } else {
            tdCodeAddLog('❌ Create failed: ' + (d.error || ''), 'err');
        }
    }).catch(function(e) { tdCodeAddLog('❌ Error: ' + e.message, 'err'); });
}

function tdTreeNewFolder(parentPath) {
    const name = prompt('Enter new folder name:');
    if (!name || !name.trim()) return;
    const fullPath = parentPath ? parentPath + '/' + name.trim() : name.trim();
    // Create a placeholder file inside the folder to create it
    fetch(SERVER + '/api/save-file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: fullPath + '/.gitkeep', content: '' })
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) {
            tdCodeAddLog('✅ Created folder: ' + fullPath, 'ok');
            tdLoadCodeTree();
        } else {
            tdCodeAddLog('❌ Create folder failed: ' + (d.error || ''), 'err');
        }
    }).catch(function(e) { tdCodeAddLog('❌ Error: ' + e.message, 'err'); });
}

function tdTreeRename(filePath, type) {
    const oldName = filePath.split('/').pop();
    const newName = prompt('Rename "' + oldName + '" to:', oldName);
    if (!newName || !newName.trim() || newName.trim() === oldName) return;
    const parentDir = filePath.substring(0, filePath.lastIndexOf('/'));
    const newPath = parentDir ? parentDir + '/' + newName.trim() : newName.trim();
    fetch(SERVER + '/api/rename-file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ oldPath: filePath, newPath: newPath, type: type })
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) {
            tdCodeAddLog('✅ Renamed: ' + oldName + ' → ' + newName.trim(), 'ok');
            if (_tdCodeCurrentFile === filePath) _tdCodeCurrentFile = newPath;
            tdLoadCodeTree();
        } else {
            tdCodeAddLog('❌ Rename failed: ' + (d.error || ''), 'err');
        }
    }).catch(function(e) { tdCodeAddLog('❌ Error: ' + e.message, 'err'); });
}

function tdTreeDelete(filePath, type) {
    const name = filePath.split('/').pop();
    if (!confirm('Delete "' + name + '"' + (type === 'folder' ? ' and all its contents' : '') + '?')) return;
    fetch(SERVER + '/api/delete-file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: filePath, type: type })
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) {
            tdCodeAddLog('✅ Deleted: ' + filePath, 'ok');
            if (_tdCodeCurrentFile === filePath) {
                _tdCodeCurrentFile = null;
                document.getElementById('tdCodeEditorArea').value = '';
                document.getElementById('tdCodeEditorFileName').textContent = 'Select a file';
            }
            tdLoadCodeTree();
        } else {
            tdCodeAddLog('❌ Delete failed: ' + (d.error || ''), 'err');
        }
    }).catch(function(e) { tdCodeAddLog('❌ Error: ' + e.message, 'err'); });
}

async function tdCodeOpenFile(filePath, treeItem) {
    if (_tdCodeEditMode) {
        if (!confirm('You have unsaved changes. Discard?')) return;
        tdCodeCancel();
    }
    _tdCodeCurrentFile = filePath;
    // Highlight active item
    document.querySelectorAll('#tdCodeTree div').forEach(function(d) { d.style.background = ''; });
    if (treeItem) { treeItem.style.background = 'rgba(59,130,246,0.12)'; treeItem.style.color = '#60a5fa'; }

    const editor = document.getElementById('tdCodeEditorArea');
    const nameEl = document.getElementById('tdCodeEditorFileName');
    const editBtn = document.getElementById('tdCodeEditBtn');
    const dryRunBtn = document.getElementById('tdCodeDryRunBtn');
    nameEl.textContent = filePath;
    editor.value = 'Loading...';
    editor.readOnly = true;

    try {
        const res = await fetch(SERVER + '/api/read-file', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: filePath })
        });
        const data = await res.json();
        editor.value = data.content || '';
        _tdCodeOrigContent = data.content || '';
        editBtn.style.display = 'inline-block';
        // Show Dry Run only for .spec.ts files
        dryRunBtn.style.display = filePath.endsWith('.spec.ts') ? 'inline-block' : 'none';
    } catch(e) {
        editor.value = 'Error loading file: ' + e.message;
    }
}

function tdCodeToggleEdit() {
    const editor = document.getElementById('tdCodeEditorArea');
    const editBtn = document.getElementById('tdCodeEditBtn');
    const saveBtn = document.getElementById('tdCodeSaveBtn');
    const cancelBtn = document.getElementById('tdCodeCancelBtn');

    _tdCodeEditMode = true;
    editor.readOnly = false;
    editor.style.background = '#0a1628';
    editor.style.borderLeft = '3px solid #3b82f6';
    editBtn.style.display = 'none';
    saveBtn.style.display = 'inline-block';
    cancelBtn.style.display = 'inline-block';
}

async function tdCodeSave() {
    const editor = document.getElementById('tdCodeEditorArea');
    if (!_tdCodeCurrentFile) return;
    try {
        const res = await fetch(SERVER + '/api/save-file', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: _tdCodeCurrentFile, content: editor.value })
        });
        const data = await res.json();
        if (data.ok) {
            _tdCodeOrigContent = editor.value;
            tdCodeExitEdit();
            tdCodeAddLog('✅ Saved: ' + _tdCodeCurrentFile, 'ok');
        } else {
            tdCodeAddLog('❌ Save failed: ' + (data.error || 'Unknown'), 'err');
        }
    } catch(e) {
        tdCodeAddLog('❌ Save error: ' + e.message, 'err');
    }
}

function tdCodeCancel() {
    const editor = document.getElementById('tdCodeEditorArea');
    editor.value = _tdCodeOrigContent;
    tdCodeExitEdit();
}

function tdCodeExitEdit() {
    const editor = document.getElementById('tdCodeEditorArea');
    const editBtn = document.getElementById('tdCodeEditBtn');
    const saveBtn = document.getElementById('tdCodeSaveBtn');
    const cancelBtn = document.getElementById('tdCodeCancelBtn');
    _tdCodeEditMode = false;
    editor.readOnly = true;
    editor.style.background = '#050e1a';
    editor.style.borderLeft = 'none';
    editBtn.style.display = 'inline-block';
    saveBtn.style.display = 'none';
    cancelBtn.style.display = 'none';
}

async function tdRunWithRepair(file, testName, log, updateStatus = () => {}, publishReport = () => {}) {
    const maxRetries = 3;
    async function runOnce(attempt) {
        updateStatus(`Playwright execution · attempt ${attempt + 1} of ${maxRetries + 1}`, attempt, maxRetries);
        const response = await fetch(`${SERVER}/api/run-test-simple`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ file, testName, retries: 0 })
        });
        if (!response.ok) {
            const body = await response.json().catch(() => ({}));
            throw new Error(body.error || `Dry Run request failed with HTTP ${response.status}`);
        }
        if (!response.body) throw new Error('Dry Run response did not include a stream');

        const lines = [];
        let doneData = null;
        let buffer = '';
        const decoder = new TextDecoder();
        const handlePart = part => {
            const dataLine = part.split('\n').find(line => line.startsWith('data:'));
            if (!dataLine) return;
            const message = JSON.parse(dataLine.slice(5).trim());
            if (message.type === 'log' || message.type === 'error') {
                const text = String(message.data || '').trim();
                if (text) {
                    lines.push(text);
                    log(text, message.type === 'error' ? 'err' : tdLogClass(text));
                }
            } else if (message.type === 'done') {
                doneData = message.data || {};
            }
        };
        const reader = response.body.getReader();
        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            parts.forEach(handlePart);
        }
        buffer += decoder.decode();
        if (buffer.trim()) handlePart(buffer);
        if (!doneData) throw new Error('Dry Run ended without a completion event');
        if (doneData.reportUrl) log(`📊 Playwright report saved: ${doneData.reportUrl}`, 'info');
        publishReport(doneData);
        return {
            exitCode: Number(doneData.exitCode ?? 1),
            lines,
            reportUrl: doneData.reportUrl || '',
            errorReportFile: doneData.errorReportFile || ''
        };
    }

    log(`🧪 Dry Run: ${file}${testName ? ` — ${testName}` : ''}`, 'info');
    log('⏱️ Playwright retries are disabled; only verified repairs are rerun.', 'info');
    let result = await runOnce(0);
    if (result.exitCode === 0) {
        log('✅ Dry Run passed', 'ok');
        return { ...result, retries: 0, needsHuman: false };
    }

    for (let retry = 1; retry <= maxRetries; retry++) {
        updateStatus(`Healer stage · repair ${retry} of ${maxRetries}`, retry, maxRetries);
        log(`🩹 Healer stage: analyzing failure and attempting repair ${retry}/${maxRetries}`, 'warn');
        const healResponse = await fetch(`${SERVER}/api/self-healing/auto-heal`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ file, failureOutput: result.lines.join('\n') })
        });
        const healData = await healResponse.json();
        if (!healResponse.ok) throw new Error(healData.error || `Repair request failed with HTTP ${healResponse.status}`);
        if (!healData.patched) {
            const reason = healData.reason || healData.analysis || 'No applicable repair was identified';
            log(`⚠️ Healer could not apply a repair: ${reason}`, 'warn');
            return { ...result, retries: retry - 1, needsHuman: true, interventionReason: reason };
        }

        log(`🛠️ ${healData.patchSummary || 'Repair applied'}`, 'info');
        (healData.changes || []).forEach(change => log(`   ${change}`, 'info'));
        log(`🔁 Rerunning after repair ${retry}/${maxRetries}`, 'info');
        result = await runOnce(retry);
        if (result.exitCode === 0) {
            log(`✅ Dry Run passed after repair ${retry}/${maxRetries}`, 'ok');
            return { ...result, retries: retry, needsHuman: false };
        }
    }

    const interventionReason = `The test still fails after ${maxRetries} verified repair attempts.`;
    log(`❌ ${interventionReason} Human intervention is required.`, 'err');
    return { ...result, retries: maxRetries, needsHuman: true, interventionReason };
}

async function tdCodeDryRun() {
    if (!_tdCodeCurrentFile || !_tdCodeCurrentFile.endsWith('.spec.ts')) return;
    const dryBtn = document.getElementById('tdCodeDryRunBtn');
    dryBtn.disabled = true;
    dryBtn.textContent = '⏳ Running...';
    dryBtn.style.opacity = '0.7';
    try {
        tokenOnDryRun((tdCurrentIssue && tdCurrentIssue.key) || '');
        await tdRunWithRepair(_tdCodeCurrentFile, '', tdCodeAddLog);
    } catch(e) {
        tdCodeAddLog('❌ Dry Run error: ' + e.message, 'err');
    }
    dryBtn.disabled = false;
    dryBtn.textContent = '▶ Dry Run';
    dryBtn.style.opacity = '1';
}

function tdCodeAddLog(text, cls) {
    const log = document.getElementById('tdGenLog');
    if (!log) return;
    const line = document.createElement('div');
    line.className = 'td-log-line ' + (cls || '');
    line.textContent = text;
    log.appendChild(line);
    log.scrollTop = log.scrollHeight;
}

// Load code tree when Test Design tab is shown
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(tdLoadCodeTree, 2000);
});

function tdToggleTicketSection() {
    const ticketBody    = document.getElementById('tdTicketIdBody');
    const ticketChevron = document.getElementById('tdTicketIdChevron');
    if (!ticketBody) return;
    const collapsed = ticketBody.style.display === 'none';

    // Ticket ID body
    ticketBody.style.display = collapsed ? '' : 'none';
    if (ticketChevron) ticketChevron.style.transform = collapsed ? 'rotate(0deg)' : 'rotate(-90deg)';

    // Entire Description section (title + body)
    const descSection = document.getElementById('tdDescSection');
    if (descSection) descSection.style.display = collapsed ? '' : 'none';

    // Entire Acceptance Criteria section (title + body)
    const critSection = document.getElementById('tdCriteriaSection');
    if (critSection) critSection.style.display = collapsed ? '' : 'none';
}

function activateJiraTab() {
    closeJiraDropdown();
    openJiraBoardModal();
}
function toggleJiraDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('jiraDropdownMenu');
    const toggle = document.getElementById('jiraDropdownToggle');
    const isOpen = menu.classList.contains('open');
    menu.classList.toggle('open', !isOpen); toggle.classList.toggle('open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
}
function closeJiraDropdown() {
    document.getElementById('jiraDropdownMenu').classList.remove('open');
    document.getElementById('jiraDropdownToggle').classList.remove('open');
    document.getElementById('jiraDropdownToggle').setAttribute('aria-expanded','false');
}
function selectJiraView(view, el) {
    JIRA_CONFIG.view = view;
    document.querySelectorAll('.jira-dropdown-item').forEach(i => i.classList.remove('selected'));
    if (el) el.classList.add('selected');
    const sel = document.getElementById('jiraBoardViewSelect');
    if (sel) sel.value = view;
    const lbl = document.getElementById('jiraBoardViewLabel');
    if (lbl) lbl.textContent = 'Showing: ' + (JIRA_VIEW_LABELS[view] || view);
    activateJiraTab(); loadJiraBoard(true); closeJiraDropdown();
}
function onJiraSelectChange(view) {
    JIRA_CONFIG.view = view;
    const lbl = document.getElementById('jiraBoardViewLabel');
    if (lbl) lbl.textContent = 'Showing: ' + (JIRA_VIEW_LABELS[view] || view);
    loadJiraBoard(true);
}
document.addEventListener('click', e => {
    const nav = document.getElementById('jiraNavTab');
    if (nav && !nav.contains(e.target)) closeJiraDropdown();
});
document.querySelectorAll('.nav-tab').forEach(tab => {
    tab.addEventListener('click', () => {
        document.getElementById('jiraTabBtn').classList.remove('active');
        document.getElementById('jiraDropdownToggle').classList.remove('active');
        closeJiraDropdown();
    });
});

async function loadJiraBoard(forceRefresh=false) {
    const inner = document.getElementById('jiraBoardInner');
    const refreshBtn = document.getElementById('jiraRefreshBtn');
    document.getElementById('jira').dataset.loaded = '1';
    if (refreshBtn) { refreshBtn.classList.add('spinning'); refreshBtn.disabled = true; }
    const isADO = JIRA_CONFIG.toolType === 'ADO';
    const toolName = isADO ? 'Azure DevOps' : 'Jira';
    if (!forceRefresh) {
        inner.innerHTML = `<div class="jira-state"><div class="icon">⏳</div><div class="msg">Fetching from ${toolName}…</div></div>`;
    }
    try {
        const url = isADO
            ? `${SERVER}/api/ado/board?view=${JIRA_CONFIG.view}`
            : `${SERVER}/api/jira/board?project=${JIRA_CONFIG.project}&view=${JIRA_CONFIG.view}`;
        const res  = await fetch(url);
        const data = await res.json();
        if (!res.ok) {
            const isToken = data.error && data.error.includes('API token');
            inner.innerHTML = `<div class="jira-state"><div class="icon">${isToken?'🔑':'⚠️'}</div><div class="msg">${isToken?'API Token Required':'Failed to load board'}</div><div class="detail">${escHtml(data.error||'Unknown error')}</div>${!isToken?'<button class="retry-btn" onclick="loadJiraBoard(true)">Retry</button>':''}</div>`;
            return;
        }
        renderBoard(data);
        const fa = document.getElementById('jiraFetchedAt');
        if (fa && data.fetchedAt) fa.textContent = 'Updated: ' + new Date(data.fetchedAt).toLocaleTimeString();
    } catch(e) {
        inner.innerHTML = `<div class="jira-state"><div class="icon">📡</div><div class="msg">Backend server is not running</div><div class="detail">Start the server with:<br><code>cd server &amp;&amp; node index.js</code><br><br>Then click Retry to reload the board.</div><button class="retry-btn" onclick="loadJiraBoard(true)">Retry</button></div>`;
    } finally {
        if (refreshBtn) { refreshBtn.classList.remove('spinning'); refreshBtn.disabled = false; }
    }
}

function renderBoard(data) {
    const inner = document.getElementById('jiraBoardInner');
    if (!data.columns || !data.columns.length) {
        inner.innerHTML = `<div class="jira-state"><div class="icon">📭</div><div class="msg">No issues found</div></div>`;
        return;
    }
    let html = `<div class="jira-meta-bar"><span class="jira-meta-badge">${data.project}</span><span>${data.total} issue${data.total!==1?'s':''}</span><a class="jira-link" href="#" onclick="openJiraBoardPopup('${escHtml(data.baseUrl)}/jira/software/projects/${data.project}/boards');return false;">Open in Jira ↗</a></div><div class="jira-columns">`;
    for (const col of data.columns) {
        const color = colColor(col.name);
        html += `<div class="jira-column"><div class="jira-col-header" style="border-top:3px solid ${color};"><span class="jira-col-title" style="color:${color};">${escHtml(col.name)}</span><span class="jira-col-count">${col.issues.length}</span></div><div class="jira-col-body">`;
        if (!col.issues.length) {
            html += `<div style="font-size:11px;color:#475569;text-align:center;padding:16px 0;">No issues</div>`;
        } else {
            for (const issue of col.issues) {
                const pc = priorityClass(issue.priority);
                const av = issue.assigneeAvatar ? `<img src="${escHtml(issue.assigneeAvatar)}" alt="${escHtml(issue.assignee||'')}" loading="lazy"/>` : (issue.assigneeInitials||'?');
                html += `<div class="jira-card" onclick="openJiraIssue('${issue.key}')" title="Click to view details and design tests">
                    <div class="jira-card-top">${issue.issueTypeIcon?`<img class="jira-type-icon" src="${escHtml(issue.issueTypeIcon)}" loading="lazy"/>`:''}<span class="jira-card-key">${escHtml(issue.key)}</span></div>
                    <div class="jira-card-title">${escHtml(issue.summary)}</div>
                    <div class="jira-card-meta">
                        ${issue.priority?`<span class="jira-priority ${pc}">${escHtml(issue.priority)}</span>`:'<span></span>'}
                        <div style="display:flex;align-items:center;gap:6px;">
                            ${issue.updated?`<span class="jira-updated">${timeAgo(issue.updated)}</span>`:''}
                            ${issue.assignee?`<div class="jira-assignee-avatar" title="${escHtml(issue.assignee)}">${av}</div>`:''}
                        </div>
                    </div>
                    ${issue.labels&&issue.labels.length?`<div style="margin-top:6px;display:flex;gap:4px;flex-wrap:wrap;">${issue.labels.map(l=>`<span class="jira-card-label">${escHtml(l)}</span>`).join('')}</div>`:''}
                    <div style="margin-top:8px;padding-top:8px;border-top:1px solid #2a3f5a;display:flex;gap:6px;">
                        <button onclick="event.stopPropagation();selectTicketForDesign('${issue.key}')" style="background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:4px 10px;border-radius:4px;font-size:10px;font-weight:700;cursor:pointer;flex:1;" title="Open in Test Design tab">⚡ Generate Tests</button>
                    </div>
                </div>`;
            }
        }
        html += `</div></div>`;
    }
    html += '</div>';
    inner.innerHTML = html;
}

async function openJiraIssue(key, instance) {
    const jiraEl = document.getElementById('jira');
    // Just open the board modal — no tab switching needed
    openJiraBoardModal();

    const modal = document.getElementById('jiraModal');
    document.getElementById('jiraModalKey').textContent = key;
    document.getElementById('jiraModalTitle').textContent = '';
    document.getElementById('jiraModalBody').innerHTML = `<div class="jira-state"><div class="icon">⏳</div><div class="msg">Loading ${key}…</div></div>`;
    document.getElementById('jiraModalUpdated').textContent = '';
    document.getElementById('jiraModalOpenLink').href = '#';
    modal.classList.add('open'); document.body.style.overflow = 'hidden';
    try {
        const res  = await fetch(`${SERVER}/api/jira/issue/${key}`);
        const data = await res.json();
        if (!res.ok) { document.getElementById('jiraModalBody').innerHTML = `<div class="jira-state"><div class="icon">⚠️</div><div class="msg">Failed</div><div class="detail">${escHtml(data.error||'Unknown error')}</div></div>`; return; }
        document.getElementById('jiraModalTitle').textContent = data.summary || key;
        document.getElementById('jiraModalOpenLink').href = data.url || '#';
        if (data.updated) document.getElementById('jiraModalUpdated').textContent = `Updated ${timeAgo(data.updated)}`;
        const pc = priorityClass(data.priority);
        let html = `<div class="jira-modal-meta">
            <div class="jira-modal-field"><div class="jira-modal-field-label">Status</div><div class="jira-modal-field-value">${escHtml(data.status||'—')}</div></div>
            <div class="jira-modal-field"><div class="jira-modal-field-label">Priority</div><div class="jira-modal-field-value">${data.priority?`<span class="jira-priority ${pc}">${escHtml(data.priority)}</span>`:'—'}</div></div>
            <div class="jira-modal-field"><div class="jira-modal-field-label">Type</div><div class="jira-modal-field-value">${escHtml(data.issueType||'—')}</div></div>
            <div class="jira-modal-field"><div class="jira-modal-field-label">Assignee</div><div class="jira-modal-field-value">${data.assignee?escHtml(data.assignee):'<span style="color:#475569">Unassigned</span>'}</div></div>
        </div>`;
        if (data.description) html += `<div class="jira-modal-section-title">Description</div><div class="jira-modal-desc">${escHtml(data.description)}</div>`;
        if (data.acceptanceCriteria || data.description) html += `<div class="jira-modal-section-title">Acceptance Criteria</div><div class="jira-modal-desc">${escHtml(data.acceptanceCriteria || data.description || 'No acceptance criteria provided.')}</div>`;
        if (data.subtasks&&data.subtasks.length) { html += `<div class="jira-modal-section-title">Subtasks (${data.subtasks.length})</div>`; for(const s of data.subtasks) html += `<div class="jira-subtask"><span class="jira-subtask-key">${escHtml(s.key)}</span><span class="jira-subtask-name">${escHtml(s.summary)}</span><span style="font-size:10px;color:#64748b;">${escHtml(s.status||'')}</span></div>`; }
        if (data.comments&&data.comments.length) { html += `<div class="jira-modal-section-title">Recent Comments</div>`; for(const c of data.comments) html += `<div class="jira-comment"><div class="jira-comment-meta">${escHtml(c.author||'Unknown')} · ${c.created?timeAgo(c.created):''}</div><div class="jira-comment-body">${escHtml((c.body||'').slice(0,400))}</div></div>`; }
        document.getElementById('jiraModalBody').innerHTML = html;
    } catch(e) {
        document.getElementById('jiraModalBody').innerHTML = `<div class="jira-state"><div class="icon">📡</div><div class="msg">Network error</div><div class="detail">${escHtml(e.message)}</div></div>`;
    }
}
function closeJiraModal() { document.getElementById('jiraModal').classList.remove('open'); document.body.style.overflow=''; }
document.addEventListener('keydown', e => { if (e.key==='Escape') closeJiraModal(); });
</script>

<script>
// ── Auth ──────────────────────────────────────────────────────────────────────
const MOCK_USERS = [
    { userId: 'admin',    password: 'admin123',     displayName: 'Admin User' },
    { userId: 'hexaware', password: 'hexaware@123', displayName: 'Hexaware QA' },
    { userId: 'tester',   password: 'test@2024',    displayName: 'Test Engineer' },
];
let currentUser = null;

function handleSignIn() {
    const uidEl  = document.getElementById('authUserId');
    const pwdEl  = document.getElementById('authPassword');
    const errEl  = document.getElementById('authError');
    const btn    = document.getElementById('authSignInBtn');
    const uid = uidEl.value.trim(), pwd = pwdEl.value;
    errEl.classList.remove('visible');
    uidEl.classList.remove('input-error'); pwdEl.classList.remove('input-error');
    if (!uid || !pwd) {
        document.getElementById('authErrorText').textContent = 'Please enter both User ID and Password.';
        errEl.classList.add('visible');
        if (!uid) uidEl.classList.add('input-error');
        if (!pwd) pwdEl.classList.add('input-error');
        return;
    }
    btn.disabled = true; btn.textContent = 'Signing in…';
    setTimeout(() => {
        const match = MOCK_USERS.find(u => u.userId===uid && u.password===pwd);
        if (match) {
            currentUser = match;
            document.getElementById('authOverlay').classList.add('hidden');
            const pill = document.getElementById('userPill');
            document.getElementById('userAvatar').textContent = match.displayName.charAt(0).toUpperCase();
            document.getElementById('userPillName').textContent = match.displayName;
            pill.style.display = 'flex';
            pwdEl.value = '';
            // Always land on Dashboard after login
            switchToTab('dashboard');
        } else {
            document.getElementById('authErrorText').textContent = 'Invalid User ID or Password. Please try again.';
            errEl.classList.add('visible');
            uidEl.classList.add('input-error'); pwdEl.classList.add('input-error');
            const card = document.querySelector('.auth-card');
            card.style.animation='none';
            requestAnimationFrame(()=>{ card.style.animation='authShake 0.35s ease'; });
        }
        btn.disabled=false; btn.textContent='Sign In';
    }, 300);
}

function handleSignOut() {
    currentUser = null;
    ['authUserId','authPassword'].forEach(id => { document.getElementById(id).value=''; document.getElementById(id).classList.remove('input-error'); });
    document.getElementById('authError').classList.remove('visible');
    document.getElementById('userPill').style.display='none';
    document.getElementById('authOverlay').classList.remove('hidden');
    const card = document.querySelector('.auth-card');
    card.style.animation='none';
    requestAnimationFrame(()=>{ card.style.animation='authSlideIn 0.25s ease'; });
}

document.getElementById('authUserId').addEventListener('keydown', e => { if(e.key==='Enter') document.getElementById('authPassword').focus(); });
document.getElementById('authPassword').addEventListener('keydown', e => { if(e.key==='Enter') handleSignIn(); });
['authUserId','authPassword'].forEach(id => {
    document.getElementById(id).addEventListener('input', () => {
        document.getElementById('authError').classList.remove('visible');
        document.getElementById(id).classList.remove('input-error');
    });
});

const shakeStyle = document.createElement('style');
shakeStyle.textContent = `@keyframes authShake { 0%,100%{transform:translateX(0)}20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)} }`;
document.head.appendChild(shakeStyle);

// ── Script Viewer Modal ───────────────────────────────────────────────────────
function openScriptModal(filename, content) {
    document.getElementById('scriptModalFilename').textContent = filename;
    document.getElementById('scriptModalContent').textContent = content;
    document.getElementById('scriptModal').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeScriptModal() {
    document.getElementById('scriptModal').classList.remove('open');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeJiraModal(); closeScriptModal(); closeJiraBoardModal(); closeNewSuiteModal(); } });

// ── Generated Tests (Test Execution tab) ─────────────────────────────────────
let _generatedFiles = [];

// ── Generated Scripts for Test Execution tab ──────────────────────────────────
let _allScriptGroups = {};   // { KEY: [{ file, name, testCount }] }
let _execTicketFilter = '';  // currently selected ticket key

// ── Defects Management (Defects tab) ─────────────────────────────────────────
let _defects = [];  // Array of defect objects

/**
 * Add a defect to the log
 * @param {string} testCaseName - Name of the failed test case
 * @param {string} severity - Severity level (High/Medium/Low)
 * @param {string} defectType - Type of defect (Locator Issue, Logic Error, etc.)
 * @param {string} description - Detailed description of the failure
 * @param {string} expectedResult - Expected result from test case
 * @param {string} actualResult - Actual failure/error message
 * @param {string} comments - Additional comments (optional)
 */
function addDefect(testCaseName, severity, defectType, description, expectedResult, actualResult, comments = '') {
    const defect = {
        id: `defect-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
        date: new Date().toLocaleString(),
        timestamp: Date.now(),
        testCaseName: testCaseName || 'Unknown',
        severity: severity || 'Medium',
        defectType: defectType || 'Test Failure',
        description: description || 'No description provided',
        expectedResult: expectedResult || 'Not specified',
        actualResult: actualResult || 'Not captured',
        status: 'Open',
        comments: comments
    };
    
    _defects.unshift(defect);  // Add to front for newest first
    saveDefectsToStorage();
    renderDefects();
    return defect;
}

/**
 * Update a defect's status or comments
 */
function updateDefect(defectId, updates) {
    const defect = _defects.find(d => d.id === defectId);
    if (defect) {
        Object.assign(defect, updates);
        saveDefectsToStorage();
        renderDefects();
    }
}

/**
 * Edit defect - open modal pre-filled
 */
function editDefect(defectId) {
    const defect = _defects.find(d => d.id === defectId);
    if (!defect) return;
    document.getElementById('defectModalTitle').textContent = '✏️ Edit Defect';
    document.getElementById('defectModalId').value = defectId;
    document.getElementById('dm_testCaseName').value = defect.testCaseName || '';
    document.getElementById('dm_description').value = defect.description || '';
    document.getElementById('dm_expectedResult').value = defect.expectedResult || '';
    document.getElementById('dm_actualResult').value = defect.actualResult || '';
    document.getElementById('dm_severity').value = defect.severity || 'Medium';
    document.getElementById('dm_status').value = defect.status || 'Open';
    document.getElementById('dm_comments').value = defect.comments || '';
    const modal = document.getElementById('defectModal');
    modal.style.display = 'flex';
}

/**
 * Delete a defect
 */
function deleteDefect(defectId) {
    if (confirm('Are you sure you want to delete this defect?')) {
        _defects = _defects.filter(d => d.id !== defectId);
        saveDefectsToStorage();
        renderDefects();
    }
}

/**
 * Open modal to create a new defect
 */
function openCreateDefectModal() {
    document.getElementById('defectModalTitle').textContent = '➕ Create Defect';
    document.getElementById('defectModalId').value = '';
    document.getElementById('dm_testCaseName').value = '';
    document.getElementById('dm_description').value = '';
    document.getElementById('dm_expectedResult').value = '';
    document.getElementById('dm_actualResult').value = '';
    document.getElementById('dm_severity').value = 'Medium';
    document.getElementById('dm_status').value = 'Open';
    document.getElementById('dm_comments').value = '';
    document.getElementById('defectModal').style.display = 'flex';
}

/**
 * Close the defect modal (Cancel)
 */
function closeDefectModal() {
    document.getElementById('defectModal').style.display = 'none';
}

/**
 * Save (create or update) from modal (Update button)
 */
function saveDefectModal() {
    const testCaseName = document.getElementById('dm_testCaseName').value.trim();
    const description = document.getElementById('dm_description').value.trim();
    if (!testCaseName || !description) {
        alert('Test Case Id and Defect Description are required.');
        return;
    }
    const id = document.getElementById('defectModalId').value;
    const data = {
        testCaseName,
        description,
        expectedResult: document.getElementById('dm_expectedResult').value.trim(),
        actualResult: document.getElementById('dm_actualResult').value.trim(),
        severity: document.getElementById('dm_severity').value,
        status: document.getElementById('dm_status').value,
        comments: document.getElementById('dm_comments').value.trim()
    };
    if (id) {
        updateDefect(id, data);
    } else {
        addDefect(data.testCaseName, data.severity, 'Manual', data.description, data.expectedResult, data.actualResult, data.comments);
        // patch status after creation since addDefect defaults to Open
        const created = _defects[0];
        if (created && data.status !== 'Open') updateDefect(created.id, { status: data.status });
    }
    closeDefectModal();
}

/**
 * Refresh defects table
 */
function refreshDefects() {
    loadDefectsFromStorage();
}

/**
 * Export defects to XLSX using SheetJS (CDN)
 */
function exportDefectsToXlsx() {
    if (!_defects.length) { alert('No defects to export.'); return; }
    function doExport() {
        const rows = _defects.map(d => ({
            'Date': d.date,
            'Test Case Id': d.testCaseName,
            'Defect Description': d.description,
            'Expected Result': d.expectedResult,
            'Actual Result': d.actualResult,
            'Severity': d.severity,
            'Status': d.status,
            'Comments': d.comments || ''
        }));
        const ws = XLSX.utils.json_to_sheet(rows);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Defects');
        XLSX.writeFile(wb, 'defects-export.xlsx');
    }
    if (typeof XLSX !== 'undefined') { doExport(); return; }
    const script = document.createElement('script');
    script.src = 'https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js';
    script.onload = doExport;
    document.head.appendChild(script);
}

/**
 * Clear all defects (kept for internal use)
 */
function clearAllDefects() {
    if (confirm('Are you sure you want to clear all defects? This action cannot be undone.')) {
        _defects = [];
        saveDefectsToStorage();
        renderDefects();
    }
}

/**
 * Save defects to localStorage for persistence
 */
function saveDefectsToStorage() {
    try {
        localStorage.setItem('orchestrator_defects', JSON.stringify(_defects));
    } catch(e) {
        console.warn('Failed to save defects to localStorage:', e);
    }
}

/**
 * Load defects from localStorage
 */
function loadDefectsFromStorage() {
    try {
        const stored = localStorage.getItem('orchestrator_defects');
        if (stored) {
            _defects = JSON.parse(stored);
            renderDefects();
        }
    } catch(e) {
        console.warn('Failed to load defects from localStorage:', e);
        _defects = [];
    }
}

/**
 * Render defects table with filtering and sorting
 */
function renderDefects() {
    const tbody = document.getElementById('defectsTableBody');
    const emptyState = document.getElementById('defectsEmptyState');
    const filterInput = document.getElementById('defectFilterInput');
    const statusFilter = document.getElementById('defectStatusFilter');
    
    if (!tbody) return;
    
    // Get filter values
    const searchTerm = (filterInput?.value || '').toLowerCase();
    const statusValue = statusFilter?.value || '';
    
    // Filter defects
    let filtered = _defects.filter(d => {
        const matchSearch = !searchTerm || 
            d.testCaseName.toLowerCase().includes(searchTerm) ||
            d.description.toLowerCase().includes(searchTerm) ||
            d.actualResult.toLowerCase().includes(searchTerm) ||
            d.defectType.toLowerCase().includes(searchTerm);
        
        const matchStatus = !statusValue || d.status === statusValue;
        
        return matchSearch && matchStatus;
    });
    
    // Show/hide empty state
    if (emptyState) {
        emptyState.style.display = filtered.length === 0 ? 'flex' : 'none';
    }
    
    // Render rows
    tbody.innerHTML = filtered.map(d => `
        <tr style="border-bottom:1px solid #1a2f4a;background:#0a1628;">
            <td style="padding:10px 8px;color:#e0e0e0;white-space:nowrap;">${escHtml(d.date)}</td>
            <td style="padding:10px 8px;color:#e0e0e0;font-weight:500;">${escHtml(d.testCaseName)}</td>
            <td style="padding:10px 8px;color:#cbd5e1;font-size:11px;">
                <div style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escHtml(d.description)}">${escHtml(d.description)}</div>
            </td>
            <td style="padding:10px 8px;color:#cbd5e1;font-size:11px;">
                <div style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escHtml(d.expectedResult)}">${escHtml(d.expectedResult)}</div>
            </td>
            <td style="padding:10px 8px;color:#cbd5e1;font-size:11px;">
                <div style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escHtml(d.actualResult)}">${escHtml(d.actualResult)}</div>
            </td>
            <td style="padding:10px 8px;">
                <span style="padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600;${
                    d.severity === 'High' ? 'background:rgba(248,113,113,0.2);color:#f87171;' :
                    d.severity === 'Medium' ? 'background:rgba(245,158,11,0.2);color:#f59e0b;' :
                    'background:rgba(59,130,246,0.2);color:#60a5fa;'
                }">${escHtml(d.severity)}</span>
            </td>
            <td style="padding:10px 8px;">
                <span style="padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600;${
                    d.status === 'Open' ? 'background:rgba(248,113,113,0.15);color:#f87171;' :
                    d.status === 'In Progress' ? 'background:rgba(245,158,11,0.15);color:#f59e0b;' :
                    d.status === 'Resolved' ? 'background:rgba(34,197,94,0.15);color:#4ade80;' :
                    'background:rgba(100,116,139,0.2);color:#94a3b8;'
                }">${escHtml(d.status)}</span>
            </td>
            <td style="padding:10px 8px;color:#cbd5e1;font-size:11px;">${escHtml(d.comments || '')}</td>
            <td style="padding:10px 8px;text-align:center;">
                <div style="display:flex;gap:4px;align-items:center;justify-content:center;">
                    <button onclick="editDefect('${d.id}')" style="background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.3);color:#60a5fa;cursor:pointer;font-size:11px;padding:3px 7px;border-radius:3px;font-weight:600;" title="Edit">✏️ Edit</button>
                    <button onclick="deleteDefect('${d.id}')" style="background:rgba(248,113,113,0.1);border:1px solid rgba(248,113,113,0.3);color:#f87171;cursor:pointer;font-size:11px;padding:3px 7px;border-radius:3px;font-weight:600;" title="Delete">🗑️</button>
                </div>
            </td>
        </tr>
    `).join('');
}

/**
 * Set up defect table event listeners
 */
function initDefectsTab() {
    const filterInput = document.getElementById('defectFilterInput');
    const statusFilter = document.getElementById('defectStatusFilter');
    
    if (filterInput) {
        filterInput.addEventListener('input', renderDefects);
    }
    if (statusFilter) {
        statusFilter.addEventListener('change', renderDefects);
    }
    
    // Load defects from storage on page load
    loadDefectsFromStorage();
}

/**
 * Load all generated test scripts from tests/{KEY}/ folders and populate
 * the Generated Scripts section + the ticket filter dropdown.
 */
async function loadGeneratedTests() {
    try {
        const res  = await fetch(`${SERVER}/api/tests/scripts`);
        if (!res.ok) return;
        const data = await res.json();
        _allScriptGroups = data.groups || {};

        // Populate ticket filter dropdown
        const sel = document.getElementById('execTicketFilter');
        if (sel) {
            // Keep "All Tickets" option, replace the rest
            while (sel.options.length > 1) sel.remove(1);
            for (const key of Object.keys(_allScriptGroups).sort()) {
                const opt = document.createElement('option');
                opt.value = key;
                opt.textContent = key;
                sel.appendChild(opt);
            }
            // Re-apply current filter if set
            if (_execTicketFilter && _allScriptGroups[_execTicketFilter]) {
                sel.value = _execTicketFilter;
            }
        }

        renderExecScripts();
    } catch(_) {}
}

/** Called when the ticket filter dropdown changes */
function execFilterChanged(val) {
    _execTicketFilter = val;
    renderExecScripts();
    // Also filter the test cases list
    renderCases();
}

/**
 * Render the Generated Scripts section in the Test Execution tab.
 * Shows scripts for the selected ticket (or all tickets if none selected).
 */
function renderExecScripts() {
    const section   = document.getElementById('execScriptsSection');
    const list      = document.getElementById('execScriptsList');
    const countEl   = document.getElementById('execScriptsCount');
    if (!section || !list) return;

    const keys = _execTicketFilter
        ? (_allScriptGroups[_execTicketFilter] ? [_execTicketFilter] : [])
        : Object.keys(_allScriptGroups).sort();

    const allScripts = keys.flatMap(key =>
        (_allScriptGroups[key] || []).map(s => ({ ...s, key }))
    );

    if (!allScripts.length) {
        section.style.display = 'none';
        return;
    }

    section.style.display = '';
    countEl.textContent   = allScripts.length + ' script' + (allScripts.length > 1 ? 's' : '');

    list.innerHTML = allScripts.map(s => {
        const safeId = btoa(s.file).replace(/[^a-zA-Z0-9]/g, '');
        return `
        <div id="exec-script-card-${safeId}" style="background:#0a1628;border:1px solid #1a2f4a;border-radius:8px;overflow:hidden;">
            <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;cursor:pointer;" onclick="toggleTestCases('${escHtml(s.file)}','${safeId}')">
                <div style="min-width:0;flex:1;">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;flex-wrap:wrap;">
                        <span style="font-size:10px;font-weight:700;color:#3b82f6;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);padding:1px 7px;border-radius:8px;">${escHtml(s.key)}</span>
                        <span style="font-family:monospace;font-size:11px;color:#60a5fa;">${escHtml(s.name)}</span>
                        ${s.testCount ? `<span style="font-size:10px;color:#475569;">${s.testCount} test${s.testCount > 1 ? 's' : ''}</span>` : ''}
                    </div>
                    <div style="font-family:monospace;font-size:10px;color:#334155;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(s.file)}</div>
                </div>
                <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
                    <span id="exec-badge-${safeId}" style="font-size:10px;font-weight:600;padding:2px 8px;border-radius:8px;background:#1a2f4a;color:#64748b;"></span>
                    ${projectRoot ? `<a href="vscode://file/${projectRoot.replace(/\/$/, '')}/${s.file}" title="Open in VS Code" style="font-size:11px;color:#60a5fa;text-decoration:none;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.25);padding:3px 8px;border-radius:4px;white-space:nowrap;" onclick="event.stopPropagation();">↗ IDE</a>` : ''}
                    <span id="exec-arrow-${safeId}" style="color:#64748b;font-size:12px;transition:transform 0.2s;">▾</span>
                </div>
            </div>
            <!-- Test cases panel: hidden until clicked -->
            <div id="exec-tests-${safeId}" style="display:none;border-top:1px solid #0d1d30;background:#050e1a;">
                <div style="padding:14px;">
                    <div id="exec-tests-loading-${safeId}" style="text-align:center;color:#64748b;font-size:11px;padding:20px;">⏳ Loading test cases...</div>
                    <div id="exec-tests-list-${safeId}" style="display:none;"></div>
                </div>
            </div>
            <!-- Result panel: hidden until run -->
            <div id="exec-result-${safeId}" style="display:none;border-top:1px solid #0d1d30;">
                <!-- summary bar -->
                <div id="exec-summary-${safeId}" style="display:flex;gap:16px;padding:7px 14px;background:#0f1e30;font-size:11px;flex-wrap:wrap;align-items:center;"></div>
                <!-- log output -->
                <div id="exec-log-${safeId}" style="font-family:monospace;font-size:11px;color:#94a3b8;padding:10px 14px;max-height:220px;overflow-y:auto;background:#050e1a;white-space:pre-wrap;word-break:break-all;"></div>
            </div>
        </div>`;
    }).join('');
}

/**
 * Get expected result from manual test case by name
 * Searches through mtTestCases to find the test case and return its expected result
 */
function getExpectedResultForTestCase(testCaseName) {
    if (!window.mtTestCases) return 'Not specified';
    
    const allCases = [
        ...(window.mtTestCases.positive || []),
        ...(window.mtTestCases.negative || []),
        ...(window.mtTestCases.edge || []),
    ];
    
    const tc = allCases.find(c => 
        c.title === testCaseName || 
        c.name === testCaseName ||
        c.id === testCaseName
    );
    
    return tc ? (tc.expectedResult || 'Not specified') : 'Not specified';
}

/**
 * Determine severity based on failure message
 */
function determineSeverity(failureMessage) {
    const msg = (failureMessage || '').toLowerCase();
    
    // High severity: Assertion failures, crashes, timeouts
    if (msg.includes('assert') || msg.includes('exception') || msg.includes('timeout') || msg.includes('crashed')) {
        return 'High';
    }
    
    // Medium severity: Element not found, interaction failures
    if (msg.includes('element not found') || msg.includes('no such element') || msg.includes('cannot find')) {
        return 'High';
    }
    
    // Low severity: Warnings, data mismatches
    if (msg.includes('warning') || msg.includes('deprecated')) {
        return 'Low';
    }
    
    return 'Medium';
}

/**
 * Log a test failure to the defects table
 */
function logTestFailure(testName, failureMessage, expectedResult) {
    const severity = determineSeverity(failureMessage);
    const defectType = 'Test Execution Failure';
    const description = failureMessage ? failureMessage.substring(0, 200) : 'Test failed without error message';
    const actualResult = failureMessage || 'Test execution failed';
    
    addDefect(
        testName,
        severity,
        defectType,
        description,
        expectedResult,
        actualResult,
        ''
    );
}

/**
 * Run a generated script from the Test Execution tab.
 * Streams output into the inline result panel below the script card.
 */
async function execRunScript(file, safeId, testName = null) {
    const btn     = document.getElementById('exec-runbtn-'  + safeId);
    const badge   = document.getElementById('exec-badge-'   + safeId);
    const result  = document.getElementById('exec-result-'  + safeId);
    const summary = document.getElementById('exec-summary-' + safeId);
    const logEl   = document.getElementById('exec-log-'     + safeId);
    if (!result || !logEl) return;

    // Show result panel, reset state
    result.style.display  = 'block';
    logEl.textContent     = '';
    summary.innerHTML     = '<span style="color:#60a5fa;">⏳ Running…</span>';
    if (btn) {
        btn.disabled          = true;
        btn.textContent       = '⏳';
    }
    if (badge) { badge.textContent = 'Running'; badge.style.cssText = 'font-size:10px;font-weight:600;padding:2px 8px;border-radius:8px;background:rgba(59,130,246,0.15);color:#60a5fa;'; }

    // Also show and update the global log panel at the bottom
    const logPanel = document.getElementById('logPanel');
    const logBody  = document.getElementById('logBody');
    const logStatus = document.getElementById('logStatus');
    if (logPanel) { logPanel.style.display = 'flex'; logPanel.style.flexDirection = 'column'; }
    if (logBody)  logBody.innerHTML = '';
    if (logStatus) logStatus.textContent = testName ? `Running ${testName}…` : `Running ${file}…`;
    setStatus('Running…', 'running');
    setProgress(10);

    let lineCount = 0;
    try {
        const res = await fetch(`${SERVER}/api/run-tests/file`, {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({ file, testName }),
        });

        const reader  = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '', doneData = null;

        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            for (const part of parts) {
                const dl = part.split('\n').find(l => l.startsWith('data:'));
                if (!dl) continue;
                try {
                    const msg = JSON.parse(dl.slice(5));
                    if (msg.type === 'log') {
                        lineCount++;
                        // Append to inline log
                        logEl.textContent += msg.data + '\n';
                        logEl.scrollTop    = logEl.scrollHeight;
                        // Also append to global log panel
                        appendLog(msg.data, classifyLine(msg.data));
                        setProgress(Math.min(85, 10 + lineCount * 2));
                    } else if (msg.type === 'error') {
                        // Surface server-side error messages (e.g. file not found)
                        logEl.textContent += '❌ ' + msg.data + '\n';
                        logEl.scrollTop    = logEl.scrollHeight;
                        appendLog('❌ ' + msg.data, 'fail');
                    } else if (msg.type === 'done') {
                        doneData = msg.data;
                    }
                } catch(_) {}
            }
        }

        if (doneData) {
            const ok       = doneData.exitCode === 0;
            const passed   = doneData.passed   || 0;
            const failed   = doneData.failed   || 0;
            const skipped  = doneData.skipped  || 0;
            const results  = doneData.testResults || [];

            // Append run-complete line to the inline log
            logEl.textContent += '\n' + (ok ? '✅ Run complete' : '❌ Run complete — Tests failed') + '\n';
            logEl.scrollTop = logEl.scrollHeight;
            appendLog(ok ? '✅ Run complete' : '❌ Run complete — Tests failed', ok ? 'pass' : 'fail');

            setProgress(100, ok ? 'done' : 'error');
            setStatus(ok ? 'Passed' : 'Failed', ok ? 'passed' : 'failed');
            if (logStatus) logStatus.textContent = ok ? '✅ Run complete' : '❌ Run complete';

            // Badge
            if (badge) {
                badge.textContent = ok ? '✅ Passed' : '❌ Failed';
                badge.style.cssText = `font-size:10px;font-weight:600;padding:2px 8px;border-radius:8px;background:${ok ? 'rgba(16,185,129,0.15)' : 'rgba(248,113,113,0.15)'};color:${ok ? '#10b981' : '#f87171'};`;
            }

            // Summary bar with counters + per-test chips
            let summaryHtml =
                `<span style="color:${passed > 0 ? '#10b981' : '#475569'}">✅ ${passed} passed</span>` +
                `<span style="color:${failed > 0 ? '#f87171' : '#475569'}">❌ ${failed} failed</span>` +
                (skipped ? `<span style="color:#f59e0b">⏭ ${skipped} skipped</span>` : '');

            if (results.length) {
                summaryHtml += '<div style="width:100%;margin-top:6px;display:flex;flex-wrap:wrap;gap:4px;">';
                summaryHtml += results.map(t => {
                    const c = t.status === 'passed' ? '#10b981' : t.status === 'failed' ? '#f87171' : '#f59e0b';
                    const icon = t.status === 'passed' ? '✅' : t.status === 'failed' ? '❌' : '⏭';
                    
                    // Log failed tests to defects table
                    if (t.status === 'failed') {
                        const expectedResult = getExpectedResultForTestCase(t.name);
                        logTestFailure(t.name, t.error || 'Test execution failed', expectedResult);
                    }
                    
                    return `<span title="${escHtml(t.name)}" style="font-size:10px;padding:2px 8px;border-radius:12px;background:${c}22;color:${c};border:1px solid ${c}44;white-space:nowrap;max-width:260px;overflow:hidden;text-overflow:ellipsis;">${icon} ${escHtml(t.name.slice(0, 40))}${t.name.length > 40 ? '…' : ''}${t.duration ? ` (${t.duration})` : ''}</span>`;
                }).join('');
                summaryHtml += '</div>';
            }

            summary.innerHTML = summaryHtml;
        }
    } catch(e) {
        logEl.textContent += '\n❌ Error: ' + e.message;
        summary.innerHTML  = `<span style="color:#f87171;">❌ Error: ${escHtml(e.message)}</span>`;
        if (badge) { badge.textContent = '❌ Error'; badge.style.cssText = 'font-size:10px;font-weight:600;padding:2px 8px;border-radius:8px;background:rgba(248,113,113,0.15);color:#f87171;'; }
        setStatus('Error', 'failed');
    } finally {
        if (btn) {
            btn.disabled    = false;
            btn.textContent = '▶ Run';
        }
    }
}

/**
 * Toggle test cases view for a script file in Test Execution tab.
 * Fetches and displays all test cases from the .ts file.
 */
async function toggleTestCases(file, safeId) {
    const testsPanel = document.getElementById(`exec-tests-${safeId}`);
    const arrow = document.getElementById(`exec-arrow-${safeId}`);
    const loading = document.getElementById(`exec-tests-loading-${safeId}`);
    const testsList = document.getElementById(`exec-tests-list-${safeId}`);
    
    if (!testsPanel) return;
    
    // Toggle visibility
    if (testsPanel.style.display === 'none' || !testsPanel.style.display) {
        testsPanel.style.display = 'block';
        if (arrow) arrow.style.transform = 'rotate(180deg)';
        
        // Load test cases if not already loaded
        if (testsList && testsList.innerHTML === '') {
            try {
                const res = await fetch(`${SERVER}/api/parse-test-file?file=${encodeURIComponent(file)}`);
                
                if (!res.ok) {
                    const errorText = await res.text();
                    throw new Error(`Failed to load test cases: ${res.status} ${errorText}`);
                }
                
                const data = await res.json();
                
                if (loading) loading.style.display = 'none';
                testsList.style.display = 'block';
                
                if (data.tests && data.tests.length > 0) {
                    testsList.innerHTML = data.tests.map((tc, idx) => {
                        const typeColor = tc.type === 'Positive' ? '#10b981' : tc.type === 'Negative' ? '#f87171' : '#a78bfa';
                        const typeBg = tc.type === 'Positive' ? 'rgba(16,185,129,0.12)' : tc.type === 'Negative' ? 'rgba(248,113,113,0.12)' : 'rgba(167,139,250,0.12)';
                        const tcId = (tc.name || '').replace(/[^a-zA-Z0-9_]/g,'_');
                        return `
                            <div style="background:#0a1628;border:1px solid #1a2f4a;border-radius:6px;padding:10px;margin-bottom:8px;">
                                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px;">
                                    <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
                                        <input type="checkbox" class="exec-tc-cb" data-tc-name="${escHtml(tc.name)}" data-tc-file="${escHtml(file)}" style="width:14px;height:14px;accent-color:#3b82f6;cursor:pointer;flex-shrink:0;" onchange="execSyncSelection()" />
                                        <div style="min-width:0;flex:1;">
                                            <div style="font-size:12px;color:#e0e0e0;font-weight:600;margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(tc.name)}</div>
                                            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                                <span style="font-size:9px;padding:2px 6px;border-radius:4px;background:${typeBg};color:${typeColor};font-weight:600;">${escHtml(tc.type)}</span>
                                                <span style="font-size:9px;padding:2px 6px;border-radius:4px;background:rgba(100,116,139,0.12);color:#64748b;font-weight:600;">${escHtml(tc.priority)}</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
                                        <select class="exec-tc-suite-select" data-tc-name="${escHtml(tc.name)}" data-tc-file="${escHtml(file)}" style="font-size:10px;padding:3px 6px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:4px;color:#94a3b8;cursor:pointer;" onchange="execAddTestToSuite(this)">
                                            <option value="">Add to Suite...</option>
                                        </select>
                                        <button id="testrun-${safeId}test${idx}" onclick="event.stopPropagation();execRunSingleTest('${escHtml(file)}','${escHtml(tc.name)}','testrun-${safeId}test${idx}')"
                                            style="background:linear-gradient(135deg,#10b981,#059669);border:none;color:white;padding:4px 12px;border-radius:4px;font-size:10px;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;"
                                            onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                                            ▶ Run
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');
                    // Populate suite dropdowns in this panel
                    execPopulateSuiteDropdowns(testsList);
                    // Restore persisted log/status for previously-run tests
                    execRestoreTestLogs(testsList);
                } else {
                    testsList.innerHTML = '<div style="text-align:center;color:#64748b;font-size:11px;padding:10px;">No test cases found in this file.</div>';
                }
            } catch(e) {
                if (loading) loading.textContent = `❌ Error: ${e.message}`;
            }
        }
    } else {
        testsPanel.style.display = 'none';
        if (arrow) arrow.style.transform = 'rotate(0deg)';
    }
}

/**
 * Populate suite dropdowns within the Generated Scripts test cases panel.
 */
function execPopulateSuiteDropdowns(container) {
    const suites = loadSuites();
    const selects = container.querySelectorAll('.exec-tc-suite-select');
    selects.forEach(function(sel) {
        // Keep the first "Add to Suite..." option, add suite options
        while (sel.options.length > 1) sel.remove(1);
        suites.forEach(function(s) {
            const opt = document.createElement('option');
            opt.value = s.id;
            opt.textContent = s.name;
            sel.appendChild(opt);
        });
        // Also add a "Regression" option if no suite named Regression exists
        if (!suites.find(function(s){ return s.name.toLowerCase() === 'regression'; })) {
            const opt = document.createElement('option');
            opt.value = '__create_regression__';
            opt.textContent = '+ Regression (new)';
            sel.appendChild(opt);
        }
        // Also add a "Smoke" option if no suite named Smoke exists
        if (!suites.find(function(s){ return s.name.toLowerCase() === 'smoke'; })) {
            const opt = document.createElement('option');
            opt.value = '__create_smoke__';
            opt.textContent = '+ Smoke (new)';
            sel.appendChild(opt);
        }
    });
}

/**
 * Add a test case to a suite from the Generated Scripts panel dropdown.
 */
function execAddTestToSuite(selectEl) {
    const suiteVal = selectEl.value;
    if (!suiteVal) return;

    const tcName = selectEl.getAttribute('data-tc-name');
    const tcFile = selectEl.getAttribute('data-tc-file');
    if (!tcName || !tcFile) return;

    let suites = loadSuites();
    let targetSuite = null;

    // Handle auto-create for Regression/Smoke
    if (suiteVal === '__create_regression__') {
        const newSuite = { id: 'suite_' + Date.now(), name: 'Regression', caseIds: [] };
        suites.push(newSuite);
        saveSuites(suites);
        targetSuite = newSuite;
    } else if (suiteVal === '__create_smoke__') {
        const newSuite = { id: 'suite_' + Date.now(), name: 'Smoke', caseIds: [] };
        suites.push(newSuite);
        saveSuites(suites);
        targetSuite = newSuite;
    } else {
        targetSuite = suites.find(function(s){ return s.id === suiteVal; });
    }

    if (!targetSuite) { selectEl.value = ''; return; }

    // Use the test name as the case ID (same as how _allCases work)
    const caseId = tcName;
    if (!targetSuite.caseIds.includes(caseId)) {
        targetSuite.caseIds.push(caseId);
        // Also store the file reference for running from suite
        if (!targetSuite.fileMap) targetSuite.fileMap = {};
        targetSuite.fileMap[caseId] = tcFile;
        saveSuites(suites);
        showToast('Added "' + tcName.substring(0, 40) + '..." to ' + targetSuite.name, 'success');
    } else {
        showToast('Already in ' + targetSuite.name, 'warn');
    }

    selectEl.value = '';
    // Refresh the suite sidebar and main cases view
    renderSuiteList();
    renderCases();
}

/**
 * Run a single test case from a script file.
 */
const EXEC_LOGS_KEY = 'pw_exec_test_logs'; // localStorage key for persisted logs

function _getExecLogs() {
    try { return JSON.parse(localStorage.getItem(EXEC_LOGS_KEY)) || {}; } catch(e) { return {}; }
}
function _saveExecLog(testName, data) {
    const all = _getExecLogs();
    all[testName] = data;
    localStorage.setItem(EXEC_LOGS_KEY, JSON.stringify(all));
}

/**
 * Restore persisted log/status for a test card (called after test cases are rendered).
 */
function execRestoreTestLogs(container) {
    const logs = _getExecLogs();
    const cards = container.querySelectorAll('div[style*="background:#0a1628"]');
    cards.forEach(function(card) {
        const btn = card.querySelector('button[id^="testrun-"]');
        if (!btn) return;
        // Extract test name from the onclick attribute
        const onclickAttr = btn.getAttribute('onclick') || '';
        const nameMatch = onclickAttr.match(/execRunSingleTest\('[^']*','([^']*)'/);
        if (!nameMatch) return;
        const tcName = nameMatch[1].replace(/\\'/g, "'");
        const saved = logs[tcName];
        if (!saved) return;

        // Build the log wrapper
        let logWrapper = card.querySelector('.exec-log-wrapper');
        if (!logWrapper) {
            logWrapper = document.createElement('div');
            logWrapper.className = 'exec-log-wrapper';
            logWrapper.style.cssText = 'margin-top:8px;';
            logWrapper.innerHTML = '<div class="exec-log-header" style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:6px 10px;background:#0d1d30;border:1px solid #1a2f4a;border-radius:5px 5px 0 0;user-select:none;" onclick="this.parentElement.querySelector(\'.exec-log-body\').style.display=this.parentElement.querySelector(\'.exec-log-body\').style.display===\'none\'?\'block\':\'none\';this.querySelector(\'.exec-log-arrow\').textContent=this.parentElement.querySelector(\'.exec-log-body\').style.display===\'none\'?\'\\u25b6\':\'\\u25bc\';"><span class="exec-log-arrow" style="font-size:10px;color:#64748b;">\u25b6</span><span class="exec-log-status" style="font-size:11px;font-weight:600;color:#64748b;"></span><span class="exec-log-report" style="margin-left:auto;"></span></div><div class="exec-log-body" style="display:none;background:#050e1a;border:1px solid #1a2f4a;border-top:none;border-radius:0 0 5px 5px;padding:8px 10px;max-height:200px;overflow-y:auto;font-family:monospace;font-size:10px;line-height:1.7;"></div>';
            card.appendChild(logWrapper);
        }
        const logStatus = logWrapper.querySelector('.exec-log-status');
        const logReport = logWrapper.querySelector('.exec-log-report');
        const logBody = logWrapper.querySelector('.exec-log-body');
        const logArrow = logWrapper.querySelector('.exec-log-arrow');

        // Restore status
        if (saved.status === 'passed') {
            logStatus.textContent = '\u2705 Run Passed';
            logStatus.style.color = '#10b981';
        } else {
            logStatus.textContent = '\u274c Run Failed';
            logStatus.style.color = '#f87171';
        }

        // Restore report link
        if (saved.reportUrl) {
            logReport.innerHTML = '<a href="' + saved.reportUrl + '" target="_blank" style="font-size:10px;color:#60a5fa;text-decoration:underline;padding:2px 8px;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);border-radius:4px;">\ud83d\udcca View Report</a>';
        }

        // Restore log lines (collapsed by default)
        logBody.innerHTML = '';
        logBody.style.display = 'none';
        logArrow.textContent = '\u25b6';
        if (saved.lines && saved.lines.length) {
            saved.lines.forEach(function(l) {
                const d = document.createElement('div');
                d.style.color = l.color || '#94a3b8';
                d.textContent = l.text;
                logBody.appendChild(d);
            });
        }
        logWrapper.style.display = 'block';
    });
}

async function execRunSingleTest(file, testName, buttonId) {
    const btn = document.getElementById(buttonId);
    if (!btn) { alert('Button not found'); return; }
    btn.disabled = true;
    btn.textContent = '\u23f3 Running\u2026';
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';

    // Create or reuse a collapsible log area below the test card
    const card = btn.closest('div[style*="background:#0a1628"]');
    let logWrapper = card ? card.querySelector('.exec-log-wrapper') : null;
    if (!logWrapper && card) {
        logWrapper = document.createElement('div');
        logWrapper.className = 'exec-log-wrapper';
        logWrapper.style.cssText = 'margin-top:8px;';
        logWrapper.innerHTML = '<div class="exec-log-header" style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:6px 10px;background:#0d1d30;border:1px solid #1a2f4a;border-radius:5px 5px 0 0;user-select:none;" onclick="this.parentElement.querySelector(\'.exec-log-body\').style.display=this.parentElement.querySelector(\'.exec-log-body\').style.display===\'none\'?\'block\':\'none\';this.querySelector(\'.exec-log-arrow\').textContent=this.parentElement.querySelector(\'.exec-log-body\').style.display===\'none\'?\'\\u25b6\':\'\\u25bc\';"><span class="exec-log-arrow" style="font-size:10px;color:#64748b;">\u25bc</span><span class="exec-log-status" style="font-size:11px;font-weight:600;color:#60a5fa;">\u23f3 Running...</span><span class="exec-log-report" style="margin-left:auto;"></span></div><div class="exec-log-body" style="background:#050e1a;border:1px solid #1a2f4a;border-top:none;border-radius:0 0 5px 5px;padding:8px 10px;max-height:200px;overflow-y:auto;font-family:monospace;font-size:10px;line-height:1.7;"></div>';
        card.appendChild(logWrapper);
    }

    // Reset the log panel
    const logBody = logWrapper.querySelector('.exec-log-body');
    const logStatus = logWrapper.querySelector('.exec-log-status');
    const logReport = logWrapper.querySelector('.exec-log-report');
    const logArrow = logWrapper.querySelector('.exec-log-arrow');
    logBody.innerHTML = '';
    logBody.style.display = 'block';
    logArrow.textContent = '\u25bc';
    logStatus.textContent = '\u23f3 Running...';
    logStatus.style.color = '#60a5fa';
    logReport.innerHTML = '';
    logWrapper.style.display = 'block';

    // Track log lines for persistence
    const logLines = [];

    function appendLog(text, color) {
        if (!logBody) return;
        const d = document.createElement('div');
        d.style.color = color || '#94a3b8';
        d.textContent = text;
        logBody.appendChild(d);
        logBody.scrollTop = logBody.scrollHeight;
        logLines.push({ text: text, color: color || '#94a3b8' });
    }

    appendLog('\u25b6 Running: ' + testName, '#60a5fa');
    // Track token consumption for script maintenance/execution
    tokenOnScriptMaintenance('');

    try {
        const res = await fetch(SERVER + '/api/run-test-simple', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ file, testName }),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        if (!res.body) throw new Error('Empty response body');

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '', doneData = null;

        function processSSEPart(part) {
            if (!part.trim()) return;
            const dl = part.split('\n').find(function(l){ return l.startsWith('data:'); });
            if (!dl) return;
            try {
                const msg = JSON.parse(dl.slice(5).trim());
                if (msg.type === 'log') {
                    const t = (typeof msg.data === 'string') ? msg.data.replace(/\r?\n/g,' ').trim() : '';
                    if (t) {
                        const c = /passed|\u2713|\u2714|ok\s/.test(t) ? '#10b981' : /failed|\u2717|\u2718|error/i.test(t) ? '#f87171' : '#94a3b8';
                        appendLog(t, c);
                    }
                } else if (msg.type === 'error') {
                    appendLog('\u274c ' + msg.data, '#f87171');
                } else if (msg.type === 'done') {
                    doneData = msg.data;
                }
            } catch(e) { /* ignore parse errors */ }
        }

        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            for (const p of parts) processSSEPart(p);
        }
        // CRITICAL: process remaining buffer (contains the 'done' event)
        if (buffer.trim()) processSSEPart(buffer);

        const ok = doneData && doneData.exitCode === 0;

        // Prepend completion status at the top of the log (keep existing log lines)
        const completeLine = document.createElement('div');
        completeLine.style.color = ok ? '#10b981' : '#f87171';
        completeLine.style.fontWeight = '600';
        completeLine.textContent = ok ? '✅ Run complete — Test Passed' : '❌ Run complete — Test Failed';
        logBody.insertBefore(completeLine, logBody.firstChild);

        const reportUrl = doneData?.reportUrl ? new URL(doneData.reportUrl, SERVER).href : '';

        // Update status header with result
        if (ok) {
            btn.textContent = '\u2705 Passed';
            btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
            btn.style.color = 'white';
            logStatus.textContent = '\u2705 Run Passed';
            logStatus.style.color = '#10b981';
            logBody.style.display = 'none';
            logArrow.textContent = '\u25b6';
        } else {
            btn.textContent = '\u274c Failed';
            btn.style.background = 'linear-gradient(135deg, #f87171, #ef4444)';
            btn.style.color = 'white';
            logStatus.textContent = '\u274c Run Failed — Auto-healing…';
            logStatus.style.color = '#f59e0b';

            // ── AUTO SELF-HEAL: analyze failure and attempt fix ──
            appendLog('', '');
            appendLog('🔧 Self-healing: Analyzing failure…', '#f59e0b');
            try {
                const healRes = await fetch(SERVER + '/api/self-heal', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        file: file,
                        testName: testName,
                        errorOutput: logLines.map(l => l.text).join('\n')
                    })
                });
                const healData = await healRes.json();
                if (healData.fixed && healData.fixes && healData.fixes.length > 0) {
                    healData.fixes.forEach(fix => {
                        appendLog(`   📍 ${fix.type}: ${fix.message}`, '#f59e0b');
                        if (fix.suggestion) appendLog(`   💡 ${fix.suggestion}`, '#94a3b8');
                    });
                    appendLog('', '');
                    appendLog('🔧 Self-heal analysis complete. Use Kiro agent to auto-fix: "Fix the failing test and re-run"', '#60a5fa');
                } else {
                    appendLog('   ℹ️ Could not auto-identify fixable issues from error output', '#64748b');
                }
            } catch(healErr) {
                appendLog('   ⚠️ Self-heal unavailable: ' + healErr.message, '#64748b');
            }
            logStatus.textContent = '\u274c Run Failed';
            logStatus.style.color = '#f87171';
        }

        if (reportUrl) {
            const link = document.createElement('a');
            link.href = reportUrl;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.textContent = '📊 View Playwright Report';
            link.style.cssText = 'font-size:10px;color:#60a5fa;text-decoration:underline;padding:2px 8px;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);border-radius:4px;';
            logReport.replaceChildren(link);
        }

        // Persist to localStorage
        _saveExecLog(testName, {
            status: ok ? 'passed' : 'failed',
            lines: logLines,
            reportUrl: reportUrl,
            timestamp: new Date().toISOString()
        });

        // Reset button after delay (keep logs visible)
        setTimeout(function() {
            btn.textContent = '\u25b6 Run';
            btn.style.background = 'linear-gradient(135deg,#10b981,#059669)';
            btn.style.color = 'white';
            btn.disabled = false;
            btn.style.opacity = '1';
            btn.style.cursor = 'pointer';
        }, 5000);

    } catch(e) {
        btn.textContent = '\u274c Error';
        btn.style.background = 'linear-gradient(135deg, #f87171, #ef4444)';
        btn.style.color = 'white';
        logStatus.textContent = '\u274c Error: ' + e.message;
        logStatus.style.color = '#f87171';
        appendLog('\u274c Error: ' + e.message, '#f87171');
        // Persist error state
        _saveExecLog(testName, { status: 'failed', lines: logLines, reportUrl: '', timestamp: new Date().toISOString() });
        setTimeout(function() {
            btn.textContent = '\u25b6 Run';
            btn.style.background = 'linear-gradient(135deg,#10b981,#059669)';
            btn.style.color = 'white';
            btn.disabled = false;
            btn.style.opacity = '1';
            btn.style.cursor = 'pointer';
        }, 5000);
    }
}

// ── Manual Test Cases tab ─────────────────────────────────────────────────────
let mtCurrentIssue = null;      // { key, summary, description }
let mtCurrentView  = 'all';     // view filter for issue list
let mtTestCases    = null;      // { positive: [...], negative: [...], edge: [...] }
let mtSelectedIds  = new Set(); // IDs of currently checked test cases

/** Load tickets into sidebar — routes to ADO or Jira based on JIRA_CONFIG.toolType */
async function loadMtTickets() {
    const listEl   = document.getElementById('mtTicketList');
    const toolSel  = document.getElementById('mtToolSelect');
    const toolType = (toolSel && toolSel.value) || JIRA_CONFIG.toolType || '';

    // LocalHost — show uploaded files instead of remote work items
    if (toolType === 'LocalHost') {
        listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#334155;text-align:center;">Loading files…</div>';
        try {
            const res  = await fetch(`${SERVER}/api/requirements/tree`);
            const data = await res.json();
            const files = (data.tree || []).flatMap(n =>
                n.type === 'file' ? [n] : (n.children || []).filter(c => c.type === 'file').map(c => ({ ...c, path: `${n.name}/${c.name}` }))
            );
            if (!files.length) {
                listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#475569;text-align:center;">No files uploaded yet.</div>';
                return;
            }
            listEl.innerHTML = '';
            for (const f of files) {
                const fp = f.path || f.name;
                const el = document.createElement('div');
                el.className = 'testdesign-ticket';
                el.innerHTML = `<div class="testdesign-ticket-key" style="font-size:10px;">📄 ${escHtml(f.name)}</div>
                    <div class="testdesign-ticket-summary" style="font-size:10px;color:#475569;">${escHtml(fp)}</div>`;
                el.onclick = async () => {
                    document.querySelectorAll('#mtTicketList .testdesign-ticket').forEach(e => e.classList.remove('active'));
                    el.classList.add('active');
                    const r = await fetch(`${SERVER}/api/requirements/content?file=${encodeURIComponent(fp)}`);
                    const d = await r.json();
                    const content = d.content || '';
                    const summary = f.name.replace(/\.[^.]+$/, '');

                    // Update sidebar hint
                    const mtHint = document.getElementById('mtSidebarHint');
                    if (mtHint) { mtHint.innerHTML = `<span style="color:#60a5fa;font-weight:600;">${escHtml(f.name)}</span> <span style="color:#475569;">selected</span>`; }

                    // Show panel — same structure as mtSelectTicket
                    document.getElementById('mtEmpty').style.display = 'none';
                    const panel = document.getElementById('mtPanel');
                    if (panel) { panel.style.display = 'flex'; panel.style.flexDirection = 'column'; }

                    // Populate fields
                    document.getElementById('mtIssueKey').textContent     = f.name;
                    document.getElementById('mtIssueSummary').textContent = summary;
                    document.getElementById('mtIssueMeta').innerHTML      = `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Source:</span> Local file</span>`;
                    document.getElementById('mtDescription').textContent  = content || 'No text content available.';
                    document.getElementById('mtResults').style.display    = 'none';
                    document.getElementById('mtLoading').style.display    = 'none';
                    document.getElementById('mtError').style.display      = 'none';

                    // Re-expand description section
                    const descBox    = document.getElementById('mtDescriptionBox');
                    const descToggle = document.getElementById('mtDescToggle');
                    if (descBox)    descBox.style.display    = 'block';
                    if (descToggle) descToggle.textContent   = '▾';

                    const srcBadge = document.getElementById('mtSourceBadge');
                    if (srcBadge) { srcBadge.style.display = 'inline-flex'; srcBadge.textContent = '📄 Local File'; }

                    mtTestCases   = null;
                    mtCurrentIssue = { key: f.name, summary, description: content };
                    document.getElementById('mtGenerateBtn').disabled = false;
                    mtSelectedIds.clear();
                    mtUpdateSaveBtn();
                };
                listEl.appendChild(el);
            }
        } catch(e) {
            listEl.innerHTML = `<div style="padding:16px;font-size:12px;color:#f87171;text-align:center;">${escHtml(e.message)}</div>`;
        }
        return;
    }

    if (!toolType) {
        listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#334155;text-align:center;">Select a tool above to load work items.</div>';
        return;
    }

    listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#334155;text-align:center;">Loading…</div>';
    try {
        const isADO   = toolType === 'ADO';
        const project = JIRA_CONFIG.project || '';
        const url     = isADO
            ? `${SERVER}/api/ado/board?view=${mtCurrentView}`
            : `${SERVER}/api/jira/board?project=${project}&view=${mtCurrentView}`;
        const res  = await fetch(url);
        if (!res.ok) throw new Error('Board unavailable');
        const data = await res.json();
        const issues = (data.columns || []).flatMap(c => c.issues || []);
        if (!issues.length) {
            listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#475569;text-align:center;">No work items found.</div>';
            return;
        }
        listEl.innerHTML = '';
        for (const issue of issues) {
            const el = document.createElement('div');
            el.className = 'testdesign-ticket';
            el.id = 'mt-ticket-' + issue.key;
            el.innerHTML = `
                <div class="testdesign-ticket-key">${escHtml(issue.key)}</div>
                <div class="testdesign-ticket-summary">${escHtml(issue.summary)}</div>
                <div class="testdesign-ticket-meta">
                    <span>${escHtml(issue.status || '')}</span>
                    ${issue.priority ? `<span class="jira-priority ${priorityClass(issue.priority)}" style="font-size:9px;">${escHtml(issue.priority)}</span>` : ''}
                    ${issue.issueType ? `<span style="font-size:9px;color:#64748b;">${escHtml(issue.issueType)}</span>` : ''}
                </div>`;
            el.onclick = () => mtSelectTicket(issue.key);
            listEl.appendChild(el);
        }
    } catch(e) {
        listEl.innerHTML = `<div style="padding:16px;font-size:12px;color:#f87171;text-align:center;">Could not load work items.<br><small>${escHtml(e.message)}</small></div>`;
    }
}

/** Change view filter and reload */
function mtChangeView(view) {
    mtCurrentView = view;
    loadMtTickets();
}

async function mtOnToolChange(toolType) {
    const projectWrap = document.getElementById('mtProjectViewWrap');
    if (projectWrap) projectWrap.style.display = (toolType === 'LocalHost' || !toolType) ? 'none' : 'block';
    updateViewSelectOptions('mtViewSelect', toolType);
    if (toolType && toolType !== 'LocalHost') {
        await onToolSourceChange(toolType);
    }
    loadMtTickets();
}

/** Select a ticket and fetch its details */
async function mtSelectTicket(key) {
    // Highlight sidebar
    document.querySelectorAll('#mtTicketList .testdesign-ticket').forEach(el => el.classList.remove('active'));
    const item = document.getElementById('mt-ticket-' + key);
    if (item) item.classList.add('active');
    // Update sidebar hint to show selected item key
    const mtHint = document.getElementById('mtSidebarHint');
    if (mtHint) { mtHint.innerHTML = `<span style="color:#60a5fa;font-weight:600;">${escHtml(key)}</span> <span style="color:#475569;">selected</span>`; }
    // Show panel
    document.getElementById('mtEmpty').style.display = 'none';
    const panel = document.getElementById('mtPanel');
    panel.style.display = 'flex';
    // Reset state
    document.getElementById('mtIssueKey').textContent = key;
    document.getElementById('mtIssueSummary').textContent = 'Loading…';
    document.getElementById('mtIssueMeta').innerHTML = '';
    document.getElementById('mtDescription').textContent = 'Loading…';
    document.getElementById('mtResults').style.display = 'none';
    document.getElementById('mtLoading').style.display = 'none';
    document.getElementById('mtError').style.display = 'none';
    document.getElementById('mtSourceBadge').style.display = 'none';
    document.getElementById('mtGenerateBtn').disabled = true;
    // Re-expand AC section for new ticket
    const descBox = document.getElementById('mtDescriptionBox');
    const descToggle = document.getElementById('mtDescToggle');
    if (descBox) descBox.style.display = 'block';
    if (descToggle) descToggle.textContent = '▾';
    mtTestCases = null;
    try {
        const isADO = JIRA_CONFIG.toolType === 'ADO';
        const issueUrl = isADO
            ? `${SERVER}/api/ado/issue/${encodeURIComponent(key)}`
            : `${SERVER}/api/jira/issue/${encodeURIComponent(key)}`;
        const res = await fetch(issueUrl);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load issue');
        mtCurrentIssue = { key: data.key, summary: data.summary || key, description: data.description || '' };
        document.getElementById('mtIssueKey').textContent = data.key;
        document.getElementById('mtIssueSummary').textContent = data.summary || key;
        const pc = priorityClass(data.priority);
        document.getElementById('mtIssueMeta').innerHTML = `
            ${data.issueType ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Type:</span> ${escHtml(data.issueType)}</span>` : ''}
            ${data.status    ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Status:</span> ${escHtml(data.status)}</span>` : ''}
            ${data.priority  ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Priority:</span> <span class="jira-priority ${pc}">${escHtml(data.priority)}</span></span>` : ''}
            ${data.assignee  ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Assignee:</span> ${escHtml(data.assignee)}</span>` : ''}
        `;
        document.getElementById('mtDescription').textContent = data.description || 'No description/acceptance criteria available.';
        document.getElementById('mtGenerateBtn').disabled = false;
        // Update hint with full key + summary
        const mtHintFull = document.getElementById('mtSidebarHint');
        if (mtHintFull) {
            const summary = data.summary || key;
            const shortSummary = summary.length > 40 ? summary.slice(0, 40) + '…' : summary;
            mtHintFull.innerHTML = `<span style="color:#60a5fa;font-weight:600;">${escHtml(data.key)}</span> <span style="color:#64748b;">${escHtml(shortSummary)}</span>`;
        }
        // Clear selections when switching issues
        mtSelectedIds.clear();
        mtUpdateSaveBtn();
        
        // NEW: Try to load saved test cases from Spec folder
        await mtLoadSavedTestCases(key);
    } catch(e) {
        document.getElementById('mtIssueSummary').textContent = '⚠ ' + e.message;
        document.getElementById('mtDescription').textContent = '–';
        // Reset hint on error
        const mtHintErr = document.getElementById('mtSidebarHint');
        if (mtHintErr) mtHintErr.textContent = 'Click a ticket from the board, or select one below to generate tests';
    }
}

/** Load saved test cases from Spec folder if available */
async function mtLoadSavedTestCases(issueKey) {
    const resultsEl = document.getElementById('mtResults');
    const srcEl = document.getElementById('mtSourceBadge');
    const errEl = document.getElementById('mtError');
    
    try {
        // Fetch ALL test cases (generated + saved) from specs for this ticket
        const res = await fetch(`${SERVER}/api/specs/all-for-ticket?issueKey=${encodeURIComponent(issueKey)}`);
        
        if (!res.ok) {
            // File doesn't exist, that's okay - user can generate new ones
            return;
        }
        
        const data = await res.json();
        if (!data.testCases || data.testCases.length === 0) return;
        
        // Convert API response to test cases format
        const testCases = convertApiTestCasesToFormat(data.testCases);
        
        if (testCases.total > 0) {
            mtTestCases = testCases;
            renderManualTestCases('saved');
            srcEl.style.display = 'none';
        }
    } catch(e) {
        // Silent fail - if file doesn't exist or can't be parsed, just don't show anything
        console.log('Could not load saved test cases:', e.message);
    }
}

/** Parse saved test cases from markdown content */
function parseSavedTestCases(content) {
    const positive = [];
    const negative = [];
    const edge = [];
    
    // Split by test case sections (## Test Case ID: ...)
    const testCaseBlocks = content.split(/(?=## Test Case ID:)/g).filter(block => block.trim());
    
    for (const block of testCaseBlocks) {
        if (!block.includes('Test Case ID:')) continue;
        
        const tc = {};
        
        // Extract Test Case ID
        const idMatch = block.match(/## Test Case ID:\s*(\S+)/);
        if (idMatch) tc.id = idMatch[1];
        
        // Extract Title
        const titleMatch = block.match(/\*\*Title:\*\*\s*(.+)/);
        if (titleMatch) tc.title = titleMatch[1].trim();
        
        // Extract Priority
        const priorityMatch = block.match(/\*\*Priority:\*\*\s*(\w+)/);
        if (priorityMatch) tc.priority = priorityMatch[1];
        
        // Extract Test Type to categorize
        const typeMatch = block.match(/\*\*Test Type:\*\*\s*(.+)/);
        let testType = 'Positive';
        if (typeMatch) {
            const type = typeMatch[1].toLowerCase();
            if (type.includes('negative')) testType = 'Negative';
            else if (type.includes('edge') || type.includes('boundary')) testType = 'Edge';
        }
        tc.type = testType;
        
        // Extract Preconditions
        const precondMatch = block.match(/\*\*Preconditions:\*\*\s*([\s\S]*?)(?=\*\*Test Steps:\*\*|\*\*Expected Results?:\*\*|$)/);
        if (precondMatch) {
            tc.preconditions = precondMatch[1].trim().split('\n').map(line => line.replace(/^-\s*/, '')).join('\n');
        }
        
        // Extract Test Steps
        const stepsMatch = block.match(/\*\*Test Steps:\*\*\s*([\s\S]*?)(?=\*\*Expected Results?:\*\*|\*\*Test Data:\*\*|$)/);
        if (stepsMatch) {
            const stepsText = stepsMatch[1].trim();
            tc.steps = stepsText.split('\n')
                .map(line => line.trim())
                .filter(line => line && /^\d+\./.test(line))
                .map(line => line.replace(/^\d+\.\s*/, ''));
        }
        
        // Extract Expected Results
        const expectedMatch = block.match(/\*\*Expected Results?:\*\*\s*([\s\S]*?)(?=\*\*Test Data:\*\*|\*\*Priority:\*\*|$)/);
        if (expectedMatch) {
            tc.expectedResult = expectedMatch[1].trim().split('\n').map(line => line.replace(/^-\s*/, '')).join('\n');
        }
        
        // Categorize the test case
        if (testType === 'Negative') {
            negative.push(tc);
        } else if (testType === 'Edge') {
            edge.push(tc);
        } else {
            positive.push(tc);
        }
    }
    
    return {
        positive,
        negative,
        edge,
        total: positive.length + negative.length + edge.length
    };
}


/** Convert API test cases to internal format (positive/negative/edge categories) */
function convertApiTestCasesToFormat(apiTestCases) {
    const positive = [];
    const negative = [];
    const edge = [];
    
    for (const tc of apiTestCases) {
        const testCase = {
            id: tc.id || '',
            title: tc.title || '',
            priority: tc.priority || 'Medium',
            type: tc.type || 'Positive',
            preconditions: tc.preconditions || '',
            steps: Array.isArray(tc.steps) ? tc.steps : [],
            expectedResult: tc.expectedResult || '',
            automated: tc.automated || false
        };
        
        // Categorize by test type
        if (tc.type && tc.type.toLowerCase().includes('negative')) {
            negative.push(testCase);
        } else if (tc.type && (tc.type.toLowerCase().includes('edge') || tc.type.toLowerCase().includes('boundary'))) {
            edge.push(testCase);
        } else {
            positive.push(testCase);
        }
    }
    
    return {
        positive,
        negative,
        edge,
        total: positive.length + negative.length + edge.length
    };
}

/**
 * Build a structured test data JSON from all generated test cases and save it
 * to Test_Data/{issueKey}-test-data.json on disk, then refresh the sidebar.
 */
async function mtSaveTestDataFile(issueKey, testCases) {
    if (!testCases || !issueKey) return;
    const allCases = [
        ...(testCases.positive || []),
        ...(testCases.negative || []),
        ...(testCases.edge     || []),
    ];
    if (!allCases.length) return;

    // Build dataSets: one entry per test case that has testData
    const dataSets = allCases
        .filter(tc => tc.testData)
        .map(tc => {
            const raw = typeof tc.testData === 'string'
                ? (() => { try { return JSON.parse(tc.testData); } catch { return { raw: tc.testData }; } })()
                : tc.testData;
            return {
                label:  `${tc.id} — ${tc.title}`,
                type:   tc.type || '',
                testCaseId: tc.id,
                ...raw,
            };
        });

    const payload = {
        storyId:     issueKey,
        generatedOn: new Date().toISOString(),
        totalCases:  allCases.length,
        dataSets:    dataSets.length ? dataSets : allCases.map((tc, i) => ({
            label: `${tc.id} — ${tc.title}`,
            type:  tc.type || '',
            testCaseId: tc.id,
        })),
    };

    const filename = `${issueKey}-test-data.json`;
    try {
        const res = await fetch(`${SERVER}/api/testdata`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ file: filename, content: JSON.stringify(payload, null, 2) }),
        });
        if (res.ok) {
            // Refresh Test Data tab sidebar so the file appears there
            await loadTestData();
            // Pre-select our file in the sidebar
            const fileItems = document.querySelectorAll('.testdata-file-item');
            fileItems.forEach(el => {
                if (el.textContent.includes(filename)) el.click();
            });
        }
    } catch (_) { /* non-blocking — test data save is best-effort */ }
}

/** Generate manual test cases */
async function generateManualTestCases() {
    if (!mtCurrentIssue) return;
    const btn = document.getElementById('mtGenerateBtn');
    const loadingEl = document.getElementById('mtLoading');
    const resultsEl = document.getElementById('mtResults');
    const errEl = document.getElementById('mtError');
    const srcEl = document.getElementById('mtSourceBadge');
    btn.disabled = true;
    btn.textContent = '⏳ Generating…';
    loadingEl.style.display = 'flex';
    resultsEl.style.display = 'none';
    errEl.style.display = 'none';
    srcEl.style.display = 'none';
    try {
        const res = await fetch(`${SERVER}/api/manual-test-cases/generate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                issueKey: mtCurrentIssue.key,
                summary: mtCurrentIssue.summary,
                description: mtCurrentIssue.description,
            }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Generation failed');
        mtTestCases = data.testCases;
        renderManualTestCases(data.source);
        // Auto-save test data to Test_Data/ and refresh the Test Data tab sidebar
        await mtSaveTestDataFile(mtCurrentIssue.key, mtTestCases);

    } catch(e) {
        errEl.textContent = '❌ ' + e.message;
        errEl.style.display = 'block';
    } finally {
        loadingEl.style.display = 'none';
        btn.disabled = false;
        btn.textContent = '🧪 Generate Test Cases';
    }
}

/** Render test cases */
function renderManualTestCases(source) {
    const resultsEl = document.getElementById('mtResults');
    const srcEl = document.getElementById('mtSourceBadge');
    if (!mtTestCases) { resultsEl.style.display = 'none'; return; }
    const total = (mtTestCases.positive?.length || 0) + (mtTestCases.negative?.length || 0) + (mtTestCases.edge?.length || 0);
    if (total === 0) { resultsEl.style.display = 'none'; return; }
    
    // Auto-collapse the AC section
    const descBox = document.getElementById('mtDescriptionBox');
    const descToggle = document.getElementById('mtDescToggle');
    if (descBox) descBox.style.display = 'none';
    if (descToggle) descToggle.textContent = '▸';

    // Reset selections on fresh render
    mtSelectedIds.clear();
    mtUpdateSaveBtn();
    mtUpdateSelectAll();
    
    document.getElementById('mtTotalBadge').textContent = total + ' total';
    document.getElementById('mtPosBadge').textContent  = '✅ ' + (mtTestCases.positive?.length || 0) + ' Positive';
    document.getElementById('mtNegBadge').textContent  = '❌ ' + (mtTestCases.negative?.length || 0) + ' Negative';
    document.getElementById('mtEdgeBadge').textContent = '⚡ ' + (mtTestCases.edge?.length    || 0) + ' Edge';
    document.getElementById('mtPosCount').textContent  = mtTestCases.positive?.length || 0;
    document.getElementById('mtNegCount').textContent  = mtTestCases.negative?.length || 0;
    document.getElementById('mtEdgeCount').textContent = mtTestCases.edge?.length    || 0;
    if (source === 'ai') {
        srcEl.innerHTML = '<span style="font-size:11px;background:rgba(16,185,129,0.1);color:#10b981;border:1px solid rgba(16,185,129,0.25);padding:4px 10px;border-radius:10px;font-weight:600;">✨ AI-powered generation</span>';
        srcEl.style.display = 'block';
    } else if (source === 'fallback') {
        srcEl.innerHTML = '<span style="font-size:11px;background:rgba(245,158,11,0.1);color:#f59e0b;border:1px solid rgba(245,158,11,0.25);padding:4px 10px;border-radius:10px;font-weight:600;">⚡ Rule-based generation (set AI_PROVIDER + AI_API_KEY for AI)</span>';
        srcEl.style.display = 'block';
    } else if (source === 'saved') {
        srcEl.style.display = 'none';
    }
    document.getElementById('mtSectionPosBody').innerHTML  = renderTestCaseList(mtTestCases.positive  || [], 'Positive');
    document.getElementById('mtSectionNegBody').innerHTML  = renderTestCaseList(mtTestCases.negative  || [], 'Negative');
    document.getElementById('mtSectionEdgeBody').innerHTML = renderTestCaseList(mtTestCases.edge     || [], 'Edge');
    document.getElementById('mtSectionPos').style.display  = (mtTestCases.positive?.length || 0) > 0 ? 'block' : 'none';
    document.getElementById('mtSectionNeg').style.display  = (mtTestCases.negative?.length || 0) > 0 ? 'block' : 'none';
    document.getElementById('mtSectionEdge').style.display = (mtTestCases.edge?.length    || 0) > 0 ? 'block' : 'none';
    resultsEl.style.display = 'flex';
    
    // Populate Test Data tab with all test case data
    mtPopulateTestDataTab(mtTestCases);
}

/** Registry of rendered test cases — keyed by tc.id — for onclick access */
const _mtRegistry = {};

/** Render a list of test case cards */
function renderTestCaseList(cases, type) {
    if (!cases.length) return '';
    const badgeClass = type === 'Positive' ? 'mt-badge-pos' : type === 'Negative' ? 'mt-badge-neg' : 'mt-badge-edge';
    const priorityClass = { High: 'mt-badge-high', Medium: 'mt-badge-medium', Low: 'mt-badge-low' };
    
    // Helper function to format expected results with numbering
    const formatExpectedResults = (resultText) => {
        if (!resultText) return '';
        // Split by line breaks and bullet points
        const lines = resultText.split(/\n|(?:^|\s)[-•]\s/).filter(l => l.trim());
        if (lines.length > 1) {
            return lines.map((l, i) => `<li><span class="mt-step-num">${i + 1}.</span><span>${escHtml(l.trim())}</span></li>`).join('');
        }
        return escHtml(resultText);
    };
    
    return cases.map(tc => {
        // Store in registry so onclick can retrieve full object safely
        _mtRegistry[tc.id] = tc;
        const expanded = true;
        const bodyId   = 'mt-body-'  + tc.id.replace(/[^a-z0-9]/gi, '');
        const arrowId  = 'mt-arrow-' + tc.id.replace(/[^a-z0-9]/gi, '');
        const cbId     = 'mt-cb-'    + tc.id.replace(/[^a-z0-9]/gi, '');
        const cardId   = 'mt-card-'  + tc.id.replace(/[^a-z0-9]/gi, '');
        const viewId   = 'mt-view-'  + tc.id.replace(/[^a-z0-9]/gi, '');
        const editId   = 'mt-edit-'  + tc.id.replace(/[^a-z0-9]/gi, '');
        const isChecked = mtSelectedIds.has(tc.id);
        const stepsHtml = (() => {
            // If stepsWithResults is available, render rows for mt-steps-table
            if (tc.stepsWithResults && tc.stepsWithResults.length > 0) {
                return tc.stepsWithResults.map((s, i) =>
                    `<tr><td style="text-align:center;padding:8px 6px;"><span class="mt-step-num-badge">${i + 1}</span></td><td style="padding:9px 10px;">${escHtml(s.action)}</td><td class="mt-expected-cell" style="padding:9px 10px;">${escHtml(s.result)}</td></tr>`
                ).join('');
            }
            // Fallback: plain steps as rows
            return (tc.steps || []).map((s, i) => {
                const cleanStep = (typeof s === 'string' ? s : '').replace(/^Step \d+:\s*/i, '');
                return `<tr><td style="text-align:center;padding:8px 6px;"><span class="mt-step-num-badge">${i + 1}</span></td><td style="padding:9px 10px;">${escHtml(cleanStep)}</td><td class="mt-expected-cell" style="padding:9px 10px;">Expected behavior is observed</td></tr>`;
            }).join('');
        })();
        const stepsIsTable = true;
        return `
            <div class="mt-card${isChecked ? ' mt-card-checked' : ''}" id="${cardId}">
                <div class="mt-card-header" onclick="mtToggleCard('${bodyId}','${arrowId}')">
                    <input type="checkbox" class="mt-checkbox" id="${cbId}" ${isChecked ? 'checked' : ''}
                        onclick="event.stopPropagation();mtToggleCheckbox('${escHtml(tc.id)}','${cbId}','${cardId}')"
                        aria-label="Select test case ${escHtml(tc.id)}" />
                    <span class="mt-card-id">${escHtml(tc.id)}</span>
                    <span class="mt-card-title">${escHtml(tc.title)}</span>
                    <span class="mt-badge ${badgeClass}">${type}</span>
                    ${tc.priority ? `<span class="mt-badge ${priorityClass[tc.priority] || ''}">${escHtml(tc.priority)}</span>` : ''}
                    <button class="mt-edit-btn" onclick="event.stopPropagation();mtEnterEditMode('${escHtml(tc.id)}','${editId}','${viewId}')">✏️ Edit</button>
                    <button class="mt-delete-btn" onclick="event.stopPropagation();deleteManualTestCase('${escHtml(tc.id)}')">✕ Delete</button>
                    <span id="${arrowId}" style="margin-left:4px;color:#475569;font-size:11px;">${expanded ? '▾' : '▸'}</span>
                </div>
                <div id="${bodyId}" class="mt-card-body" style="display:${expanded ? 'flex' : 'none'};flex-direction:column;gap:12px;">
                    <!-- View Mode -->
                    <div id="${viewId}" style="display:flex;flex-direction:column;gap:12px;width:100%;">
                        ${(tc.component || tc.automationPriority) ? `<div class="mt-meta-row">${tc.component ? `<span class="mt-meta-pill mt-meta-component"><span class="mt-meta-pill-label">Component</span> ${escHtml(tc.component)}</span>` : ''}${tc.automationPriority ? `<span class="mt-meta-pill mt-meta-autoprio"><span class="mt-meta-pill-label">Automation Priority</span> ${escHtml(tc.automationPriority)}</span>` : ''}</div>` : ''}
                        ${tc.preconditions ? `<div><div class="mt-field-label">Preconditions</div><div class="mt-field-box">${escHtml(tc.preconditions).replace(/\n/g, '<br>')}</div></div>` : ''}
                        ${stepsHtml ? `<div><div class="mt-field-label">Test Steps</div><div style="overflow-x:auto;border-radius:6px;overflow:hidden;border:1px solid #1a2f4a;"><table class="mt-steps-table"><thead><tr><th>Step</th><th>Action</th><th>Expected Result</th></tr></thead><tbody>${stepsIsTable ? stepsHtml : (tc.steps || []).map((s,i)=>`<tr><td style="text-align:center;padding:8px 6px;"><span class="mt-step-num-badge">${i+1}</span></td><td style="padding:9px 10px;">${escHtml((typeof s==='string'?s:'').replace(/^Step \d+:\s*/i,''))}</td><td class="mt-expected-cell" style="padding:9px 10px;">Expected behavior is observed</td></tr>`).join('')}</tbody></table></div></div>` : ''}
                    </div>
                    <!-- Edit Mode (hidden by default) -->
                    <div id="${editId}" style="display:none;flex-direction:column;gap:12px;width:100%;">
                        <div>
                            <div class="mt-field-label">Preconditions</div>
                            <textarea class="mt-edit-textarea" id="mt-precond-${tc.id.replace(/[^a-z0-9]/gi, '')}" style="width:100%;min-height:60px;padding:8px;background:#0a1628;border:1px solid #2a3f5a;border-radius:4px;color:#e0e0e0;font-size:11px;font-family:monospace;box-sizing:border-box;resize:vertical;">${escHtml(tc.preconditions || '')}</textarea>
                        </div>
                        <div>
                            <div class="mt-field-label" style="margin-bottom:6px;">Test Steps</div>
                            <div style="overflow-x:auto;border:1px solid #2a3f5a;border-radius:6px;background:#0a1628;">
                                <table id="mt-steps-table-${tc.id.replace(/[^a-z0-9]/gi, '')}" style="width:100%;border-collapse:collapse;font-size:11px;">
                                    <thead>
                                        <tr style="border-bottom:1px solid #1a2f4a;">
                                            <th style="padding:6px 8px;color:#64748b;font-weight:600;width:28px;text-align:left;">#</th>
                                            <th style="padding:6px 8px;color:#64748b;font-weight:600;width:48%;text-align:left;">Action</th>
                                            <th style="padding:6px 8px;color:#10b981;font-weight:600;text-align:left;">Expected Result</th>
                                            <th style="padding:6px 8px;width:28px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="mt-steps-tbody-${tc.id.replace(/[^a-z0-9]/gi, '')}">
                                        ${(() => {
                                            const stepsData = (tc.stepsWithResults && tc.stepsWithResults.length > 0)
                                                ? tc.stepsWithResults
                                                : (tc.steps || []).map(s => ({ action: s, result: '' }));
                                            return stepsData.map((s, i) => `
                                                <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
                                                    <td style="padding:4px 8px;color:#38bdf8;font-weight:600;vertical-align:top;">${i + 1}</td>
                                                    <td style="padding:4px 8px;vertical-align:top;"><div contenteditable="true" data-col="action" style="min-height:32px;padding:4px 6px;background:#0f2540;border:1px solid #1a3a5c;border-radius:3px;color:#e0e0e0;font-size:11px;line-height:1.5;outline:none;word-break:break-word;" onfocus="this.style.borderColor='#38bdf8'" onblur="this.style.borderColor='#1a3a5c'">${escHtml(s.action || '')}</div></td>
                                                    <td style="padding:4px 8px;vertical-align:top;"><div contenteditable="true" data-col="result" style="min-height:32px;padding:4px 6px;background:#0f2540;border:1px solid #1a3a5c;border-radius:3px;color:#6ee7b7;font-size:11px;line-height:1.5;outline:none;word-break:break-word;" onfocus="this.style.borderColor='#10b981'" onblur="this.style.borderColor='#1a3a5c'">${escHtml(s.result || '')}</div></td>
                                                    <td style="padding:4px 8px;vertical-align:top;text-align:center;"><button onclick="mtDeleteStepRow(this)" style="background:none;border:none;color:#475569;cursor:pointer;font-size:13px;padding:2px 4px;border-radius:3px;" onmouseover="this.style.color='#f87171'" onmouseout="this.style.color='#475569'" title="Delete row">✕</button></td>
                                                </tr>`).join('');
                                        })()}
                                    </tbody>
                                </table>
                            </div>
                            <button onclick="mtAddStepRow('${tc.id.replace(/[^a-z0-9]/gi, '')}')" style="margin-top:6px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#10b981;padding:4px 12px;border-radius:4px;font-size:11px;font-weight:600;cursor:pointer;">+ Add Row</button>
                        </div>
                        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px;">
                            <button onclick="event.stopPropagation();mtCancelEdit('${editId}','${viewId}')" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:6px 14px;border-radius:4px;font-size:11px;font-weight:600;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.borderColor='#f87171';this.style.color='#f87171'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">✕ Cancel</button>
                            <button onclick="event.stopPropagation();mtSaveChanges('${escHtml(tc.id)}','${editId}','${viewId}')" style="background:linear-gradient(135deg,#10b981,#059669);border:none;color:white;padding:6px 18px;border-radius:4px;font-size:11px;font-weight:600;cursor:pointer;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">💾 Save</button>
                        </div>
                    </div>
                </div>
            </div>`;
    }).join('');
}

/**
 * Navigate to Test Design tab and pre-load it with a manual test case.
 * The user can then click "Generate Test Script" to produce a Playwright spec.
 */
function openTestCaseInDesign(tcId) {
    const tc = _mtRegistry[tcId];
    if (!tc || !mtCurrentIssue) return;

    // Switch to Test Design tab
    switchToTab('testdesign');
    document.getElementById('jiraTabBtn')?.classList.remove('active');
    document.getElementById('jiraDropdownToggle')?.classList.remove('active');

    // Build a criteria string from the test case details
    const stepsText = (tc.steps || [])
        .map((s, i) => `${i + 1}. ${(typeof s === 'string' ? s : '').replace(/^Step \d+:\s*/i, '')}`)
        .join('\n');
    const criteriaText =
        `Test Case: ${tc.id} — ${tc.title}\n` +
        `Type: ${tc.type || ''}  |  Priority: ${tc.priority || ''}\n\n` +
        (tc.preconditions ? `Preconditions:\n${tc.preconditions}\n\n` : '') +
        (stepsText ? `Steps:\n${stepsText}\n\n` : '') +
        (tc.expectedResult ? `Expected Result:\n${tc.expectedResult}` : '');

    // Populate tdCurrentIssue so generateTests() sends the right issueKey
    tdCurrentIssue = {
        key        : mtCurrentIssue.key,
        summary    : `${mtCurrentIssue.summary} — ${tc.id}: ${tc.title}`,
        description: criteriaText,
        criteria   : criteriaText,
        priority   : tc.priority || '',
        status     : '',
        issueType  : tc.type || '',
        assignee   : null,
        // Extra metadata for the generation endpoint
        _manualTc  : {
            id            : tc.id,
            title         : tc.title,
            type          : tc.type,
            steps         : tc.steps || [],
            expectedResult: tc.expectedResult || '',
            preconditions : tc.preconditions  || '',
        },
    };

    // Show the panel
    document.getElementById('tdEmpty').style.display = 'none';
    document.getElementById('tdPanel').style.display = 'flex';
    document.getElementById('tdPanel').style.flexDirection = 'column';

    // Banner showing this was loaded from Manual Test Cases
    let bannerEl = document.getElementById('tdFromManualBanner');
    if (!bannerEl) {
        bannerEl = document.createElement('div');
        bannerEl.id = 'tdFromManualBanner';
        bannerEl.className = 'td-from-manual-banner';
        const panel = document.getElementById('tdPanel');
        panel.insertBefore(bannerEl, panel.firstChild);
    }
    bannerEl.style.display = 'flex';
    bannerEl.innerHTML = `
        <span class="td-from-manual-badge">📋 From Test Cases</span>
        <span style="color:#94a3b8;">Loaded <strong style="color:#e0e0e0;">${escHtml(tc.id)}</strong> from ticket <strong style="color:#60a5fa;">${escHtml(mtCurrentIssue.key)}</strong></span>
        <button onclick="document.getElementById('tdFromManualBanner').style.display='none'" style="margin-left:auto;background:none;border:none;color:#475569;cursor:pointer;font-size:14px;line-height:1;">✕</button>
    `;

    // Populate fields
    document.getElementById('tdIssueKey').textContent = `${mtCurrentIssue.key} › ${tc.id}`;
    document.getElementById('tdIssueSummary').textContent = tc.title;
    document.getElementById('tdTicketIdDisplay').textContent = `${mtCurrentIssue.key} / ${tc.id}`;

    const pc = priorityClass(tc.priority);
    document.getElementById('tdIssueMeta').innerHTML = `
        <span class="testdesign-meta-item"><span class="testdesign-meta-label">Ticket:</span> <span style="color:#60a5fa;font-weight:700;">${escHtml(mtCurrentIssue.key)}</span></span>
        ${tc.type     ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Type:</span> ${escHtml(tc.type)}</span>` : ''}
        ${tc.priority ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Priority:</span> <span class="jira-priority ${pc}">${escHtml(tc.priority)}</span></span>` : ''}
    `;

    document.getElementById('tdDescription').textContent = tc.preconditions
        ? `Preconditions: ${tc.preconditions}`
        : 'No preconditions specified.';
    document.getElementById('tdCriteria').textContent = criteriaText;

    // Reset generation state
    // tdResult always visible
    const _fc1 = document.getElementById('tdFileCard'); if (_fc1) _fc1.style.display = 'none';
    document.getElementById('tdGenLog').innerHTML       = '';
    document.getElementById('tdResultStatus').textContent = '';
    document.getElementById('tdGenerateBtn').disabled   = false;
    document.getElementById('tdGenerateBtn').textContent = '⚡ Generate Test Script';

    // Ensure the sidebar shows this ticket highlighted
    document.querySelectorAll('.testdesign-ticket').forEach(el => el.classList.remove('active'));
    const tdTicketEl = document.getElementById('td-ticket-' + mtCurrentIssue.key);
    if (tdTicketEl) tdTicketEl.classList.add('active');

    // Auto-trigger generation
    setTimeout(() => generateTests(), 150);
}

/** Populate Test Data tab with JSON test data from all test cases */
function mtPopulateTestDataTab(testCases) {
    const testdataView = document.getElementById('testdataView');
    if (!testdataView) return;
    
    if (!testCases || (!testCases.positive?.length && !testCases.negative?.length && !testCases.edge?.length)) {
        testdataView.innerHTML = '<div style="color:#475569;font-size:13px;padding:20px;">No test data available. Generate test cases first.</div>';
        return;
    }
    
    let html = '<div style="display:flex;flex-direction:column;gap:16px;padding:16px;">';
    
    // Helper to add test cases by type
    const addTestDataGroup = (cases, typeLabel, typeEmoji, typeColor) => {
        if (!cases || cases.length === 0) return;
        html += `<div>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;font-weight:600;color:${typeColor};">
                <span style="font-size:16px;">${typeEmoji}</span>
                <span>${typeLabel}</span>
            </div>`;
        
        cases.forEach((tc, idx) => {
            if (!tc.testData) return;
            const tcData = typeof tc.testData === 'string' ? (() => {
                try { return JSON.parse(tc.testData); } catch { return tc.testData; }
            })() : tc.testData;
            
            html += `<div style="background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:12px;margin-bottom:12px;">
                <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
                    <span style="font-weight:600;color:#38bdf8;font-size:12px;">${escHtml(tc.id)}</span>
                    <span style="color:#94a3b8;font-size:11px;">${escHtml(tc.title)}</span>
                </div>
                <pre style="background:#0a1628;border:1px solid #2a3f5a;border-radius:4px;padding:8px;font-size:10px;color:#93c5fd;overflow-x:auto;white-space:pre-wrap;word-break:break-word;margin:0;font-family:'Courier New',monospace;">${escHtml(typeof tcData === 'string' ? tcData : JSON.stringify(tcData, null, 2))}</pre>
            </div>`;
        });
        
        html += '</div>';
    };
    
    // Add all test data by type
    addTestDataGroup(testCases.positive, 'Positive Test Cases', '✅', '#10b981');
    addTestDataGroup(testCases.negative, 'Negative Test Cases', '❌', '#f87171');
    addTestDataGroup(testCases.edge, 'Edge Cases', '⚡', '#a78bfa');
    
    html += '</div>';
    testdataView.innerHTML = html;
}

/** Add a blank row to the editable steps table */
function mtAddStepRow(safe) {
    const tbody = document.getElementById('mt-steps-tbody-' + safe);
    if (!tbody) return;
    const rowCount = tbody.querySelectorAll('tr').length + 1;
    const tr = document.createElement('tr');
    tr.style.cssText = 'border-bottom:1px solid rgba(255,255,255,0.04);';
    tr.innerHTML = `
        <td style="padding:4px 8px;color:#38bdf8;font-weight:600;vertical-align:top;">${rowCount}</td>
        <td style="padding:4px 8px;vertical-align:top;"><div contenteditable="true" data-col="action" style="min-height:32px;padding:4px 6px;background:#0f2540;border:1px solid #1a3a5c;border-radius:3px;color:#e0e0e0;font-size:11px;line-height:1.5;outline:none;word-break:break-word;" onfocus="this.style.borderColor='#38bdf8'" onblur="this.style.borderColor='#1a3a5c'"></div></td>
        <td style="padding:4px 8px;vertical-align:top;"><div contenteditable="true" data-col="result" style="min-height:32px;padding:4px 6px;background:#0f2540;border:1px solid #1a3a5c;border-radius:3px;color:#6ee7b7;font-size:11px;line-height:1.5;outline:none;word-break:break-word;" onfocus="this.style.borderColor='#10b981'" onblur="this.style.borderColor='#1a3a5c'"></div></td>
        <td style="padding:4px 8px;vertical-align:top;text-align:center;"><button onclick="mtDeleteStepRow(this)" style="background:none;border:none;color:#475569;cursor:pointer;font-size:13px;padding:2px 4px;border-radius:3px;" onmouseover="this.style.color='#f87171'" onmouseout="this.style.color='#475569'" title="Delete row">✕</button></td>
    `;
    tbody.appendChild(tr);
    // Renumber all rows
    mtRenumberStepRows(tbody);
    // Focus the new action cell
    tr.querySelector('[data-col="action"]')?.focus();
}

/** Delete a row from the editable steps table and renumber */
function mtDeleteStepRow(btn) {
    const tr = btn.closest('tr');
    const tbody = tr?.parentElement;
    if (!tbody || tbody.querySelectorAll('tr').length <= 1) return; // keep at least 1 row
    tr.remove();
    mtRenumberStepRows(tbody);
}

/** Renumber the # column in the editable steps table */
function mtRenumberStepRows(tbody) {
    tbody.querySelectorAll('tr').forEach((row, i) => {
        const numCell = row.querySelector('td:first-child');
        if (numCell) numCell.textContent = i + 1;
    });
}

/** Toggle test case card body */
function mtToggleCard(bodyId, arrowId) {
    const body = document.getElementById(bodyId);
    const arrow = document.getElementById(arrowId);
    if (!body || !arrow) return;
    const isOpen = body.style.display === 'flex';
    body.style.display = isOpen ? 'none' : 'flex';
    arrow.textContent = isOpen ? '▸' : '▾';
}

/** Toggle section */
function mtToggleSection(bodyId, arrowId) {
    const body = document.getElementById(bodyId);
    const arrow = document.getElementById(arrowId);
    if (!body || !arrow) return;
    const isOpen = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'flex';
    arrow.textContent = isOpen ? '▸' : '▾';
}

/** Toggle section */
function mtToggleSection(bodyId, arrowId) {
    const body = document.getElementById(bodyId);
    const arrow = document.getElementById(arrowId);
    if (!body || !arrow) return;
    const isOpen = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'flex';
    arrow.textContent = isOpen ? '▸' : '▾';
}

/** Toggle the Acceptance Criteria / Description box */
function mtToggleDescription() {
    const box = document.getElementById('mtDescriptionBox');
    const toggle = document.getElementById('mtDescToggle');
    if (!box || !toggle) return;
    const isOpen = box.style.display !== 'none';
    box.style.display = isOpen ? 'none' : 'block';
    toggle.textContent = isOpen ? '▸' : '▾';
}

/** Delete a test case */
function deleteManualTestCase(id) {
    if (!mtTestCases) return;
    mtTestCases.positive = (mtTestCases.positive || []).filter(tc => tc.id !== id);
    mtTestCases.negative = (mtTestCases.negative || []).filter(tc => tc.id !== id);
    mtTestCases.edge     = (mtTestCases.edge     || []).filter(tc => tc.id !== id);
    renderManualTestCases(null);
}

/** Enter edit mode for a test case */
function mtEnterEditMode(tcId, editViewId, displayViewId) {
    const displayView = document.getElementById(displayViewId);
    const editView = document.getElementById(editViewId);
    if (!displayView || !editView) return;
    displayView.style.display = 'none';
    editView.style.display = 'flex';
}

/** Cancel editing and return to view mode */
function mtCancelEdit(editViewId, displayViewId) {
    const editView = document.getElementById(editViewId);
    const displayView = document.getElementById(displayViewId);
    if (!editView || !displayView) return;
    editView.style.display = 'none';
    displayView.style.display = 'flex';
}

/** Save changes to a test case */
function mtSaveChanges(tcId, editViewId, displayViewId) {
    const safe = tcId.replace(/[^a-z0-9]/gi, '');
    const precondEl  = document.getElementById('mt-precond-'  + safe);
    const expectedEl = document.getElementById('mt-expected-' + safe);
    const tbody      = document.getElementById('mt-steps-tbody-' + safe);
    
    if (!precondEl || !tbody) return;
    
    // Find the test case in the current data
    const allCases = [
        ...(mtTestCases?.positive || []),
        ...(mtTestCases?.negative || []),
        ...(mtTestCases?.edge || []),
    ];
    const tc = allCases.find(c => c.id === tcId);
    if (!tc) return;
    
    // Read stepsWithResults from the editable table rows
    const parsedStepsWithResults = Array.from(tbody.querySelectorAll('tr')).map(row => {
        const actionEl = row.querySelector('[data-col="action"]');
        const resultEl = row.querySelector('[data-col="result"]');
        return {
            action: (actionEl ? actionEl.innerText.trim() : ''),
            result: (resultEl ? resultEl.innerText.trim() : '')
        };
    }).filter(s => s.action.length > 0 || s.result.length > 0);

    // Update the test case data
    tc.preconditions     = precondEl.value.trim();
    tc.stepsWithResults  = parsedStepsWithResults;
    tc.steps             = parsedStepsWithResults.map(s => s.action);
    if (expectedEl) tc.expectedResult = expectedEl.value.trim();
    
    // Update the registry
    _mtRegistry[tcId] = tc;
    
    // Re-render the display view using the 3-column table
    const displayView = document.getElementById(displayViewId);
    let stepsHtml    = '';
    let stepsIsTable = false;
    if (tc.stepsWithResults && tc.stepsWithResults.length > 0) {
        stepsIsTable = true;
        const rows = tc.stepsWithResults.map((s, i) =>
            `<tr><td style="text-align:center;padding:8px 6px;"><span class="mt-step-num-badge">${i + 1}</span></td><td style="padding:9px 10px;">${escHtml(s.action)}</td><td class="mt-expected-cell" style="padding:9px 10px;">${escHtml(s.result)}</td></tr>`
        ).join('');
        stepsHtml = rows;
    } else if (tc.steps && tc.steps.length > 0) {
        stepsIsTable = true;
        stepsHtml = tc.steps.map((s, i) => {
            const cleanStep = (typeof s === 'string' ? s : '').replace(/^Step \d+:\s*/i, '');
            return `<tr><td style="text-align:center;padding:8px 6px;"><span class="mt-step-num-badge">${i + 1}</span></td><td style="padding:9px 10px;">${escHtml(cleanStep)}</td><td class="mt-expected-cell" style="padding:9px 10px;">Expected behavior is observed</td></tr>`;
        }).join('');
    }

    displayView.innerHTML = `
        ${(tc.component || tc.automationPriority) ? `<div class="mt-meta-row">${tc.component ? `<span class="mt-meta-pill mt-meta-component"><span class="mt-meta-pill-label">Component</span> ${escHtml(tc.component)}</span>` : ''}${tc.automationPriority ? `<span class="mt-meta-pill mt-meta-autoprio"><span class="mt-meta-pill-label">Automation Priority</span> ${escHtml(tc.automationPriority)}</span>` : ''}</div>` : ''}
        ${tc.preconditions ? `<div><div class="mt-field-label">Preconditions</div><div class="mt-field-box">${escHtml(tc.preconditions).replace(/\n/g, '<br>')}</div></div>` : ''}
        ${stepsHtml ? `<div><div class="mt-field-label">Test Steps</div><div style="overflow-x:auto;border-radius:6px;overflow:hidden;border:1px solid #1a2f4a;"><table class="mt-steps-table"><thead><tr><th>Step</th><th>Action</th><th>Expected Result</th></tr></thead><tbody>${stepsHtml}</tbody></table></div></div>` : ''}
    `;
    
    // Return to view mode
    mtCancelEdit(editViewId, displayViewId);
    
    // Show success message
    mtShowToast(`✅ Test case ${escHtml(tcId)} updated`, 'success', 2000);
}

/** Clear all test cases */
function clearManualTestCases() {
    mtTestCases = null;
    mtSelectedIds.clear();
    mtUpdateSaveBtn();
    mtUpdateSelectAll();
    document.getElementById('mtResults').style.display = 'none';
    document.getElementById('mtSourceBadge').style.display = 'none';
}

// ── Checkbox / Select All / Save helpers ──────────────────────────────────────

/** Toggle a single checkbox */
function mtToggleCheckbox(id, cbId, cardId) {
    const cb = document.getElementById(cbId);
    const card = document.getElementById(cardId);
    if (cb && cb.checked) {
        mtSelectedIds.add(id);
        if (card) card.classList.add('mt-card-checked');
    } else {
        mtSelectedIds.delete(id);
        if (card) card.classList.remove('mt-card-checked');
    }
    mtUpdateSaveBtn();
    mtUpdateSelectAll();
}

/** Get all currently displayed test case IDs */
function mtAllDisplayedIds() {
    if (!mtTestCases) return [];
    return [
        ...(mtTestCases.positive || []),
        ...(mtTestCases.negative || []),
        ...(mtTestCases.edge     || []),
    ].map(tc => tc.id);
}

/** Handle Select All / Deselect All toggle */
function mtToggleSelectAll(cb) {
    const allIds = mtAllDisplayedIds();
    if (allIds.length === 0) { cb.checked = false; cb.indeterminate = false; return; }
    if (cb.checked) {
        allIds.forEach(id => mtSelectedIds.add(id));
    } else {
        allIds.forEach(id => mtSelectedIds.delete(id));
    }
    // Sync individual checkboxes and card styles
    allIds.forEach(id => {
        const safe = id.replace(/[^a-z0-9]/gi, '');
        const indCb   = document.getElementById('mt-cb-'   + safe);
        const indCard = document.getElementById('mt-card-' + safe);
        if (indCb)   indCb.checked = cb.checked;
        if (indCard) cb.checked ? indCard.classList.add('mt-card-checked') : indCard.classList.remove('mt-card-checked');
    });
    mtUpdateSaveBtn();
}

/** Sync the Select All checkbox to reflect current selection state */
function mtUpdateSelectAll() {
    const selectAllCb = document.getElementById('mtSelectAllCb');
    if (!selectAllCb) return;
    const allIds = mtAllDisplayedIds();
    if (allIds.length === 0) {
        selectAllCb.checked = false;
        selectAllCb.indeterminate = false;
        selectAllCb.disabled = true;
        return;
    }
    selectAllCb.disabled = false;
    const checkedCount = allIds.filter(id => mtSelectedIds.has(id)).length;
    if (checkedCount === 0) {
        selectAllCb.checked = false;
        selectAllCb.indeterminate = false;
    } else if (checkedCount === allIds.length) {
        selectAllCb.checked = true;
        selectAllCb.indeterminate = false;
    } else {
        selectAllCb.checked = false;
        selectAllCb.indeterminate = true;
    }
}

/** Enable / disable the Save button based on selection */
function mtUpdateSaveBtn() {
    const btn = document.getElementById('mtSaveBtn');
    if (btn) btn.disabled = mtSelectedIds.size === 0;
}

// ── Save / Load ───────────────────────────────────────────────────────────────

/** Save selected test cases to the backend */
async function saveSelectedTestCases() {
    if (!mtCurrentIssue || mtSelectedIds.size === 0) return;
    const allCases = [
        ...(mtTestCases?.positive || []),
        ...(mtTestCases?.negative || []),
        ...(mtTestCases?.edge     || []),
    ];
    const selected = allCases.filter(tc => mtSelectedIds.has(tc.id));
    const saveBtn = document.getElementById('mtSaveBtn');
    saveBtn.disabled = true;
    saveBtn.textContent = '⏳ Saving…';
    try {
        // Write directly to specs/ folder via write-spec endpoint
        const specRes = await fetch(`${SERVER}/api/manual-test-cases/write-spec`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                issueKey: mtCurrentIssue.key,
                summary:  mtCurrentIssue.summary,
                testCases: selected,
            }),
        });
        const specData = await specRes.json();
        if (!specRes.ok) throw new Error(specData.error || 'Save failed');

        mtShowToast(`✅ ${selected.length} test case(s) saved to ${specData.file}`, 'success', 5000);

        // Clear selections after successful save
        mtSelectedIds.clear();
        mtUpdateSaveBtn();
        mtUpdateSelectAll();
        document.querySelectorAll('.mt-checkbox').forEach(cb => { cb.checked = false; });
        document.querySelectorAll('.mt-card-checked').forEach(card => card.classList.remove('mt-card-checked'));

        // Reload saved test cases in Test Design tab if same ticket is open
        if (tdCurrentIssue && tdCurrentIssue.key === mtCurrentIssue.key) {
            tdLoadSavedTestCases(mtCurrentIssue.key);
        }
    } catch(e) {
        mtShowToast('❌ ' + e.message, 'error', 5000);
    } finally {
        saveBtn.textContent = '💾 Save to Specs';
        mtUpdateSaveBtn();
    }
}

/** Load saved test cases from the backend */
async function loadSavedTestCases(issueKey) {
    const section = document.getElementById('mtSavedSection');
    const list    = document.getElementById('mtSavedList');
    // Hide section by default until we have data
    if (section) section.style.display = 'none';
    try {
        const res = await fetch(`${SERVER}/api/manual-test-cases/saved?issueKey=${encodeURIComponent(issueKey)}`);
        // Guard: if response is not JSON (e.g. server not running or HTML error page), show nothing
        const contentType = res.headers.get('content-type') || '';
        if (!contentType.includes('application/json')) {
            // Server is likely not running or endpoint missing — silently hide section
            return;
        }
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Load failed');
        renderSavedTestCases(data.saved || []);
    } catch(e) {
        // Only show an error if the section is visible (i.e. had prior data)
        // Otherwise silently fail so the UI doesn't show an empty error heading
        if (section && section.style.display !== 'none' && list) {
            list.innerHTML =
                `<div style="font-size:12px;color:#f87171;padding:8px 0;">⚠ Could not load saved test cases: ${escHtml(e.message)}</div>`;
        }
    }
}

/** Render saved test cases in the Saved section */
function renderSavedTestCases(cases) {
    const section = document.getElementById('mtSavedSection');
    const list    = document.getElementById('mtSavedList');
    const countEl = document.getElementById('mtSavedCount');
    if (!section || !list) return;
    if (!cases || cases.length === 0) { section.style.display = 'none'; return; }

    countEl.textContent = cases.length + ' saved';
    section.style.display = 'block';
    document.getElementById('mtPanel').style.display = 'flex';
    document.getElementById('mtEmpty').style.display = 'none';
    // Also ensure the results wrapper is visible
    const resultsEl = document.getElementById('mtResults');
    if (resultsEl) resultsEl.style.display = 'flex';

    // Store reference for edit/delete
    window._savedCases = cases;

    list.innerHTML = cases.map((tc, idx) => {
        const safe    = 'saved-' + tc.id.replace(/[^a-z0-9]/gi, '');
        const bodyId  = 'mt-sbody-'  + safe;
        const arrowId = 'mt-sarrow-' + safe;
        const cbId    = 'mt-scb-'    + safe;
        const typeLabel = tc.type || '';
        const typeBadge = typeLabel === 'Positive' ? 'mt-badge-pos' : typeLabel === 'Negative' ? 'mt-badge-neg' : 'mt-badge-edge';
        // Render steps as 3-column table if stepsWithResults available, else plain list
        const savedStepsHtml = (() => {
            if (tc.stepsWithResults && tc.stepsWithResults.length > 0) {
                const rows = tc.stepsWithResults.map((s, i) =>
                    `<tr>
                        <td style="padding:5px 8px;color:#38bdf8;font-weight:600;vertical-align:top;white-space:nowrap;">${i + 1}</td>
                        <td style="padding:5px 8px;color:#e2e8f0;vertical-align:top;">${escHtml(s.action)}</td>
                        <td style="padding:5px 8px;color:#6ee7b7;vertical-align:top;">${escHtml(s.result)}</td>
                    </tr>`
                ).join('');
                return { html: `<table style="width:100%;border-collapse:collapse;font-size:11px;">
                    <thead>
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
                            <th style="text-align:left;padding:4px 8px;color:#64748b;font-weight:600;width:28px;">#</th>
                            <th style="text-align:left;padding:4px 8px;color:#64748b;font-weight:600;width:50%;">Action</th>
                            <th style="text-align:left;padding:4px 8px;color:#10b981;font-weight:600;">Expected Result</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>`, isTable: true };
            }
            const listHtml = (tc.steps || []).map((s, i) => {
                const cleanStep = (typeof s === 'string' ? s : '').replace(/^Step \d+:\s*/i, '');
                return `<li><span class="mt-step-num">${i + 1}.</span><span>${escHtml(cleanStep)}</span></li>`;
            }).join('');
            return { html: listHtml, isTable: false };
        })();
        _mtRegistry[tc.id] = tc;
        return `
            <div class="mt-saved-card" id="mt-saved-card-${safe}">
                <div class="mt-saved-card-header">
                    <input type="checkbox" id="${cbId}" class="mt-saved-cb" style="width:14px;height:14px;accent-color:#f59e0b;flex-shrink:0;cursor:pointer;" onclick="event.stopPropagation()">
                    <span class="mt-card-id" onclick="mtToggleCard('${bodyId}','${arrowId}')" style="cursor:pointer;">${escHtml(tc.id)}</span>
                    <span class="mt-card-title" onclick="mtToggleCard('${bodyId}','${arrowId}')" style="flex:1;font-size:13px;font-weight:600;color:#e0e0e0;cursor:pointer;">${escHtml(tc.title)}</span>
                    ${typeLabel ? `<span class="mt-badge ${typeBadge}" style="font-size:10px;">${escHtml(typeLabel)}</span>` : ''}
                    <span class="mt-saved-badge">Saved</span>
                    <button class="mt-gen-script-btn" onclick="event.stopPropagation();openTestCaseInDesign('${escHtml(tc.id)}')" title="Generate automation script">▶ Generate Script</button>
                    <button onclick="event.stopPropagation();mtEditSaved(${idx})" style="background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.3);color:#60a5fa;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;flex-shrink:0;">✏ Edit</button>
                    <button onclick="event.stopPropagation();mtDeleteSaved('${escHtml(tc.id)}')" style="background:rgba(248,113,113,0.1);border:1px solid rgba(248,113,113,0.3);color:#f87171;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;flex-shrink:0;">✕ Delete</button>
                    <span id="${arrowId}" onclick="mtToggleCard('${bodyId}','${arrowId}')" style="margin-left:4px;color:#475569;font-size:11px;cursor:pointer;">▾</span>
                </div>
                <div id="${bodyId}" class="mt-card-body" style="display:none;">
                    ${tc.preconditions ? `<div><div class="mt-field-label">Preconditions</div><div class="mt-field-box">${escHtml(tc.preconditions)}</div></div>` : ''}
                    ${savedStepsHtml.html ? `<div><div class="mt-field-label">Test Steps</div>${savedStepsHtml.isTable
                        ? `<div style="overflow-x:auto;background:rgba(0,0,0,0.2);border-radius:6px;border:1px solid rgba(255,255,255,0.06);padding:4px 0;">${savedStepsHtml.html}</div>`
                        : `<ol class="mt-steps-list">${savedStepsHtml.html}</ol>`}</div>` : ''}
                </div>
            </div>`;
    }).join('');
}

/** Delete a saved test case by id */
async function mtDeleteSaved(id) {
    if (!mtCurrentIssue) return;
    if (!confirm(`Delete saved test case "${id}"?`)) return;
    const updated = (window._savedCases || []).filter(tc => tc.id !== id);
    try {
        const res = await fetch(`${SERVER}/api/manual-test-cases/save`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ issueKey: mtCurrentIssue.key, testCases: [], mode: 'replace' }),
        });
        // Re-save all remaining
        if (updated.length > 0) {
            await fetch(`${SERVER}/api/manual-test-cases/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ issueKey: mtCurrentIssue.key, testCases: updated, mode: 'replace' }),
            });
        }
        renderSavedTestCases(updated);
        mtShowToast('🗑 Deleted ' + id, 'success', 2500);
    } catch(e) {
        mtShowToast('❌ Delete failed: ' + e.message, 'error', 4000);
    }
}

/** Clear all saved test cases for the current issue */
async function mtClearAllSaved() {
    if (!mtCurrentIssue) return;
    const count = (window._savedCases || []).length;
    if (count === 0) return;
    if (!confirm(`Clear all ${count} saved test case(s) for ${mtCurrentIssue.key}? This will remove them from memory but not from the specs/ folder.`)) return;
    try {
        await fetch(`${SERVER}/api/manual-test-cases/saved?issueKey=${encodeURIComponent(mtCurrentIssue.key)}`, {
            method: 'DELETE',
        });
        renderSavedTestCases([]);
        mtShowToast(`🗑️ Cleared ${count} saved test case(s)`, 'success', 3000);
    } catch(e) {
        mtShowToast('❌ Clear failed: ' + e.message, 'error', 4000);
    }
}

/** Open an inline edit modal for a saved test case */
function mtEditSaved(idx) {
    const tc = (window._savedCases || [])[idx];
    if (!tc) return;

    // Remove any existing modal
    const existing = document.getElementById('mtEditModal');
    if (existing) existing.remove();

    const modal = document.createElement('div');
    modal.id = 'mtEditModal';
    modal.style.cssText = 'position:fixed;inset:0;z-index:9500;background:rgba(5,14,26,0.88);display:flex;align-items:center;justify-content:center;padding:24px;';
    modal.innerHTML = `
        <div style="background:#0f1e30;border:1px solid #2a3f5a;border-radius:10px;width:100%;max-width:600px;max-height:90vh;display:flex;flex-direction:column;overflow:hidden;">
            <div style="padding:16px 20px;border-bottom:1px solid #1a2f4a;display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:13px;font-weight:700;color:white;">✏ Edit Test Case — ${escHtml(tc.id)}</span>
                <button onclick="document.getElementById('mtEditModal').remove()" style="background:none;border:none;color:#475569;cursor:pointer;font-size:16px;">✕</button>
            </div>
            <div style="padding:20px;overflow-y:auto;display:flex;flex-direction:column;gap:14px;">
                <div>
                    <label style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;">Title</label>
                    <input id="mtEdit_title" value="${escHtml(tc.title)}" style="width:100%;margin-top:5px;background:#0a1628;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:5px;font-size:13px;box-sizing:border-box;">
                </div>
                <div>
                    <label style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;">Preconditions</label>
                    <textarea id="mtEdit_pre" rows="2" style="width:100%;margin-top:5px;background:#0a1628;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:5px;font-size:12px;resize:vertical;box-sizing:border-box;">${escHtml(tc.preconditions || '')}</textarea>
                </div>
                <div>
                    <label style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;">Steps (one per line)</label>
                    <textarea id="mtEdit_steps" rows="4" style="width:100%;margin-top:5px;background:#0a1628;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:5px;font-size:12px;resize:vertical;box-sizing:border-box;">${(tc.steps||[]).join('\n')}</textarea>
                </div>
                <div>
                    <label style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;">Expected Result</label>
                    <textarea id="mtEdit_expected" rows="2" style="width:100%;margin-top:5px;background:#0a1628;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:5px;font-size:12px;resize:vertical;box-sizing:border-box;">${escHtml(tc.expectedResult || '')}</textarea>
                </div>
            </div>
            <div style="padding:14px 20px;border-top:1px solid #1a2f4a;display:flex;justify-content:flex-end;gap:10px;">
                <button onclick="document.getElementById('mtEditModal').remove()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:7px 16px;border-radius:5px;font-size:12px;cursor:pointer;">Cancel</button>
                <button onclick="mtSaveEdit(${idx})" style="background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:7px 18px;border-radius:5px;font-size:12px;font-weight:700;cursor:pointer;">💾 Save Changes</button>
            </div>
        </div>`;
    document.body.appendChild(modal);
}

/** Persist edits from the inline modal */
async function mtSaveEdit(idx) {
    const tc = (window._savedCases || [])[idx];
    if (!tc || !mtCurrentIssue) return;

    tc.title         = document.getElementById('mtEdit_title').value.trim();
    tc.preconditions = document.getElementById('mtEdit_pre').value.trim();
    tc.steps         = document.getElementById('mtEdit_steps').value.split('\n').map(s => s.trim()).filter(Boolean);
    tc.expectedResult= document.getElementById('mtEdit_expected').value.trim();
    _mtRegistry[tc.id] = tc;

    try {
        const res = await fetch(`${SERVER}/api/manual-test-cases/save`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ issueKey: mtCurrentIssue.key, testCases: window._savedCases }),
        });
        if (!res.ok) throw new Error('Save failed');
        document.getElementById('mtEditModal').remove();
        renderSavedTestCases(window._savedCases);
        mtShowToast('✅ Changes saved', 'success', 2500);
    } catch(e) {
        mtShowToast('❌ ' + e.message, 'error', 4000);
    }
}

/** Show a toast notification */
function mtShowToast(msg, type, durationMs) {
    const container = document.getElementById('mtToast');
    if (!container) return;
    const el = document.createElement('div');
    el.className = `mt-toast ${type}`;
    el.textContent = msg;
    container.appendChild(el);
    setTimeout(() => {
        el.style.animation = 'mtToastOut 0.3s ease forwards';
        setTimeout(() => { if (el.parentNode) el.parentNode.removeChild(el); }, 320);
    }, durationMs - 300);
}

// ── Test Design tab ───────────────────────────────────────────────────────────
let tdCurrentIssue = null;     // { key, summary, description, criteria, priority, status, issueType, assignee }
let tdBoardCache   = null;     // flat list of issues from the last board load
let tdCurrentView  = 'all';   // view filter for issue list

/**
 * Load all work items into the Test Design sidebar — routes to ADO or Jira.
 */
async function loadTdTickets() {
    const listEl   = document.getElementById('tdTicketList');
    const toolSel  = document.getElementById('tdToolSelect');
    const toolType = (toolSel && toolSel.value) || JIRA_CONFIG.toolType || '';

    // LocalHost — show uploaded files
    if (toolType === 'LocalHost') {
        listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#334155;text-align:center;">Loading files…</div>';
        try {
            const res  = await fetch(`${SERVER}/api/requirements/tree`);
            const data = await res.json();
            const files = (data.tree || []).flatMap(n =>
                n.type === 'file' ? [n] : (n.children || []).filter(c => c.type === 'file').map(c => ({ ...c, path: `${n.name}/${c.name}` }))
            );
            if (!files.length) {
                listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#475569;text-align:center;">No files uploaded yet.</div>';
                return;
            }
            listEl.innerHTML = '';
            for (const f of files) {
                const fp = f.path || f.name;
                const el = document.createElement('div');
                el.className = 'testdesign-ticket';
                el.innerHTML = `<div class="testdesign-ticket-key" style="font-size:10px;">📄 ${escHtml(f.name)}</div>
                    <div class="testdesign-ticket-summary" style="font-size:10px;color:#475569;">${escHtml(fp)}</div>`;
                el.onclick = async () => {
                    document.querySelectorAll('#tdTicketList .testdesign-ticket').forEach(e => e.classList.remove('active'));
                    el.classList.add('active');
                    const r = await fetch(`${SERVER}/api/requirements/content?file=${encodeURIComponent(fp)}`);
                    const d = await r.json();
                    const content = d.content || '';
                    const summary = f.name.replace(/\.[^.]+$/, '');

                    // Update sidebar hint
                    const tdHint = document.getElementById('tdSidebarHint');
                    if (tdHint) { tdHint.innerHTML = `<span style="color:#60a5fa;font-weight:600;">${escHtml(f.name)}</span> <span style="color:#475569;">selected</span>`; }

                    // Show panel — same way tdSelectTicket does it
                    document.getElementById('tdEmpty').style.display = 'none';
                    const panel = document.getElementById('tdPanel');
                    panel.style.display        = 'flex';
                    panel.style.flexDirection  = 'column';

                    // Populate fields
                    document.getElementById('tdIssueKey').textContent       = f.name;
                    document.getElementById('tdIssueSummary').textContent   = summary;
                    document.getElementById('tdTicketIdDisplay').textContent = f.name;
                    document.getElementById('tdIssueMeta').innerHTML        = `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Source:</span> Local file</span>`;
                    document.getElementById('tdDescription').textContent    = content || 'No text content available.';
                    document.getElementById('tdCriteria').textContent       = content || '–';
                    document.getElementById('tdGenerateBtn').disabled       = false;
                    const _fc2 = document.getElementById('tdFileCard'); if (_fc2) _fc2.style.display = 'none';

                    // Reset all collapsible sections to expanded (same as tdSelectTicket)
                    ['tdTicketIdBody','tdDescBody','tdCriteriaBody'].forEach(id => {
                        const el2 = document.getElementById(id); if (el2) el2.style.display = '';
                    });
                    ['tdTicketIdChevron','tdDescChevron','tdCriteriaChevron'].forEach(id => {
                        const el2 = document.getElementById(id); if (el2) el2.style.transform = 'rotate(0deg)';
                    });
                    ['tdDescSection','tdCriteriaSection'].forEach(id => {
                        const el2 = document.getElementById(id); if (el2) el2.style.display = '';
                    });

                    tdCurrentIssue = { key: f.name, summary, description: content, criteria: content, priority: '', status: '', issueType: 'Local File', assignee: null };
                    tdLoadSavedTestCases(f.name);
                };
                listEl.appendChild(el);
            }
        } catch(e) {
            listEl.innerHTML = `<div style="padding:16px;font-size:12px;color:#f87171;text-align:center;">${escHtml(e.message)}</div>`;
        }
        return;
    }

    if (!toolType) {
        listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#334155;text-align:center;">Select a tool above to load work items.</div>';
        return;
    }

    listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#334155;text-align:center;">Loading…</div>';
    try {
        const isADO   = toolType === 'ADO';
        const project = JIRA_CONFIG.project || '';
        const url     = isADO
            ? `${SERVER}/api/ado/board?view=${tdCurrentView}`
            : `${SERVER}/api/jira/board?project=${project}&view=${tdCurrentView}`;
        const res  = await fetch(url);
        if (!res.ok) throw new Error('Board unavailable');
        const data = await res.json();

        const issues = (data.columns || []).flatMap(c => c.issues || []);
        tdBoardCache = issues;

        if (!issues.length) {
            listEl.innerHTML = '<div style="padding:16px;font-size:12px;color:#475569;text-align:center;">No tickets found in project.</div>';
            return;
        }

        listEl.innerHTML = '';
        for (const issue of issues) {
            const el = document.createElement('div');
            el.className = 'testdesign-ticket';
            el.id = 'td-ticket-' + issue.key;
            el.innerHTML = `
                <div style="display:flex;align-items:flex-start;gap:6px;">
                    <span id="td-chevron-${escHtml(issue.key)}" style="font-size:10px;color:#475569;margin-top:2px;flex-shrink:0;transition:transform 0.2s;">▶</span>
                    <div style="min-width:0;flex:1;">
                        <div class="testdesign-ticket-key">${escHtml(issue.key)}</div>
                        <div class="testdesign-ticket-summary">${escHtml(issue.summary)}</div>
                        <div class="testdesign-ticket-meta">
                            <span>${escHtml(issue.status || '')}</span>
                            ${issue.priority ? `<span class="jira-priority ${priorityClass(issue.priority)}" style="font-size:9px;">${escHtml(issue.priority)}</span>` : ''}
                        </div>
                    </div>
                </div>`;
            el.onclick = () => tdToggleTicket(issue.key);
            listEl.appendChild(el);
        }
    } catch(e) {
        listEl.innerHTML = `<div style="padding:16px;font-size:12px;color:#f87171;text-align:center;">Could not load tickets.<br><small>${escHtml(e.message)}</small></div>`;
    }
}

/**
 * Called when a ticket is selected in the Test Design sidebar, or from the Jira Board.
 * Fetches full issue details and populates the panel.
 * Only updates the Test Design tab — no other tabs are affected.
 */
/**
 * Toggle: if clicking the already-active ticket, collapse back to empty state.
 * Otherwise select the new ticket.
 */
function tdToggleTicket(key) {
    if (tdCurrentIssue && tdCurrentIssue.key === key) {
        // Collapse
        tdCurrentIssue = null;
        document.querySelectorAll('#tdTicketList .testdesign-ticket').forEach(el => el.classList.remove('active'));
        const chevron = document.getElementById('td-chevron-' + key);
        if (chevron) chevron.style.transform = 'rotate(0deg)';
        document.getElementById('tdEmpty').style.display = 'flex';
        document.getElementById('tdPanel').style.display = 'none';
        // Reset hint back to default
        const tdHintReset = document.getElementById('tdSidebarHint');
        if (tdHintReset) tdHintReset.textContent = 'Click a ticket from the board, or select one below to generate tests';
        return;
    }
    // Collapse previous chevron
    if (tdCurrentIssue) {
        const prev = document.getElementById('td-chevron-' + tdCurrentIssue.key);
        if (prev) prev.style.transform = 'rotate(0deg)';
    }
    tdSelectTicket(key);
}

async function tdSelectTicket(key) {
    // Highlight sidebar item
    document.querySelectorAll('.testdesign-ticket').forEach(el => el.classList.remove('active'));
    const sidebarItem = document.getElementById('td-ticket-' + key);
    if (sidebarItem) sidebarItem.classList.add('active');
    const chevron = document.getElementById('td-chevron-' + key);
    if (chevron) chevron.style.transform = 'rotate(90deg)';
    // Update sidebar hint to show selected item key
    const tdHint = document.getElementById('tdSidebarHint');
    if (tdHint) { tdHint.innerHTML = `<span style="color:#60a5fa;font-weight:600;">${escHtml(key)}</span> <span style="color:#475569;">selected</span>`; }

    // Show loading state in main panel
    document.getElementById('tdEmpty').style.display = 'none';
    document.getElementById('tdPanel').style.display = 'flex';
    document.getElementById('tdPanel').style.flexDirection = 'column';
    document.getElementById('tdIssueKey').textContent     = key;
    document.getElementById('tdIssueSummary').textContent = 'Loading…';
    document.getElementById('tdIssueMeta').innerHTML      = '';
    document.getElementById('tdTicketIdDisplay').textContent = key;
    document.getElementById('tdDescription').textContent  = 'Loading…';
    document.getElementById('tdCriteria').textContent     = 'Loading…';
    // tdResult always visible
    document.getElementById('tdGenerateBtn').disabled     = true;
    // Reset studio container
    const studioContainer = document.getElementById('tdStudioContainer');
    if (studioContainer) studioContainer.style.display = 'none';
    // Reset saved test cases section
    const savedSection = document.getElementById('tdSavedTCSection');
    if (savedSection) savedSection.style.display = 'none';
    // Reset code editor (clear previous file content)
    const codeArea = document.getElementById('tdCodeEditorArea');
    if (codeArea) { codeArea.value = ''; codeArea.readOnly = true; codeArea.style.background = '#050e1a'; codeArea.style.borderLeft = 'none'; }
    const codeFileName = document.getElementById('tdCodeEditorFileName');
    if (codeFileName) codeFileName.textContent = 'Select a file';
    var _editBtn = document.getElementById('tdCodeEditBtn'); if (_editBtn) _editBtn.style.display = 'none';
    var _saveBtn = document.getElementById('tdCodeSaveBtn'); if (_saveBtn) _saveBtn.style.display = 'none';
    var _cancelBtn = document.getElementById('tdCodeCancelBtn'); if (_cancelBtn) _cancelBtn.style.display = 'none';
    var _dryRunBtn = document.getElementById('tdCodeDryRunBtn'); if (_dryRunBtn) _dryRunBtn.style.display = 'none';
    // Reset all collapsible sections to expanded
    ['tdTicketIdBody','tdDescBody','tdCriteriaBody'].forEach(id => {
        const el = document.getElementById(id); if (el) el.style.display = '';
    });
    ['tdTicketIdChevron','tdDescChevron','tdCriteriaChevron'].forEach(id => {
        const el = document.getElementById(id); if (el) el.style.transform = 'rotate(0deg)';
    });
    ['tdDescSection','tdCriteriaSection'].forEach(id => {
        const el = document.getElementById(id); if (el) el.style.display = '';
    });
    // Clear generation log
    const genLog = document.getElementById('tdGenLog');
    if (genLog) genLog.innerHTML = '';
    const resultStatus = document.getElementById('tdResultStatus');
    if (resultStatus) resultStatus.innerHTML = '';

    try {
        const isADO = JIRA_CONFIG.toolType === 'ADO';
        const issueUrl = isADO
            ? `${SERVER}/api/ado/issue/${encodeURIComponent(key)}`
            : `${SERVER}/api/jira/issue/${encodeURIComponent(key)}`;
        const res  = await fetch(issueUrl);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load issue');

        // Persist for generateTests()
        tdCurrentIssue = {
            key        : data.key,
            summary    : data.summary    || key,
            description: data.description || '',
            criteria   : data.acceptanceCriteria || data.description || 'No description/acceptance criteria provided.',
            priority   : data.priority   || '',
            status     : data.status     || '',
            issueType  : data.issueType  || '',
            assignee   : data.assignee   || null,
        };

        // Populate panel
        document.getElementById('tdIssueKey').textContent     = data.key;
        document.getElementById('tdIssueSummary').textContent = data.summary || key;
        document.getElementById('tdTicketIdDisplay').textContent = data.key;

        // Meta row
        const pc = priorityClass(data.priority);
        document.getElementById('tdIssueMeta').innerHTML = `
            ${data.issueType ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Type:</span> ${escHtml(data.issueType)}</span>` : ''}
            ${data.status    ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Status:</span> ${escHtml(data.status)}</span>` : ''}
            ${data.priority  ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Priority:</span> <span class="jira-priority ${pc}">${escHtml(data.priority)}</span></span>` : ''}
            ${data.assignee  ? `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Assignee:</span> ${escHtml(data.assignee)}</span>` : ''}
        `;

        // Description and Acceptance Criteria (same field for now — Jira stores AC in description)
        const descText = data.description || 'No description available.';
        document.getElementById('tdDescription').textContent = descText;
        document.getElementById('tdCriteria').textContent    = descText;

        document.getElementById('tdGenerateBtn').disabled = false;
        // Update hint with full key + summary
        const tdHintFull = document.getElementById('tdSidebarHint');
        if (tdHintFull) {
            const summary = data.summary || key;
            const shortSummary = summary.length > 40 ? summary.slice(0, 40) + '…' : summary;
            tdHintFull.innerHTML = `<span style="color:#60a5fa;font-weight:600;">${escHtml(data.key)}</span> <span style="color:#64748b;">${escHtml(shortSummary)}</span>`;
        }
        // Load saved test cases from specs file for this ticket
        tdLoadSavedTestCases(key);
        // Track token consumption for Jira context
        tokenOnJiraContext(key);

    } catch(e) {
        document.getElementById('tdIssueSummary').textContent = '⚠ ' + e.message;
        document.getElementById('tdDescription').textContent  = '–';
        document.getElementById('tdCriteria').textContent     = '–';
        // Reset hint on error
        const tdHintErr = document.getElementById('tdSidebarHint');
        if (tdHintErr) tdHintErr.textContent = 'Click a ticket from the board, or select one below to generate tests';
    }
}

/**
 * Called when "Design Tests" is clicked from the Jira Board card or modal.
 * Switches to Manual Test Cases tab and loads the selected ticket.
 */
function selectTicketForDesign(key) {
    if (!key) return;
    // Close both modals if open
    closeJiraModal();
    closeJiraBoardModal();
    // Switch to Test Cases tab and load the ticket
    switchToTab('manualtests');
    mtSelectTicket(key);
}

/**
 * Global tdLog — appends a line to the Test Design generation log.
 * Safe to call from any function; no-ops if the log element is missing.
 */
function tdLog(text, cls='') {
    const log = document.getElementById('tdGenLog');
    if (!log) return;
    const line = document.createElement('div');
    line.className = 'td-log-line ' + (cls || '');
    line.textContent = text;
    log.appendChild(line);
    log.scrollTop = log.scrollHeight;
}

function tdLogClass(text) {
    if (/✅|generated|written|success/i.test(text)) return 'ok';
    if (/❌|error|failed/i.test(text))              return 'err';
    if (/⚙|generating|fetching|extracting/i.test(text)) return 'info';
    if (/⚠|warning/i.test(text))                   return 'warn';
    return '';
}

/**
 * Called when "Generate Test Scripts" is clicked in Test Design tab.
 * Streams SSE from POST /api/generate-test-automation.
 * Generates locators FIRST, then page objects, then test scripts, then test data (correct order).
 * After success, refreshes Test Execution tab's generated tests section.
 */
async function generateTests() {
    if (!tdCurrentIssue) return;
    const btn    = document.getElementById('tdGenerateBtn');
    const result = document.getElementById('tdResult');
    const log    = document.getElementById('tdGenLog');
    const status = document.getElementById('tdResultStatus');
    const fileCard = document.getElementById('tdFileCard');

    btn.disabled = true;
    btn.textContent = '⏳ Generating…';
    // tdResult always visible — just clear and reset
    if (fileCard) fileCard.style.display = 'none';
    log.innerHTML = '';
    status.textContent = '';

    // Show progress bar
    const progressWrap = document.createElement('div');
    progressWrap.style.cssText = 'height:4px;background:#1a2f4a;border-radius:2px;margin-bottom:8px;overflow:hidden;';
    const progressBar = document.createElement('div');
    progressBar.style.cssText = 'height:100%;width:0%;background:linear-gradient(90deg,#3b82f6,#60a5fa);border-radius:2px;transition:width 0.3s ease;';
    progressWrap.appendChild(progressBar);
    log.parentElement.insertBefore(progressWrap, log);

    let progressPercent = 0;
    function updateProgress(pct) {
        progressPercent = Math.min(pct, 100);
        progressBar.style.width = progressPercent + '%';
        if (progressPercent >= 100) {
            progressBar.style.background = 'linear-gradient(90deg,#10b981,#059669)';
        }
    }
    updateProgress(5);

    try {
        tdLog('🚀 Starting test script generation for ' + tdCurrentIssue.key + '…', 'info');

        // Step 1: Fetch test cases from TEST-CASES.md file
        tdLog('📄 Loading test cases from TEST-CASES.md…', 'info');
        const specFileName = `${tdCurrentIssue.key}-TEST-CASES.md`;
        const specRes = await fetch(`${SERVER}/api/specs/file?fileName=${encodeURIComponent(specFileName)}`);
        
        if (!specRes.ok) {
            tdLog('⚠️  TEST-CASES.md not found. Creating test automation with default test structure…', 'warn');
        }

        let testCases = { positive: [], negative: [], edge: [] };
        if (specRes.ok) {
            const specData = await specRes.json();
            if (specData.content) {
                // Parse the markdown file to extract test cases
                testCases = parseSavedTestCases(specData.content);
                tdLog(`✅ Loaded ${testCases.total} test case(s)`, 'ok');
            }
        }

        // Step 2: Call /api/generate-test-automation with parsed test cases
        const response = await fetch(`${SERVER}/api/generate-test-automation`, {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({ 
                issueKey: tdCurrentIssue.key,
                testCases: testCases,
                summary: (tdCurrentIssue.summary || tdCurrentIssue.key)
            }),
        });

        if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            tdLog('❌ Server error: ' + (err.error || response.statusText), 'err');
            status.textContent = '❌ Failed';
            btn.disabled = false;
            btn.textContent = '⚡ Generate Test Scripts';
            return;
        }

        const reader  = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let doneData = null;

        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            for (const part of parts) {
                const dl = part.split('\n').find(l => l.startsWith('data:'));
                if (!dl) continue;
                try {
                    const msg = JSON.parse(dl.slice(5));
                    if (msg.type === 'log') {
                        tdLog(msg.data, tdLogClass(msg.data));
                    } else if (msg.type === 'issue') {
                        // Update criteria box with live data from server
                        const criteriaEl = document.getElementById('tdCriteria');
                        if (criteriaEl && msg.data.criteria) criteriaEl.textContent = msg.data.criteria;
                    } else if (msg.type === 'done') {
                        doneData = msg.data;
                    } else if (msg.type === 'error') {
                        tdLog('❌ ' + msg.data, 'err');
                    }
                } catch(_) {}
            }
        }

        if (doneData && !doneData.error) {
            const specFile = doneData.specFile || '';

            // Show spec file content in the log
            if (specFile) {
                tdLog('', '');
                tdLog('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                tdLog('📄 Spec file: ' + specFile, 'info');
                tdLog('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                try {
                    const fileRes = await fetch(`${SERVER}/api/tests/file?path=${encodeURIComponent(specFile)}`);
                    if (fileRes.ok) {
                        const fileData = await fileRes.json();
                        const lines = (fileData.content || '').split('\n');
                        lines.forEach(line => tdLog(line, ''));
                    }
                } catch(_) {}
            }

            tdLog('', '');
            tdLog('✅ Test scripts saved successfully!', 'ok');

            // Status badge + Run button
            status.innerHTML = `
                <span style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#10b981;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:600;">✅ Generation complete</span>
                ${specFile ? `<button onclick="tdRunSpec('${specFile.replace(/'/g,"\\'")}')" id="tdRunSpecBtn"
                    style="background:linear-gradient(135deg,#059669,#047857);border:none;color:white;padding:3px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:5px;white-space:nowrap;">
                    ▶ Run
                </button>` : ''}
            `;

            // Show generated file card
            if (fileCard) fileCard.style.display = 'block';

            function renderFileLine(elId, relPath, icon) {
                const el = document.getElementById(elId);
                if (!el) return;
                el.innerHTML = '';
                if (!relPath) { el.style.display = 'none'; return; }
                el.style.display = 'flex';

                // Icon + path label
                const label = document.createElement('span');
                label.style.cssText = 'font-family:monospace;font-size:12px;color:#60a5fa;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
                label.textContent = icon + ' ' + relPath;
                el.appendChild(label);

                // "↗ View Script in IDE" button
                if (projectRoot) {
                    const absPath = projectRoot.replace(/\/$/, '') + '/' + relPath;
                    const btn = document.createElement('a');
                    btn.href = 'vscode://file/' + absPath;
                    btn.title = 'Open in VS Code';
                    btn.textContent = '↗ View Script in IDE';
                    btn.style.cssText = [
                        'flex-shrink:0',
                        'font-size:11px',
                        'color:#60a5fa',
                        'text-decoration:none',
                        'background:rgba(59,130,246,0.12)',
                        'border:1px solid rgba(59,130,246,0.3)',
                        'padding:3px 10px',
                        'border-radius:4px',
                        'white-space:nowrap',
                        'transition:background 0.15s',
                        'cursor:pointer',
                    ].join(';');
                    btn.onmouseover = () => { btn.style.background = 'rgba(59,130,246,0.25)'; };
                    btn.onmouseout  = () => { btn.style.background = 'rgba(59,130,246,0.12)'; };
                    el.appendChild(btn);
                }
            }

            renderFileLine('tdSpecPath', doneData.specFile || '', '◆');
            renderFileLine('tdDataPath', doneData.testDataFile || '', '🗂');
            renderFileLine('tdLocatorsPath', (doneData.files && doneData.files.locators) || '', '📍');
            renderFileLine('tdPageObjectPath', (doneData.files && doneData.files.pageObject) || '', '📄');
            // Store spec file for single-test run
            const specPathEl = document.getElementById('tdSpecPath');
            if (specPathEl && doneData.specFile) specPathEl.dataset.specFile = doneData.specFile;

            // Load generated files into Studio UI
            if (doneData && doneData.specFile) {
                await tdLoadStudioFiles(doneData);
            }

            // Complete progress bar
            updateProgress(100);

            // Refresh Code Editor tree to show new files
            try { tdLoadCodeTree(); } catch(_) {}

            // Track token consumption for test design and script generation
            const _issueKey = (tdCurrentIssue && tdCurrentIssue.key) || '';
            tokenOnTestDesign(_issueKey);
            tokenOnScriptGeneration(_issueKey);

            // Refresh Test Execution generated section
            await loadGeneratedTests();
        } else if (doneData && doneData.error) {
            status.textContent = '❌ Generation failed';
            tdLog('❌ ' + doneData.error, 'err');
        }
    } catch(e) {
        tdLog('❌ Network error: ' + e.message, 'err');
        status.textContent = '❌ Error';
        progressBar.style.background = '#f87171';
        updateProgress(100);
    }
    
    btn.disabled = false;
    btn.textContent = '⚡ Generate Test Scripts';
}

// ── Test Design Studio UI State ───────────────────────────────────────────
let tdStudioFiles = {
    locators: '',
    pageobject: '',
    spec: '',
    testdata: ''
};

/**
 * Load generated files into Studio state after generation completes.
 * (Studio panels removed from header — files viewable via Code Editor section)
 */
async function tdLoadStudioFiles(doneData) {
    const key = tdCurrentIssue.key;
    const normalized = key.replace(/[^a-zA-Z0-9]/g, '');
    const pascalCase = normalized.charAt(0).toUpperCase() + normalized.slice(1).toLowerCase();
    
    const locatorsPath = `Locators/${pascalCase}.locators.ts`;
    const pageObjectPath = `pages/${pascalCase}Page.ts`;
    const specPath = doneData.specFile || `tests/${key}/${key}-Script.spec.ts`;
    
    try {
        const locRes = await fetch(`${SERVER}/api/tests/file?path=${encodeURIComponent(locatorsPath)}`);
        if (locRes.ok) {
            const data = await locRes.json();
            tdStudioFiles.locators = data.content || '';
            const el = document.getElementById('tdLocatorsEditor');
            if (el) el.value = tdStudioFiles.locators;
        }
        
        const pageRes = await fetch(`${SERVER}/api/tests/file?path=${encodeURIComponent(pageObjectPath)}`);
        if (pageRes.ok) {
            const data = await pageRes.json();
            tdStudioFiles.pageobject = data.content || '';
            const el = document.getElementById('tdPageObjectEditor');
            if (el) el.value = tdStudioFiles.pageobject;
        }
        
        const specRes = await fetch(`${SERVER}/api/tests/file?path=${encodeURIComponent(specPath)}`);
        if (specRes.ok) {
            const data = await specRes.json();
            tdStudioFiles.spec = data.content || '';
            const el = document.getElementById('tdSpecEditor');
            if (el) el.value = tdStudioFiles.spec;
        }
    } catch (e) {
        // Silently handle — files are viewable via Code Editor section
    }
}

/**
 * Show a file in the Studio UI editor
 */
function tdShowStudioFile(fileType) {
    document.querySelectorAll('.td-studio-tab').forEach(t => t.classList.remove('active'));
    if (event && event.target) {
        event.target.classList.add('active');
    }
    
    const editorId = {
        'locators': 'tdLocatorsEditor',
        'pageobject': 'tdPageObjectEditor',
        'spec': 'tdSpecEditor'
    }[fileType];
    
    if (editorId) {
        const editor = document.getElementById(editorId);
        if (editor) {
            editor.focus();
            editor.scrollTop = 0;
        }
    }
}

/**
 * Toggle edit mode for the current editor
 */
function tdToggleEditMode(fileType) {
    const editorId = {
        'locators': 'tdLocatorsEditor',
        'pageobject': 'tdPageObjectEditor',
        'spec': 'tdSpecEditor'
    }[fileType];
    
    if (!editorId) return;
    
    const editor = document.getElementById(editorId);
    const btnId = `tdEditBtn${fileType.charAt(0).toUpperCase() + fileType.slice(1)}`;
    const btn = document.getElementById(btnId);
    
    if (editor.readOnly) {
        editor.readOnly = false;
        editor.style.background = '#132a42';
        editor.style.borderColor = '#3b82f6';
        if (btn) btn.textContent = '✅ Done Editing';
    } else {
        editor.readOnly = true;
        editor.style.background = '#0d1d30';
        editor.style.borderColor = '#1a2f4a';
        if (btn) btn.textContent = '✏️ Edit';
    }
}

/**
 * Save edited file content back to server
 */
async function tdSaveFile(fileType) {
    const editorId = {
        'locators': 'tdLocatorsEditor',
        'pageobject': 'tdPageObjectEditor',
        'spec': 'tdSpecEditor'
    }[fileType];
    
    if (!editorId) return;
    
    const editor = document.getElementById(editorId);
    const content = editor.value;
    
    // Determine file path based on type
    let filePath = '';
    const key = tdCurrentIssue.key;
    const normalized = key.replace(/[^a-zA-Z0-9]/g, '');
    const pascalCase = normalized.charAt(0).toUpperCase() + normalized.slice(1).toLowerCase();
    
    if (fileType === 'locators') {
        filePath = `Locators/${pascalCase}.locators.ts`;
    } else if (fileType === 'pageobject') {
        filePath = `pages/${pascalCase}Page.ts`;
    } else if (fileType === 'spec') {
        filePath = `tests/${key}/${key}-Script.spec.ts`;
    }
    
    if (!filePath) return;
    
    try {
        const res = await fetch(`${SERVER}/api/save-file`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: filePath, content })
        });
        
        if (res.ok) {
            tdLog(`✅ Saved ${fileType}: ${filePath}`, 'ok');
        } else {
            const err = await res.json();
            tdLog(`❌ Save failed: ${err.error}`, 'err');
        }
    } catch (e) {
        tdLog(`❌ Save error: ${e.message}`, 'err');
    }
}

/**
 * Copy file content to clipboard
 */
function tdCopyFile(fileType) {
    const editorId = {
        'locators': 'tdLocatorsEditor',
        'pageobject': 'tdPageObjectEditor',
        'spec': 'tdSpecEditor'
    }[fileType];
    
    if (!editorId) return;
    
    const editor = document.getElementById(editorId);
    const text = editor.value;
    
    if (text) {
        navigator.clipboard.writeText(text).then(() => {
            tdLog(`📋 Copied ${fileType} to clipboard`, 'ok');
        });
    }
}

/** Run a dry-run test to verify the generated spec works */
async function tdRunDryRun() {
    if (!tdCurrentIssue) return;
    const specFile = `tests/${tdCurrentIssue.key}/${tdCurrentIssue.key}-Script.spec.ts`;
    tdLog('', '');
    tdLog('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
    try {
        await tdRunWithRepair(specFile, '', tdLog);
    } catch (e) {
        tdLog(`❌ Dry run error: ${e.message}`, 'err');
    }
    tdLog('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
}

/**
 * Navigate to the Test Execution tab and highlight generated tests.
 */
function goToExplorer() {
    switchToTab('explorer');
}

/** Load automated tests for the current ticket and render them in tdAutomatedSection */
async function tdLoadAutomatedTests(issueKey) {
    const section = document.getElementById('tdAutomatedSection');
    const list    = document.getElementById('tdAutomatedList');
    const count   = document.getElementById('tdAutomatedCount');
    if (!section || !list) return;
    try {
        const res  = await fetch(`${SERVER}/api/manual-test-cases/saved?issueKey=${encodeURIComponent(issueKey)}`);
        if (!res.ok) return;
        const data = await res.json();
        const cases = data.saved || [];
        if (!cases.length) { section.style.display = 'none'; return; }

        count.textContent = cases.length;
        section.style.display = '';
        list.innerHTML = cases.map(tc => {
            const typeColor = tc.type === 'Positive' ? '#10b981' : tc.type === 'Negative' ? '#f87171' : '#a78bfa';
            const safe = tc.id.replace(/[^a-z0-9]/gi, '');
            return `
                <div style="background:#0a1628;border:1px solid #1a2f4a;border-radius:6px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                    <div style="min-width:0;flex:1;">
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">
                            <span style="font-size:10px;font-weight:700;color:#60a5fa;font-family:monospace;">${escHtml(tc.id)}</span>
                            <span style="font-size:10px;padding:1px 6px;border-radius:8px;background:${typeColor}22;color:${typeColor};border:1px solid ${typeColor}44;">${escHtml(tc.type||'')}</span>
                        </div>
                        <div style="font-size:12px;color:#cbd5e1;">${escHtml(tc.title)}</div>
                    </div>
                    <span id="td-atc-badge-${safe}" style="font-size:10px;color:#475569;flex-shrink:0;"></span>
                    <button id="td-atc-run-${safe}" onclick="tdRunSingleTest('${escHtml(tc.id)}','${escHtml(tc.title)}')"
                        style="background:linear-gradient(135deg,#059669,#047857);border:none;color:white;padding:4px 12px;border-radius:5px;font-size:11px;font-weight:700;cursor:pointer;flex-shrink:0;white-space:nowrap;">
                        ▶ Run
                    </button>
                </div>`;
        }).join('');
    } catch(_) { section.style.display = 'none'; }
}

async function tdRunSavedTestDryRun(encodedId, encodedTitle, buttonId) {
    const testId = decodeURIComponent(encodedId);
    const title = decodeURIComponent(encodedTitle);
    const button = document.getElementById(buttonId);
    const badge = document.getElementById(`${buttonId}-status`);
    const panel = document.getElementById(`${buttonId}-panel`);
    const progress = document.getElementById(`${buttonId}-progress`);
    const attemptLabel = document.getElementById(`${buttonId}-attempt`);
    const runLog = document.getElementById(`${buttonId}-log`);
    const intervention = document.getElementById(`${buttonId}-intervention`);
    const reportLinks = document.getElementById(`${buttonId}-reports`);
    const errorReportLink = document.getElementById(`${buttonId}-error-report`);
    const updateStatus = (text, retry, maxRetries) => {
        if (progress) progress.textContent = text;
        if (attemptLabel) attemptLabel.textContent = retry > 0 ? `Repair ${Math.min(retry, maxRetries)}/${maxRetries}` : 'Initial run';
        if (badge) badge.textContent = text;
    };
    const appendRunLog = (text, cls) => {
        if (!runLog) return;
        const line = document.createElement('div');
        line.textContent = text;
        line.style.color = cls === 'err' ? '#f87171' : cls === 'warn' ? '#f59e0b' : cls === 'ok' ? '#10b981' : '#94a3b8';
        runLog.appendChild(line);
        runLog.scrollTop = runLog.scrollHeight;
    };
    const publishReport = doneData => {
        if (!reportLinks) return;
        if (errorReportLink) errorReportLink.style.display = 'none';
        const links = [];
        if (doneData.reportUrl) {
            const report = document.createElement('a');
            report.href = new URL(doneData.reportUrl, SERVER).href;
            report.target = '_blank';
            report.rel = 'noopener noreferrer';
            report.textContent = '📊 Playwright report';
            links.push(report);
        }
        reportLinks.replaceChildren(...links);
        if (doneData.errorReportFile && errorReportLink) {
            errorReportLink.href = new URL(doneData.errorReportFile.replace(/\\/g, '/'), `${SERVER}/`).href;
            errorReportLink.style.display = 'inline';
        }
    };
    if (button) {
        button.disabled = true;
        button.textContent = '⏳ Running';
    }
    if (panel) panel.style.display = '';
    if (runLog) runLog.replaceChildren();
    if (reportLinks) reportLinks.replaceChildren();
    if (errorReportLink) errorReportLink.style.display = 'none';
    if (intervention) intervention.style.display = 'none';
    updateStatus('Orchestrator stage · resolving saved test', 0, 3);
    try {
        let file = document.getElementById('tdSpecPath')?.dataset.specFile || '';
        if (!file && tdCurrentIssue?.key) {
            const sourceParams = tdCurrentIssue.sourceType === 'LocalHost'
                ? `&sourceType=LocalHost&sourceFile=${encodeURIComponent(tdCurrentIssue.sourceFile || '')}`
                : '';
            const scriptsResponse = await fetch(`${SERVER}/api/tests/for-ticket?issueKey=${encodeURIComponent(tdCurrentIssue.key)}${sourceParams}`);
            const scriptsData = await scriptsResponse.json();
            if (!scriptsResponse.ok) throw new Error(scriptsData.error || `Could not find an automated spec (${scriptsResponse.status})`);
            file = scriptsData.scripts?.[0]?.file || '';
            if (file) {
                const specPath = document.getElementById('tdSpecPath');
                if (specPath) specPath.dataset.specFile = file;
            }
        }
        if (!file) {
            appendRunLog('⚠ No generated spec file is available. Generate the test script first.', 'warn');
            if (badge) badge.textContent = 'No script';
            return;
        }

        appendRunLog(`Orchestrator stage: selected spec ${file}`, 'info');
        updateStatus('Generator stage · validating test mapping', 0, 3);
        const parseResponse = await fetch(`${SERVER}/api/parse-test-file?file=${encodeURIComponent(file)}`);
        const parsed = await parseResponse.json();
        if (!parseResponse.ok) throw new Error(parsed.error || `Could not inspect spec file (${parseResponse.status})`);

        const tests = parsed.tests || [];
        const normalize = value => String(value || '').toLowerCase().replace(/[^a-z0-9]/g, '');
        const idToken = normalize(testId);
        const titleToken = normalize(title);
        let matches = tests.filter(test => {
            const name = normalize(test.name);
            return (idToken && name.includes(idToken)) || (titleToken && name.includes(titleToken));
        });
        if (matches.length > 1) {
            const titleMatches = matches.filter(test => normalize(test.name) === titleToken);
            if (titleMatches.length === 1) matches = titleMatches;
        }
        if (matches.length !== 1) {
            const reason = matches.length
                ? `More than one automated test matches ${testId}; no test was run.`
                : `No automated test matching ${testId} / "${title}" was found in ${file}; no test was run.`;
            appendRunLog(`⚠ ${reason}`, 'warn');
            if (badge) badge.textContent = 'Not matched';
            updateStatus('Stopped · test mapping is ambiguous', 0, 3);
            return;
        }

        const testName = matches[0].name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        appendRunLog(`Generator stage: verified generated test "${matches[0].name}"`, 'info');
        const result = await tdRunWithRepair(file, testName, appendRunLog, updateStatus, publishReport);
        updateStatus(result.exitCode === 0 ? 'Passed' : 'Failed · human intervention required', result.retries || 0, 3);
        if (badge) {
            badge.textContent = result.exitCode === 0 ? '✅ Passed' : result.needsHuman ? '🧑‍💻 Needs help' : '❌ Failed';
            badge.style.color = result.exitCode === 0 ? '#10b981' : '#f87171';
        }
        if (result.needsHuman && intervention) {
            intervention.style.display = '';
            intervention.querySelector('[data-intervention-message]').textContent =
                `${result.interventionReason || 'Automatic repair could not resolve the test.'} Review the Playwright and failure reports, then update the spec or page object and rerun.`;
            if (errorReportLink && result.errorReportFile) errorReportLink.style.display = 'inline';
        }
    } catch (e) {
        appendRunLog(`❌ Dry Run error: ${e.message}`, 'err');
        if (badge) {
            badge.textContent = 'Error';
            badge.style.color = '#f87171';
        }
        updateStatus('Execution error · human review required', 0, 3);
        if (intervention) {
            intervention.style.display = '';
            intervention.querySelector('[data-intervention-message]').textContent = `Dry Run could not complete: ${e.message}. Review the logs and fix the runner or spec before retrying.`;
        }
    } finally {
        if (button) {
            button.disabled = false;
            button.textContent = '🧪 Dry Run';
        }
    }
}

/**
 * Load saved test cases from the specs/ file for a ticket and display them
 * in the Automation Studio tab's "Automated Tests" section.
 */
async function tdLoadSavedTestCases(issueKey) {
    // ── 1. Show saved test cases from specs/ via the server ────────────────
    const savedSection = document.getElementById('tdSavedTCSection');
    const savedList    = document.getElementById('tdSavedTCList');
    const savedCount   = document.getElementById('tdSavedTCCount');
    const existingSpecPath = document.getElementById('tdSpecPath');
    const existingFileCard = document.getElementById('tdFileCard');
    if (existingSpecPath) existingSpecPath.dataset.specFile = '';
    if (existingFileCard) existingFileCard.style.display = 'none';

    try {
        const res  = await fetch(`${SERVER}/api/specs/for-ticket?issueKey=${encodeURIComponent(issueKey)}`);
        if (res.ok) {
            const data = await res.json();
            const cases = data.testCases || [];
            if (cases.length > 0 && savedSection && savedList) {
                savedCount.textContent = cases.length;
                savedSection.style.display = '';
                // Show upload button with correct label based on active tool
                const toolType = document.getElementById('tdToolSelect')?.value || JIRA_CONFIG.toolType || '';
                const uploadBtn = document.getElementById('tdUploadBtn');
                const uploadLbl = document.getElementById('tdUploadBtnLabel');
                if (uploadBtn && (toolType === 'Jira' || toolType === 'ADO')) {
                    if (uploadLbl) uploadLbl.textContent = toolType === 'ADO' ? 'Upload to Azure DevOps' : 'Upload to Jira';
                    uploadBtn.style.display = 'inline-flex';
                    uploadBtn.title = toolType === 'ADO'
                        ? 'Upload these test cases to Azure DevOps as Test Cases'
                        : 'Upload these test cases to Jira as Test Cases';
                } else if (uploadBtn) {
                    uploadBtn.style.display = 'none';
                }
                savedList.innerHTML = cases.map((tc, index) => {
                    const typeColor = (tc.type||'').toLowerCase().includes('positive') ? '#10b981'
                                    : (tc.type||'').toLowerCase().includes('negative') ? '#f87171' : '#a78bfa';
                    const buttonId = `td-saved-dry-run-${String(tc.id || 'test').replace(/[^a-z0-9]/gi, '')}-${index}`;
                    return `
                        <div style="background:#0a1628;border:1px solid #1a2f4a;border-radius:6px;padding:8px 10px;">
                            <div style="display:flex;align-items:flex-start;gap:10px;">
                                <div style="min-width:0;flex:1;">
                                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;flex-wrap:wrap;">
                                        <span style="font-size:10px;font-weight:700;color:#60a5fa;font-family:monospace;">${escHtml(tc.id)}</span>
                                        <span style="font-size:10px;padding:1px 6px;border-radius:8px;background:${typeColor}22;color:${typeColor};border:1px solid ${typeColor}44;">${escHtml(tc.type||'Functional')}</span>
                                        ${tc.priority ? `<span style="font-size:10px;padding:1px 6px;border-radius:8px;background:rgba(59,130,246,0.12);color:#60a5fa;border:1px solid rgba(59,130,246,0.25);">${escHtml(tc.priority)}</span>` : ''}
                                    </div>
                                    <div style="font-size:12px;color:#cbd5e1;line-height:1.4;">${escHtml(tc.title)}</div>
                                </div>
                                <span id="${buttonId}-status" style="font-size:10px;color:#64748b;flex-shrink:0;align-self:center;"></span>
                                <button id="${buttonId}" onclick="tdRunSavedTestDryRun('${encodeURIComponent(String(tc.id || '')).replace(/'/g, '%27')}','${encodeURIComponent(String(tc.title || '')).replace(/'/g, '%27')}','${buttonId}')"
                                    style="background:linear-gradient(135deg,#7c3aed,#6d28d9);border:none;color:white;padding:4px 10px;border-radius:5px;font-size:10px;font-weight:700;cursor:pointer;flex-shrink:0;white-space:nowrap;">
                                    🧪 Dry Run
                                </button>
                            </div>
                            <div id="${buttonId}-panel" style="display:none;margin-top:8px;background:#050e1a;border:1px solid #1a2f4a;border-radius:5px;overflow:hidden;">
                                <div style="display:flex;align-items:center;gap:10px;padding:7px 10px;background:#0d1d30;border-bottom:1px solid #1a2f4a;">
                                    <strong style="font-size:10px;color:#60a5fa;">EXECUTION STATUS</strong>
                                    <span id="${buttonId}-progress" style="font-size:10px;color:#f59e0b;">Queued</span>
                                    <span id="${buttonId}-attempt" style="font-size:10px;color:#64748b;margin-left:auto;"></span>
                                    <span id="${buttonId}-reports" style="display:flex;gap:8px;font-size:10px;"></span>
                                </div>
                                <div id="${buttonId}-log" style="padding:8px 10px;max-height:220px;overflow:auto;font-family:monospace;font-size:10px;line-height:1.6;white-space:pre-wrap;"></div>
                                <div id="${buttonId}-intervention" style="display:none;padding:9px 10px;background:rgba(248,113,113,0.1);border-top:1px solid rgba(248,113,113,0.3);font-size:11px;color:#fca5a5;">
                                    <strong>Human intervention required.</strong>
                                    <span data-intervention-message></span>
                                    <a id="${buttonId}-error-report" href="#" target="_blank" rel="noopener noreferrer" style="display:none;margin-left:8px;color:#93c5fd;">View failure report</a>
                                </div>
                            </div>
                        </div>`;
                }).join('');
            } else if (savedSection) {
                savedSection.style.display = 'none';
            }
        }
    } catch(_) {
        if (savedSection) savedSection.style.display = 'none';
    }

    // ── 2. Check for existing generated script for this ticket ─────────────
    try {
        const res  = await fetch(`${SERVER}/api/tests/for-ticket?issueKey=${encodeURIComponent(issueKey)}`);
        if (!res.ok) return;
        const data = await res.json();
        const scripts = data.scripts || [];
        if (!scripts.length) return;

        // Show file card with existing script
        const fileCard = document.getElementById('tdFileCard');
        const specPath = document.getElementById('tdSpecPath');
        const dataPath = document.getElementById('tdDataPath');
        if (!fileCard || !specPath) return;

        fileCard.style.display = 'block';

        const relSpec = scripts[0]?.file || '';
        if (relSpec) {
            specPath.style.display = 'flex';
            specPath.dataset.specFile = relSpec;
            specPath.innerHTML = '';
            const label = document.createElement('span');
            label.style.cssText = 'font-family:monospace;font-size:12px;color:#60a5fa;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
            label.textContent = '◆ ' + relSpec;
            specPath.appendChild(label);
            if (projectRoot) {
                const absPath = projectRoot.replace(/\/$/, '') + '/' + relSpec;
                const viewBtn = document.createElement('a');
                viewBtn.href = 'vscode://file/' + absPath;
                viewBtn.textContent = '↗ View Script in IDE';
                viewBtn.style.cssText = 'flex-shrink:0;font-size:11px;color:#60a5fa;text-decoration:none;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.3);padding:3px 10px;border-radius:4px;white-space:nowrap;';
                specPath.appendChild(viewBtn);
            }
        }
        if (data.testDataFile && dataPath) {
            dataPath.style.display = 'flex';
            dataPath.innerHTML = `<span style="font-family:monospace;font-size:12px;color:#10b981;flex:1;">🗂 ${escHtml(data.testDataFile)}</span>`;
        }

        const statusEl = document.getElementById('tdResultStatus');
        if (statusEl && relSpec) {
            statusEl.innerHTML = `<span style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#10b981;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:600;">✅ Script exists</span>
            <button onclick="tdRunSpec('${relSpec.replace(/'/g,"\\'")}')" style="background:linear-gradient(135deg,#059669,#047857);border:none;color:white;padding:3px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;">▶ Run</button>`;
        }
    } catch(_) {}
}

/**
 * Upload saved test cases from specs/ to Jira or Azure DevOps.
 * Reads the loaded cases and posts them to the appropriate API endpoint.
 */
async function tdUploadTestCases() {
    const toolType  = document.getElementById('tdToolSelect')?.value || JIRA_CONFIG.toolType || '';
    const issueKey  = tdCurrentIssue?.key;
    const btn       = document.getElementById('tdUploadBtn');
    const statusEl  = document.getElementById('tdUploadStatus');

    if (!issueKey) return;
    if (!toolType || toolType === 'LocalHost') return;

    // Collect test cases from the rendered list
    const res = await fetch(`${SERVER}/api/specs/for-ticket?issueKey=${encodeURIComponent(issueKey)}`);
    const data = res.ok ? await res.json() : {};
    const cases = data.testCases || [];
    if (!cases.length) {
        if (statusEl) { statusEl.textContent = '⚠ No test cases to upload.'; statusEl.style.background = 'rgba(245,158,11,0.12)'; statusEl.style.color = '#f59e0b'; statusEl.style.display = ''; }
        return;
    }

    // Update button state
    if (btn) { btn.disabled = true; btn.innerHTML = '⏳ <span>Uploading…</span>'; }
    if (statusEl) { statusEl.style.display = 'none'; }

    try {
        const isADO    = toolType === 'ADO';
        const endpoint = isADO
            ? `${SERVER}/api/ado/upload-test-cases`
            : `${SERVER}/api/jira/upload-test-cases`;

        const uploadRes = await fetch(endpoint, {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({ issueKey, testCases: cases })
        });
        const result = await uploadRes.json();

        if (uploadRes.ok && (result.success || result.uploaded)) {
            const count = result.uploaded || cases.length;
            if (statusEl) {
                statusEl.textContent  = `✅ ${count} test case${count !== 1 ? 's' : ''} uploaded to ${isADO ? 'Azure DevOps' : 'Jira'} successfully.`;
                statusEl.style.background = 'rgba(16,185,129,0.1)';
                statusEl.style.color      = '#10b981';
                statusEl.style.border     = '1px solid rgba(16,185,129,0.25)';
                statusEl.style.display    = '';
            }
        } else {
            throw new Error(result.error || 'Upload failed');
        }
    } catch(e) {
        if (statusEl) {
            statusEl.textContent  = `❌ Upload failed: ${e.message}`;
            statusEl.style.background = 'rgba(248,113,113,0.1)';
            statusEl.style.color      = '#f87171';
            statusEl.style.border     = '1px solid rgba(248,113,113,0.25)';
            statusEl.style.display    = '';
        }
    } finally {
        if (btn) {
            btn.disabled = false;
            const lbl = document.getElementById('tdUploadBtnLabel');
            if (lbl) lbl.textContent = toolType === 'ADO' ? 'Upload to Azure DevOps' : 'Upload to Jira';
            btn.innerHTML = `☁️ <span id="tdUploadBtnLabel">${toolType === 'ADO' ? 'Upload to Azure DevOps' : 'Upload to Jira'}</span>`;
        }
        // Auto-hide status after 5s
        setTimeout(() => { if (statusEl) statusEl.style.display = 'none'; }, 5000);
    }
}

/** Run a single test case by name using --grep against the current spec file */
async function tdRunSingleTest(tcId, tcTitle) {
    // Find the spec file from tdCurrentIssue or tdFileCard
    const specPathEl = document.getElementById('tdSpecPath');
    let specFile = specPathEl ? (specPathEl.dataset.specFile || '') : '';
    // Fallback: derive from issueKey
    if (!specFile && tdCurrentIssue) {
        try {
            const res  = await fetch(`${SERVER}/api/tests`);
            const data = await res.json();
            const key  = (tdCurrentIssue.key || '').toUpperCase();
            const found = (data.specs || []).find(s => (s.file || s.path || '').toUpperCase().includes(key));
            if (found) specFile = found.file || found.path || '';
        } catch(_) {}
    }
    if (!specFile) {
        tdAppendLog('⚠ No spec file found. Generate the test script first.', 'warn');
        return;
    }

    const safe = tcId.replace(/[^a-z0-9]/gi, '');
    const runBtn   = document.getElementById('td-atc-run-'   + safe);
    const badge    = document.getElementById('td-atc-badge-' + safe);
    if (runBtn)  { runBtn.disabled = true; runBtn.textContent = '⏳'; }
    if (badge)   { badge.textContent = 'Running…'; badge.style.color = '#f59e0b'; }

    tdAppendLog('', '');
    tdAppendLog(`▶ Running test: "${tcTitle}"`, 'info');
    tdAppendLog(`   File: ${specFile}`, 'info');

    try {
        const res = await fetch(`${SERVER}/api/run-tests/file`, {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({ file: specFile, testName: tcTitle }),
        });
        const reader  = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '', exitCode = 1;
        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            for (const part of parts) {
                const dl = part.split('\n').find(l => l.startsWith('data:'));
                if (!dl) continue;
                try {
                    const msg = JSON.parse(dl.slice(5));
                    if (msg.type === 'log') tdAppendLog(msg.data, '');
                    else if (msg.type === 'done') exitCode = msg.data?.exitCode ?? 1;
                } catch(_) {}
            }
        }
        const passed = exitCode === 0;
        tdAppendLog(passed ? `✅ "${tcTitle}" passed` : `❌ "${tcTitle}" failed (exit ${exitCode})`, passed ? 'ok' : 'err');
        if (badge) { badge.textContent = passed ? '✅' : '❌'; badge.style.color = passed ? '#10b981' : '#f87171'; }
    } catch(e) {
        tdAppendLog('❌ Run error: ' + e.message, 'err');
        if (badge) { badge.textContent = '❌'; badge.style.color = '#f87171'; }
    } finally {
        if (runBtn) { runBtn.disabled = false; runBtn.textContent = '▶ Run'; }
    }
}

/** Append a line to the generation log */
function tdAppendLog(text, cls) {
    const log = document.getElementById('tdGenLog');
    if (!log) return;
    const line = document.createElement('div');
    line.className = 'td-log-line ' + (cls || '');
    line.textContent = text;
    log.appendChild(line);
    log.scrollTop = log.scrollHeight;
    // Make sure log body is expanded
    const body = document.getElementById('tdResultBody');
    if (body && body.style.display === 'none') {
        body.style.display = '';
        const chev = document.getElementById('tdResultChevron');
        if (chev) chev.style.transform = 'rotate(0deg)';
    }
}

/** Run a spec file from the Test Design tab, streaming output into the generation log */
async function tdRunSpec(file) {
    const btn    = document.getElementById('tdRunSpecBtn');
    const log    = document.getElementById('tdGenLog');
    const status = document.getElementById('tdResultStatus');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ Running…'; }

    function tdLog(text, cls) {
        const line = document.createElement('div');
        line.className = 'td-log-line ' + (cls||'');
        line.textContent = text;
        log.appendChild(line);
        log.scrollTop = log.scrollHeight;
    }

    tdLog('', '');
    tdLog('▶ Running: ' + file, 'info');

    try {
        const res = await fetch(`${SERVER}/api/run-tests/file`, {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({ file }),
        });
        const reader  = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '', exitCode = 1;
        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            for (const part of parts) {
                const dl = part.split('\n').find(l => l.startsWith('data:'));
                if (!dl) continue;
                try {
                    const msg = JSON.parse(dl.slice(5));
                    if (msg.type === 'log' || msg.type === 'stdout') {
                        tdLog(msg.data || msg.line || '', '');
                    } else if (msg.type === 'done') {
                        exitCode = msg.data?.exitCode ?? msg.exitCode ?? 1;
                    }
                } catch(_) {}
            }
        }
        const passed = exitCode === 0;
        tdLog('', '');
        tdLog(passed ? '✅ Tests passed' : '❌ Tests failed (exit ' + exitCode + ')', passed ? 'ok' : 'err');
        status.innerHTML = `
            <span style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#10b981;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:600;">✅ Generation complete</span>
            <button onclick="tdRunSpec('${file.replace(/'/g,"\\'")}')" id="tdRunSpecBtn"
                style="background:linear-gradient(135deg,#059669,#047857);border:none;color:white;padding:3px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:5px;white-space:nowrap;">
                ▶ Run
            </button>`;
    } catch(e) {
        tdLog('❌ Run error: ' + e.message, 'err');
        if (btn) { btn.disabled = false; btn.textContent = '▶ Run'; }
    }
}

/**
 * Reset the generation result panel in Test Design tab.
 */
function resetGeneration() {
    // tdResult always visible
    const _fc3 = document.getElementById('tdFileCard'); if (_fc3) _fc3.style.display = 'none';
    document.getElementById('tdGenLog').innerHTML       = '';
    document.getElementById('tdResultStatus').textContent = '';
    document.getElementById('tdGenerateBtn').disabled   = false;
    document.getElementById('tdGenerateBtn').textContent = '⚡ Generate Test Scripts';
}
// ── Server Status & Restart ───────────────────────────────────────────────

let _serverStatusPollId = null;

async function fetchServerStatus() {
    try {
        const r = await fetch(`${SERVER}/api/server/status`);
        if (!r.ok) throw new Error('offline');
        const d = await r.json();
        return d;
    } catch {
        return null;
    }
}

function updateServerPill(data) {
    const dot   = document.getElementById('serverDot');
    const label = document.getElementById('serverPillLabel');
    if (!dot || !label) return;
    if (data && data.ok) {
        dot.style.background = '#10b981';
        label.style.color    = '#10b981';
        label.textContent    = `Server :${data.port}`;
    } else {
        dot.style.background = '#f87171';
        label.style.color    = '#f87171';
        label.textContent    = 'Server Offline';
    }
}

async function initServerStatusPoll() {
    const data = await fetchServerStatus();
    updateServerPill(data);
    clearInterval(_serverStatusPollId);
    _serverStatusPollId = setInterval(async () => {
        updateServerPill(await fetchServerStatus());
    }, 15000);
}

function showServerStatusModal() {
    document.getElementById('serverModal').style.display = 'flex';
    refreshServerStatus();
}

function closeServerModal() {
    document.getElementById('serverModal').style.display = 'none';
}

async function refreshServerStatus() {
    const body = document.getElementById('serverModalBody');
    body.textContent = 'Loading…';
    const d = await fetchServerStatus();
    updateServerPill(d);
    if (d && d.ok) {
        body.innerHTML = `
            <div style="display:grid;grid-template-columns:80px 1fr;gap:4px 12px;">
                <span style="color:#64748b;text-transform:uppercase;font-size:10px;">Status</span>
                <span style="color:#10b981;font-weight:700;">● Online</span>
                <span style="color:#64748b;text-transform:uppercase;font-size:10px;">Port</span>
                <span style="color:#e0e0e0;font-family:monospace;">:${d.port}</span>
                <span style="color:#64748b;text-transform:uppercase;font-size:10px;">PID</span>
                <span style="color:#e0e0e0;font-family:monospace;">${d.pid}</span>
                <span style="color:#64748b;text-transform:uppercase;font-size:10px;">Uptime</span>
                <span style="color:#e0e0e0;font-family:monospace;">${d.uptimeStr}</span>
                <span style="color:#64748b;text-transform:uppercase;font-size:10px;">Node</span>
                <span style="color:#e0e0e0;font-family:monospace;">${d.nodeVersion}</span>
                <span style="color:#64748b;text-transform:uppercase;font-size:10px;">Started</span>
                <span style="color:#e0e0e0;font-family:monospace;">${new Date(d.startedAt).toLocaleTimeString()}</span>
            </div>`;
        document.getElementById('serverRestartBtn').disabled = false;
    } else {
        body.innerHTML = `<span style="color:#f87171;">⚠ Server is offline or unreachable at ${SERVER}</span>`;
        document.getElementById('serverRestartBtn').disabled = true;
    }
}

async function restartServer() {
    if (!confirm('Restart the backend server now?')) return;
    const btn  = document.getElementById('serverRestartBtn');
    const body = document.getElementById('serverModalBody');
    btn.disabled = true;
    btn.textContent = 'Restarting…';
    body.innerHTML = '<span style="color:#f59e0b;">⟳ Sending restart signal…</span>';

    try { await fetch(`${SERVER}/api/server/restart`, { method: 'POST' }); } catch { /* may close before responding */ }

    // Poll until back online (max 30 s)
    body.innerHTML = '<span style="color:#f59e0b;">⟳ Waiting for server to come back online…</span>';
    const start = Date.now();
    const poll = setInterval(async () => {
        const d = await fetchServerStatus();
        if (d && d.ok) {
            clearInterval(poll);
            updateServerPill(d);
            btn.textContent = '⟳ Restart Server';
            btn.disabled = false;
            await refreshServerStatus();
        }
        if (Date.now() - start > 30000) {
            clearInterval(poll);
            body.innerHTML = '<span style="color:#f87171;">⚠ Server did not come back in 30 s. Check your terminal.</span>';
            btn.textContent = '⟳ Restart Server';
            btn.disabled = false;
        }
    }, 1500);
}


// ── Requirements Tab ─────────────────────────────────────────────────────────

let _reqTree           = [];
let _reqDocs           = [];
let _reqSelected       = null;
let _reqActiveFolder   = null;
let _reqRawItems       = [];
let _reqCollapsedFolders = new Set(); // tracks which folders are collapsed

async function reqLoadDocList() {
    try {
        const res  = await fetch(`${SERVER}/api/requirements/tree`);
        const data = await res.json();
        _reqTree = data.tree || [];
        _reqDocs = flattenTree(_reqTree);
        renderReqDocList();
    } catch(_) {}
}
function flattenTree(nodes, prefix) {
    const out = [];
    for (const n of nodes) {
        if (n.type === 'file') out.push({ ...n, displayPath: prefix ? `${prefix}/${n.name}` : n.name });
        else if (n.type === 'folder') out.push(...flattenTree(n.children||[], n.name));
    }
    return out;
}
function renderReqDocList() {
    const el = document.getElementById('reqDocList');
    if (!el) return;
    if (!_reqTree.length) {
        el.innerHTML = '<div style="font-size:11px;color:#334155;padding:10px;text-align:center;">No documents yet.<br><span style="color:#475569;">Click \u2794 New Folder or \u2794 Upload.</span></div>';
        return;
    }
    el.innerHTML = renderReqTreeNodes(_reqTree, 0);
}
function renderReqTreeNodes(nodes, depth) {
    const EXT_COLOR = { TXT:'#60a5fa', CSV:'#10b981', PDF:'#f87171', DOCX:'#a78bfa', XLSX:'#34d399' };
    return nodes.map(n => {
        const ind = depth * 10;
        if (n.type === 'folder') {
            const fid       = 'rfdr-' + (n.name).replace(/[^a-zA-Z0-9]/g,'_');
            const isAF      = _reqActiveFolder === n.name;
            const collapsed = _reqCollapsedFolders.has(n.name);
            const ch        = renderReqTreeNodes(n.children||[], depth+1);
            const safeName  = n.name.replace(/'/g,"\\'");
            return `<div>
  <div id="drop-${fid}"
    style="display:flex;align-items:center;gap:0;padding:5px 4px 5px ${6+ind}px;border-radius:4px;border:1px solid ${isAF?'rgba(16,185,129,0.4)':'transparent'};background:${isAF?'rgba(16,185,129,0.06)':'none'};transition:all 0.15s;"
    onmouseover="this.querySelector('.req-folder-actions').style.opacity='1'"
    onmouseout="this.querySelector('.req-folder-actions').style.opacity='0'"
    ondragover="reqDragOver(event,'${safeName}')"
    ondragleave="reqDragLeave(event,'${safeName}')"
    ondrop="reqDrop(event,'${safeName}')">
    <div onclick="reqToggleFolder('${safeName}','${fid}')" style="display:flex;align-items:center;gap:5px;flex:1;cursor:pointer;overflow:hidden;">
      <span id="chv-${fid}" style="font-size:9px;color:#475569;transition:transform 0.2s;display:inline-block;transform:rotate(${collapsed?'0':'90'}deg)">▶</span>
      <span style="font-size:13px">${collapsed?'📁':'📂'}</span>
      <span style="font-size:11px;font-weight:600;color:${isAF?'#10b981':'#94a3b8'};overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${n.name}">${n.name}</span>
      <span style="font-size:9px;color:#475569;flex-shrink:0">${(n.children||[]).filter(c=>c.type==='file').length}</span>
    </div>
    <div class="req-folder-actions" style="display:flex;align-items:center;gap:2px;opacity:0;transition:opacity 0.15s;flex-shrink:0;">
      <button onclick="event.stopPropagation();reqNewFileInFolder('${safeName}')" title="New file in folder" style="background:none;border:none;color:#64748b;cursor:pointer;padding:2px 4px;border-radius:3px;font-size:11px;line-height:1;" onmouseover="this.style.color='#10b981'" onmouseout="this.style.color='#64748b'">➕</button>
      <button onclick="event.stopPropagation();reqRenameFolder('${safeName}')" title="Rename folder" style="background:none;border:none;color:#64748b;cursor:pointer;padding:2px 4px;border-radius:3px;font-size:11px;line-height:1;" onmouseover="this.style.color='#60a5fa'" onmouseout="this.style.color='#64748b'">✏️</button>
      <button onclick="event.stopPropagation();reqDeleteFolder('${safeName}')" title="Delete folder" style="background:none;border:none;color:#64748b;cursor:pointer;padding:2px 4px;border-radius:3px;font-size:11px;line-height:1;" onmouseover="this.style.color='#f87171'" onmouseout="this.style.color='#64748b'">🗑️</button>
    </div>
  </div>
  <div id="${fid}" style="display:${collapsed?'none':'block'}">${ch}</div>
</div>`;
        } else {
            const ext      = n.name.split('.').pop().toUpperCase();
            const ec       = EXT_COLOR[ext]||'#64748b';
            const fp       = n.path||n.name;
            const ia       = _reqSelected === fp;
            const safeFp   = fp.replace(/'/g,"\\'");
            const safeName = n.name.replace(/'/g,"\\'");
            // Only root-level files (depth === 0) are draggable into folders
            const draggable = depth === 0 ? `draggable="true" ondragstart="reqDragStart(event,'${safeFp}')" ondragend="this.style.opacity='1'"` : '';
            const dragCursor = depth === 0 ? 'cursor:grab;' : '';
            return `<div ${draggable}
  style="display:flex;align-items:center;gap:0;padding:4px 4px 4px ${6+ind}px;border-radius:4px;border:1px solid ${ia?'rgba(59,130,246,0.4)':'transparent'};background:${ia?'rgba(59,130,246,0.08)':'none'};margin-bottom:2px;transition:all 0.15s;${dragCursor}"
  onmouseover="this.querySelector('.req-file-actions').style.opacity='1'"
  onmouseout="this.querySelector('.req-file-actions').style.opacity='0'">
  <div onclick="reqSelectDoc('${safeFp}','${safeName}')" style="display:flex;align-items:center;gap:5px;flex:1;cursor:pointer;overflow:hidden;">
    <span style="font-size:9px;font-weight:700;background:${ec}22;color:${ec};border:1px solid ${ec}44;padding:1px 4px;border-radius:3px;flex-shrink:0">${ext}</span>
    <span style="font-size:11px;color:${ia?'#93c5fd':'#cbd5e1'};overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1" title="${n.name}">${n.name}</span>
  </div>
  <div class="req-file-actions" style="display:flex;align-items:center;gap:2px;opacity:0;transition:opacity 0.15s;flex-shrink:0;">
    <button onclick="event.stopPropagation();reqRenameFile('${safeFp}','${safeName}')" title="Rename file" style="background:none;border:none;color:#64748b;cursor:pointer;padding:2px 4px;border-radius:3px;font-size:11px;line-height:1;" onmouseover="this.style.color='#60a5fa'" onmouseout="this.style.color='#64748b'">✏️</button>
    <button onclick="event.stopPropagation();reqDeleteFile('${safeFp}','${safeName}')" title="Delete file" style="background:none;border:none;color:#64748b;cursor:pointer;padding:2px 4px;border-radius:3px;font-size:11px;line-height:1;" onmouseover="this.style.color='#f87171'" onmouseout="this.style.color='#64748b'">🗑️</button>
  </div>
</div>`;
        }
    }).join('');
}
function reqToggleFolder(name, fid) {
    // Toggle collapsed state in the persistent Set
    if (_reqCollapsedFolders.has(name)) {
        _reqCollapsedFolders.delete(name);
    } else {
        _reqCollapsedFolders.add(name);
    }
    const collapsed = _reqCollapsedFolders.has(name);
    // Update active folder tracking
    _reqActiveFolder = collapsed ? (_reqActiveFolder === name ? null : _reqActiveFolder) : name;
    // Re-render the list — collapsed state is read from the Set so it persists correctly
    renderReqDocList();
}

// ── Drag-and-drop: move root-level files into folders ─────────────────────────
let _reqDragFilePath = null;   // the relPath of the file being dragged

function reqDragStart(event, filePath) {
    _reqDragFilePath = filePath;
    event.dataTransfer.effectAllowed = 'move';
    event.dataTransfer.setData('text/plain', filePath);
    // Dim the dragged element
    setTimeout(() => { if (event.target) event.target.style.opacity = '0.4'; }, 0);
}

function reqDragOver(event, folderName) {
    event.preventDefault();
    event.dataTransfer.dropEffect = 'move';
    // Only highlight if we actually have a file being dragged
    if (!_reqDragFilePath) return;
    const fid = 'drop-' + 'rfdr-' + folderName.replace(/[^a-zA-Z0-9]/g,'_');
    const el  = document.getElementById(fid);
    if (el) {
        el.style.borderColor  = 'rgba(16,185,129,0.7)';
        el.style.background   = 'rgba(16,185,129,0.12)';
        el.style.boxShadow    = '0 0 0 2px rgba(16,185,129,0.25)';
    }
}

function reqDragLeave(event, folderName) {
    // Only clear highlight if leaving the folder row itself (not a child)
    if (event.currentTarget.contains(event.relatedTarget)) return;
    const fid = 'drop-' + 'rfdr-' + folderName.replace(/[^a-zA-Z0-9]/g,'_');
    const el  = document.getElementById(fid);
    if (el) {
        el.style.borderColor = '';
        el.style.background  = '';
        el.style.boxShadow   = '';
    }
}

async function reqDrop(event, folderName) {
    event.preventDefault();
    // Clear highlight on folder
    const fid = 'drop-' + 'rfdr-' + folderName.replace(/[^a-zA-Z0-9]/g,'_');
    const el  = document.getElementById(fid);
    if (el) { el.style.borderColor = ''; el.style.background = ''; el.style.boxShadow = ''; }

    const filePath = _reqDragFilePath || event.dataTransfer.getData('text/plain');
    _reqDragFilePath = null;
    if (!filePath) return;

    // Don't move if the file is already inside a folder (it has a slash)
    if (filePath.includes('/')) { return; }

    try {
        const res = await fetch(`${SERVER}/api/requirements/file/move`, {
            method:  'PUT',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ oldPath: filePath, newFolder: folderName })
        });
        const d = await res.json();
        if (!res.ok) throw new Error(d.error || 'Move failed');
        // If the moved file was selected, update the selection to the new path
        if (_reqSelected === filePath) _reqSelected = d.relPath;
        // Expand the destination folder so the file is visible
        _reqCollapsedFolders.delete(folderName);
        _reqActiveFolder = folderName;
        await reqLoadDocList();
    } catch(e) {
        alert('Could not move file: ' + e.message);
    }
}
async function reqSelectDoc(filePath, label) {
    _reqSelected = filePath;
    renderReqDocList();
    const main = document.getElementById('reqMainContent');
    const name = label || filePath.split('/').pop();
    main.innerHTML = `<div style="color:#60a5fa;font-size:12px;padding:4px 0 16px">Loading ${name}…</div>`;
    try {
        const res  = await fetch(`${SERVER}/api/requirements/content?file=${encodeURIComponent(filePath)}`);
        const data = await res.json();
        const safeFp   = filePath.replace(/'/g,"\\'");
        const safeName = name.replace(/'/g,"\\'");
        const isEditable = /\.(txt|csv|md|pdf|xlsx|xls|docx)$/i.test(name);

        if (data.content) {
            const isBinary = /\.(pdf|xlsx|xls|docx)$/i.test(name);
            const isXlsx   = /\.(xlsx|xls)$/i.test(name);
            const editLabel = isBinary ? '✏️ Edit as Text' : '✏️ Edit';
            const editHint  = isBinary ? `<span style="font-size:10px;color:#64748b;font-style:italic;">Saves as .txt copy</span>` : '';

            // For XLSX: skeleton HTML only — table is rendered via JS after innerHTML is set
            let viewBlockInner = '';
            if (isXlsx && data.sheets && data.sheets.length) {
                const sheetTabsHtml = data.sheets.length > 1
                    ? `<div id="reqXlsxTabs" style="display:flex;gap:0;border-bottom:1px solid #1a2f4a;flex-wrap:wrap;">
                        ${data.sheets.map((s, i) => `<button onclick="reqXlsxShowSheet(${i})" id="reqXlsxTab_${i}" class="xlsx-sheet-tab${i===0?' active':''}">${escHtml(s.name)}</button>`).join('')}
                       </div>`
                    : '';
                viewBlockInner = `
                  ${sheetTabsHtml}
                  <div id="reqXlsxTableWrap" style="overflow-x:auto;max-height:520px;overflow-y:auto;">
                    <div id="reqXlsxTableInner"></div>
                  </div>`;
            } else {
                viewBlockInner = `<div style="padding:16px 20px;"><pre style="font-family:monospace;font-size:12px;color:#94a3b8;white-space:pre-wrap;word-break:break-word;margin:0;line-height:1.7;">${escHtml(data.content)}</pre></div>`;
            }

            main.innerHTML = `
<div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
  <span style="font-size:14px;font-weight:600;color:white;">📄 ${escHtml(name)}</span>
  <span style="font-size:10px;background:rgba(59,130,246,0.12);color:#60a5fa;border:1px solid rgba(59,130,246,0.25);padding:2px 8px;border-radius:8px;">${data.type.toUpperCase()}</span>
  ${isXlsx && data.sheets ? `<span style="font-size:10px;color:#475569;">${data.sheets.length} sheet${data.sheets.length!==1?'s':''} · ${data.sheets.reduce((s,sh)=>s+(sh.rows?Math.max(0,sh.rows.length-1):0),0)} rows</span>` : ''}
  <div style="margin-left:auto;display:flex;gap:8px;align-items:center;">
    ${editHint}
    ${isEditable ? `
    <div id="reqViewActions" style="display:flex;gap:8px;align-items:center;">
      <button id="reqEditBtn" onclick="reqEnableEdit('${safeFp}','${safeName}')" style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:7px 16px;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;transition:opacity 0.2s;" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">✏️ Edit</button>
    </div>
    <div id="reqEditActions" style="display:none;gap:8px;align-items:center;">
      <button onclick="reqSaveFileContent('${safeFp}','${safeName}')" style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,#10b981,#059669);border:none;color:white;padding:7px 16px;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;transition:opacity 0.2s;" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">💾 Save</button>
      <button onclick="reqCancelEdit('${safeFp}','${safeName}')" style="display:inline-flex;align-items:center;gap:6px;background:none;border:1px solid rgba(248,113,113,0.5);color:#f87171;padding:7px 16px;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.background='rgba(248,113,113,0.1)'" onmouseout="this.style.background='none'">✕ Cancel</button>
      ${isBinary ? `<span style="font-size:10px;color:#64748b;font-style:italic;">Saves as .txt copy</span>` : ''}
    </div>` : ''}
  </div>
</div>
<div id="reqViewBlock" style="background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;overflow:hidden;">
  ${viewBlockInner}
</div>
<div id="reqEditBlock" style="display:none;flex-direction:column;gap:10px;">
  <textarea id="reqEditArea" style="width:100%;min-height:420px;background:#050e1a;border:1px solid #3b82f6;border-radius:6px;padding:16px 20px;font-family:monospace;font-size:12px;color:#e2e8f0;line-height:1.7;resize:vertical;outline:none;box-sizing:border-box;">${escHtml(data.content)}</textarea>
</div>`;

            // After innerHTML is set, render the XLSX table via live JS (scripts in innerHTML don't execute)
            if (isXlsx && data.sheets && data.sheets.length) {
                _reqXlsxSheets = data.sheets;
                reqXlsxShowSheet(0);
            }
        } else {
            // Check if this is an editable file type that's just empty (e.g. newly created)
            const isEditableEmpty = /\.(txt|csv|md)$/i.test(name);
            if (isEditableEmpty) {
                // Empty editable file — render the edit UI directly, pre-opened so the user can start typing
                main.innerHTML = `
<div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
  <span style="font-size:14px;font-weight:600;color:white;">📄 ${escHtml(name)}</span>
  <span style="font-size:10px;background:rgba(16,185,129,0.12);color:#10b981;border:1px solid rgba(16,185,129,0.25);padding:2px 8px;border-radius:8px;">NEW · EMPTY</span>
  <span style="font-size:10px;color:#475569;font-style:italic;">Add your content below and click Save</span>
</div>
<div id="reqViewBlock" style="display:none;"></div>
<div id="reqEditBlock" style="display:flex;flex-direction:column;gap:10px;">
  <textarea id="reqEditArea" placeholder="Start typing your requirements here…" style="width:100%;min-height:420px;background:#050e1a;border:1px solid #3b82f6;border-radius:6px;padding:16px 20px;font-family:monospace;font-size:12px;color:#e2e8f0;line-height:1.7;resize:vertical;outline:none;box-sizing:border-box;"></textarea>
  <div style="display:flex;gap:8px;align-items:center;">
    <button onclick="reqSaveFileContent('${safeFp}','${safeName}')" style="background:linear-gradient(135deg,#10b981,#059669);border:none;color:white;padding:8px 20px;border-radius:5px;font-size:12px;font-weight:700;cursor:pointer;transition:opacity 0.2s;" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">💾 Save</button>
    <button onclick="reqCancelEdit('${safeFp}','${safeName}')" style="background:none;border:1px solid #2a3f5a;color:#94a3b8;padding:8px 20px;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.borderColor='#f87171';this.style.color='#f87171'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#94a3b8'">✕ Cancel</button>
  </div>
</div>`;
                document.getElementById('reqEditArea').focus();
            } else {
                main.innerHTML = `
<div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
  <span style="font-size:14px;font-weight:600;color:white;">📄 ${escHtml(name)}</span>
</div>
<div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:8px;padding:32px;text-align:center;">
  <div style="font-size:32px;margin-bottom:12px;">📎</div>
  <div style="font-size:13px;color:#94a3b8;margin-bottom:6px;">${escHtml(data.message||'Binary file — preview not available')}</div>
  <div style="font-size:11px;color:#475569;">${escHtml(filePath)}</div>
</div>`;
            }
        }
    } catch(e) { main.innerHTML = `<div style="color:#f87171;font-size:12px">Failed: ${escHtml(e.message)}</div>`; }
}

/** XLSX tabular rendering helpers */
let _reqXlsxSheets = [];

function reqXlsxShowSheet(idx) {
    const sheet = _reqXlsxSheets[idx];
    if (!sheet) return;

    // Update tab active state
    _reqXlsxSheets.forEach((_, i) => {
        const tab = document.getElementById('reqXlsxTab_' + i);
        if (tab) tab.className = 'xlsx-sheet-tab' + (i === idx ? ' active' : '');
    });

    const wrap = document.getElementById('reqXlsxTableInner');
    if (!wrap) return;

    if (!sheet.rows || !sheet.rows.length) {
        wrap.innerHTML = '<div style="padding:24px;color:#475569;font-size:12px;text-align:center;">Sheet is empty</div>';
        return;
    }

    const headerRow = sheet.rows[0];
    const dataRows  = sheet.rows.slice(1);
    const colCount  = Math.max(...sheet.rows.map(r => r.length), 1);

    let html = '<table class="xlsx-table"><thead><tr>';
    for (let ci = 0; ci < colCount; ci++) {
        const cell = headerRow[ci] !== undefined ? headerRow[ci] : '';
        html += `<th>${cell.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</th>`;
    }
    html += '</tr></thead><tbody>';

    dataRows.forEach(row => {
        html += '<tr>';
        for (let ci = 0; ci < colCount; ci++) {
            const cell = row[ci] !== undefined ? String(row[ci]) : '';
            html += `<td>${cell.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</td>`;
        }
        html += '</tr>';
    });

    html += '</tbody></table>';
    wrap.innerHTML = html;
}

/** Switch the view panel to edit mode */
function reqEnableEdit(filePath, name) {
    const viewBlock   = document.getElementById('reqViewBlock');
    const editBlock   = document.getElementById('reqEditBlock');
    const viewActions = document.getElementById('reqViewActions');
    const editActions = document.getElementById('reqEditActions');
    if (!viewBlock || !editBlock) return;
    viewBlock.style.display   = 'none';
    editBlock.style.display   = 'flex';
    if (viewActions) viewActions.style.display = 'none';
    if (editActions) { editActions.style.display = 'flex'; editActions.style.marginLeft = 'auto'; }
    const area = document.getElementById('reqEditArea');
    if (area) area.focus();
}

/** Save edited content back to the server */
async function reqSaveFileContent(filePath, name) {
    const area = document.getElementById('reqEditArea');
    if (!area) return;
    const content = area.value;
    try {
        const res = await fetch(`${SERVER}/api/requirements/content`, {
            method:  'PUT',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ file: filePath, content })
        });
        const d = await res.json();
        if (!res.ok) throw new Error(d.error || 'Save failed');
        // For PDF/XLSX the server saves a sibling .txt file and returns the new path
        if (d.savedAs && d.savedAs !== filePath) {
            // Update the selection to the new .txt file and reload the doc list
            _reqSelected = d.savedAs;
            await reqLoadDocList();
            await reqSelectDoc(d.savedAs, d.savedAs.split('/').pop());
        } else {
            // Reload the doc in view mode with updated content
            await reqSelectDoc(filePath, name);
        }
    } catch(e) { alert('Save failed: ' + e.message); }
}

/** Cancel edit and return to view mode */
function reqCancelEdit(filePath, name) {
    reqSelectDoc(filePath, name);
}

/** Navigate to Test Cases tab and pre-load the local file as the requirement source */
async function reqGenerateTestsFromFile(filePath, fileName, btn) {
    // Fetch the content if not already loaded
    let content = '';
    try {
        if (btn) { btn.disabled = true; btn.textContent = '⏳ Loading…'; }
        const res  = await fetch(`${SERVER}/api/requirements/content?file=${encodeURIComponent(filePath)}`);
        const data = await res.json();
        content = data.content || data.message || '';
    } catch(_) {}

    // Build a synthetic issue object from the file
    const key     = fileName;                           // use filename as the identifier
    const summary = fileName.replace(/\.[^.]+$/, '');   // strip extension for summary

    // Switch to Test Cases tab
    switchToTab('manualtests');

    // Show the panel and populate fields directly (no API call needed)
    document.getElementById('mtEmpty').style.display   = 'none';
    const panel = document.getElementById('mtPanel');
    if (panel) panel.style.display = 'flex';

    document.getElementById('mtIssueKey').textContent      = key;
    document.getElementById('mtIssueSummary').textContent  = summary;
    document.getElementById('mtIssueMeta').innerHTML       = `<span class="testdesign-meta-item"><span class="testdesign-meta-label">Source:</span> Local file</span>`;
    document.getElementById('mtDescription').textContent   = content || 'No text content available for this file.';
    document.getElementById('mtResults').style.display     = 'none';
    document.getElementById('mtLoading').style.display     = 'none';
    document.getElementById('mtError').style.display       = 'none';

    const srcBadge = document.getElementById('mtSourceBadge');
    if (srcBadge) { srcBadge.style.display = 'inline-flex'; srcBadge.textContent = '📄 Local File'; }

    // Re-expand description section
    const descBox    = document.getElementById('mtDescriptionBox');
    const descToggle = document.getElementById('mtDescToggle');
    if (descBox)    descBox.style.display    = 'block';
    if (descToggle) descToggle.textContent   = '▾';

    mtTestCases = null;
    mtCurrentIssue = { key, summary, description: content };
    document.getElementById('mtGenerateBtn').disabled = false;
}
async function reqHandleUpload(input) {
    const file = input.files && input.files[0];
    if (!file) return;
    if (!/\.(docx|pdf|xlsx|csv|txt)$/i.test(file.name)) { alert('Invalid type. Allowed: .docx .pdf .xlsx .csv .txt'); input.value=''; return; }
    const main = document.getElementById('reqMainContent');
    main.innerHTML = `<div style="color:#60a5fa;font-size:12px">⏳ Uploading ${escHtml(file.name)}…</div>`;
    const fd = new FormData(); fd.append('file', file);
    const qs = _reqActiveFolder ? `?folder=${encodeURIComponent(_reqActiveFolder)}` : '';
    try {
        const res  = await fetch(`${SERVER}/api/requirements/upload${qs}`, { method:'POST', body:fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error||'Upload failed');
        input.value = '';
        await reqLoadDocList();
        await reqSelectDoc(data.relPath||data.filename, file.name);
    } catch(e) { main.innerHTML = `<div style="color:#f87171;padding:20px;font-size:12px">❌ ${escHtml(e.message)}</div>`; input.value=''; }
}
async function reqNewFolder() {
    const name = prompt('Folder name (max 12 characters):');
    if (!name || !name.trim()) return;
    if (name.trim().length > 12) { alert('Folder name must be 12 characters or fewer.'); return; }
    if (/[<>:"\/\\|?*]/.test(name)) { alert('Invalid folder name.'); return; }
    try {
        const res = await fetch(`${SERVER}/api/requirements/folder`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({name:name.trim()}) });
        const d   = await res.json();
        if (!res.ok) throw new Error(d.error||'Failed');
        _reqActiveFolder = name.trim();
        await reqLoadDocList();
    } catch(e) { alert('Error: '+e.message); }
}
async function reqNewFileInFolder(folderName) {
    const raw = prompt(`New file name in "${folderName}"\n(allowed types: .txt, .csv, .md)`);
    if (!raw || !raw.trim()) return;
    let fileName = raw.trim();
    // Auto-append .txt if no recognised extension given
    if (!/\.(txt|csv|md)$/i.test(fileName)) {
        fileName += '.txt';
    }
    if (/[<>:"\/\\|?*]/.test(fileName)) { alert('Invalid file name.'); return; }
    try {
        const res = await fetch(`${SERVER}/api/requirements/upload-json`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ name: fileName, content: '', folder: folderName })
        });
        const d = await res.json();
        if (!res.ok) throw new Error(d.error || 'Failed');
        // Expand the folder so the new file is visible
        _reqCollapsedFolders.delete(folderName);
        _reqActiveFolder = folderName;
        await reqLoadDocList();
        // Open the new file — reqSelectDoc auto-opens edit mode for empty editable files
        await reqSelectDoc(d.relPath, fileName);
    } catch(e) { alert('Error: ' + e.message); }
}
async function reqRenameFolder(oldName) {
    const newName = prompt(`Rename folder "${oldName}" to (max 12 characters):`, oldName);
    if (!newName || !newName.trim() || newName.trim() === oldName) return;
    if (newName.trim().length > 12) { alert('Folder name must be 12 characters or fewer.'); return; }
    if (/[<>:"\/\\|?*]/.test(newName)) { alert('Invalid folder name.'); return; }
    try {
        const res = await fetch(`${SERVER}/api/requirements/folder`, { method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify({oldName, newName:newName.trim()}) });
        const d   = await res.json();
        if (!res.ok) throw new Error(d.error||'Failed');
        if (_reqActiveFolder === oldName) _reqActiveFolder = newName.trim();
        await reqLoadDocList();
    } catch(e) { alert('Error: '+e.message); }
}
async function reqDeleteFolder(name) {
    if (!confirm(`Delete folder "${name}" and all its files? This cannot be undone.`)) return;
    try {
        const res = await fetch(`${SERVER}/api/requirements/folder`, { method:'DELETE', headers:{'Content-Type':'application/json'}, body:JSON.stringify({name}) });
        const d   = await res.json();
        if (!res.ok) throw new Error(d.error||'Failed');
        if (_reqActiveFolder === name) _reqActiveFolder = null;
        if (_reqSelected && _reqSelected.startsWith(name + '/')) _reqSelected = null;
        await reqLoadDocList();
    } catch(e) { alert('Error: '+e.message); }
}
async function reqRenameFile(filePath, oldName) {
    const ext      = oldName.includes('.') ? '.' + oldName.split('.').pop() : '';
    const baseName = oldName.includes('.') ? oldName.slice(0, oldName.lastIndexOf('.')) : oldName;
    const newBase  = prompt(`Rename "${oldName}" to:`, baseName);
    if (!newBase || !newBase.trim() || newBase.trim() + ext === oldName) return;
    const newName = newBase.trim() + ext;
    if (/[<>:"\/\\|?*]/.test(newBase.trim())) { alert('Invalid file name.'); return; }
    try {
        const res = await fetch(`${SERVER}/api/requirements/file`, { method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify({oldPath:filePath, newName}) });
        const d   = await res.json();
        if (!res.ok) throw new Error(d.error||'Failed');
        if (_reqSelected === filePath) _reqSelected = d.relPath;
        await reqLoadDocList();
    } catch(e) { alert('Error: '+e.message); }
}
async function reqDeleteFile(filePath, name) {
    if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
    try {
        const res = await fetch(`${SERVER}/api/requirements/file`, { method:'DELETE', headers:{'Content-Type':'application/json'}, body:JSON.stringify({path:filePath}) });
        const d   = await res.json();
        if (!res.ok) throw new Error(d.error||'Failed');
        if (_reqSelected === filePath) {
            _reqSelected = null;
            const main = document.getElementById('reqMainContent');
            if (main) main.innerHTML = `<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#475569;text-align:center;gap:12px;"><div style="font-size:36px;">📄</div><div style="font-size:14px;color:#94a3b8;">Select a document to preview</div></div>`;
        }
        await reqLoadDocList();
    } catch(e) { alert('Error: '+e.message); }
}
function reqOnToolChange(toolType, suppressPopup) {
    const jiraWrap     = document.getElementById('reqJiraViewWrap');
    const adoWrap      = document.getElementById('reqAdoFilterWrap');
    const boardWrap    = document.getElementById('reqBoardOpenWrap');
    const wiSection    = document.getElementById('reqWorkItemsSection');
    const wiLabel      = document.getElementById('reqWorkItemsLabel');
    const boardLbl     = document.getElementById('reqBoardOpenLabel');
    const uploadWrap   = document.getElementById('reqUploadWrap');
    const connFields   = document.getElementById('reqConnectFields');
    const docsHeader   = document.getElementById('reqDocumentsHeader');
    const docsList     = document.getElementById('reqDocList');
    const wsWrap       = document.getElementById('reqWorkspaceWrap');
    const wsSel        = document.getElementById('reqWorkspaceSelect');
    if (jiraWrap)   jiraWrap.style.display   = 'none';
    if (adoWrap)    adoWrap.style.display    = 'none';
    if (boardWrap)  boardWrap.style.display  = 'none';
    if (uploadWrap) uploadWrap.style.display = 'none';
    if (connFields) connFields.style.display = 'none';
    if (wsWrap)     wsWrap.style.display     = 'none';
    // Reset: show documents, hide work items by default
    if (docsHeader) docsHeader.style.display = 'flex';
    if (docsList)   docsList.style.display   = 'block';

    if (toolType === 'Jira') {
        // Hide documents panel, show only work items
        if (docsHeader) docsHeader.style.display = 'none';
        if (docsList)   docsList.style.display   = 'none';
        if (connFields) {
            connFields.style.display = 'flex';
            // Pre-fill from config
            document.getElementById('reqConnAppUrl').value = (JIRA_CONFIG.jiraUrl || JIRA_CONFIG.baseUrl || '').replace(/\/$/, '').replace(/\/jira\/?$/, '');
            document.getElementById('reqConnUsername').value = JIRA_CONFIG.email || '';
            document.getElementById('reqConnPassword').value = JIRA_CONFIG.apiToken || '';
        }
        if (jiraWrap)  jiraWrap.style.display  = 'flex';
        if (boardWrap) boardWrap.style.display = 'flex';
        if (boardLbl)  boardLbl.textContent    = '🟦 Open in Jira Board';
        if (wiLabel)   wiLabel.textContent     = 'Work Items';
        if (wiSection) wiSection.style.display = 'flex';
        const adoBtn  = document.getElementById('reqAdoBoardBtn');
        const jiraBtn = document.getElementById('reqJiraBoardBtn');
        if (adoBtn)  adoBtn.style.display  = 'none';
        if (jiraBtn) jiraBtn.style.display = 'flex';
        onToolSourceChange('Jira');
        // Sync tool selection to Test Cases and Test Design tabs
        reqSyncToolToOtherTabs('Jira');
        // Load workspace list then work items
        reqLoadWorkspaces('Jira');
    } else if (toolType === 'ADO') {
        // Hide documents panel, show only work items
        if (docsHeader) docsHeader.style.display = 'none';
        if (docsList)   docsList.style.display   = 'none';
        if (connFields) {
            connFields.style.display = 'flex';
            // Pre-fill from config
            document.getElementById('reqConnAppUrl').value = (JIRA_CONFIG.adoOrgUrl || '').replace(/\/$/, '');
            document.getElementById('reqConnUsername').value = '';
            document.getElementById('reqConnPassword').value = JIRA_CONFIG.adoPat || '';
        }
        if (adoWrap)   adoWrap.style.display   = 'flex';
        if (boardWrap) boardWrap.style.display = 'flex';
        if (wiLabel)   wiLabel.textContent     = 'Work Items';
        if (wiSection) wiSection.style.display = 'flex';
        const adoBtn  = document.getElementById('reqAdoBoardBtn');
        const jiraBtn = document.getElementById('reqJiraBoardBtn');
        if (adoBtn) {
            adoBtn.style.display = 'flex';
            const base    = (JIRA_CONFIG.adoOrgUrl || '').replace(/\/$/, '');
            const project = JIRA_CONFIG.adoProject || JIRA_CONFIG.project || '';
            adoBtn.href   = base && project
                ? `${base}/${encodeURIComponent(project)}/_boards`
                : (base ? `${base}/_boards` : '#');
        }
        if (jiraBtn) jiraBtn.style.display = 'none';
        onToolSourceChange('ADO');
        // Sync tool selection to Test Cases and Test Design tabs
        reqSyncToolToOtherTabs('ADO');
        // Load workspace list then work items
        reqLoadWorkspaces('ADO');
    } else if (toolType === 'LocalHost') {
        if (uploadWrap) uploadWrap.style.display = 'flex';
        if (wiSection)  wiSection.style.display  = 'none';
        // Sync LocalHost to Test Cases and Test Design tabs
        reqSyncToolToOtherTabs('LocalHost');
    } else {
        if (wiSection) wiSection.style.display = 'none';
    }
}
function reqOnJiraViewChange(view) { reqLoadWorkItems('Jira',view); }

/**
 * Sync the selected test management tool from the Requirements tab
 * to the Test Cases (mtToolSelect) and Test Design (tdToolSelect) dropdowns,
 * then trigger their respective change handlers so the work items lists load.
 */
function reqSyncToolToOtherTabs(toolType) {
    const mtSel = document.getElementById('mtToolSelect');
    const tdSel = document.getElementById('tdToolSelect');
    if (mtSel && mtSel.value !== toolType) {
        mtSel.value = toolType;
        mtOnToolChange(toolType);
    }
    if (tdSel && tdSel.value !== toolType) {
        tdSel.value = toolType;
        tdOnToolChange(toolType);
    }
}

/**
 * Fetch workspaces/projects from Jira or ADO and populate the
 * #reqWorkspaceSelect dropdown inside the Work Items panel.
 * After populating, auto-selects the current project and loads its items.
 */
async function reqLoadWorkspaces(toolType) {
    const wsWrap = document.getElementById('reqWorkspaceWrap');
    const wsSel  = document.getElementById('reqWorkspaceSelect');
    const listEl = document.getElementById('reqWorkItemList');
    if (!wsWrap || !wsSel) { reqLoadWorkItems(toolType, 'all'); return; }

    // Show loading state inside the list while workspaces load
    if (listEl) listEl.innerHTML = '<div style="font-size:11px;color:#334155;padding:10px;text-align:center;">Loading workspaces…</div>';

    try {
        const isADO = toolType === 'ADO';
        const data  = await fetch(`${SERVER}/api/${isADO ? 'ado' : 'jira'}/projects`).then(r => r.json());
        const projects = data.projects || [];

        if (!projects.length) {
            // No projects found — hide workspace dropdown and load items directly
            wsWrap.style.display = 'none';
            reqLoadWorkItems(toolType, 'all');
            return;
        }

        // Build options
        wsSel.innerHTML = '<option value="">— Select Workspace —</option>' +
            projects.map(p => {
                const label = isADO ? `☁️ ${p.name}` : `📁 ${p.key} — ${p.name}`;
                const selected = p.key === JIRA_CONFIG.project ? ' selected' : '';
                return `<option value="${escHtml(p.key)}"${selected}>${escHtml(label)}</option>`;
            }).join('');

        wsWrap.style.display = 'flex';

        // If we already have a current project selected, load its items immediately
        const currentProject = JIRA_CONFIG.project || (projects.length ? projects[0].key : '');
        if (currentProject) {
            wsSel.value = currentProject;
            JIRA_CONFIG.project = currentProject;
            reqLoadWorkItems(toolType, 'all');
        } else {
            if (listEl) listEl.innerHTML = '<div style="font-size:11px;color:#475569;padding:10px;text-align:center;">Select a workspace above.</div>';
        }
    } catch(e) {
        wsWrap.style.display = 'none';
        reqLoadWorkItems(toolType, 'all');
    }
}

/**
 * Called when the user picks a workspace from the #reqWorkspaceSelect dropdown.
 * Updates the global project config and reloads work items for that workspace.
 */
function reqOnWorkspaceChange(projectKey) {
    if (!projectKey) {
        const listEl = document.getElementById('reqWorkItemList');
        const countEl = document.getElementById('reqWorkItemCount');
        if (listEl)  listEl.innerHTML = '<div style="font-size:11px;color:#475569;padding:10px;text-align:center;">Select a workspace above.</div>';
        if (countEl) countEl.textContent = '';
        return;
    }
    // Sync project key across all project selects in the app
    JIRA_CONFIG.project = projectKey;
    ['jiraProjectSelect','mtProjectSelect','tdProjectSelect','jiraBoardModalProjectSelect'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = projectKey;
    });
    const toolType = document.getElementById('reqToolSelect')?.value || 'Jira';
    reqLoadWorkItems(toolType, 'all');
}

/** Connect to Jira/ADO using the provided credentials */
async function reqConnect() {
    const appUrl   = document.getElementById('reqConnAppUrl').value.trim();
    const username = document.getElementById('reqConnUsername').value.trim();
    const password = document.getElementById('reqConnPassword').value.trim();
    const statusEl = document.getElementById('reqConnStatus');
    const btn      = document.getElementById('reqConnectBtn');
    const toolType = document.getElementById('reqToolSelect').value;

    if (!appUrl || !password) {
        statusEl.textContent = '⚠️ URL and API Key are required';
        statusEl.style.color = '#f59e0b';
        return;
    }

    btn.disabled = true;
    btn.textContent = 'Connecting...';
    statusEl.textContent = '';

    try {
        // Call server to test connection and load work items
        const res = await fetch(SERVER + '/api/test-connection-v2', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ toolType, appUrl, username, password })
        });
        const data = await res.json();

        if (res.ok && data.connected) {
            statusEl.textContent = '✅ Connected';
            statusEl.style.color = '#10b981';
            btn.textContent = '✅ Connected';
            btn.style.background = 'linear-gradient(135deg,#10b981,#059669)';
            // Reload work items
            reqLoadWorkItems(toolType, 'all');
            // Track token
            if (typeof tokenOnJiraContext === 'function') tokenOnJiraContext('');
        } else {
            statusEl.textContent = '❌ ' + (data.error || 'Connection failed');
            statusEl.style.color = '#f87171';
            btn.textContent = 'Connect';
            btn.disabled = false;
        }
    } catch(e) {
        statusEl.textContent = '❌ ' + e.message;
        statusEl.style.color = '#f87171';
        btn.textContent = 'Connect';
        btn.disabled = false;
    }

    setTimeout(function() {
        btn.textContent = 'Connect';
        btn.style.background = 'linear-gradient(135deg,#3b82f6,#2563eb)';
        btn.disabled = false;
    }, 3000);
}
/** Open Jira board in a popup window — same pattern as ADO */
function reqOpenJiraPopup() {
    const base    = (JIRA_CONFIG.jiraUrl || JIRA_CONFIG.baseUrl || '').replace(/\/$/, '');
    const project = JIRA_CONFIG.project || '';
    const url     = base && project
        ? `${base}/jira/software/projects/${encodeURIComponent(project)}/boards`
        : (base ? `${base}/jira/your-work` : '#');
    if (!base) { alert('Jira URL not configured. Check JIRA_BASE_URL in .env'); return; }
    const w    = Math.min(1200, screen.availWidth  - 80);
    const h    = Math.min(800,  screen.availHeight - 80);
    const left = Math.round((screen.availWidth  - w) / 2);
    const top  = Math.round((screen.availHeight - h) / 2);
    window.open(url, 'JiraBoardPopup',
        `width=${w},height=${h},left=${left},top=${top},` +
        `resizable=yes,scrollbars=yes,toolbar=no,menubar=no,location=no,status=no`
    );
}
function reqApplyAdoFilters() {
    const tf = document.getElementById('reqAdoTypeFilter')?.value || '';
    const af = document.getElementById('reqAdoAssignedTo')?.value || '';
    const sf = document.getElementById('reqAdoStateFilter')?.value || '';
    const f  = _reqRawItems.filter(i =>
        (!tf || i.issueType === tf) &&
        (!af || (af === '__unassigned__' ? !i.assigneeDisplayName : i.assigneeDisplayName === af)) &&
        (!sf || i.status === sf)
    );
    renderReqWorkItemList(f, 'ADO');
}
function reqClearAdoFilters() {
    ['reqAdoTypeFilter','reqAdoAssignedTo','reqAdoStateFilter'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = '';
    });
    renderReqWorkItemList(_reqRawItems, 'ADO');
}

/** Open the ADO work items as a popup modal inside the dashboard */
let _reqAdoRawItems = [];
async function reqOpenAdoBoard() {
    const modal = document.getElementById('reqAdoModal');
    if (!modal) return;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    // Set the "Open in Azure DevOps ↗" link inside the modal to the boards page
    const base    = (JIRA_CONFIG.adoOrgUrl || '').replace(/\/$/, '');
    const project = JIRA_CONFIG.adoProject || JIRA_CONFIG.project || '';
    const boardsUrl = base && project
        ? `${base}/${encodeURIComponent(project)}/_boards`
        : (base ? `${base}/_boards` : '#');
    const extLink = document.getElementById('reqAdoExternalLink');
    if (extLink) extLink.href = boardsUrl;
    await reqLoadAdoModal();
}
function closeReqAdoModal() {
    const modal = document.getElementById('reqAdoModal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
}

// ── Jira Popup Modal (Requirements tab) ──────────────────────────────────────
let _reqJiraRawItems = [];
async function reqOpenJiraBoard() {
    const modal = document.getElementById('reqJiraModal');
    if (!modal) return;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    // Set the "Open in Jira ↗" external link
    const base    = (JIRA_CONFIG.baseUrl || JIRA_CONFIG.jiraUrl || '').replace(/\/$/, '');
    const project = JIRA_CONFIG.project || '';
    const jiraUrl = base && project
        ? `${base}/jira/software/projects/${encodeURIComponent(project)}/boards`
        : (base ? `${base}/jira/your-work` : '#');
    const extLink = document.getElementById('reqJiraExternalLink');
    if (extLink) extLink.href = jiraUrl;
    await reqLoadJiraModal();
}
function closeReqJiraModal() {
    const modal = document.getElementById('reqJiraModal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
}
async function reqLoadJiraModal() {
    const body  = document.getElementById('reqJiraModalBody');
    const badge = document.getElementById('reqJiraModalBadge');
    const updAt = document.getElementById('reqJiraModalUpdatedAt');
    if (!body) return;
    body.innerHTML = '<div class="jira-state"><div class="icon">⏳</div><div class="msg">Fetching Jira issues…</div></div>';
    try {
        const res  = await fetch(`${SERVER}/api/jira/board?project=${encodeURIComponent(JIRA_CONFIG.project || '')}&view=all`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        _reqJiraRawItems = (data.columns || []).flatMap(c => c.issues || []);
        if (badge) badge.textContent = `${data.project} · ${data.total} issue${data.total !== 1 ? 's' : ''}`;
        if (updAt && data.fetchedAt) updAt.textContent = 'Updated: ' + new Date(data.fetchedAt).toLocaleTimeString();
        reqPopulateJiraModalAssignees(_reqJiraRawItems);
        reqRenderJiraModalBoard(_reqJiraRawItems);
    } catch(e) {
        body.innerHTML = `<div class="jira-state"><div class="icon">⚠️</div><div class="msg">${escHtml(e.message)}</div><button class="retry-btn" onclick="reqLoadJiraModal()">Retry</button></div>`;
    }
}
function reqPopulateJiraModalAssignees(items) {
    const sel = document.getElementById('reqJiraModalAssignee');
    if (!sel) return;
    const cur   = sel.value;
    const names = [...new Set(items.map(i => i.assigneeDisplayName).filter(Boolean))].sort();
    sel.innerHTML = '<option value="">All</option>' +
        names.map(n => `<option value="${escHtml(n)}"${n === cur ? ' selected' : ''}>${escHtml(n)}</option>`).join('');
}
function reqJiraModalFilter() {
    const tf = document.getElementById('reqJiraModalType')?.value     || '';
    const af = document.getElementById('reqJiraModalAssignee')?.value || '';
    const sf = document.getElementById('reqJiraModalStatus')?.value   || '';
    const f  = _reqJiraRawItems.filter(i =>
        (!tf || i.issueType === tf) &&
        (!af || i.assigneeDisplayName === af) &&
        (!sf || i.status === sf)
    );
    reqRenderJiraModalBoard(f);
}
function reqJiraClearModalFilters() {
    ['reqJiraModalType', 'reqJiraModalAssignee', 'reqJiraModalStatus'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = '';
    });
    reqRenderJiraModalBoard(_reqJiraRawItems);
}
function reqRenderJiraModalBoard(items) {
    const body = document.getElementById('reqJiraModalBody');
    if (!body) return;
    if (!items.length) {
        body.innerHTML = '<div class="jira-state"><div class="icon">📭</div><div class="msg">No issues match the current filters</div></div>';
        return;
    }
    // Group by status
    const COL_ORDER = ['To Do', 'In Progress', 'In Review', 'Backlog', 'Sprint', 'Done'];
    const colMap = {};
    for (const i of items) {
        const col = i.status || 'To Do';
        if (!colMap[col]) colMap[col] = [];
        colMap[col].push(i);
    }
    const cols = [...COL_ORDER.filter(c => colMap[c]), ...Object.keys(colMap).filter(c => !COL_ORDER.includes(c))];
    const COL_COLOR = { 'To Do':'#64748b', 'In Progress':'#3b82f6', 'In Review':'#a78bfa', 'Backlog':'#475569', 'Sprint':'#06b6d4', 'Done':'#10b981' };
    let html = `<div style="display:flex;gap:3px;margin-bottom:12px;font-size:11px;color:#475569;">
        <span style="background:#1a2f4a;color:#3b82f6;padding:2px 8px;border-radius:8px;font-weight:600;">${items.length} issues</span>
    </div><div style="display:flex;gap:14px;align-items:flex-start;overflow-x:auto;padding-bottom:8px;">`;
    for (const col of cols) {
        const color    = COL_COLOR[col] || '#64748b';
        const colItems = colMap[col];
        html += `<div style="flex:0 0 230px;background:#0f1f35;border:1px solid #1a2f4a;border-radius:8px;overflow:hidden;">
            <div style="padding:10px 14px;border-bottom:1px solid #1a2f4a;border-top:3px solid ${color};display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:${color};">${escHtml(col)}</span>
                <span style="font-size:10px;background:#1a2f4a;color:#64748b;padding:1px 7px;border-radius:10px;font-weight:600;">${colItems.length}</span>
            </div>
            <div style="padding:8px;display:flex;flex-direction:column;gap:7px;max-height:calc(100vh - 220px);overflow-y:auto;">`;
        for (const i of colItems) {
            const ico = i.issueType==='Epic'?'🟣':i.issueType==='Bug'?'🐛':i.issueType==='Task'?'✅':'📋';
            const av  = i.assigneeAvatar
                ? `<img src="${escHtml(i.assigneeAvatar)}" style="width:20px;height:20px;border-radius:50%;object-fit:cover;flex-shrink:0;" alt="" loading="lazy">`
                : i.assigneeInitials
                    ? `<div style="width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#2563eb);display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:white;flex-shrink:0;">${escHtml(i.assigneeInitials)}</div>`
                    : `<div style="width:20px;height:20px;border-radius:50%;background:#1a2f4a;border:1px dashed #2a3f5a;flex-shrink:0;" title="Unassigned"></div>`;
            html += `<div onclick="closeReqJiraModal();reqShowWorkItem('${escHtml(i.key)}','Jira')" style="background:#0a1628;border:1px solid #1a2f4a;border-radius:6px;padding:10px;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.borderColor='#3b82f6';this.style.background='#0d1e32'" onmouseout="this.style.borderColor='#1a2f4a';this.style.background='#0a1628'">
                <div style="display:flex;align-items:center;gap:5px;margin-bottom:5px;">
                    <span style="font-size:11px;">${ico}</span>
                    <span style="font-size:10px;font-weight:700;color:#3b82f6;">${escHtml(i.key)}</span>
                    ${i.updated ? `<span style="font-size:9px;color:#475569;margin-left:auto;">${timeAgo(i.updated)}</span>` : ''}
                </div>
                <div style="font-size:11px;color:#cbd5e1;line-height:1.4;margin-bottom:7px;">${escHtml(i.summary)}</div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;">
                    <span style="font-size:9px;background:#1a2f4a;color:#64748b;padding:1px 6px;border-radius:8px;">${escHtml(i.issueType||'')}</span>
                    ${av}
                </div>
            </div>`;
        }
        html += `</div></div>`;
    }
    html += '</div>';
    body.innerHTML = html;
}
async function reqLoadAdoModal() {
    const body    = document.getElementById('reqAdoModalBody');
    const badge   = document.getElementById('reqAdoModalBadge');
    const updAt   = document.getElementById('reqAdoModalUpdatedAt');
    if (!body) return;
    body.innerHTML = '<div class="jira-state"><div class="icon">⏳</div><div class="msg">Fetching Azure DevOps work items…</div></div>';
    try {
        const res  = await fetch(`${SERVER}/api/ado/board?view=all`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        _reqAdoRawItems = (data.columns || []).flatMap(c => c.issues || []);
        if (badge)  badge.textContent  = `${data.project} · ${data.total} item${data.total !== 1 ? 's' : ''}`;
        if (updAt && data.fetchedAt) updAt.textContent = 'Updated: ' + new Date(data.fetchedAt).toLocaleTimeString();
        // Populate assignee dropdown dynamically
        reqPopulateAdoModalAssignees(_reqAdoRawItems);
        reqRenderAdoModalBoard(_reqAdoRawItems);
    } catch(e) {
        body.innerHTML = `<div class="jira-state"><div class="icon">⚠️</div><div class="msg">${escHtml(e.message)}</div><button class="retry-btn" onclick="reqLoadAdoModal()">Retry</button></div>`;
    }
}
function reqPopulateAdoModalAssignees(items) {
    const sel = document.getElementById('reqAdoModalAssignee');
    if (!sel) return;
    const cur   = sel.value;
    const names = [...new Set(items.map(i => i.assigneeDisplayName).filter(Boolean))].sort();
    sel.innerHTML = '<option value="">All</option><option value="__unassigned__">Unassigned</option>' +
        names.map(n => `<option value="${escHtml(n)}"${n === cur ? ' selected' : ''}>${escHtml(n)}</option>`).join('');
}
function reqAdoModalFilter() {
    const tf = document.getElementById('reqAdoModalType')?.value    || '';
    const af = document.getElementById('reqAdoModalAssignee')?.value|| '';
    const sf = document.getElementById('reqAdoModalStatus')?.value  || '';
    const f  = _reqAdoRawItems.filter(i =>
        (!tf || i.issueType === tf) &&
        (!af || (af === '__unassigned__' ? !i.assigneeDisplayName : i.assigneeDisplayName === af)) &&
        (!sf || i.status === sf)
    );
    reqRenderAdoModalBoard(f);
}
function reqAdoClearModalFilters() {
    ['reqAdoModalType','reqAdoModalAssignee','reqAdoModalStatus'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = '';
    });
    reqRenderAdoModalBoard(_reqAdoRawItems);
}
function reqRenderAdoModalBoard(items) {
    const body = document.getElementById('reqAdoModalBody');
    if (!body) return;
    if (!items.length) {
        body.innerHTML = '<div class="jira-state"><div class="icon">📭</div><div class="msg">No work items match the current filters</div></div>';
        return;
    }
    // Group by status column
    const COL_ORDER = ['New', 'Active', 'Design', 'To Do', 'Resolved', 'Closed', 'Removed'];
    const colMap = {};
    for (const i of items) {
        const col = i.status || 'New';
        if (!colMap[col]) colMap[col] = [];
        colMap[col].push(i);
    }
    const cols = [...COL_ORDER.filter(c => colMap[c]), ...Object.keys(colMap).filter(c => !COL_ORDER.includes(c))];
    const COL_COLOR = { New:'#64748b', Active:'#3b82f6', Design:'#a78bfa', 'To Do':'#475569', Resolved:'#f59e0b', Closed:'#10b981', Removed:'#334155' };

    let html = `<div style="display:flex;gap:3px;margin-bottom:12px;font-size:11px;color:#475569;">
        <span style="background:#1a2f4a;color:#60a5fa;padding:2px 8px;border-radius:8px;font-weight:600;">${items.length} items</span>
    </div><div style="display:flex;gap:14px;align-items:flex-start;overflow-x:auto;padding-bottom:8px;">`;
    for (const col of cols) {
        const color  = COL_COLOR[col] || '#64748b';
        const colItems = colMap[col];
        html += `<div style="flex:0 0 230px;background:#0f1f35;border:1px solid #1a2f4a;border-radius:8px;overflow:hidden;">
            <div style="padding:10px 14px;border-bottom:1px solid #1a2f4a;border-top:3px solid ${color};display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:${color};">${escHtml(col)}</span>
                <span style="font-size:10px;background:#1a2f4a;color:#64748b;padding:1px 7px;border-radius:10px;font-weight:600;">${colItems.length}</span>
            </div>
            <div style="padding:8px;display:flex;flex-direction:column;gap:7px;max-height:calc(100vh - 220px);overflow-y:auto;">`;
        for (const i of colItems) {
            const ico = i.issueType==='Epic'?'🟣':i.issueType==='Feature'?'🔷':i.issueType==='Test Case'?'🧪':i.issueType==='Bug'?'🐛':'📋';
            const av  = i.assigneeAvatar
                ? `<img src="${escHtml(i.assigneeAvatar)}" style="width:20px;height:20px;border-radius:50%;object-fit:cover;flex-shrink:0;" alt="" loading="lazy">`
                : i.assigneeInitials
                    ? `<div style="width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#2563eb);display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:white;flex-shrink:0;">${escHtml(i.assigneeInitials)}</div>`
                    : `<div style="width:20px;height:20px;border-radius:50%;background:#1a2f4a;border:1px dashed #2a3f5a;flex-shrink:0;" title="Unassigned"></div>`;
            html += `<div onclick="closeReqAdoModal();reqShowWorkItem('${escHtml(i.key)}','ADO')" style="background:#0a1628;border:1px solid #1a2f4a;border-radius:6px;padding:10px;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.borderColor='#3b82f6';this.style.background='#0d1e32'" onmouseout="this.style.borderColor='#1a2f4a';this.style.background='#0a1628'">
                <div style="display:flex;align-items:center;gap:5px;margin-bottom:5px;">
                    <span style="font-size:11px;">${ico}</span>
                    <span style="font-size:10px;font-weight:700;color:#60a5fa;">${escHtml(i.key)}</span>
                    ${i.updated ? `<span style="font-size:9px;color:#475569;margin-left:auto;">${timeAgo(i.updated)}</span>` : ''}
                </div>
                <div style="font-size:11px;color:#cbd5e1;line-height:1.4;margin-bottom:7px;">${escHtml(i.summary)}</div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;">
                    <span style="font-size:9px;background:#1a2f4a;color:#64748b;padding:1px 6px;border-radius:8px;">${escHtml(i.issueType||'')}</span>
                    ${av}
                </div>
            </div>`;
        }
        html += `</div></div>`;
    }
    html += '</div>';
    body.innerHTML = html;
}

/** Navigate directly to ADO work items page in browser (external link) */
function reqOpenAdoExternal() {
    const base    = (JIRA_CONFIG.adoOrgUrl || '').replace(/\/$/, '');
    const project = encodeURIComponent(JIRA_CONFIG.project || JIRA_CONFIG.adoProject || '');
    if (!base || !project) { alert('ADO not configured. Check ADO_ORG_URL in .env'); return; }
    window.open(`${base}/${project}/_workitems`, '_blank');
}
function reqApplyJiraFilters() {
    const af = document.getElementById('reqJiraAssignee')?.value || '';
    const sf = document.getElementById('reqJiraStatus')?.value || '';
    const tf = document.getElementById('reqJiraType')?.value || '';
    const f  = _reqRawItems.filter(i =>
        (!af || i.assigneeDisplayName === af) &&
        (!sf || i.status === sf) &&
        (!tf || i.issueType === tf)
    );
    renderReqWorkItemList(f, 'Jira');
}
function reqClearJiraFilters() {
    ['reqJiraAssignee','reqJiraStatus','reqJiraType'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = '';
    });
    renderReqWorkItemList(_reqRawItems, 'Jira');
}
/** Populate the Assigned To dropdown with unique names from loaded items */
function reqPopulateAssigneeDropdown(items, toolType) {
    const isADO = toolType === 'ADO';
    const selId = isADO ? 'reqAdoAssignedTo' : 'reqJiraAssignee';
    const sel   = document.getElementById(selId);
    if (!sel) return;
    const current = sel.value;
    const names = [...new Set(items.map(i => i.assigneeDisplayName).filter(Boolean))].sort();
    sel.innerHTML = `<option value="">All</option>${isADO ? '<option value="__unassigned__">Unassigned</option>' : ''}` +
        names.map(n => `<option value="${escHtml(n)}"${n===current?' selected':''}>${escHtml(n)}</option>`).join('');
}
/** Populate the Jira Work Type dropdown dynamically */
function reqPopulateJiraTypeDropdown(items) {
    const sel = document.getElementById('reqJiraType');
    if (!sel) return;
    const current = sel.value;
    const types = [...new Set(items.map(i => i.issueType).filter(Boolean))].sort();
    sel.innerHTML = '<option value="">All</option>' +
        types.map(t => `<option value="${escHtml(t)}"${t===current?' selected':''}>${escHtml(t)}</option>`).join('');
}
/** Populate the Jira Status dropdown dynamically */
function reqPopulateJiraStatusDropdown(items) {
    const sel = document.getElementById('reqJiraStatus');
    if (!sel) return;
    const current = sel.value;
    const statuses = [...new Set(items.map(i => i.status).filter(Boolean))].sort();
    sel.innerHTML = '<option value="">All</option>' +
        statuses.map(s => `<option value="${escHtml(s)}"${s===current?' selected':''}>${escHtml(s)}</option>`).join('');
}
async function reqLoadWorkItems(toolType, view) {
    const listEl  = document.getElementById('reqWorkItemList');
    const countEl = document.getElementById('reqWorkItemCount');
    if (!listEl) return;
    listEl.innerHTML = '<div style="font-size:11px;color:#334155;padding:10px;text-align:center">Loading…</div>';
    try {
        const isADO = toolType==='ADO';
        const url   = isADO ? `${SERVER}/api/ado/board?view=${view}` : `${SERVER}/api/jira/board?project=${JIRA_CONFIG.project}&view=${view}`;
        const res   = await fetch(url);
        const data  = await res.json();
        const items = (data.columns||[]).flatMap(c=>c.issues||[]);
        _reqRawItems = items;
        if (countEl) countEl.textContent = items.length||'';
        if (!items.length) { listEl.innerHTML='<div style="font-size:11px;color:#475569;padding:10px;text-align:center">No items found.</div>'; return; }
        // Populate dynamic filter dropdowns
        reqPopulateAssigneeDropdown(items, toolType);
        if (toolType === 'Jira') {
            reqPopulateJiraTypeDropdown(items);
            reqPopulateJiraStatusDropdown(items);
        }
        renderReqWorkItemList(items, toolType);
    } catch(e) { listEl.innerHTML=`<div style="font-size:11px;color:#f87171;padding:10px;text-align:center">${escHtml(e.message)}</div>`; }
}
function renderReqWorkItemList(items, toolType) {
    const listEl = document.getElementById('reqWorkItemList');
    if (!listEl) return;
    listEl.innerHTML = items.map(i => {
        const kc  = toolType==='ADO' ? '#60a5fa' : '#3b82f6';
        const ico = i.issueType==='Epic'?'🟣':i.issueType==='Feature'?'🔷':i.issueType==='Test Case'?'🧪':'📋';
        const av  = i.assigneeAvatar
            ? `<img src="${escHtml(i.assigneeAvatar)}" style="width:18px;height:18px;border-radius:50%;object-fit:cover" alt="" loading="lazy">`
            : i.assigneeInitials
                ? `<div style="width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#2563eb);display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:white;flex-shrink:0">${escHtml(i.assigneeInitials)}</div>`
                : `<div style="width:18px;height:18px;border-radius:50%;background:#1a2f4a;flex-shrink:0"></div>`;
        return `<div onclick="reqShowWorkItem('${escHtml(i.key)}','${toolType}')" style="background:#0a1628;border:1px solid #1a2f4a;border-radius:6px;padding:8px 10px;margin-bottom:5px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='#3b82f6';this.style.background='#0d1e32'" onmouseout="this.style.borderColor='#1a2f4a';this.style.background='#0a1628'">
  <div style="display:flex;align-items:center;gap:5px;margin-bottom:4px">
    <span>${ico}</span>
    <span style="font-size:10px;font-weight:700;color:${kc}">${escHtml(i.key)}</span>
    ${i.updated?`<span style="font-size:9px;color:#475569;margin-left:auto">${timeAgo(i.updated)}</span>`:''}
  </div>
  <div style="font-size:11px;color:#cbd5e1;line-height:1.4;margin-bottom:5px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">${escHtml(i.summary)}</div>
  <div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
    <span style="font-size:9px;background:#1a2f4a;color:#64748b;padding:1px 6px;border-radius:8px">${escHtml(i.status||'')}</span>
    ${av}
  </div>
</div>`;
    }).join('');
}
function reqDesignFromItem(key, toolType) {
    if (toolType === 'ADO' || toolType === 'Jira') {
        switchToTab('manualtests');
        mtSelectTicket(key);
    } else {
        switchToTab('testdesign');
        tdSelectTicket(key);
    }
}
async function reqShowWorkItem(key, toolType) {
    const main = document.getElementById('reqMainContent');
    main.innerHTML = `<div style="color:#60a5fa;font-size:12px;padding:8px 0">⏳ Loading ${escHtml(key)}…</div>`;
    try {
        const isADO = toolType==='ADO';
        const url   = isADO ? `${SERVER}/api/ado/issue/${encodeURIComponent(key)}` : `${SERVER}/api/jira/issue/${encodeURIComponent(key)}`;
        const res   = await fetch(url);
        const d     = await res.json();

        // Store current item for feature file generation
        window._reqCurrentItem = { key: d.key, summary: d.summary, description: d.description, acceptanceCriteria: d.acceptanceCriteria, toolType };

        main.innerHTML = `
<div style="margin-bottom:20px">
  <div style="font-size:11px;color:#3b82f6;font-weight:700;margin-bottom:4px">${escHtml(d.key)}${d.url?`<a href="${escHtml(d.url)}" target="_blank" style="font-size:10px;color:#60a5fa;margin-left:8px;text-decoration:none">↗ Open</a>`:''}
  </div>
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
    <div style="font-size:18px;font-weight:600;color:white;flex:1;min-width:0;">${escHtml(d.summary)}</div>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:12px;font-size:11px;color:#64748b;margin-bottom:16px">
    ${d.status   ?`<span>Status: <strong style="color:#94a3b8">${escHtml(d.status)}</strong></span>`:''}
    ${d.priority ?`<span>Priority: <strong style="color:#94a3b8">${escHtml(d.priority)}</strong></span>`:''}
    ${d.issueType?`<span>Type: <strong style="color:#94a3b8">${escHtml(d.issueType)}</strong></span>`:''}
    ${d.assignee ?`<span>Assignee: <strong style="color:#94a3b8">${escHtml(d.assignee)}</strong></span>`:''}
  </div>
</div>
${d.description?`<div style="margin-bottom:20px"><div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:8px">Description</div><div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:6px;padding:14px 18px;font-size:12px;color:#94a3b8;line-height:1.7;white-space:pre-wrap;word-break:break-word">${escHtml(d.description)}</div></div>`:''}
${d.acceptanceCriteria&&d.acceptanceCriteria!==d.description?`<div style="margin-bottom:20px"><div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:8px">Acceptance Criteria</div><div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:6px;padding:14px 18px;font-size:12px;color:#94a3b8;line-height:1.7;white-space:pre-wrap;word-break:break-word">${escHtml(d.acceptanceCriteria)}</div></div>`:''}`;

    } catch(e) { main.innerHTML=`<div style="color:#f87171;font-size:12px">Failed: ${escHtml(e.message)}</div>`; }
}

// ── Scheduler (inside Test Execution tab) ────────────────────────────────────

const SCHEDULES_KEY = 'pw_schedules';
let _schedulerVisible = false;
let _editingScheduleIdx = -1; // -1 = new, >=0 = editing existing

function loadSchedules() {
    try { return JSON.parse(localStorage.getItem(SCHEDULES_KEY)) || []; } catch(_) { return []; }
}
function saveSchedules(s) { localStorage.setItem(SCHEDULES_KEY, JSON.stringify(s)); }

function toggleScheduler() {
    _schedulerVisible = !_schedulerVisible;
    const panel = document.getElementById('schedulerPanel');
    if (panel) panel.style.display = _schedulerVisible ? 'flex' : 'none';
    if (_schedulerVisible) {
        populateSuiteDropdown();
        renderSchedules();
    }
}

function populateSuiteDropdown() {
    const select = document.getElementById('schSuite');
    if (!select) return;
    // Get suites from the suite sidebar
    const suiteItems = document.querySelectorAll('.suite-item .suite-item-name');
    const options = ['<option value="">— Select Suite —</option>'];
    suiteItems.forEach(el => {
        const name = el.textContent.trim();
        if (name) options.push(`<option value="${escHtml(name)}">${escHtml(name)}</option>`);
    });
    // Also add "All Tests" option
    options.splice(1, 0, '<option value="All Tests">All Tests</option>');
    select.innerHTML = options.join('');
}

function showScheduleForm(idx) {
    const form = document.getElementById('scheduleFormPanel');
    if (!form) return;
    form.style.display = 'block';
    populateSuiteDropdown();

    if (typeof idx === 'number' && idx >= 0) {
        // Edit mode
        _editingScheduleIdx = idx;
        const schedules = loadSchedules();
        const s = schedules[idx];
        if (s) {
            document.getElementById('schName').value = s.name || '';
            document.getElementById('schSuite').value = s.suite || '';
            document.getElementById('schEnv').value = s.environment || 'Dev';
            document.getElementById('schBrowser').value = s.browser || 'Chromium';
            document.getElementById('schFrequency').value = s.frequency || 'Daily';
            document.getElementById('schStartDate').value = s.startDate || '';
            document.getElementById('schStartTime').value = s.startTime || '';
        }
    } else {
        // New mode
        _editingScheduleIdx = -1;
        document.getElementById('schName').value = '';
        document.getElementById('schSuite').value = '';
        document.getElementById('schEnv').value = 'Dev';
        document.getElementById('schBrowser').value = 'Chromium';
        document.getElementById('schFrequency').value = 'Daily';
        document.getElementById('schStartDate').value = '';
        document.getElementById('schStartTime').value = '';
    }
}

function cancelScheduleForm() {
    const form = document.getElementById('scheduleFormPanel');
    if (form) form.style.display = 'none';
    _editingScheduleIdx = -1;
}

function saveScheduleForm() {
    const name = document.getElementById('schName').value.trim();
    const suite = document.getElementById('schSuite').value;
    const environment = document.getElementById('schEnv').value;
    const browser = document.getElementById('schBrowser').value;
    const frequency = document.getElementById('schFrequency').value;
    const startDate = document.getElementById('schStartDate').value;
    const startTime = document.getElementById('schStartTime').value;

    if (!name) { alert('Please enter a Scheduler Name'); return; }
    if (!suite) { alert('Please select a Test Suite'); return; }

    const entry = { name, suite, environment, browser, frequency, startDate, startTime, enabled: true, createdAt: new Date().toISOString() };

    const s = loadSchedules();
    if (_editingScheduleIdx >= 0 && _editingScheduleIdx < s.length) {
        // Update existing
        s[_editingScheduleIdx] = { ...s[_editingScheduleIdx], ...entry };
    } else {
        // Add new
        s.push(entry);
    }
    saveSchedules(s);
    cancelScheduleForm();
    renderSchedules();
}

function renderSchedules() {
    const list = document.getElementById('scheduleList');
    if (!list) return;
    const schedules = loadSchedules();
    if (!schedules.length) {
        list.innerHTML = '<div style="font-size:12px;color:#475569;text-align:center;padding:30px;">No schedules yet. Click <strong style="color:#60a5fa;">+ New Schedule</strong> to create one.</div>';
        return;
    }
    list.innerHTML = schedules.map((s, i) => `
        <div style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:8px;padding:14px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <div style="flex:1;min-width:0;">
                <div style="font-size:12px;font-weight:600;color:#e0e0e0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(s.name)}</div>
                <div style="font-size:10px;color:#64748b;margin-top:4px;display:flex;flex-wrap:wrap;gap:8px;">
                    <span>📦 ${escHtml(s.suite || 'All')}</span>
                    <span>🌐 ${escHtml(s.environment || '-')}</span>
                    <span>🖥 ${escHtml(s.browser || 'Chromium')}</span>
                    <span>🔁 ${escHtml(s.frequency || '-')}</span>
                    <span>📅 ${escHtml(s.startDate || '-')} ${escHtml(s.startTime || '')}</span>
                </div>
            </div>
            <span style="font-size:9px;padding:3px 8px;border-radius:8px;font-weight:600;background:${s.enabled ? 'rgba(16,185,129,0.15)' : 'rgba(100,116,139,0.15)'};color:${s.enabled ? '#10b981' : '#64748b'};">${s.enabled ? 'Active' : 'Paused'}</span>
            <button onclick="toggleScheduleEnabled(${i})" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:4px 10px;border-radius:4px;font-size:10px;cursor:pointer;white-space:nowrap;">${s.enabled ? '⏸ Pause' : '▶ Enable'}</button>
            <button onclick="showScheduleForm(${i})" style="background:none;border:1px solid #2a3f5a;color:#60a5fa;padding:4px 10px;border-radius:4px;font-size:10px;cursor:pointer;white-space:nowrap;">✏️ Edit</button>
            <button onclick="deleteSchedule(${i})" style="background:none;border:1px solid rgba(248,113,113,0.3);color:#f87171;padding:4px 10px;border-radius:4px;font-size:10px;cursor:pointer;white-space:nowrap;">🗑 Delete</button>
        </div>`).join('');
}

function addSchedule() {
    showScheduleForm();
}

function toggleScheduleEnabled(idx) {
    const s = loadSchedules();
    if (s[idx]) s[idx].enabled = !s[idx].enabled;
    saveSchedules(s);
    renderSchedules();
}

function deleteSchedule(idx) {
    if (!confirm('Delete this schedule?')) return;
    const s = loadSchedules().filter((_, i) => i !== idx);
    saveSchedules(s);
    renderSchedules();
}

(async function init() {
    // Fetch project root for IDE deep-links
    fetch(`${SERVER}/api/project-root`)
        .then(r => r.json())
        .then(d => { projectRoot = (d.root || '').replace(/\\/g, '/'); })
        .catch(() => {});
    await loadDashboard();
    await loadTestExplorer();
    // Init Jira config + populate all project dropdowns before loading boards
    await initJiraConfig();
    // Pre-load history in background so it's ready
    loadResults().catch(()=>{});
    loadTestData().catch(()=>{});
    loadTdTickets().catch(()=>{});
    loadMtTickets().catch(()=>{});
    // Start server status polling
    initServerStatusPoll().catch(()=>{});
})();

