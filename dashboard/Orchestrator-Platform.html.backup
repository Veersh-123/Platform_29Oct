let _vasActiveKey = null;

function vasRenderCards() {
    const grid = document.getElementById('vasCardsGrid');
    if (!grid) return;
    grid.innerHTML = Object.entries(VAS_SERVICES).map(([key, svc]) => {
        const isLive = !!svc.launched;
        const badge = isLive
            ? `<span style="font-size:9px;background:rgba(16,185,129,0.15);color:#10b981;border:1px solid rgba(16,185,129,0.35);padding:2px 7px;border-radius:8px;font-weight:600;letter-spacing:0.4px;">🚀 LIVE</span>`
            : `<span style="font-size:9px;background:rgba(245,158,11,0.15);color:#f59e0b;border:1px solid rgba(245,158,11,0.3);padding:2px 7px;border-radius:8px;font-weight:600;letter-spacing:0.4px;">COMING SOON</span>`;
        const hint = isLive ? 'Launch →' : 'View details →';
        const accentGradient = isLive
            ? 'linear-gradient(90deg,#10b981,#3b82f6)'
            : 'linear-gradient(90deg,#3b82f6,#8b5cf6)';
        return `
        <div id="vasCard-${key}"
             onclick="vasOnCardClick('${key}')"
             style="background:#0f1f35;border:1px solid ${isLive ? 'rgba(16,185,129,0.25)' : '#1a2f4a'};border-radius:12px;padding:20px;cursor:pointer;
                    transition:border-color 0.2s,box-shadow 0.2s;display:flex;flex-direction:column;gap:12px;
                    position:relative;overflow:hidden;"
             onmouseenter="this.style.borderColor='${isLive ? '#10b981' : '#3b82f6'}';this.style.boxShadow='0 0 0 1px rgba(${isLive ? '16,185,129' : '59,130,246'},0.25)'"
             onmouseleave="vasCardHoverLeave(this,'${key}')">
            <!-- top accent line -->
            <div style="position:absolute;top:0;left:0;right:0;height:3px;background:${accentGradient};border-radius:12px 12px 0 0;"></div>
            <!-- header row -->
            <div style="display:flex;align-items:center;gap:12px;margin-top:4px;">
                <div style="font-size:28px;line-height:1;">${svc.icon}</div>
                <div style="flex:1;">
                    <div style="font-size:13px;font-weight:700;color:white;margin-bottom:4px;">${escHtml(svc.name)}</div>
                    ${badge}
                </div>
            </div>
            <!-- description -->
            <div style="font-size:11px;color:#94a3b8;line-height:1.6;">${escHtml(svc.desc)}</div>
            <!-- feature pills -->
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:2px;">
                ${svc.features.slice(0,2).map(f =>
                    `<span style="font-size:10px;background:#0a1628;border:1px solid #1a2f4a;color:#cbd5e1;padding:3px 8px;border-radius:6px;">${escHtml(f.slice(0,2))} ${escHtml(f.slice(2).trim().split(' ').slice(0,4).join(' '))}…</span>`
                ).join('')}
            </div>
            <!-- click hint -->
            <div style="font-size:10px;color:${isLive ? '#10b981' : '#475569'};margin-top:auto;text-align:right;font-weight:${isLive ? '600' : '400'};">${hint}</div>
        </div>
    `}).join('');
}

function vasCardHoverLeave(el, key) {
    if (_vasActiveKey === key) {
        el.style.borderColor = '#3b82f6';
        el.style.boxShadow   = '0 0 0 2px rgba(59,130,246,0.4)';
    } else {
        el.style.borderColor = '#1a2f4a';
        el.style.boxShadow   = 'none';
    }
}

function vasOnCardClick(key) {
    // ── Framework Migrator → open dedicated full-screen modal ──────────────
    if (key === 'framework-migrator') {
        openMigratorModal();
        return;
    }
    // ── Coverage Analyzer → open dedicated full-screen modal ───────────────
    if (key === 'coverage-analyzer') {
        openCoverageModal();
        return;
    }
    // ── Test Observability → open dedicated full-screen modal ──────────────
    if (key === 'test-observability') {
        openObservabilityModal();
        return;
    }
    // ── Tensai-Script Importer → open dedicated modal ──────────────────────
    if (key === 'tensai-importer') {
        openTensaiModal();
        return;
    }
    // ── User Settings → open user settings modal ─────────────────────────────
    if (key === 'user-settings') {
        openUserSettingsModal();
        return;
    }

    // Deactivate previous card
    if (_vasActiveKey) {
        const prev = document.getElementById('vasCard-' + _vasActiveKey);
        if (prev) { prev.style.borderColor = '#1a2f4a'; prev.style.boxShadow = 'none'; }
    }

    if (_vasActiveKey === key) {
        // Toggle off
        _vasActiveKey = null;
        document.getElementById('vasDetailPanel').style.display = 'none';
        return;
    }

    _vasActiveKey = key;
    const card = document.getElementById('vasCard-' + key);
    if (card) { card.style.borderColor = '#3b82f6'; card.style.boxShadow = '0 0 0 2px rgba(59,130,246,0.4)'; }

    const svc = VAS_SERVICES[key];
    document.getElementById('vasDetailIcon').textContent = svc.icon;
    document.getElementById('vasDetailName').textContent = svc.name;
    document.getElementById('vasDetailDesc').textContent = svc.desc;
    document.getElementById('vasDetailFeatures').innerHTML = svc.features.map(f =>
        `<div style="display:flex;align-items:flex-start;gap:10px;background:#0a1628;border:1px solid #1a2f4a;border-radius:8px;padding:11px 14px;">
            <span style="font-size:14px;line-height:1.4;">${f.slice(0,2)}</span>
            <span style="font-size:12px;color:#cbd5e1;line-height:1.5;">${escHtml(f.slice(2).trim())}</span>
        </div>`
    ).join('');

    const panel = document.getElementById('vasDetailPanel');
    panel.style.display = 'block';
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// ── Framework Migrator Modal ──────────────────────────────────────────────────
const MIGRATOR_URL = (VAS_SERVICES['framework-migrator'] || {}).launchUrl || 'http://localhost:5174/app/';

function openMigratorModal() {
    const modal = document.getElementById('migratorModal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    // Keep the "Open in Tab" link in sync with the configured URL
    const openLink = document.getElementById('migratorOpenLink');
    if (openLink) openLink.href = MIGRATOR_URL;
    // Kick off connectivity check then load
    migratorCheckAndLoad();
    // ESC to close
    document._migratorEscHandler = function(e) {
        if (e.key === 'Escape') closeMigratorModal();
    };
    document.addEventListener('keydown', document._migratorEscHandler);
}

function closeMigratorModal() {
    const modal = document.getElementById('migratorModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
    // Blank the iframe to stop any ongoing network calls
    const frame = document.getElementById('migratorFrame');
    if (frame) frame.src = 'about:blank';
    if (document._migratorEscHandler) {
        document.removeEventListener('keydown', document._migratorEscHandler);
        delete document._migratorEscHandler;
    }
}

function reloadMigratorFrame() {
    migratorSetOverlay('loading');
    migratorCheckAndLoad();
}

/** Set the overlay state: 'loading' | 'error' | 'hidden' */
function migratorSetOverlay(state, errorMsg) {
    const overlay  = document.getElementById('migratorOverlay');
    const msgEl    = document.getElementById('migratorOverlayMsg');
    const detailEl = document.getElementById('migratorOverlayDetail');
    const retryBtn = document.getElementById('migratorRetryBtn');
    const badge    = document.getElementById('migratorStatusBadge');

    if (state === 'hidden') {
        overlay.style.display = 'none';
        badge.textContent = '✅ Connected';
        badge.style.background = 'rgba(16,185,129,0.15)';
        badge.style.color       = '#10b981';
        badge.style.border      = '1px solid rgba(16,185,129,0.35)';
        return;
    }

    overlay.style.display = 'flex';

    if (state === 'loading') {
        msgEl.textContent    = 'Connecting to Framework Migrator…';
        detailEl.textContent = '';
        retryBtn.style.display = 'none';
        badge.textContent = '⏳ Connecting…';
        badge.style.background = 'rgba(100,116,139,0.15)';
        badge.style.color       = '#64748b';
        badge.style.border      = '1px solid rgba(100,116,139,0.3)';
    } else if (state === 'error') {
        msgEl.textContent = '⚠️ Framework Migrator is not reachable';
        detailEl.innerHTML =
            `The migrator UI runs as a separate local server.<br>
             Make sure it is started before opening this panel.<br><br>
             <strong style="color:#cbd5e1;">How to start it:</strong><br>
             <code style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:4px;
                          padding:6px 12px;display:inline-block;margin-top:6px;color:#10b981;font-size:12px;">
               cd "selenium-playwruight-migration (java n python)"<br>
               npm run dev
             </code><br><br>
             <span style="color:#64748b;">Expected URL: <a href="${MIGRATOR_URL}" target="_blank"
               style="color:#60a5fa;">${MIGRATOR_URL}</a></span>
             ${errorMsg ? `<br><span style="color:#f87171;font-size:11px;margin-top:4px;display:block;">${escHtml(errorMsg)}</span>` : ''}`;
        retryBtn.style.display = 'inline-block';
        badge.textContent = '❌ Offline';
        badge.style.background = 'rgba(248,113,113,0.15)';
        badge.style.color       = '#f87171';
        badge.style.border      = '1px solid rgba(248,113,113,0.3)';
    }
}

/** Probe the migrator URL then load the iframe if reachable */
async function migratorCheckAndLoad() {
    migratorSetOverlay('loading');
    try {
        // Use a no-cors fetch probe; if the server is up the fetch resolves
        // (status may be 0 for opaque, but no network error = server is up)
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 6000);
        await fetch(MIGRATOR_URL, { mode: 'no-cors', signal: ctrl.signal });
        clearTimeout(timer);
        // Server responded — load the iframe
        const frame = document.getElementById('migratorFrame');
        // Only set src if not already pointing there (avoids reload flicker)
        if (!frame.src || frame.src === 'about:blank' || frame.src === window.location.href) {
            frame.src = MIGRATOR_URL;
        }
        // Wait a tick then reveal; hide overlay after iframe load event or timeout
        frame.onload = () => migratorSetOverlay('hidden');
        setTimeout(() => {
            // Fallback: if onload never fires (e.g. same-origin restriction), still hide overlay
            if (document.getElementById('migratorOverlay').style.display !== 'none') {
                migratorSetOverlay('hidden');
            }
        }, 4000);
    } catch (err) {
        migratorSetOverlay('error', err && err.message ? err.message : '');
    }
}

// ── Test Observability Modal ──────────────────────────────────────────────────
const OBSERVABILITY_URL = (VAS_SERVICES['test-observability'] || {}).launchUrl || 'http://localhost:3001';

function openObservabilityModal() {
