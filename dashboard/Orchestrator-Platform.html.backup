                    <div style="flex:1;position:relative;overflow:hidden;">
                        <div id="coverageOverlay"
                             style="position:absolute;inset:0;z-index:2;background:#050e1a;
                                    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
                            <div style="font-size:40px;">📊</div>
                            <div id="coverageOverlayMsg" style="font-size:14px;color:#94a3b8;text-align:center;max-width:480px;line-height:1.7;">
                                Connecting to Coverage Analyzer…
                            </div>
                            <div id="coverageOverlayDetail" style="font-size:12px;color:#475569;text-align:center;max-width:520px;line-height:1.8;"></div>
                            <button id="coverageRetryBtn" onclick="coverageCheckAndLoad()"
                                    style="display:none;background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;
                                           color:white;padding:9px 24px;border-radius:6px;font-size:13px;font-weight:600;
