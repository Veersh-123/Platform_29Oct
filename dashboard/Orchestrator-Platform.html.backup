            <!-- ── Tensai-Script Importer Full-Screen Modal ── -->
            <div id="tensaiModal" onclick="if(event.target===this)closeTensaiModal()"
                 style="display:none;position:fixed;inset:0;z-index:9500;background:rgba(5,14,26,0.92);
                        backdrop-filter:blur(6px);flex-direction:column;align-items:center;justify-content:center;">
                <div style="background:#0a1628;border:1px solid #1e3a5a;border-radius:12px;
                            width:calc(100vw - 48px);max-width:900px;height:auto;max-height:calc(100vh - 80px);
                            display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,0.7);
                            overflow:hidden;animation:tensaiIn 0.22s ease;">
                    <!-- Header bar -->
                    <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:14px 24px;
                                display:flex;align-items:center;gap:14px;flex-shrink:0;">
                        <span style="font-size:22px;line-height:1;">📥</span>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:white;">Tensai-Script Importer</div>
                            <div style="font-size:11px;color:#64748b;">Convert Python Playwright scripts to TypeScript specs</div>
                        </div>
                        <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
                            <a href="http://localhost:8765" target="_blank" rel="noopener"
                               style="background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.3);
                                      color:#60a5fa;padding:6px 12px;border-radius:5px;font-size:11px;
                                      text-decoration:none;font-weight:600;transition:all 0.2s;"
                               onmouseenter="this.style.background='rgba(59,130,246,0.22)'"
                               onmouseleave="this.style.background='rgba(59,130,246,0.12)'">
                                ↗ Open in New Tab
                            </a>
                            <button onclick="closeTensaiModal()"
                                    style="background:none;border:1px solid #2a3f5a;color:#64748b;
                                           width:32px;height:32px;border-radius:6px;font-size:16px;cursor:pointer;
                                           display:flex;align-items:center;justify-content:center;transition:all 0.2s;"
                                    onmouseenter="this.style.borderColor='#f87171';this.style.color='#f87171'"
                                    onmouseleave="this.style.borderColor='#2a3f5a';this.style.color='#64748b'"
                                    title="Close">✕</button>
                        </div>
                    </div>
                    <!-- Content area -->
                    <div style="flex:1;overflow-y:auto;padding:28px;">
                        <!-- File Path Input -->
                        <div style="margin-bottom:20px;">
                            <label style="font-size:12px;font-weight:600;color:#94a3b8;display:block;margin-bottom:8px;">Python Script File Path</label>
                            <div style="display:flex;gap:10px;">
                                <input id="tensaiFilePath" type="text" placeholder="C:/path/to/your/script.py"
                                       style="flex:1;padding:10px 14px;border-radius:8px;background:#050e1a;border:1px solid #1a2f4a;
                                              color:white;font-size:13px;outline:none;transition:border-color 0.2s;"
                                       onfocus="this.style.borderColor='#3b82f6'"
                                       onblur="this.style.borderColor='#1a2f4a'" />
                                <button onclick="tensaiConvertFromPath()"
                                        style="padding:10px 20px;border-radius:8px;background:linear-gradient(135deg,#3b82f6,#6366f1);
                                               border:none;color:white;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;">
                                    🔄 Convert
                                </button>
                            </div>
                        </div>
                        <!-- OR divider -->
                        <div style="display:flex;align-items:center;gap:12px;margin:20px 0;">
                            <div style="flex:1;height:1px;background:#1a2f4a;"></div>
                            <span style="font-size:11px;color:#475569;font-weight:600;">OR</span>
                            <div style="flex:1;height:1px;background:#1a2f4a;"></div>
                        </div>
                        <!-- File Upload -->
                        <div style="border:2px dashed rgba(59,130,246,0.3);border-radius:12px;padding:28px;text-align:center;
                                    background:rgba(59,130,246,0.03);transition:border-color 0.2s;"
                             ondragover="event.preventDefault();this.style.borderColor='#3b82f6'"
                             ondragleave="this.style.borderColor='rgba(59,130,246,0.3)'"
                             ondrop="event.preventDefault();this.style.borderColor='rgba(59,130,246,0.3)';tensaiHandleDrop(event)">
                            <input id="tensaiFileInput" type="file" accept=".py" style="display:none;" onchange="tensaiHandleFileSelect(this)" />
                            <div style="font-size:32px;margin-bottom:10px;">📂</div>
                            <div style="font-size:13px;color:#94a3b8;margin-bottom:12px;">Drag & drop a .py file here, or</div>
                            <button onclick="document.getElementById('tensaiFileInput').click()"
                                    style="padding:10px 24px;border-radius:8px;background:linear-gradient(135deg,#0ea5e9,#3b82f6);
                                           border:none;color:white;font-size:13px;font-weight:600;cursor:pointer;">
                                📁 Choose Python File
                            </button>
                            <div id="tensaiSelectedFile" style="margin-top:10px;font-size:11px;color:#10b981;display:none;"></div>
                        </div>
                        <!-- Status / Error -->
                        <div id="tensaiStatus" style="display:none;margin-top:16px;padding:12px 16px;border-radius:8px;font-size:12px;"></div>
                        <!-- Result -->
                        <div id="tensaiResult" style="display:none;margin-top:20px;">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                                <div>
                                    <span style="font-size:13px;font-weight:600;color:#10b981;">✅ Conversion Complete</span>
                                    <span id="tensaiOutputName" style="font-size:11px;color:#64748b;margin-left:10px;"></span>
                                </div>
                                <button onclick="tensaiDownload()"
                                        style="padding:8px 18px;border-radius:8px;background:linear-gradient(135deg,#10b981,#059669);
                                               border:none;color:white;font-size:12px;font-weight:600;cursor:pointer;">
                                    ⬇️ Download .ts File
                                </button>
                            </div>
                            <div style="background:#050e1a;border:1px solid #1a2f4a;border-radius:8px;padding:14px;
                                        max-height:300px;overflow-y:auto;">
                                <pre id="tensaiOutput" style="font-size:11px;color:#10b981;font-family:'Fira Code',monospace;
                                     white-space:pre-wrap;margin:0;line-height:1.6;"></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <style>
                @keyframes tensaiIn {
                    from { opacity:0; transform:scale(0.97) translateY(-12px); }
                    to   { opacity:1; transform:scale(1) translateY(0); }
                }
            </style>

            <!-- ── Test Observability Full-Screen Modal ── -->
            <div id="observabilityModal" onclick="if(event.target===this)closeObservabilityModal()"
                 style="display:none;position:fixed;inset:0;z-index:9500;background:rgba(5,14,26,0.92);
                        backdrop-filter:blur(6px);flex-direction:column;align-items:center;justify-content:center;">
                <div style="background:#0a1628;border:1px solid #1e3a5a;border-radius:12px;
