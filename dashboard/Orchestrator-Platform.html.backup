    };
    document.addEventListener('keydown', document._coverageEscHandler);
}

function closeCoverageModal() {
    const modal = document.getElementById('coverageModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
    const frame = document.getElementById('coverageFrame');
    if (frame) frame.src = 'about:blank';
    if (document._coverageEscHandler) {
        document.removeEventListener('keydown', document._coverageEscHandler);
        delete document._coverageEscHandler;
    }
}

function reloadCoverageFrame() {
    coverageSetOverlay('loading');
    coverageCheckAndLoad();
}

function coverageSetOverlay(state, errorMsg) {
    const overlay  = document.getElementById('coverageOverlay');
    const msgEl    = document.getElementById('coverageOverlayMsg');
    const detailEl = document.getElementById('coverageOverlayDetail');
    const retryBtn = document.getElementById('coverageRetryBtn');
    const badge    = document.getElementById('coverageStatusBadge');

    if (state === 'hidden') {
        overlay.style.display = 'none';
        badge.textContent = '✅ Connected';
        badge.style.background = 'rgba(16,185,129,0.15)';
        badge.style.color       = '#10b981';
        badge.style.border      = '1px solid rgba(16,185,129,0.35)';
        return;
    }

    overlay.style.display = 'flex';

    if (state === 'loading') {
        msgEl.textContent    = 'Connecting to Coverage Analyzer…';
        detailEl.textContent = '';
        retryBtn.style.display = 'none';
        badge.textContent = '⏳ Connecting…';
        badge.style.background = 'rgba(100,116,139,0.15)';
        badge.style.color       = '#64748b';
        badge.style.border      = '1px solid rgba(100,116,139,0.3)';
    } else if (state === 'error') {
        msgEl.textContent = '⚠️ Coverage Analyzer is not reachable';
        detailEl.innerHTML =
            `The Coverage Analyzer UI runs as a separate local server.<br>
             Make sure it is started before opening this panel.<br><br>
             <strong style="color:#cbd5e1;">How to start it:</strong><br>
             <code style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:4px;
                          padding:6px 12px;display:inline-block;margin-top:6px;color:#10b981;font-size:12px;">
               cd "coverage-analyser/coverage-analyser"<br>
               npm run dev
             </code><br><br>
             <span style="color:#64748b;">Expected URL: <a href="${COVERAGE_URL}" target="_blank"
               style="color:#60a5fa;">${COVERAGE_URL}</a></span>
             ${errorMsg ? `<br><span style="color:#f87171;font-size:11px;margin-top:4px;display:block;">${escHtml(errorMsg)}</span>` : ''}`;
        retryBtn.style.display = 'inline-block';
        badge.textContent = '❌ Offline';
        badge.style.background = 'rgba(248,113,113,0.15)';
        badge.style.color       = '#f87171';
        badge.style.border      = '1px solid rgba(248,113,113,0.3)';
    }
}

async function coverageCheckAndLoad() {
    coverageSetOverlay('loading');
    try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 6000);
        await fetch(COVERAGE_URL, { mode: 'no-cors', signal: ctrl.signal });
        clearTimeout(timer);
        const frame = document.getElementById('coverageFrame');
        if (!frame.src || frame.src === 'about:blank' || frame.src === window.location.href) {
            frame.src = COVERAGE_URL;
        }
        frame.onload = () => coverageSetOverlay('hidden');
        setTimeout(() => {
            if (document.getElementById('coverageOverlay').style.display !== 'none') {
                coverageSetOverlay('hidden');
            }
        }, 4000);
    } catch (err) {
        coverageSetOverlay('error', err && err.message ? err.message : '');
    }
}

// Legacy stub kept for safety (no longer called)
function vasOnServiceChange(value) {}

// ── Tensai-Script Importer Modal ──────────────────────────────────────────────
const TENSAI_API_URL = 'http://localhost:4000';
let _tensaiConvertedTS = '';
let _tensaiFileName = '';

function openTensaiModal() {
    const modal = document.getElementById('tensaiModal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document._tensaiEscHandler = function(e) { if (e.key === 'Escape') closeTensaiModal(); };
    document.addEventListener('keydown', document._tensaiEscHandler);
}

function closeTensaiModal() {
    const modal = document.getElementById('tensaiModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
    if (document._tensaiEscHandler) {
        document.removeEventListener('keydown', document._tensaiEscHandler);
        delete document._tensaiEscHandler;
    }
}

function tensaiShowStatus(msg, type) {
    const el = document.getElementById('tensaiStatus');
    el.style.display = 'block';
    el.textContent = msg;
    if (type === 'error') {
        el.style.background = 'rgba(239,68,68,0.1)'; el.style.color = '#f87171'; el.style.border = '1px solid rgba(239,68,68,0.3)';
    } else if (type === 'success') {
        el.style.background = 'rgba(16,185,129,0.1)'; el.style.color = '#10b981'; el.style.border = '1px solid rgba(16,185,129,0.3)';
    } else {
        el.style.background = 'rgba(59,130,246,0.1)'; el.style.color = '#60a5fa'; el.style.border = '1px solid rgba(59,130,246,0.3)';
    }
}

function tensaiShowResult(data) {
    _tensaiConvertedTS = data.typescript;
    _tensaiFileName = data.fileName;
    document.getElementById('tensaiOutputName').textContent = data.fileName;
    document.getElementById('tensaiOutput').textContent = data.typescript;
    document.getElementById('tensaiResult').style.display = 'block';
    tensaiShowStatus('Conversion successful!', 'success');
}

async function tensaiConvertFromPath() {
    const filePath = document.getElementById('tensaiFilePath').value.trim();
    if (!filePath) { tensaiShowStatus('Please enter a file path', 'error'); return; }
    tensaiShowStatus('Converting...', 'info');
    document.getElementById('tensaiResult').style.display = 'none';
    try {
        const res = await fetch(TENSAI_API_URL + '/api/tensai/convert', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filePath })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Conversion failed');
        tensaiShowResult(data);
    } catch (err) { tensaiShowStatus(err.message, 'error'); }
}

function tensaiHandleFileSelect(input) {
    const file = input.files[0];
    if (!file) return;
    if (!file.name.endsWith('.py')) { tensaiShowStatus('Please select a .py file', 'error'); return; }
    document.getElementById('tensaiSelectedFile').style.display = 'block';
    document.getElementById('tensaiSelectedFile').textContent = '📄 ' + file.name;
    tensaiConvertFile(file);
}

function tensaiHandleDrop(event) {
    const file = event.dataTransfer.files[0];
    if (!file) return;
    if (!file.name.endsWith('.py')) { tensaiShowStatus('Please drop a .py file', 'error'); return; }
    document.getElementById('tensaiSelectedFile').style.display = 'block';
    document.getElementById('tensaiSelectedFile').textContent = '📄 ' + file.name;
    tensaiConvertFile(file);
}

async function tensaiConvertFile(file) {
    tensaiShowStatus('Converting...', 'info');
    document.getElementById('tensaiResult').style.display = 'none';
    try {
        const text = await file.text();
        const res = await fetch(TENSAI_API_URL + '/api/tensai/convert', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pythonSource: text, filePath: file.name })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Conversion failed');
        tensaiShowResult(data);
    } catch (err) { tensaiShowStatus(err.message, 'error'); }
}

function tensaiDownload() {
    if (!_tensaiConvertedTS) return;
    const blob = new Blob([_tensaiConvertedTS], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = _tensaiFileName || 'converted.spec.ts';
    a.click();
    URL.revokeObjectURL(url);
}

// Render cards on first load (in case VAS tab is already active)
document.addEventListener('DOMContentLoaded', vasRenderCards);

// Initialize defects tab on page load
document.addEventListener('DOMContentLoaded', initDefectsTab);

// ── Token Utility Tracker ─────────────────────────────────────────────────────
const TOKEN_STORAGE_KEY = 'pw_token_usage';
const TOKEN_BUDGETS = {
    'jira-context': 1500,
    'test-cases': 3000,
    'test-design': 3000,
    'script-generation': 4000,
    'dry-run': 3000,
    'failure-analysis': 2500,
    'script-maintenance': 3000
};

function tokenGetUsage() {
    try { return JSON.parse(localStorage.getItem(TOKEN_STORAGE_KEY)) || {}; } catch(e) { return {}; }
}
function tokenSaveUsage(data) {
    localStorage.setItem(TOKEN_STORAGE_KEY, JSON.stringify(data));
}

/**
 * Record token consumption for a stage.
 * @param {string} stage - one of the TOKEN_BUDGETS keys
 * @param {number} tokens - number of tokens consumed
 * @param {string} issueKey - optional issue key
 */
function tokenConsume(stage, tokens, issueKey) {
    const usage = tokenGetUsage();
    if (!usage[stage]) usage[stage] = { total: 0, history: [] };
    usage[stage].total += tokens;
    usage[stage].history.push({ tokens: tokens, issueKey: issueKey || '', time: new Date().toISOString() });
    tokenSaveUsage(usage);
    tokenRefreshUI();
}

/** Refresh the Token Utility UI in Dashboard */
function tokenRefreshUI() {
    const usage = tokenGetUsage();
    let totalConsumed = 0;
    let totalBudget = 0;
    Object.keys(TOKEN_BUDGETS).forEach(function(stage) {
        const used = (usage[stage] && usage[stage].total) || 0;
        const budget = TOKEN_BUDGETS[stage];
        totalConsumed += used;
        totalBudget += budget;
        const el = document.getElementById('tokenUsed-' + stage);
        const bar = document.getElementById('tokenBar-' + stage);
        if (el) el.textContent = used.toLocaleString();
        if (bar) {
            const pct = Math.min(100, Math.round((used / budget) * 100));
            bar.style.width = pct + '%';
            if (pct > 80) bar.style.background = '#f87171';
        }
    });
    const totalEl = document.getElementById('tokenTotalConsumed');
    if (totalEl) totalEl.textContent = totalConsumed.toLocaleString();
    
    // Calculate and display utilization percentage
    const utilizationPercent = totalBudget > 0 ? Math.round((totalConsumed / totalBudget) * 100) : 0;
    const percentEl = document.getElementById('tokenUtilizationPercent');
    if (percentEl) {
        percentEl.textContent = utilizationPercent + '%';
        // Change color based on utilization
        if (utilizationPercent > 80) {
            percentEl.style.color = '#f87171';
        } else if (utilizationPercent > 50) {
            percentEl.style.color = '#fbbf24';
        } else {
            percentEl.style.color = '#a78bfa';
        }
    }
}

function tokenRefreshAll() {
    // Fetch budget limits from the server (reads token-budget.json)
    fetch(SERVER + '/api/token-budget')
        .then(function(r) { return r.json(); })
        .then(function(config) {
            if (config && config.perStage) {
                // Update budget limits from the config file
                Object.keys(config.perStage).forEach(function(stage) {
                    TOKEN_BUDGETS[stage] = config.perStage[stage];
                });
            }
            if (config && config.defaultBudgetTokens) {
                var budgetEl = document.getElementById('tokenBudgetTotal');
                if (budgetEl) budgetEl.textContent = config.defaultBudgetTokens.toLocaleString();
            }
            // Update the budget limit labels in each stage card
            var stageLabels = {
                'jira-context': 'tokenUsed-jira-context',
                'test-cases': 'tokenUsed-test-cases',
                'test-design': 'tokenUsed-test-design',
                'script-generation': 'tokenUsed-script-generation',
                'dry-run': 'tokenUsed-dry-run',
                'failure-analysis': 'tokenUsed-failure-analysis',
                'script-maintenance': 'tokenUsed-script-maintenance'
            };
            Object.keys(stageLabels).forEach(function(stage) {
                var el = document.getElementById(stageLabels[stage]);
                if (el && el.parentElement) {
                    var limitSpan = el.parentElement.querySelector('span[style*="475569"]');
                    if (limitSpan && TOKEN_BUDGETS[stage]) {
                        limitSpan.textContent = '/ ' + TOKEN_BUDGETS[stage].toLocaleString();
                    }
                }
            });
            tokenRefreshUI();
            showToast('Token budget refreshed from config', 'success');
        })
        .catch(function(e) {
            tokenRefreshUI();
            showToast('Refreshed (config not available: ' + e.message + ')', 'warn');
        });
}

/** Reset all token usage counters to 0 */
function tokenResetAll() {
    if (confirm('Are you sure you want to reset all token usage to 0? This cannot be undone.')) {
        localStorage.removeItem(TOKEN_STORAGE_KEY);
        tokenRefreshUI();
        showToast('✅ Token usage reset to 0', 'success');
    }
}
// Auto-refresh on page load
document.addEventListener('DOMContentLoaded', function() { setTimeout(tokenRefreshUI, 500); });

// ── Token consumption hooks (called from various actions) ─────────────────────
// These are wrappers to be called at appropriate points in the workflow

/** Called when Jira story is fetched or written back */
function tokenOnJiraContext(issueKey) { tokenConsume('jira-context', 320, issueKey); }

/** Called when feature files and manual test cases are generated */
function tokenOnTestCases(issueKey) { tokenConsume('test-cases', 850, issueKey); }

/** Called when locators and page objects are generated */
function tokenOnTestDesign(issueKey) { tokenConsume('test-design', 720, issueKey); }

/** Called when automation scripts (.spec.ts) are generated */
function tokenOnScriptGeneration(issueKey) { tokenConsume('script-generation', 1200, issueKey); }

/** Called when dry run is executed */
function tokenOnDryRun(issueKey) { tokenConsume('dry-run', 480, issueKey); }

/** Called when failure analysis is performed */
function tokenOnFailureAnalysis(issueKey) { tokenConsume('failure-analysis', 350, issueKey); }

/** Called when test is executed from Test Execution tab */
function tokenOnScriptMaintenance(issueKey) { tokenConsume('script-maintenance', 280, issueKey); }

</script>
</body>
</html>
