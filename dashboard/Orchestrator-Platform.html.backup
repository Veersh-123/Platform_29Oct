<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HexaPlay Orchestrator</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a1628; color: #e0e0e0; }
        .container { display: flex; flex-direction: column; height: 100vh; }
        .logo-header { background: #0a1628; border-bottom: 1px solid #1a2f4a; padding: 16px 30px; display: flex; align-items: center; gap: 16px; }
        .logo { display: flex; align-items: center; gap: 12px; }
        .logo-icon { width: 36px; height: 36px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: bold; color: white; font-size: 18px; }
        .logo-title { font-size: 12px; font-weight: 600; color: white; }
        .logo-subtitle { font-size: 10px; color: #64748b; }
        .header-controls { display: flex; align-items: center; gap: 24px; margin-left: auto; }
        .control-group { display: flex; align-items: center; gap: 8px; }
        .control-label { font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 500; letter-spacing: 0.5px; min-width: 70px; }
        .dropdown { background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 5px; padding: 6px 10px; color: #e0e0e0; cursor: pointer; font-size: 12px; min-width: 90px; }
        .tags-container { display: flex; gap: 6px; }
        .tag { background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.3); color: #3b82f6; padding: 4px 8px; border-radius: 4px; font-size: 10px; }
        .navigation-header { background: #0a1628; border-bottom: 1px solid #1a2f4a; padding: 0 30px; display: flex; align-items: center; gap: 0; }
        .header-title { font-size: 16px; font-weight: 600; color: white; letter-spacing: 0.5px; padding: 16px 0; flex-shrink: 0; }
        .nav-tabs { display: flex; gap: 30px; margin-left: auto; }
        .nav-tab { font-size: 12px; color: #64748b; cursor: pointer; padding: 16px 0; border-bottom: 2px solid transparent; transition: all 0.2s; white-space: nowrap; }
        .nav-tab.active { color: #3b82f6; border-bottom-color: #3b82f6; }
        .nav-tab:hover { color: #e0e0e0; }
        /* Jira nav */
        .jira-nav-tab { display: flex; align-items: center; gap: 0; margin-left: 32px; position: relative; flex-shrink: 0; }
        .jira-tab-btn { font-size: 12px; color: #64748b; cursor: pointer; padding: 16px 12px 16px 0; border-bottom: 2px solid transparent; transition: all 0.2s; white-space: nowrap; background: none; border-top: none; border-left: none; border-right: none; font-family: inherit; }
        .jira-tab-btn.active { color: #3b82f6; border-bottom-color: #3b82f6; }
        .jira-tab-btn:hover { color: #e0e0e0; }
        .jira-dropdown-toggle { display: flex; align-items: center; padding: 16px 4px; cursor: pointer; color: #64748b; transition: color 0.2s; border-bottom: 2px solid transparent; background: none; border-top: none; border-left: none; border-right: none; font-family: inherit; }
        .jira-tab-btn.active ~ .jira-dropdown-toggle, .jira-dropdown-toggle.active { color: #3b82f6; border-bottom-color: #3b82f6; }
        .jira-dropdown-toggle:hover { color: #e0e0e0; }
        .jira-dropdown-toggle svg { width: 10px; height: 10px; fill: currentColor; transition: transform 0.2s; }
        .jira-dropdown-toggle.open svg { transform: rotate(180deg); }
        .jira-dropdown-menu { display: none; position: absolute; top: calc(100% + 1px); left: 0; background: #0f1f35; border: 1px solid #1e3a5a; border-radius: 6px; min-width: 180px; z-index: 500; box-shadow: 0 8px 24px rgba(0,0,0,0.4); overflow: hidden; }
        .jira-dropdown-menu.open { display: block; }
        .jira-dropdown-item { padding: 10px 16px; font-size: 12px; color: #94a3b8; cursor: pointer; transition: background 0.15s, color 0.15s; display: flex; align-items: center; gap: 8px; }
        .jira-dropdown-item:hover { background: #1a2f4a; color: #e0e0e0; }
        .jira-dropdown-item.selected { color: #3b82f6; background: rgba(59,130,246,0.08); }
        .jira-dropdown-divider { height: 1px; background: #1a2f4a; margin: 4px 0; }
        /* Jira board */
        .jira-board-content { flex-direction: column; overflow: hidden; }
        .jira-board-toolbar { background: #0f1f35; border-bottom: 1px solid #1a2f4a; padding: 14px 30px; display: flex; align-items: center; gap: 16px; flex-shrink: 0; flex-wrap: wrap; }
        .jira-board-title { font-size: 14px; font-weight: 600; color: white; }
        .jira-view-label { font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.4px; }
        .jira-view-select, .jira-instance-select { background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 5px; padding: 6px 10px; color: #e0e0e0; font-size: 12px; cursor: pointer; }
        .jira-view-select { min-width: 140px; }
        .jira-instance-select { min-width: 160px; }
        .jira-refresh-btn { background: none; border: 1px solid #2a3f5a; border-radius: 5px; color: #64748b; padding: 6px 10px; font-size: 12px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 5px; }
        .jira-refresh-btn:hover { border-color: #3b82f6; color: #3b82f6; }
        .jira-refresh-btn.spinning svg { animation: jiraSpin 1s linear infinite; }
        @keyframes jiraSpin { to { transform: rotate(360deg); } }
        .jira-board-inner { flex: 1; overflow-y: auto; padding: 24px 30px; }
        .jira-columns { display: flex; gap: 16px; min-height: 400px; align-items: flex-start; }
        .jira-column { flex: 1; background: #0f1f35; border: 1px solid #1a2f4a; border-radius: 8px; display: flex; flex-direction: column; min-width: 200px; max-width: 320px; }
        .jira-col-header { padding: 12px 16px; border-bottom: 1px solid #1a2f4a; display: flex; align-items: center; justify-content: space-between; border-radius: 8px 8px 0 0; }
        .jira-col-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .jira-col-count { font-size: 10px; background: #1a2f4a; color: #64748b; padding: 2px 7px; border-radius: 10px; font-weight: 600; }
        .jira-col-body { padding: 10px; display: flex; flex-direction: column; gap: 8px; }
        .jira-card { background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 6px; padding: 12px; cursor: pointer; transition: border-color 0.2s, background 0.2s; }
        .jira-card:hover { background: #1f3a50; border-color: #3b82f6; }
        .jira-card-top { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
        .jira-type-icon { width: 14px; height: 14px; border-radius: 2px; flex-shrink: 0; }
        .jira-card-key { font-size: 10px; color: #3b82f6; font-weight: 600; }
        .jira-card-title { font-size: 12px; color: #cbd5e1; margin-bottom: 10px; line-height: 1.5; }
        .jira-card-meta { display: flex; align-items: center; justify-content: space-between; gap: 6px; flex-wrap: wrap; }
        .jira-priority { font-size: 10px; padding: 2px 6px; border-radius: 3px; font-weight: 600; white-space: nowrap; }
        .jira-priority.critical { background: rgba(239,68,68,0.2); color: #ef4444; }
        .jira-priority.highest  { background: rgba(248,113,113,0.2); color: #f87171; }
        .jira-priority.high     { background: rgba(248,113,113,0.15); color: #f87171; }
        .jira-priority.medium   { background: rgba(245,158,11,0.15); color: #f59e0b; }
        .jira-priority.low      { background: rgba(16,185,129,0.15); color: #10b981; }
        .jira-priority.lowest   { background: rgba(100,116,139,0.15); color: #64748b; }
        .jira-priority.unknown  { background: rgba(100,116,139,0.1); color: #64748b; }
        .jira-assignee-avatar { width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6, #2563eb); display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 700; color: white; flex-shrink: 0; overflow: hidden; }
        .jira-assignee-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .jira-updated { font-size: 10px; color: #475569; }
        .jira-card-label { font-size: 9px; background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2); color: #60a5fa; padding: 1px 5px; border-radius: 3px; }
        .jira-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 30px; color: #475569; text-align: center; flex: 1; width: 100%; }
        .jira-state .icon { font-size: 36px; margin-bottom: 12px; }
        .jira-state .msg { font-size: 14px; color: #94a3b8; margin-bottom: 8px; }
        .jira-state .detail { font-size: 12px; color: #475569; max-width: 480px; line-height: 1.6; }
        .jira-state .retry-btn { margin-top: 16px; background: linear-gradient(135deg, #3b82f6, #2563eb); border: none; color: white; padding: 8px 20px; border-radius: 5px; font-size: 12px; font-weight: 600; cursor: pointer; }
        .jira-meta-bar { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; font-size: 11px; color: #475569; }
        .jira-meta-badge { background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2); color: #60a5fa; padding: 3px 8px; border-radius: 10px; font-size: 10px; font-weight: 600; }
        .jira-link { color: #3b82f6; text-decoration: none; font-size: 11px; }
        .jira-link:hover { text-decoration: underline; }
        /* Jira modal */
        #jiraModal { display: none; position: fixed; inset: 0; z-index: 8000; background: rgba(5,14,26,0.85); backdrop-filter: blur(4px); align-items: flex-start; justify-content: center; padding: 40px 20px; overflow-y: auto; }
        #jiraModal.open { display: flex; }
        .jira-modal-card { background: #0f1f35; border: 1px solid #1e3a5a; border-radius: 10px; width: 100%; max-width: 640px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); animation: jiraModalIn 0.2s ease; overflow: hidden; }
        @keyframes jiraModalIn { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: translateY(0); } }
        .jira-modal-header { padding: 20px 24px; border-bottom: 1px solid #1a2f4a; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
        .jira-modal-key { font-size: 11px; color: #3b82f6; font-weight: 700; margin-bottom: 4px; }
        .jira-modal-title { font-size: 16px; font-weight: 600; color: white; line-height: 1.4; }
        .jira-modal-close { background: none; border: none; color: #64748b; font-size: 20px; cursor: pointer; line-height: 1; padding: 2px 6px; border-radius: 4px; flex-shrink: 0; }
        .jira-modal-close:hover { color: #e0e0e0; background: #1a2f4a; }
        .jira-modal-body { padding: 20px 24px; }
        .jira-modal-meta { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 20px; }
        .jira-modal-field { display: flex; flex-direction: column; gap: 4px; min-width: 120px; }
        .jira-modal-field-label { font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.4px; }
        .jira-modal-field-value { font-size: 12px; color: #e0e0e0; }
        .jira-modal-desc { font-size: 12px; color: #94a3b8; line-height: 1.7; margin-bottom: 20px; white-space: pre-wrap; word-break: break-word; max-height: 200px; overflow-y: auto; }
        .jira-modal-section-title { font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 8px; margin-top: 16px; }
        .jira-subtask { display: flex; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px solid #1a2f4a; }
        .jira-subtask:last-child { border-bottom: none; }
        .jira-subtask-key { font-size: 10px; color: #3b82f6; font-weight: 600; }
        .jira-subtask-name { font-size: 11px; color: #94a3b8; flex: 1; }
        .jira-comment { padding: 10px 0; border-bottom: 1px solid #1a2f4a; }
        .jira-comment:last-child { border-bottom: none; }
        .jira-comment-meta { font-size: 10px; color: #64748b; margin-bottom: 4px; }
        .jira-comment-body { font-size: 12px; color: #94a3b8; white-space: pre-wrap; word-break: break-word; }
        .jira-modal-footer { padding: 14px 24px; border-top: 1px solid #1a2f4a; display: flex; justify-content: space-between; align-items: center; }
        .jira-open-btn { background: linear-gradient(135deg, #3b82f6, #2563eb); border: none; color: white; padding: 7px 16px; border-radius: 5px; font-size: 12px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
        .jira-open-btn:hover { opacity: 0.9; }
        /* Jira Board popup modal */
        #jiraBoardModal { display: none; position: fixed; inset: 0; z-index: 7500; background: rgba(5,14,26,0.88); backdrop-filter: blur(5px); align-items: flex-start; justify-content: center; padding: 28px 20px 20px; overflow-y: auto; }
        #jiraBoardModal.open { display: flex; }
        #jiraBoardModal.open { animation: jiraBoardModalIn 0.22s ease; }
        @keyframes jiraBoardModalIn { from { opacity: 0; } to { opacity: 1; } }
        .jira-board-modal-card { background: #0a1628; border: 1px solid #1e3a5a; border-radius: 12px; width: 100%; max-width: 1180px; max-height: calc(100vh - 56px); display: flex; flex-direction: column; box-shadow: 0 24px 80px rgba(0,0,0,0.6); animation: jiraBoardCardIn 0.22s ease; overflow: hidden; }
        @keyframes jiraBoardCardIn { from { opacity: 0; transform: translateY(-18px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
        .jira-board-modal-header { padding: 16px 24px; background: #0f1f35; border-bottom: 1px solid #1a2f4a; display: flex; align-items: center; gap: 14px; flex-shrink: 0; flex-wrap: wrap; }
        .jira-board-modal-title { font-size: 14px; font-weight: 700; color: white; }
        .jira-board-modal-close { margin-left: auto; background: none; border: 1px solid #2a3f5a; color: #64748b; width: 30px; height: 30px; border-radius: 6px; cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; flex-shrink: 0; }
        .jira-board-modal-close:hover { color: white; background: #1a2f4a; border-color: #3b82f6; }
        .jira-board-modal-body { flex: 1; overflow-y: auto; padding: 20px 24px; }
        /* Content layout */
        .content { flex: 1; display: flex; overflow: hidden; }
        .tab-content { display: none; flex: 1; overflow: hidden; }
        .tab-content.active { display: flex; }
        /* Dashboard */
        .dashboard-panel { width: 300px; background: #0f1f35; border-right: 1px solid #1a2f4a; padding: 24px; overflow-y: auto; flex-shrink: 0; }
        .panel-title { font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 12px; }
        .panel-heading { font-size: 20px; font-weight: 600; color: white; margin-bottom: 6px; }
        .panel-description { font-size: 12px; color: #64748b; margin-bottom: 20px; }
        .metric { margin-bottom: 16px; }
        .metric-label { font-size: 12px; color: #64748b; margin-bottom: 4px; }
        .metric-value { font-size: 24px; font-weight: 600; color: white; }
        .main-panel { flex: 1; padding: 30px; overflow-y: auto; }
        .section-title { font-size: 18px; font-weight: 600; color: white; margin-bottom: 20px; }
        .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 30px; }
        .metric-card { background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 6px; padding: 20px; }
        .metric-card-label { font-size: 11px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; }
        .metric-card-value { font-size: 26px; font-weight: 600; color: white; }
        /* Test Execution */
        .test-explorer-content { flex-direction: column; }
        .explorer-toolbar { background: #0f1f35; border-bottom: 1px solid #1a2f4a; padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; gap: 12px; flex-wrap: wrap; }
        .run-all-btn { background: linear-gradient(135deg, #3b82f6, #2563eb); border: none; color: white; padding: 8px 20px; border-radius: 5px; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 8px; }
        .run-all-btn:hover { background: linear-gradient(135deg, #2563eb, #1d4ed8); box-shadow: 0 4px 12px rgba(59,130,246,0.3); }
        .run-all-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        /* Suite + cases layout */
        .explorer-body { flex: 1; display: flex; overflow: hidden; }
        .suite-sidebar { width: 240px; background: #0f1f35; border-right: 1px solid #1a2f4a; display: flex; flex-direction: column; flex-shrink: 0; overflow: hidden; }
        .suite-sidebar-header { padding: 12px 14px; border-bottom: 1px solid #1a2f4a; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
        .suite-sidebar-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; }
        .new-suite-btn { background: linear-gradient(135deg,#3b82f6,#2563eb); border: none; color: white; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer; white-space: nowrap; transition: opacity 0.2s; }
        .new-suite-btn:hover { opacity: 0.88; }
        .suite-list { flex: 1; overflow-y: auto; padding: 8px; }
        .suite-item { padding: 9px 12px; border-radius: 5px; cursor: pointer; font-size: 12px; color: #94a3b8; margin-bottom: 3px; border: 1px solid transparent; transition: all 0.15s; display: flex; align-items: center; justify-content: space-between; gap: 6px; }
        .suite-item:hover { background: #1a2f4a; color: #e0e0e0; }
        .suite-item.active { background: rgba(59,130,246,0.12); color: #60a5fa; border-color: rgba(59,130,246,0.25); }
        .suite-item-name { flex: 1; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .suite-item-count { font-size: 10px; background: #1a2f4a; color: #64748b; padding: 1px 6px; border-radius: 8px; flex-shrink: 0; }
        .suite-item.active .suite-item-count { background: rgba(59,130,246,0.2); color: #60a5fa; }
        .suite-delete-btn { background: none; border: none; color: #334155; font-size: 13px; cursor: pointer; padding: 0 2px; line-height: 1; transition: color 0.15s; flex-shrink: 0; }
        .suite-delete-btn:hover { color: #f87171; }
        .suite-all-item { padding: 9px 12px; border-radius: 5px; cursor: pointer; font-size: 12px; color: #94a3b8; margin-bottom: 6px; border: 1px solid transparent; transition: all 0.15s; font-weight: 600; }
        .suite-all-item:hover { background: #1a2f4a; color: #e0e0e0; }
        .suite-all-item.active { background: rgba(16,185,129,0.1); color: #10b981; border-color: rgba(16,185,129,0.2); }
        /* Cases panel */
        .cases-panel { flex: 1; display: flex; flex-direction: column; overflow-y: auto; }
        .cases-toolbar { padding: 12px 20px; background: #0a1628; border-bottom: 1px solid #1a2f4a; display: flex; align-items: center; gap: 12px; flex-shrink: 0; flex-wrap: wrap; }
        .cases-toolbar-title { font-size: 13px; font-weight: 600; color: white; flex: 1; }
        .cases-add-btn { background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #10b981; padding: 5px 12px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer; transition: all 0.2s; white-space: nowrap; }
        .cases-add-btn:hover { background: rgba(16,185,129,0.22); }
        .cases-add-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .cases-list { flex: 1; overflow-y: auto; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; }
        .test-item { background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 6px; padding: 14px 16px; transition: all 0.2s; }
        .test-item:hover { background: #1f3a50; border-color: #3a5f7a; }
        .test-item.in-suite { border-color: rgba(16,185,129,0.4); background: rgba(16,185,129,0.04); }
        .test-item-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
        .test-item-left { display: flex; align-items: flex-start; gap: 10px; flex: 1; min-width: 0; }
        .test-item-cb { width: 15px; height: 15px; margin-top: 2px; accent-color: #3b82f6; cursor: pointer; flex-shrink: 0; }
        .test-name { font-size: 13px; font-weight: 600; color: #3b82f6; }
        .test-suite { font-size: 11px; color: #94a3b8; margin-bottom: 4px; }
        .test-steps { margin: 6px 0; padding-left: 12px; }
        .test-step { font-size: 11px; color: #64748b; padding: 2px 0; }
        .test-step::before { content: "→ "; color: #334155; }
        .test-description { font-size: 12px; color: #64748b; margin-bottom: 10px; }
        .test-meta { display: flex; gap: 12px; font-size: 10px; color: #475569; flex-wrap: wrap; }
        .test-in-suite-badge { font-size: 10px; background: rgba(16,185,129,0.12); color: #10b981; border: 1px solid rgba(16,185,129,0.25); padding: 1px 7px; border-radius: 8px; font-weight: 600; }
        /* New suite modal */
        #newSuiteModal { display: none; position: fixed; inset: 0; z-index: 9000; background: rgba(5,14,26,0.85); backdrop-filter: blur(4px); align-items: center; justify-content: center; }
        #newSuiteModal.open { display: flex; }
        .new-suite-card { background: #0f1f35; border: 1px solid #1e3a5a; border-radius: 10px; padding: 28px 32px; width: 360px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); animation: jiraModalIn 0.2s ease; }
        .new-suite-card h3 { font-size: 15px; font-weight: 700; color: white; margin-bottom: 16px; }
        .new-suite-input { width: 100%; padding: 9px 12px; background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 5px; color: #e0e0e0; font-size: 13px; outline: none; box-sizing: border-box; transition: border-color 0.2s; }
        .new-suite-input:focus { border-color: #3b82f6; }
        .new-suite-actions { display: flex; gap: 10px; margin-top: 18px; justify-content: flex-end; }
        .new-suite-cancel { background: none; border: 1px solid #2a3f5a; color: #64748b; padding: 7px 16px; border-radius: 5px; font-size: 12px; cursor: pointer; }
        .new-suite-cancel:hover { color: #e0e0e0; border-color: #475569; }
        .new-suite-create { background: linear-gradient(135deg,#3b82f6,#2563eb); border: none; color: white; padding: 7px 20px; border-radius: 5px; font-size: 12px; font-weight: 700; cursor: pointer; }
        .test-data-badge { display: inline-flex; gap: 6px; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2); border-radius: 4px; padding: 2px 8px; font-size: 10px; color: #10b981; margin-top: 6px; flex-wrap: wrap; }
        .token-stage-card { background: #0a1628; border: 1px solid #1a2f4a; border-radius: 8px; padding: 12px 14px; transition: border-color 0.2s; }
        .token-stage-card:hover { border-color: #2a4f7a; }
        .run-single-btn { background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.3); color: #60a5fa; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer; white-space: nowrap; transition: all 0.2s; flex-shrink: 0; }
        .run-single-btn:hover { background: rgba(59,130,246,0.25); }
        .run-single-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .test-status-badge { font-size: 10px; padding: 2px 8px; border-radius: 10px; font-weight: 600; }
        .test-status-badge.running { background: rgba(59,130,246,0.15); color: #60a5fa; }
        .test-status-badge.passed  { background: rgba(16,185,129,0.15); color: #10b981; }
        .test-status-badge.failed  { background: rgba(248,113,113,0.15); color: #f87171; }
        /* Log panel */
        .log-panel { background: #050e1a; border-top: 1px solid #1a2f4a; flex-shrink: 0; display: flex; flex-direction: column; max-height: 240px; }
        .log-header { padding: 8px 16px; background: #0f1f35; border-bottom: 1px solid #1a2f4a; display: flex; align-items: center; justify-content: space-between; }
        .log-title { font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; }
        .log-body { flex: 1; overflow-y: auto; padding: 10px 16px; font-family: monospace; font-size: 11px; color: #94a3b8; }
        .log-line { padding: 1px 0; white-space: pre-wrap; word-break: break-all; }
        .log-line.pass { color: #10b981; }
        .log-line.fail { color: #f87171; }
        .log-line.info { color: #60a5fa; }
        /* Progress bar */
        .progress-bar-wrap { height: 3px; background: #1a2f4a; margin: 0; }
        .progress-bar { height: 100%; width: 0%; background: #3b82f6; transition: width 0.4s ease; }
        .progress-bar.done  { background: #10b981; }
        .progress-bar.error { background: #f87171; }
        /* Status badge */
        .status-badge { font-size: 11px; padding: 3px 10px; border-radius: 12px; font-weight: 600; }
        .status-badge.idle    { background: #1a2f4a; color: #64748b; }
        .status-badge.running { background: rgba(59,130,246,0.15); color: #60a5fa; }
        .status-badge.passed  { background: rgba(16,185,129,0.15); color: #10b981; }
        .status-badge.failed  { background: rgba(248,113,113,0.15); color: #f87171; }
        /* History & Trends */
        .history-content { flex-direction: column; overflow-y: auto; }
        .history-inner { padding: 30px; flex: 1; overflow-y: auto; }
        .summary-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 30px; }
        .summary-card { background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 8px; padding: 20px; text-align: center; }
        .summary-card .val { font-size: 36px; font-weight: 700; margin-bottom: 4px; }
        .summary-card .lbl { font-size: 11px; color: #64748b; text-transform: uppercase; }
        .val.total { color: white; }
        .val.pass  { color: #10b981; }
        .val.fail  { color: #f87171; }
        .val.skip  { color: #f59e0b; }
        .suite-block { background: #0f1f35; border: 1px solid #1a2f4a; border-radius: 8px; margin-bottom: 20px; overflow: hidden; }
        .suite-header { padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; }
        .suite-header:hover { background: #142840; }
        .suite-name { font-size: 13px; font-weight: 600; color: #e0e0e0; }
        .suite-meta { display: flex; gap: 16px; align-items: center; font-size: 11px; color: #64748b; }
        .suite-cases { border-top: 1px solid #1a2f4a; }
        .case-row { display: flex; align-items: flex-start; padding: 10px 20px 10px 36px; border-bottom: 1px solid #0d1e30; gap: 12px; }
        .case-row:last-child { border-bottom: none; }
        .case-icon { font-size: 14px; flex-shrink: 0; margin-top: 1px; }
        .case-name { font-size: 12px; color: #cbd5e1; flex: 1; }
        .case-time { font-size: 11px; color: #475569; flex-shrink: 0; }
        .case-err { font-size: 11px; color: #f87171; margin-top: 4px; font-family: monospace; }
        .no-results { text-align: center; padding: 60px 30px; color: #475569; }
        .no-results .icon { font-size: 40px; margin-bottom: 12px; }
        .no-results p { font-size: 14px; }
        .timestamp-info { font-size: 11px; color: #475569; margin-bottom: 20px; }
        /* Test Data tab */
        .testdata-content { flex-direction: row; overflow: hidden; }
        .testdata-sidebar { width: 220px; background: #0f1f35; border-right: 1px solid #1a2f4a; padding: 20px 16px; overflow-y: auto; flex-shrink: 0; }
        .testdata-main { flex: 1; padding: 24px 30px; overflow-y: auto; }
        .testdata-file-item { padding: 8px 10px; border-radius: 5px; cursor: pointer; font-size: 12px; color: #94a3b8; margin-bottom: 4px; word-break: break-all; transition: background 0.15s; }
        .testdata-file-item:hover { background: #1a2f4a; color: #e0e0e0; }
        .testdata-file-item.active { background: rgba(59,130,246,0.12); color: #60a5fa; border: 1px solid rgba(59,130,246,0.2); }
        .testdata-kv { display: flex; align-items: flex-start; gap: 0; background: #0f1f35; border: 1px solid #1a2f4a; border-radius: 6px; overflow: hidden; margin-bottom: 8px; }
        .testdata-key { font-family: monospace; font-size: 12px; color: #60a5fa; padding: 10px 14px; min-width: 140px; background: rgba(59,130,246,0.05); border-right: 1px solid #1a2f4a; }
        .testdata-val { font-family: monospace; font-size: 12px; color: #10b981; padding: 10px 14px; word-break: break-all; }
        /* XLSX tabular view */
        .xlsx-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .xlsx-table thead th { padding: 8px 12px; background: #0f1f35; border: 1px solid #1e3a5a; color: #60a5fa; font-weight: 700; text-align: left; white-space: nowrap; font-size: 11px; text-transform: uppercase; letter-spacing: 0.3px; position: sticky; top: 0; z-index: 1; }
        .xlsx-table tbody tr:nth-child(even) { background: #0a1628; }
        .xlsx-table tbody tr:nth-child(odd)  { background: #050e1a; }
        .xlsx-table tbody tr:hover { background: #112240; }
        .xlsx-table tbody td { padding: 7px 12px; border: 1px solid #1a2f4a; color: #cbd5e1; vertical-align: top; word-break: break-word; max-width: 260px; }
        .xlsx-sheet-tab { padding: 7px 16px; font-size: 11px; font-weight: 600; border: none; border-bottom: 2px solid transparent; background: transparent; color: #64748b; cursor: pointer; transition: all 0.15s; white-space: nowrap; }
        .xlsx-sheet-tab.active { border-bottom-color: #3b82f6; background: rgba(59,130,246,0.08); color: #60a5fa; }
        .xlsx-sheet-tab:hover:not(.active) { color: #94a3b8; background: rgba(255,255,255,0.03); }
        /* Placeholder tabs */
        .placeholder-tab { padding: 60px 30px; color: #475569; text-align: center; flex: 1; }
        .placeholder-tab .big { font-size: 32px; margin-bottom: 10px; }
        /* Auth overlay */
        #authOverlay { position: fixed; inset: 0; z-index: 9999; background: rgba(5,14,26,0.92); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; }
        #authOverlay.hidden { display: none; }
        .auth-card { background: #0f1f35; border: 1px solid #1e3a5a; border-radius: 12px; padding: 40px 44px; width: 380px; box-shadow: 0 24px 64px rgba(0,0,0,0.6); animation: authSlideIn 0.25s ease; }
        @keyframes authSlideIn { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
        .auth-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
        .auth-logo-icon { width: 40px; height: 40px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: white; font-size: 20px; }
        .auth-logo-text .auth-logo-title { font-size: 13px; font-weight: 700; color: white; }
        .auth-logo-text .auth-logo-sub { font-size: 11px; color: #64748b; }
        .auth-heading { font-size: 20px; font-weight: 700; color: white; margin-bottom: 4px; }
        .auth-subheading { font-size: 12px; color: #64748b; margin-bottom: 28px; }
        .auth-field { margin-bottom: 18px; }
        .auth-label { display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; margin-bottom: 7px; }
        .auth-input { width: 100%; padding: 10px 14px; background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 6px; color: #e0e0e0; font-size: 13px; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
        .auth-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
        .auth-input.input-error { border-color: #f87171; }
        .auth-error { display: none; font-size: 12px; color: #f87171; background: rgba(248,113,113,0.08); border: 1px solid rgba(248,113,113,0.2); border-radius: 5px; padding: 9px 12px; margin-bottom: 18px; align-items: center; gap: 8px; }
        .auth-error.visible { display: flex; }
        .auth-btn { width: 100%; padding: 11px; background: linear-gradient(135deg, #3b82f6, #2563eb); border: none; border-radius: 6px; color: white; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.3px; transition: opacity 0.2s, box-shadow 0.2s; }
        .auth-btn:hover { opacity: 0.92; box-shadow: 0 4px 16px rgba(59,130,246,0.35); }
        .auth-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .auth-user-pill { display: flex; align-items: center; gap: 8px; margin-left: auto; cursor: pointer; padding: 5px 10px; border-radius: 20px; border: 1px solid #1e3a5a; background: #0f1f35; transition: background 0.2s; }
        .auth-user-pill:hover { background: #1a2f4a; }
        .auth-user-avatar { width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6, #2563eb); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: white; }
        .auth-user-name { font-size: 11px; color: #e0e0e0; font-weight: 500; }
        .auth-signout-btn { font-size: 10px; color: #64748b; margin-left: 4px; background: none; border: none; cursor: pointer; padding: 2px 4px; border-radius: 3px; }
        .auth-signout-btn:hover { color: #f87171; background: rgba(248,113,113,0.08); }
        .server-warn { background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25); border-radius: 6px; padding: 10px 14px; margin-bottom: 16px; font-size: 12px; color: #f59e0b; }
        /* ── Test Design tab ── */
        .testdesign-content { flex-direction: row; overflow: hidden; }
        #tdCodeEditorSection.td-code-editor-expanded { position: fixed; inset: 12px; z-index: 9990; padding: 12px; margin: 0 !important; overflow: auto; background: #07111f; border: 1px solid #2a3f5a; border-radius: 10px; box-shadow: 0 18px 60px rgba(0,0,0,0.7); }
        #tdCodeEditorSection.td-code-editor-expanded #tdCodeEditorBody > div { height: calc(100vh - 92px) !important; }
        
        /* Studio UI Styles */
        .td-studio-container { display: flex; gap: 12px; flex: 1; margin-top: 12px; margin-right: 12px; margin-bottom: 12px; height: calc(100% - 300px); }
        .td-studio-panel { flex: 1; display: flex; flex-direction: column; background: #0a1628; border: 1px solid #1a2f4a; border-radius: 6px; overflow: hidden; min-width: 200px; }
        .td-studio-header { background: #0f1e30; border-bottom: 1px solid #1a2f4a; padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
        .td-studio-tabs { display: flex; gap: 6px; flex: 1; }
        .td-studio-tab { padding: 6px 12px; font-size: 11px; font-weight: 600; background: #0a1628; border: 1px solid transparent; border-radius: 4px; cursor: pointer; color: #64748b; transition: all 0.2s; }
        .td-studio-tab.active { background: #1a2f4a; color: #60a5fa; border-color: #3b82f6; }
        .td-studio-content { flex: 1; overflow: auto; display: flex; flex-direction: column; background: #0d1d30; }
        .td-studio-editor { flex: 1; font-family: 'Monaco', 'Menlo', monospace; font-size: 12px; padding: 14px; color: #e2e8f0; overflow: auto; white-space: pre; word-wrap: break-word; border: none; resize: none; outline: none; line-height: 1.5; background: #0d1d30; }
        .td-studio-footer { background: #0a1628; border-top: 1px solid #1a2f4a; padding: 10px 14px; display: flex; gap: 8px; flex-shrink: 0; }
        .td-studio-btn { padding: 6px 12px; font-size: 11px; font-weight: 600; border: 1px solid #1a2f4a; border-radius: 4px; cursor: pointer; background: #1a2f4a; color: #60a5fa; transition: all 0.2s; white-space: nowrap; }
        .td-studio-btn:hover { background: #2a4a6a; border-color: #3b82f6; }
        .td-studio-btn.save { background: #16a34a; color: white; border-color: #22c55e; }
        .td-studio-btn.save:hover { background: #22c55e; }
        .td-studio-btn.dryrun { background: #7c3aed; color: white; border-color: #a78bfa; }
        .td-studio-btn.dryrun:hover { background: #a78bfa; }
        .td-log-line { padding: 6px 0; line-height: 1.4; }
        .td-log-line.error { color: #ef4444; }
        .td-log-line.success { color: #10b981; }
        .td-log-line.warning { color: #f59e0b; }
        .td-log-line.info { color: #3b82f6; }
        
        .testdesign-sidebar { width: 260px; background: #0f1f35; border-right: 1px solid #1a2f4a; display: flex; flex-direction: column; flex-shrink: 0; overflow: hidden; }
        .testdesign-sidebar-header { padding: 16px 18px 12px; border-bottom: 1px solid #1a2f4a; }
        .testdesign-sidebar-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; }
        .testdesign-sidebar-hint { font-size: 11px; color: #334155; margin-top: 5px; line-height: 1.4; }
        .testdesign-ticket-list { flex: 1; overflow-y: auto; padding: 8px; }
        .testdesign-ticket { background: #1a2f4a; border: 1px solid #2a3f5a; border-radius: 6px; padding: 10px 12px; margin-bottom: 6px; cursor: pointer; transition: border-color 0.2s, background 0.2s; }
        .testdesign-ticket:hover { background: #1f3a50; border-color: #3b82f6; }
        .testdesign-ticket.active { border-color: #3b82f6; background: rgba(59,130,246,0.08); }
        .testdesign-ticket-key { font-size: 10px; color: #3b82f6; font-weight: 700; margin-bottom: 3px; }
        .testdesign-ticket-summary { font-size: 12px; color: #cbd5e1; line-height: 1.4; }
        .testdesign-ticket-meta { display: flex; align-items: center; gap: 6px; margin-top: 5px; font-size: 10px; color: #475569; }
        .testdesign-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
        .testdesign-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; color: #334155; text-align: center; padding: 40px; }
        .testdesign-empty .td-icon { font-size: 40px; margin-bottom: 12px; }
        .testdesign-empty .td-msg { font-size: 14px; color: #64748b; }
        .testdesign-empty .td-hint { font-size: 12px; color: #334155; margin-top: 6px; }
        .testdesign-panel { flex: 1; overflow-y: auto; padding: 24px 28px; }
        .testdesign-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #1a2f4a; }
        .testdesign-issue-key { font-size: 12px; color: #3b82f6; font-weight: 700; margin-bottom: 4px; }
        .testdesign-issue-summary { font-size: 18px; font-weight: 600; color: white; line-height: 1.3; }
        .testdesign-issue-meta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
        .testdesign-meta-item { display: flex; align-items: center; gap: 5px; font-size: 11px; color: #64748b; }
        .testdesign-meta-label { text-transform: uppercase; letter-spacing: 0.3px; color: #475569; }
        .generate-btn { flex-shrink: 0; background: linear-gradient(135deg, #3b82f6, #2563eb); border: none; color: white; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 8px; white-space: nowrap; }
        .generate-btn:hover { opacity: 0.9; box-shadow: 0 4px 14px rgba(59,130,246,0.35); }
        .generate-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .testdesign-section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 10px; }
        .testdesign-criteria-box { background: #0a1628; border: 1px solid #1a2f4a; border-radius: 8px; padding: 16px; font-size: 12px; color: #94a3b8; line-height: 1.8; white-space: pre-wrap; word-break: break-word; max-height: 280px; overflow-y: auto; }
        .testdesign-result { margin-top: 20px; }
        .testdesign-result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
        .testdesign-gen-log { background: #050e1a; border: 1px solid #1a2f4a; border-radius: 8px; padding: 12px 14px; font-family: monospace; font-size: 11px; color: #64748b; max-height: 200px; overflow-y: auto; }
        .td-log-line { padding: 1px 0; white-space: pre-wrap; }
        .td-log-line.ok   { color: #10b981; }
        .td-log-line.err  { color: #f87171; }
        .td-log-line.info { color: #60a5fa; }
        .td-log-line.warn { color: #f59e0b; }
        .testdesign-file-card { background: #0f1f35; border: 1px solid #1e3a5a; border-radius: 8px; padding: 16px; margin-top: 16px; }
        .testdesign-file-path { font-family: monospace; font-size: 12px; color: #10b981; background: #050e1a; border: 1px solid #1a2f4a; border-radius: 4px; padding: 8px 12px; margin-bottom: 8px; word-break: break-all; }
        /* Script viewer modal */
        #scriptModal { display: none; position: fixed; inset: 0; z-index: 8500; background: rgba(5,14,26,0.9); backdrop-filter: blur(4px); align-items: center; justify-content: center; padding: 30px 20px; }
        #scriptModal.open { display: flex; }
        .script-modal-card { background: #0a1628; border: 1px solid #1e3a5a; border-radius: 10px; width: 100%; max-width: 860px; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.6); overflow: hidden; }
        .script-modal-header { padding: 16px 20px; border-bottom: 1px solid #1a2f4a; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-shrink: 0; }
        .script-modal-filename { font-family: monospace; font-size: 13px; color: #60a5fa; font-weight: 700; word-break: break-all; }
        .script-modal-close { background: none; border: none; color: #64748b; font-size: 20px; cursor: pointer; padding: 2px 6px; border-radius: 4px; flex-shrink: 0; }
        .script-modal-close:hover { color: #e0e0e0; background: #1a2f4a; }
        .script-modal-body { flex: 1; overflow-y: auto; padding: 0; }
        .script-modal-body pre { font-family: monospace; font-size: 12px; color: #94a3b8; padding: 20px; line-height: 1.7; white-space: pre-wrap; word-break: break-word; margin: 0; }
        .testdesign-file-path { font-family: monospace; font-size: 12px; color: #60a5fa; margin-bottom: 6px; }
        .testdesign-view-explorer-btn { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.25); color: #10b981; padding: 7px 14px; border-radius: 5px; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
        .testdesign-view-explorer-btn:hover { background: rgba(16,185,129,0.2); }
        /* ── Manual Test Cases tab ── */
        .manualtests-content { flex-direction: row; overflow: hidden; }
        .mt-card { background: #0f1f35; border: 1px solid #1e3a5a; border-radius: 8px; overflow: hidden; transition: border-color 0.2s; width: 100%; box-sizing: border-box; }
        .mt-card:hover { border-color: #2a4f6a; }
        .mt-card-header { display: flex; align-items: center; gap: 10px; padding: 12px 16px; cursor: pointer; user-select: none; transition: background 0.15s; flex-wrap: wrap; min-width: 0; }
        .mt-card-header:hover { background: rgba(255,255,255,0.03); }
        .mt-card-id { font-family: monospace; font-size: 10px; color: #64748b; font-weight: 600; flex-shrink: 0; min-width: 56px; }
        .mt-card-title { font-size: 13px; font-weight: 600; color: #e0e0e0; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .mt-badge { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 10px; border: 1px solid; white-space: nowrap; flex-shrink: 0; }
        .mt-gen-script-btn { background: linear-gradient(135deg,#3b82f6,#2563eb); border: none; color: white; font-size: 10px; font-weight: 700; padding: 4px 10px; border-radius: 4px; cursor: pointer; flex-shrink: 0; white-space: nowrap; transition: opacity 0.15s; }
        .mt-gen-script-btn:hover { opacity: 0.88; }
        /* Test Design — manual TC context banner */
        .td-from-manual-banner { background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.2); border-radius: 6px; padding: 10px 14px; margin-bottom: 16px; font-size: 12px; display: flex; align-items: center; gap: 10px; }
        .td-from-manual-badge { background: rgba(59,130,246,0.2); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); border-radius: 4px; padding: 2px 8px; font-size: 10px; font-weight: 700; flex-shrink: 0; white-space: nowrap; }
        .mt-badge-pos  { background: rgba(16,185,129,0.12); color: #10b981; border-color: rgba(16,185,129,0.25); }
        .mt-badge-neg  { background: rgba(248,113,113,0.12); color: #f87171; border-color: rgba(248,113,113,0.25); }
        .mt-badge-edge { background: rgba(167,139,250,0.12); color: #a78bfa; border-color: rgba(167,139,250,0.25); }
        .mt-badge-high   { background: rgba(248,113,113,0.12); color: #f87171; border-color: rgba(248,113,113,0.25); }
        .mt-badge-medium { background: rgba(245,158,11,0.12);  color: #f59e0b; border-color: rgba(245,158,11,0.25); }
        .mt-badge-low    { background: rgba(16,185,129,0.12);  color: #10b981; border-color: rgba(16,185,129,0.25); }
        .mt-delete-btn { background: none; border: 1px solid rgba(248,113,113,0.3); color: #f87171; font-size: 10px; padding: 3px 8px; border-radius: 4px; cursor: pointer; flex-shrink: 0; transition: all 0.15s; white-space: nowrap; }
        .mt-delete-btn:hover { background: rgba(248,113,113,0.15); }
        .mt-edit-btn { background: #0d1e32; border: 1px solid rgba(99,130,180,0.35); color: #8ba3c7; font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px; cursor: pointer; flex-shrink: 0; transition: all 0.18s; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; letter-spacing: 0.2px; }
        .mt-edit-btn:hover { background: #0f2540; border-color: rgba(99,130,180,0.6); color: #aec4e8; }
        .mt-card-body { border-top: 1px solid #1a2f4a; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; width: 100%; box-sizing: border-box; }
        .mt-field-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.4px; color: #64748b; font-weight: 600; margin-bottom: 4px; }
        .mt-field-box { background: #0a1628; border: 1px solid #1a2f4a; border-radius: 5px; padding: 10px 12px; font-size: 12px; color: #94a3b8; line-height: 1.6; word-break: break-word; overflow-wrap: break-word; width: 100%; box-sizing: border-box; white-space: pre-wrap; }
        .mt-meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
        .mt-meta-pill { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; border: 1px solid; }
        .mt-meta-pill-label { opacity: 0.7; font-weight: 500; text-transform: uppercase; font-size: 9px; letter-spacing: 0.5px; }
        .mt-meta-component { background: rgba(99,102,241,0.12); color: #a5b4fc; border-color: rgba(99,102,241,0.3); }
        .mt-meta-autoprio { background: rgba(245,158,11,0.12); color: #fbbf24; border-color: rgba(245,158,11,0.3); }
        .mt-steps-table { width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; }
        .mt-steps-table thead tr { background: #0b1d33; }
        .mt-steps-table thead th { padding: 9px 10px; color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; border-bottom: 1px solid #1a2f4a; }
        .mt-steps-table thead th:first-child { width: 42px; text-align: center; }
        .mt-steps-table thead th:last-child { width: 38%; }
        .mt-steps-table tbody tr { transition: background 0.15s; }
        .mt-steps-table tbody tr:nth-child(odd)  { background: #0a1628; }
        .mt-steps-table tbody tr:nth-child(even) { background: #0c1e34; }
        .mt-steps-table tbody tr:hover { background: #0f2540; }
        .mt-steps-table tbody td { padding: 9px 10px; border-bottom: 1px solid #162238; color: #cbd5e1; vertical-align: top; line-height: 1.55; }
        .mt-step-num-badge { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: rgba(99,102,241,0.18); color: #818cf8; font-size: 11px; font-weight: 700; border: 1px solid rgba(99,102,241,0.3); }
        .mt-steps-table .mt-expected-cell { color: #6ee7b7; background: rgba(16,185,129,0.05); }
        .mt-steps-list { list-style: none; display: flex; flex-direction: column; gap: 4px; width: 100%; }
        .mt-steps-list li { display: flex; gap: 8px; font-size: 12px; color: #94a3b8; word-break: break-word; overflow-wrap: break-word; }
        .mt-step-num { color: #3b82f6; font-weight: 700; flex-shrink: 0; min-width: 18px; }
        .mt-expected-box { background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); border-radius: 5px; padding: 10px 12px; font-size: 12px; color: #6ee7b7; line-height: 1.6; word-break: break-word; overflow-wrap: break-word; width: 100%; box-sizing: border-box; }
        /* ── Checkbox & selection ── */
        .mt-checkbox { width: 16px; height: 16px; cursor: pointer; accent-color: #3b82f6; flex-shrink: 0; }
        .mt-card.mt-card-checked { border-color: #3b82f6; background: linear-gradient(180deg, rgba(59,130,246,0.07) 0%, #0f1f35 100%); }
        .mt-card.mt-card-checked .mt-card-header { background: rgba(59,130,246,0.05); }
        /* ── Save button ── */
        .mt-save-btn { background: linear-gradient(135deg,#10b981,#059669); border: none; color: white; font-size: 12px; font-weight: 700; padding: 7px 18px; border-radius: 5px; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s; white-space: nowrap; }
        .mt-save-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .mt-save-btn:not(:disabled):hover { opacity: 0.9; box-shadow: 0 4px 12px rgba(16,185,129,0.35); }
        .mt-select-all-wrap { display: flex; align-items: center; gap: 7px; font-size: 12px; color: #94a3b8; cursor: pointer; user-select: none; }
        .mt-select-all-cb { width: 15px; height: 15px; cursor: pointer; accent-color: #3b82f6; }
        /* ── Saved test cases section ── */
        .mt-saved-section { padding: 20px 28px; border-top: 2px solid #1a2f4a; }
        .mt-saved-heading { font-size: 13px; font-weight: 700; color: #f59e0b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .mt-saved-card { background: #0a1628; border: 1px solid rgba(245,158,11,0.25); border-radius: 8px; overflow: hidden; margin-bottom: 8px; }
        .mt-saved-card-header { display: flex; align-items: center; gap: 10px; padding: 11px 16px; cursor: pointer; }
        .mt-saved-card-header:hover { background: rgba(255,255,255,0.02); }
        .mt-saved-badge { font-size: 9px; background: rgba(245,158,11,0.15); color: #f59e0b; border: 1px solid rgba(245,158,11,0.3); padding: 2px 6px; border-radius: 8px; font-weight: 700; flex-shrink: 0; white-space: nowrap; }
        /* ══════════════════════════════════════════════════════════════
           HIDE ALL CODE EDITOR FUNCTIONALITY EXCEPT TEST DESIGN TAB
           ══════════════════════════════════════════════════════════════ */
        .code-editor-section,
        .code-editor-heading,
        .code-editor-tabs,
        .code-editor-container,
        .code-editor-toolbar,
        .code-editor-filename,
        .code-editor-actions,
        .code-editor-btn,
        .code-editor-textarea,
        .code-editor-log,
        #mtEditModal,
        [onclick*="mtEditSaved"],
        [onclick*="mtSaveEdit"] {
            display: none !important;
            visibility: hidden !important;
            height: 0 !important;
            max-height: 0 !important;
            overflow: hidden !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            pointer-events: none !important;
        }
        /* KEEP the studio editor visible ONLY in Test Design tab */
        .td-studio-footer { display: flex; }
        .td-studio-btn { display: inline-block; }
        .code-log-line { padding: 2px 0; white-space: pre-wrap; word-break: break-all; }
        .code-log-line.error { color: #ef4444; }
        .code-log-line.success { color: #10b981; }
        .code-log-line.warning { color: #f59e0b; }
        .code-log-line.info { color: #3b82f6; }
        /* ── Toast notification ── */
        #mtToast { position: fixed; bottom: 28px; right: 28px; z-index: 9000; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
        .mt-toast { padding: 12px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; color: white; box-shadow: 0 8px 24px rgba(0,0,0,0.4); animation: mtToastIn 0.25s ease; pointer-events: auto; max-width: 340px; }
        .mt-toast.success { background: #059669; border: 1px solid rgba(16,185,129,0.5); }
        .mt-toast.error   { background: #b91c1c; border: 1px solid rgba(248,113,113,0.5); }
        @keyframes mtToastIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes mtToastOut { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(12px); } }
    </style>
</head>
<body>

<!-- Auth Overlay -->
<div id="authOverlay">
    <div class="auth-card" role="dialog" aria-modal="true" aria-labelledby="authHeading">
        <div class="auth-logo">
            <div class="auth-logo-icon" id="authLogoIcon">H</div>
            <div class="auth-logo-text">
                <div class="auth-logo-title" id="authLogoTitle">HexaPlay Orchestrator</div>
                <div class="auth-logo-sub" style="font-style:italic;">Enterprise Test Automation Platform powered by Playwright</div>
                <div style="font-size:10px;color:#94a3b8;font-weight:600;margin-top:2px;">Orchestrate. Automate. Accelerate.</div>
            </div>
        </div>
        <div class="auth-heading" id="authHeading">Sign In</div>
        <div class="auth-subheading">Enter your credentials to access the dashboard</div>
        <div class="auth-error" id="authError" role="alert"><span>⚠</span><span id="authErrorText">Invalid User ID or Password.</span></div>
        <div class="auth-field">
            <label class="auth-label" for="authUserId">User ID</label>
            <input class="auth-input" type="text" id="authUserId" placeholder="Enter your user ID" autocomplete="username" />
        </div>
        <div class="auth-field">
            <label class="auth-label" for="authPassword">Password</label>
            <input class="auth-input" type="password" id="authPassword" placeholder="Enter your password" autocomplete="current-password" />
        </div>
        <button class="auth-btn" id="authSignInBtn" onclick="handleSignIn()">Sign In</button>
    </div>
</div>

<div class="container">
    <!-- Header -->
    <div class="logo-header">
        <div class="logo">
            <div class="logo-icon" id="logoIcon">H</div>
            <div class="logo-text">
                <div class="logo-title" id="logoTitle">HexaPlay Orchestrator</div>
                <div class="logo-subtitle" style="font-style:italic;">Enterprise Test Automation Platform powered by Playwright</div>
            </div>
        </div>
        <div class="header-controls">
            <div class="control-group">
                <label class="control-label">Browser</label>
                <select class="dropdown"><option>Chromium</option><option>Firefox</option><option>WebKit</option></select>
            </div>
            <div class="control-group">
                <label class="control-label">Environment</label>
                <select class="dropdown"><option>DEV</option><option>STAGING</option><option>PROD</option></select>
            </div>
            <div class="auth-user-pill" id="userPill" style="display:none;" title="Signed in">
                <div class="auth-user-avatar" id="userAvatar"></div>
                <span class="auth-user-name" id="userPillName"></span>
                <button class="auth-signout-btn" onclick="handleSignOut()" title="Sign out">✕</button>
            </div>
            <!-- Server status pill -->
            <div id="serverStatusPill" title="Backend server status" style="display:flex;align-items:center;gap:7px;background:#0f1f35;border:1px solid #1e3a5a;border-radius:20px;padding:5px 12px;cursor:pointer;transition:border-color 0.2s;" onclick="showServerStatusModal()">
                <span id="serverDot" style="width:8px;height:8px;border-radius:50%;background:#64748b;flex-shrink:0;"></span>
                <span id="serverPillLabel" style="font-size:11px;color:#64748b;font-weight:600;">Server</span>
            </div>
        </div>
    </div>

    <!-- Server Status Modal -->
    <div id="serverModal" style="display:none;position:fixed;inset:0;z-index:9500;background:rgba(5,14,26,0.85);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
        <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:28px 32px;width:340px;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
                <span style="font-size:14px;font-weight:700;color:white;">Server Controls</span>
                <button onclick="closeServerModal()" style="background:none;border:none;color:#64748b;font-size:18px;cursor:pointer;line-height:1;">✕</button>
            </div>
            <div id="serverModalBody" style="font-size:12px;color:#94a3b8;line-height:2;margin-bottom:18px;">Loading…</div>
            <div style="display:flex;gap:10px;">
                <button onclick="refreshServerStatus()" style="flex:1;padding:8px;background:none;border:1px solid #2a3f5a;color:#64748b;border-radius:5px;font-size:12px;cursor:pointer;">↻ Refresh</button>
                <button id="serverRestartBtn" onclick="restartServer()" style="flex:1;padding:8px;background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.4);color:#60a5fa;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;">⟳ Restart Server</button>
            </div>
            <p style="font-size:10px;color:#475569;margin-top:12px;">Runs <code>node server/index.js</code> to restart the backend.</p>
        </div>
    </div>

    <!-- Nav bar -->
    <div class="main-section" style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
        <div class="navigation-header">
            <div class="header-title" id="headerTitle">HexaPlay Orchestrator</div>
            <div class="nav-tabs">
                <div class="nav-tab active" data-tab="dashboard">Dashboard</div>
                <div class="nav-tab" data-tab="requirements">Requirements</div>
                <div class="nav-tab" data-tab="manualtests">Test Cases</div>
                <div class="nav-tab" data-tab="testdesign">Automation Studio</div>
                <div class="nav-tab" data-tab="explorer">Test Execution</div>
                <div class="nav-tab" data-tab="history">History &amp; Trends</div>
                <div class="nav-tab" data-tab="data">Test Data</div>
                <div class="nav-tab" data-tab="defects">Defects</div>
                <div class="nav-tab" data-tab="vas">Value Added Services</div>
            </div>
        </div>

        <div class="content">

            <!-- ── Dashboard Tab ── -->
            <div class="tab-content active" id="dashboard" style="flex-direction:column;overflow-y:auto;">
                <div style="padding:28px 32px;flex:1;">

                    <!-- ── Work Summary ── -->
                    <div style="margin-bottom:32px;">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
                            <div style="width:4px;height:22px;background:linear-gradient(180deg,#3b82f6,#2563eb);border-radius:2px;"></div>
                            <div style="font-size:15px;font-weight:700;color:white;letter-spacing:0.3px;">Work Summary</div>
                        </div>
                        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
                            <!-- Total Tests -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:22px 20px;display:flex;flex-direction:column;gap:8px;position:relative;overflow:hidden;">
                                <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#3b82f6,#2563eb);"></div>
                                <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#64748b;">Total Tests</div>
                                <div style="font-size:36px;font-weight:800;color:white;line-height:1;" id="dashTotalTests">–</div>
                                <div style="font-size:11px;color:#475569;">All spec test cases</div>
                            </div>
                            <!-- Passed -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:22px 20px;display:flex;flex-direction:column;gap:8px;position:relative;overflow:hidden;">
                                <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#10b981,#059669);"></div>
                                <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#64748b;">Passed Tests</div>
                                <div style="font-size:36px;font-weight:800;color:#10b981;line-height:1;" id="dashCardPassed">–</div>
                                <div style="font-size:11px;color:#475569;">Last run results</div>
                            </div>
                            <!-- Failed -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:22px 20px;display:flex;flex-direction:column;gap:8px;position:relative;overflow:hidden;">
                                <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#f87171,#ef4444);"></div>
                                <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#64748b;">Failed Tests</div>
                                <div style="font-size:36px;font-weight:800;color:#f87171;line-height:1;" id="dashCardFailed">–</div>
                                <div style="font-size:11px;color:#475569;">Last run results</div>
                            </div>
                            <!-- Pass Rate -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:22px 20px;display:flex;flex-direction:column;gap:8px;position:relative;overflow:hidden;">
                                <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#a78bfa,#7c3aed);"></div>
                                <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#64748b;">Pass Rate</div>
                                <div style="font-size:36px;font-weight:800;line-height:1;" id="dashPassRateVal">–</div>
                                <div style="background:#1a2f4a;border-radius:6px;overflow:hidden;height:6px;margin-top:2px;">
                                    <div id="dashPassRateBar" style="height:100%;background:#10b981;transition:width 0.6s ease;width:0%;border-radius:6px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Metrics Overview ── -->
                    <div style="margin-bottom:32px;">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
                            <div style="width:4px;height:22px;background:linear-gradient(180deg,#a78bfa,#7c3aed);border-radius:2px;"></div>
                            <div style="font-size:15px;font-weight:700;color:white;letter-spacing:0.3px;">Metrics Overview</div>
                        </div>
                        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
                            <!-- Spec Files -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.25);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">📁</div>
                                <div>
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:3px;">Spec Files</div>
                                    <div style="font-size:24px;font-weight:800;color:white;" id="dashCardSpecs">–</div>
                                </div>
                            </div>
                            <!-- Test Suites -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🧪</div>
                                <div>
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:3px;">Test Suites</div>
                                    <div style="font-size:24px;font-weight:800;color:white;" id="dashCardSuites">–</div>
                                </div>
                            </div>
                            <!-- Page Objects -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:rgba(167,139,250,0.12);border:1px solid rgba(167,139,250,0.25);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">📦</div>
                                <div>
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:3px;">Page Objects</div>
                                    <div style="font-size:24px;font-weight:800;color:white;" id="dashCardPages">–</div>
                                </div>
                            </div>
                            <!-- Automated Test Cases -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.25);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">⚙️</div>
                                <div>
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:3px;">Automated Test Cases</div>
                                    <div style="font-size:24px;font-weight:800;color:white;" id="dashCardTests">–</div>
                                </div>
                            </div>
                            <!-- Framework -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🎭</div>
                                <div>
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:3px;">Framework</div>
                                    <div style="font-size:16px;font-weight:800;color:#60a5fa;">Playwright</div>
                                    <div style="font-size:10px;color:#475569;">TypeScript</div>
                                </div>
                            </div>
                            <!-- Automation Coverage -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🎯</div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:5px;">Automation Coverage</div>
                                    <div style="font-size:18px;font-weight:800;color:#10b981;" id="dashCoverage">–</div>
                                    <div style="background:#1a2f4a;border-radius:4px;overflow:hidden;height:4px;margin-top:4px;">
                                        <div id="dashCoverageBar" style="height:100%;background:#10b981;width:0%;border-radius:4px;transition:width 0.6s ease;"></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Execution Trend -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:rgba(248,113,113,0.1);border:1px solid rgba(248,113,113,0.2);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">📈</div>
                                <div>
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:3px;">Execution Trend</div>
                                    <div style="font-size:16px;font-weight:700;" id="dashTrend">–</div>
                                    <div style="font-size:10px;color:#475569;" id="dashLastRun">–</div>
                                </div>
                            </div>
                            <!-- Token Utilization -->
                            <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:rgba(167,139,250,0.12);border:1px solid rgba(167,139,250,0.25);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🔑</div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:3px;">Token Utilization</div>
                                    <div style="font-size:14px;font-weight:700;color:#a78bfa;" id="dashTokens">–</div>
                                    <div style="font-size:10px;color:#475569;" id="dashTokensHint">AI provider tokens used</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Server warning -->
                    <div id="dashServerWarn" class="server-warn" style="display:none;">
                        ⚠ Cannot reach backend server at <code>http://localhost:4000</code>. Run: <code>cd server &amp;&amp; node index.js</code>
                    </div>

                    <!-- ── Project Info ── -->
                    <div style="margin-bottom:32px;">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
                            <div style="width:4px;height:22px;background:linear-gradient(180deg,#10b981,#059669);border-radius:2px;"></div>
                            <div style="font-size:15px;font-weight:700;color:white;letter-spacing:0.3px;">Project Info</div>
                        </div>
                        <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:22px 24px;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px 32px;">
                            <div style="display:flex;flex-direction:column;gap:3px;">
                                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;font-weight:700;">Story ID</span>
                                <span style="font-size:13px;color:#60a5fa;font-weight:700;" id="dashProjStoryId">–</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:3px;">
                                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;font-weight:700;">Story Name</span>
                                <span style="font-size:13px;color:#e0e0e0;" id="dashProjStoryName">–</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:3px;">
                                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;font-weight:700;">Platform</span>
                                <span style="font-size:13px;color:#e0e0e0;text-transform:capitalize;" id="dashProjPlatform">–</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:3px;">
                                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;font-weight:700;">Framework</span>
                                <span style="font-size:13px;color:#e0e0e0;" id="dashProjFramework">–</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:3px;">
                                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;font-weight:700;">Target App URL</span>
                                <span style="font-size:12px;color:#94a3b8;word-break:break-all;" id="dashProjBaseUrl">–</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:3px;">
                                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;font-weight:700;">Test Data Files</span>
                                <span style="font-size:13px;color:#e0e0e0;" id="dashProjDataFiles">–</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:3px;">
                                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;font-weight:700;">Skipped Tests</span>
                                <span style="font-size:13px;color:#f59e0b;" id="dashProjSkipped">–</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:3px;">
                                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;font-weight:700;">Jira Link</span>
                                <span style="font-size:13px;" id="dashProjJiraUrl">–</span>
                            </div>
                        </div>
                    </div>

                    <!-- ── Token Utility ── -->
                    <div style="margin-bottom:32px;">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
                            <div style="width:4px;height:22px;background:linear-gradient(180deg,#7c3aed,#6d28d9);border-radius:2px;"></div>
                            <div style="font-size:15px;font-weight:700;color:white;letter-spacing:0.3px;">Token Utility</div>
                            <button onclick="tokenRefreshAll()" style="margin-left:auto;background:rgba(124,58,237,0.12);border:1px solid rgba(124,58,237,0.3);color:#a78bfa;padding:4px 12px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">↻ Refresh</button>
                            <button onclick="tokenResetAll()" style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;padding:4px 12px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">🔄 Reset</button>
                        </div>
                        <div style="background:#0f1f35;border:1px solid #1e3a5a;border-radius:10px;padding:22px 24px;">
                            <!-- Budget Overview -->
                            <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid #1a2f4a;">
                                <div style="font-size:11px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Default Budget:</div>
                                <div style="font-size:18px;font-weight:800;color:#a78bfa;" id="tokenBudgetTotal">10,000</div>
                                <div style="font-size:11px;color:#64748b;">tokens per stage</div>
                                <div style="margin-left:auto;font-size:11px;color:#64748b;">Total Consumed:</div>
                                <div style="font-size:18px;font-weight:800;color:#f59e0b;" id="tokenTotalConsumed">0</div>
                                <div style="font-size:11px;color:#64748b;">|</div>
                                <div style="font-size:14px;font-weight:700;color:#a78bfa;" id="tokenUtilizationPercent">0%</div>
                            </div>
                            <!-- Stage breakdown -->
                            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;" id="tokenStageGrid">
                                <div class="token-stage-card" data-stage="jira-context">
                                    <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;">📋 Jira Context</div>
                                    <div style="display:flex;align-items:baseline;gap:6px;">
                                        <span style="font-size:16px;font-weight:700;color:#60a5fa;" id="tokenUsed-jira-context">0</span>
                                        <span style="font-size:10px;color:#475569;">/ 1,500</span>
                                    </div>
                                    <div style="margin-top:4px;height:4px;background:#1a2f4a;border-radius:2px;overflow:hidden;"><div id="tokenBar-jira-context" style="height:100%;background:#60a5fa;border-radius:2px;width:0%;transition:width 0.3s;"></div></div>
                                </div>
                                <div class="token-stage-card" data-stage="test-cases">
                                    <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;">🧪 Test Cases</div>
                                    <div style="display:flex;align-items:baseline;gap:6px;">
                                        <span style="font-size:16px;font-weight:700;color:#10b981;" id="tokenUsed-test-cases">0</span>
                                        <span style="font-size:10px;color:#475569;">/ 3,000</span>
                                    </div>
                                    <div style="margin-top:4px;height:4px;background:#1a2f4a;border-radius:2px;overflow:hidden;"><div id="tokenBar-test-cases" style="height:100%;background:#10b981;border-radius:2px;width:0%;transition:width 0.3s;"></div></div>
                                </div>
                                <div class="token-stage-card" data-stage="test-design">
                                    <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;">📐 Test Design</div>
                                    <div style="display:flex;align-items:baseline;gap:6px;">
                                        <span style="font-size:16px;font-weight:700;color:#f59e0b;" id="tokenUsed-test-design">0</span>
                                        <span style="font-size:10px;color:#475569;">/ 3,000</span>
                                    </div>
                                    <div style="margin-top:4px;height:4px;background:#1a2f4a;border-radius:2px;overflow:hidden;"><div id="tokenBar-test-design" style="height:100%;background:#f59e0b;border-radius:2px;width:0%;transition:width 0.3s;"></div></div>
                                </div>
                                <div class="token-stage-card" data-stage="script-generation">
                                    <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;">⚡ Script Generation</div>
                                    <div style="display:flex;align-items:baseline;gap:6px;">
                                        <span style="font-size:16px;font-weight:700;color:#7c3aed;" id="tokenUsed-script-generation">0</span>
                                        <span style="font-size:10px;color:#475569;">/ 4,000</span>
                                    </div>
                                    <div style="margin-top:4px;height:4px;background:#1a2f4a;border-radius:2px;overflow:hidden;"><div id="tokenBar-script-generation" style="height:100%;background:#7c3aed;border-radius:2px;width:0%;transition:width 0.3s;"></div></div>
                                </div>
                                <div class="token-stage-card" data-stage="dry-run">
                                    <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;">▶ Dry Run</div>
                                    <div style="display:flex;align-items:baseline;gap:6px;">
                                        <span style="font-size:16px;font-weight:700;color:#ec4899;" id="tokenUsed-dry-run">0</span>
                                        <span style="font-size:10px;color:#475569;">/ 3,000</span>
                                    </div>
                                    <div style="margin-top:4px;height:4px;background:#1a2f4a;border-radius:2px;overflow:hidden;"><div id="tokenBar-dry-run" style="height:100%;background:#ec4899;border-radius:2px;width:0%;transition:width 0.3s;"></div></div>
                                </div>
                                <div class="token-stage-card" data-stage="failure-analysis">
                                    <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;">🔍 Failure Analysis</div>
                                    <div style="display:flex;align-items:baseline;gap:6px;">
                                        <span style="font-size:16px;font-weight:700;color:#f87171;" id="tokenUsed-failure-analysis">0</span>
                                        <span style="font-size:10px;color:#475569;">/ 2,500</span>
                                    </div>
                                    <div style="margin-top:4px;height:4px;background:#1a2f4a;border-radius:2px;overflow:hidden;"><div id="tokenBar-failure-analysis" style="height:100%;background:#f87171;border-radius:2px;width:0%;transition:width 0.3s;"></div></div>
                                </div>
                                <div class="token-stage-card" data-stage="script-maintenance">
                                    <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;">🔧 Script Maintenance</div>
                                    <div style="display:flex;align-items:baseline;gap:6px;">
                                        <span style="font-size:16px;font-weight:700;color:#06b6d4;" id="tokenUsed-script-maintenance">0</span>
                                        <span style="font-size:10px;color:#475569;">/ 3,000</span>
                                    </div>
                                    <div style="margin-top:4px;height:4px;background:#1a2f4a;border-radius:2px;overflow:hidden;"><div id="tokenBar-script-maintenance" style="height:100%;background:#06b6d4;border-radius:2px;width:0%;transition:width 0.3s;"></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-content test-explorer-content" id="explorer" style="position:relative;">
                <!-- Toolbar -->
                <div class="explorer-toolbar">
                    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
                        <div style="font-size:14px;font-weight:600;color:white;">Test Execution</div>
                        <!-- Test Suite filter -->
                        <div style="display:flex;align-items:center;gap:6px;">
                            <span style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;">Test Suites:</span>
                            <select id="execTicketFilter" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:120px;" onchange="execFilterChanged(this.value)">
                                <option value="">All Test Suites</option>
                            </select>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <button class="run-all-btn" id="runBtn" onclick="runAllTests()">&#9654; Run All Tests</button>
                        <button class="run-all-btn" id="runSelectedBtn" onclick="runSelectedTests()" disabled style="background:linear-gradient(135deg,#7c3aed,#6d28d9);white-space:nowrap;">&#9654; Run Selected</button>
                        <button class="run-all-btn" id="runSuiteBtn" onclick="runSuiteTests()" style="background:linear-gradient(135deg,#059669,#047857);display:none;">&#9654; Run Suite</button>
                        <button onclick="toggleScheduler()" id="schedulerToggleBtn" class="run-all-btn" style="background:linear-gradient(135deg,#6366f1,#4f46e5);white-space:nowrap;">&#128197; Scheduler</button>
                    </div>
                </div>
                <div class="progress-bar-wrap"><div class="progress-bar" id="progressBar"></div></div>

                <!-- Body: suite sidebar + cases panel -->
                <div class="explorer-body">

                    <!-- Left: Suite Sidebar -->
                    <div class="suite-sidebar">
                        <div class="suite-sidebar-header">
                            <span class="suite-sidebar-title">Test Suites</span>
                            <button class="new-suite-btn" onclick="openNewSuiteModal()">+ New Suite</button>
                        </div>
                        <div class="suite-list" id="suiteList">
                            <!-- populated by JS -->
                        </div>
                    </div>
                    <!-- Right: Cases Panel -->
                    <div class="cases-panel">
                        <div class="cases-toolbar">
                            <span class="cases-toolbar-title" id="casesToolbarTitle">All Test Cases</span>
                            <div style="display:flex;align-items:center;gap:6px;margin-left:auto;">
                                <select class="jira-view-select" id="addToSuiteSelect" style="font-size:11px;padding:4px 8px;min-width:140px;">
                                    <option value="">Add to suite…</option>
                                </select>
                                <button class="cases-add-btn" id="addToSuiteBtn" onclick="addSelectedToSuite()" disabled>+ Add</button>
                            </div>
                        </div>

                        <!-- Generated Scripts section -->
                        <div id="execScriptsSection" style="display:none;padding:10px 20px 0;border-bottom:1px solid #1a2f4a;">
                            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#60a5fa;">⚡ Generated Test Scripts</span>
                                <span id="execScriptsCount" style="font-size:10px;background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.25);padding:2px 7px;border-radius:10px;font-weight:600;"></span>
                            </div>
                            <div id="execScriptsList" style="display:flex;flex-direction:column;gap:6px;margin-bottom:10px;padding-right:4px;"></div>
                        </div>

                        <div class="cases-list" id="testsList">
                            <div class="no-results"><div class="icon">⏳</div><p>Loading test cases…</p></div>
                        </div>
                    </div>
                </div>

                <!-- Log panel -->
                <div class="log-panel" id="logPanel" style="display:none;">
                    <div class="log-header">
                        <span class="log-title">📄 Live Output</span>
                        <span id="logStatus" style="font-size:11px;color:#64748b;"></span>
                        <button onclick="document.getElementById('logPanel').style.display='none'" style="margin-left:auto;background:none;border:none;color:#475569;cursor:pointer;font-size:14px;">✕</button>
                    </div>
                    <div class="log-body" id="logBody"></div>
                    <!-- Result summary row -->
                    <div id="logSummary" style="display:none;padding:8px 16px;background:#0f1f35;border-top:1px solid #1a2f4a;display:flex;gap:16px;font-size:12px;flex-wrap:wrap;align-items:center;">
                    </div>
                </div>

                <!-- ── Scheduler Panel (full page overlay within tab) ── -->
                <div id="schedulerPanel" style="display:none;position:absolute;inset:0;z-index:100;background:#0a1628;flex-direction:column;overflow:hidden;">
                    <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:14px 24px;display:flex;align-items:center;gap:12px;flex-shrink:0;">
                        <span style="font-size:14px;font-weight:700;color:white;">🗓 Test Scheduler</span>
                        <span style="font-size:11px;color:#64748b;">Manage scheduled test runs</span>
                        <button onclick="showScheduleForm()" style="margin-left:auto;background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:6px 16px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;">+ New Schedule</button>
                        <button onclick="toggleScheduler()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:5px 12px;border-radius:5px;font-size:11px;cursor:pointer;">✕ Close</button>
                    </div>
                    <!-- Schedule Form (hidden by default) -->
                    <div id="scheduleFormPanel" style="display:none;padding:24px;border-bottom:1px solid #1a2f4a;background:#0f1f35;">
                        <div style="max-width:600px;display:grid;grid-template-columns:140px 1fr;gap:12px 16px;align-items:center;">
                            <label style="font-size:11px;color:#94a3b8;font-weight:600;">Scheduler Name</label>
                            <input id="schName" type="text" placeholder="e.g. Nightly Smoke Run" style="padding:7px 12px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;font-size:12px;outline:none;" />

                            <label style="font-size:11px;color:#94a3b8;font-weight:600;">Test Suite</label>
                            <select id="schSuite" style="padding:7px 12px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;font-size:12px;cursor:pointer;">
                                <option value="">— Select Suite —</option>
                            </select>

                            <label style="font-size:11px;color:#94a3b8;font-weight:600;">Environment</label>
                            <select id="schEnv" style="padding:7px 12px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;font-size:12px;cursor:pointer;">
                                <option value="Dev">Dev</option>
                                <option value="QA">QA</option>
                                <option value="UAT">UAT</option>
                                <option value="Prod">Prod</option>
                            </select>

                            <label style="font-size:11px;color:#94a3b8;font-weight:600;">Browser</label>
                            <select id="schBrowser" style="padding:7px 12px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;font-size:12px;cursor:pointer;">
                                <option value="Chromium">Chromium</option>
                                <option value="Edge">Edge</option>
                                <option value="Firefox">Firefox</option>
                            </select>

                            <label style="font-size:11px;color:#94a3b8;font-weight:600;">Frequency</label>
                            <select id="schFrequency" style="padding:7px 12px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;font-size:12px;cursor:pointer;">
                                <option value="Hourly">Hourly</option>
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Monthly">Monthly</option>
                            </select>

                            <label style="font-size:11px;color:#94a3b8;font-weight:600;">Start Date</label>
                            <input id="schStartDate" type="date" style="padding:7px 12px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;font-size:12px;outline:none;" />

                            <label style="font-size:11px;color:#94a3b8;font-weight:600;">Start Time</label>
                            <input id="schStartTime" type="time" style="padding:7px 12px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;font-size:12px;outline:none;" />
                        </div>
                        <div style="margin-top:16px;display:flex;gap:10px;">
                            <button onclick="saveScheduleForm()" style="background:linear-gradient(135deg,#10b981,#059669);border:none;color:white;padding:7px 20px;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;">💾 Save Schedule</button>
                            <button onclick="cancelScheduleForm()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:7px 16px;border-radius:5px;font-size:12px;cursor:pointer;">Cancel</button>
                        </div>
                    </div>
                    <!-- Schedule List -->
                    <div id="scheduleList" style="flex:1;overflow-y:auto;padding:16px 24px;display:flex;flex-direction:column;gap:10px;">
                        <div style="font-size:12px;color:#475569;text-align:center;padding:30px;">No schedules yet. Click <strong style="color:#60a5fa;">+ New Schedule</strong> to create one.</div>
                    </div>
                </div>

            </div>

            <!-- ── History & Trends Tab ── -->
            <div class="tab-content history-content" id="history">
                <div class="history-inner" id="historyInner">
                    <div class="no-results"><div class="icon">📊</div><p>Loading results…</p></div>
                </div>
            </div>

            <!-- ── Test Data Tab ── -->
            <div class="tab-content testdata-content" id="data">
                <div class="testdata-sidebar">
                    <div class="panel-title" style="margin-bottom:14px;">Data Files</div>
                    <div id="testdataFileList"><div style="font-size:12px;color:#475569;">Loading…</div></div>
                </div>
                <div class="testdata-main" id="testdataContent" style="display:flex;flex-direction:column;overflow:hidden;">
                    <!-- Toolbar -->
                    <div id="testdataToolbar" style="display:none;padding:12px 0 16px;border-bottom:1px solid #1a2f4a;margin-bottom:16px;flex-shrink:0;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                        <button onclick="tdDownloadTemplate()" style="background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:6px 14px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;">📥 Download Template</button>
                        <button onclick="tdExportJson()" style="background:linear-gradient(135deg,#059669,#047857);border:none;color:white;padding:6px 14px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;">📤 Export JSON</button>
                        <label style="background:linear-gradient(135deg,#7c3aed,#6d28d9);border:none;color:white;padding:6px 14px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;">📎 Upload Data <input type="file" accept=".json" onchange="tdUploadJson(this)" style="display:none;" /></label>
                        <button onclick="tdAddDataSet()" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);color:#10b981;padding:6px 14px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;">➕ Add Data Set</button>
                        <span id="testdataMsg" style="font-size:10px;color:#10b981;margin-left:auto;display:none;"></span>
                    </div>
                    <!-- Content -->
                    <div id="testdataView" style="flex:1;overflow-y:auto;">
                        <div style="color:#475569;font-size:13px;">Select a file to view its contents</div>
                    </div>
                </div>
            </div>

            <!-- ── Test Design Tab ── -->
            <div class="tab-content testdesign-content" id="testdesign">
                <div class="testdesign-sidebar">
                    <div class="testdesign-sidebar-header">
                        <div class="testdesign-sidebar-title" id="tdSidebarTitle">📋 Work Items</div>
                        <div class="testdesign-sidebar-hint" id="tdSidebarHint">Click a ticket from the board, or select one below to generate tests</div>
                        <!-- Local files section (shown when no TM tool selected) -->
                        <div id="tdLocalFilesSection" style="display:none;margin-top:8px;">
                            <div style="font-size:10px;color:#475569;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.4px;">Local Requirement Files</div>
                            <div id="tdLocalFileList" style="max-height:160px;overflow-y:auto;display:flex;flex-direction:column;gap:3px;"></div>
                        </div>
                        <!-- Remote TM selects -->
                        <div id="tdRemoteSection" style="margin-top:8px;">
                            <select id="tdToolSelect" class="jira-view-select" style="font-size:11px;padding:4px 8px;width:100%;margin-bottom:6px;" onchange="tdOnToolChange(this.value)">
                                <option value="">— Select Tool —</option>
                                <option value="ADO">☁️ Azure DevOps</option>
                                <option value="Jira">🟦 Jira</option>
                                <option value="LocalHost">🖥️ Local Host</option>
                            </select>
                            <div id="tdProjectViewWrap" style="display:none;">
                                <select id="tdProjectSelect" class="jira-view-select" style="font-size:11px;padding:4px 8px;width:100%;margin-bottom:6px;" onchange="tdChangeProject(this.value)">
                                    <option value="">Loading projects…</option>
                                </select>
                                <div style="display:flex;gap:6px;align-items:center;">
                                    <select id="tdViewSelect" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:0;flex:1;" onchange="tdChangeView(this.value)">
                                        <option value="all">All Issues</option>
                                        <option value="sprint">Active Sprint</option>
                                        <option value="backlog">Backlog</option>
                                        <option value="inprogress">In Progress</option>
                                        <option value="done">Done</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="testdesign-ticket-list" id="tdTicketList">
                        <div style="padding:16px;font-size:12px;color:#334155;text-align:center;">
                            Loading tickets…
                        </div>
                    </div>
                </div>
                <div class="testdesign-main" id="tdMain">
                    <div class="testdesign-empty" id="tdEmpty">
                        <div class="td-icon">🎯</div>
                        <div class="td-msg">No ticket selected</div>
                        <div class="td-hint">Select a Jira ticket from the left panel<br>or click any card on the Jira Board</div>
                    </div>
                    <div class="testdesign-panel" id="tdPanel" style="display:none;">
                        <div class="testdesign-header">
                            <div>
                                <div class="testdesign-issue-key" id="tdIssueKey"></div>
                                <div class="testdesign-issue-summary" id="tdIssueSummary"></div>
                                <div class="testdesign-issue-meta" id="tdIssueMeta"></div>
                            </div>
                            <button class="generate-btn" id="tdGenerateBtn" onclick="generateTests()">
                                ⚡ Generate Test Scripts
                            </button>
                        </div>

                        <div style="margin-bottom:20px;">
                            <div class="testdesign-section-title" onclick="tdToggleTicketSection()" style="cursor:pointer;display:flex;align-items:center;gap:6px;user-select:none;" onmouseenter="this.style.color='#94a3b8'" onmouseleave="this.style.color=''">
                                <span id="tdTicketIdChevron" style="font-size:10px;transition:transform 0.2s;display:inline-block;">▼</span>
                                📋 Ticket ID
                            </div>
                            <div id="tdTicketIdBody">
                                <div style="font-size:13px;color:#60a5fa;font-weight:700;background:#0a1628;border:1px solid #1a2f4a;border-radius:6px;padding:10px 14px;" id="tdTicketIdDisplay">–</div>
                            </div>
                        </div>

                        <div style="margin-bottom:20px;" id="tdDescSection">
                            <div class="testdesign-section-title" onclick="tdToggleSection('tdDescBody','tdDescChevron')" style="cursor:pointer;display:flex;align-items:center;gap:6px;user-select:none;" onmouseenter="this.style.color='#94a3b8'" onmouseleave="this.style.color=''">
                                <span id="tdDescChevron" style="font-size:10px;transition:transform 0.2s;display:inline-block;">▼</span>
                                📝 Description
                            </div>
                            <div id="tdDescBody">
                                <div class="testdesign-criteria-box" id="tdDescription" style="max-height:180px;">–</div>
                            </div>
                        </div>

                        <div style="margin-bottom:20px;" id="tdCriteriaSection">
                            <div class="testdesign-section-title" onclick="tdToggleSection('tdCriteriaBody','tdCriteriaChevron')" style="cursor:pointer;display:flex;align-items:center;gap:6px;user-select:none;" onmouseenter="this.style.color='#94a3b8'" onmouseleave="this.style.color=''">
                                <span id="tdCriteriaChevron" style="font-size:10px;transition:transform 0.2s;display:inline-block;">▼</span>
                                ✅ Acceptance Criteria
                            </div>
                            <div id="tdCriteriaBody">
                                <div class="testdesign-criteria-box" id="tdCriteria">–</div>
                            </div>
                        </div>

                        <!-- ── Saved Test Cases section (loaded from specs/) ── -->
                        <div id="tdSavedTCSection" style="margin-bottom:20px;display:none;">
                            <div onclick="tdToggleSection('tdSavedTCBody','tdSavedTCChevron')" style="cursor:pointer;display:flex;align-items:center;gap:6px;user-select:none;padding:8px 0;border-bottom:1px solid #1a2f4a;margin-bottom:10px;" onmouseenter="this.style.color='#94a3b8'" onmouseleave="this.style.color=''">
                                <span id="tdSavedTCChevron" style="font-size:10px;transition:transform 0.2s;display:inline-block;">▼</span>
                                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#10b981;">📋 Automated Tests</span>
                                <span id="tdSavedTCCount" style="font-size:10px;background:rgba(16,185,129,0.15);color:#10b981;border:1px solid rgba(16,185,129,0.3);padding:2px 7px;border-radius:10px;font-weight:600;margin-left:4px;"></span>
                                <div style="margin-left:auto;display:flex;align-items:center;gap:8px;" onclick="event.stopPropagation()">
                                    <span style="font-size:10px;color:#475569;font-style:italic;">from specs/</span>
                                    <button id="tdUploadBtn" onclick="tdUploadTestCases()" style="display:none;align-items:center;gap:5px;background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:4px 12px;border-radius:5px;font-size:10px;font-weight:700;cursor:pointer;white-space:nowrap;transition:opacity 0.2s;" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                                        ☁️ <span id="tdUploadBtnLabel">Upload to Jira</span>
                                    </button>
                                </div>
                            </div>
                            <div id="tdSavedTCBody">
                                <div id="tdUploadStatus" style="display:none;font-size:11px;padding:6px 10px;border-radius:5px;margin-bottom:8px;"></div>
                                <div id="tdSavedTCList" style="display:flex;flex-direction:column;gap:6px;"></div>
                            </div>
                        </div>

                        <!-- ── Code Editor Block ── -->
                        <div id="tdCodeEditorSection" style="margin-bottom:20px;">
                            <div onclick="tdToggleSection('tdCodeEditorBody','tdCodeEditorChevron')" style="cursor:pointer;display:flex;align-items:center;gap:6px;user-select:none;padding:8px 0;border-bottom:1px solid #1a2f4a;margin-bottom:10px;" onmouseenter="this.style.color='#94a3b8'" onmouseleave="this.style.color=''">
                                <span id="tdCodeEditorChevron" style="font-size:10px;transition:transform 0.2s;display:inline-block;">▼</span>
                                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#60a5fa;">💻 Code Editor</span>
                                <button id="tdCodeEditorExpandBtn" onclick="event.stopPropagation();tdCodeEditorToggleExpand()" style="margin-left:auto;background:rgba(124,58,237,0.12);border:1px solid rgba(124,58,237,0.3);color:#c4b5fd;padding:3px 10px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;">⛶ Enlarge</button>
                                <button onclick="event.stopPropagation();tdLoadCodeTree()" style="background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);color:#60a5fa;padding:3px 10px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;">↻ Refresh</button>
                            </div>
                            <div id="tdCodeEditorBody">
                                <div style="display:flex;border:1px solid #1a2f4a;border-radius:8px;overflow:hidden;height:420px;background:#050e1a;">
                                    <div id="tdCodeTree" style="width:220px;background:#0a1628;border-right:1px solid #1a2f4a;overflow-y:auto;padding:8px;font-size:11px;flex-shrink:0;">
                                        <div style="text-align:center;color:#475569;padding:20px;font-size:11px;">Loading files...</div>
                                    </div>
                                    <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
                                        <div id="tdCodeEditorHeader" style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:6px 14px;display:flex;align-items:center;gap:8px;flex-shrink:0;">
                                            <span id="tdCodeEditorFileName" style="font-family:monospace;font-size:11px;color:#60a5fa;flex:1;">Select a file</span>
                                            <button id="tdCodeEditBtn" onclick="tdCodeToggleEdit()" style="display:none;background:none;border:1px solid #2a3f5a;color:#64748b;padding:3px 10px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;">✏️ Edit</button>
                                            <button id="tdCodeSaveBtn" onclick="tdCodeSave()" style="display:none;background:linear-gradient(135deg,#10b981,#059669);border:none;color:white;padding:3px 10px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;">💾 Save</button>
                                            <button id="tdCodeCancelBtn" onclick="tdCodeCancel()" style="display:none;background:none;border:1px solid #f87171;color:#f87171;padding:3px 10px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;">✕ Cancel</button>
                                            <button id="tdCodeDryRunBtn" onclick="tdCodeDryRun()" style="display:none;background:linear-gradient(135deg,#7c3aed,#6d28d9);border:none;color:white;padding:3px 10px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;">▶ Dry Run</button>
                                        </div>
                                        <textarea id="tdCodeEditorArea" readonly style="flex:1;background:#050e1a;color:#e0e0e0;border:none;padding:14px;font-family:monospace;font-size:12px;line-height:1.6;resize:none;outline:none;white-space:pre;overflow:auto;tab-size:2;" placeholder="← Select a file from the tree to view its content"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── Generation Log (always visible, collapsible) ── -->
                        <div id="tdResult">
                            <div onclick="tdToggleSection('tdResultBody','tdResultChevron')" style="background:#0a1628;border:1px solid #1a2f4a;border-radius:6px 6px 0 0;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none;">
                                <div style="display:flex;align-items:center;gap:6px;">
                                    <span id="tdResultChevron" style="font-size:10px;color:#475569;transition:transform 0.2s;display:inline-block;">▼</span>
                                    <div class="testdesign-section-title" style="margin:0;font-size:11px;letter-spacing:1px;">GENERATION LOG</div>
                                </div>
                                <span id="tdResultStatus" style="font-size:11px;color:#64748b;display:flex;align-items:center;gap:6px;"></span>
                            </div>
                            <div id="tdResultBody">
                                <div class="testdesign-gen-log" id="tdGenLog" style="border-radius:0;border-top:none;min-height:60px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Requirements Tab ── -->
            <div class="tab-content" id="requirements" style="flex-direction:column;overflow:hidden;">

                <!-- Toolbar -->
                <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:10px 20px;display:flex;flex-direction:column;gap:6px;flex-shrink:0;">

                    <!-- Row 1: Title | TEST MANAGEMENT label + dropdown | App URL | Username | Password | Connect -->
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:nowrap;">
                        <span style="font-size:14px;font-weight:700;color:white;white-space:nowrap;margin-right:4px;">Requirements</span>

                        <!-- Test Management label + dropdown -->
                        <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;margin-left:24px;">Test Management</label>
                        <select id="reqToolSelect" class="jira-view-select" style="font-size:11px;padding:5px 10px;min-width:140px;" onchange="reqOnToolChange(this.value)">
                            <option value="">— Select —</option>
                            <option value="ADO">☁️ Azure DevOps</option>
                            <option value="Jira">🟦 Jira</option>
                            <option value="LocalHost">🖥️ Local Host</option>
                        </select>

                        <!-- Connection fields (shown when Jira or ADO selected) -->
                        <div id="reqConnectFields" style="display:none;align-items:center;gap:8px;flex:1;min-width:0;margin-left:16px;">
                            <input id="reqConnAppUrl" type="text" placeholder="App URL" style="font-size:11px;padding:5px 10px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;flex:1.2;min-width:0;outline:none;" />
                            <input id="reqConnUsername" type="text" placeholder="Username / Email" style="font-size:11px;padding:5px 10px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;flex:1;min-width:0;outline:none;" />
                            <input id="reqConnPassword" type="password" placeholder="Password / API Key" style="font-size:11px;padding:5px 10px;background:#1a2f4a;border:1px solid #2a3f5a;border-radius:5px;color:#e0e0e0;flex:1;min-width:0;outline:none;" />
                            <button id="reqConnectBtn" onclick="reqConnect()" style="background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:5px 16px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;flex-shrink:0;">Connect</button>
                            <span id="reqConnStatus" style="font-size:10px;color:#64748b;white-space:nowrap;"></span>
                        </div>

                        <!-- Upload — only visible when LocalHost is selected -->
                        <div id="reqUploadWrap" style="display:none;align-items:center;gap:8px;margin-left:auto;">
                            <label for="reqFileInput" style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,#3b82f6,#2563eb);color:white;padding:5px 14px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;transition:opacity 0.2s;" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">📎 Upload</label>
                            <input type="file" id="reqFileInput" accept=".docx,.pdf,.xlsx,.csv,.txt" style="display:none;" onchange="reqHandleUpload(this)">
                            <span style="font-size:10px;color:#475569;">.docx · .pdf · .xlsx · .csv · .txt</span>
                        </div>
                    </div>

                    <!-- Row 2: Jira filters — ASSIGNEE | STATUS | WORK TYPE | Clear | Refresh | Launch Jira -->
                    <div id="reqJiraViewWrap" style="display:none;align-items:center;gap:10px;padding-left:2px;justify-content:flex-end;">
                        <!-- Assignee filter -->
                        <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;">Assignee</label>
                        <select id="reqJiraAssignee" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:110px;" onchange="reqApplyJiraFilters()">
                            <option value="">All</option>
                        </select>
                        <!-- Status filter -->
                        <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;">Status</label>
                        <select id="reqJiraStatus" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:100px;" onchange="reqApplyJiraFilters()">
                            <option value="">All</option>
                            <option value="To Do">To Do</option>
                            <option value="In Progress">In Progress</option>
                            <option value="In Review">In Review</option>
                            <option value="Done">Done</option>
                            <option value="Backlog">Backlog</option>
                            <option value="Sprint">Sprint</option>
                        </select>
                        <!-- Work Type filter -->
                        <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;">Work Type</label>
                        <select id="reqJiraType" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:100px;" onchange="reqApplyJiraFilters()">
                            <option value="">All</option>
                            <option value="Story">Story</option>
                            <option value="Task">Task</option>
                            <option value="Bug">Bug</option>
                            <option value="Epic">Epic</option>
                            <option value="Sub-task">Sub-task</option>
                        </select>
                        <button onclick="reqClearJiraFilters()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:4px 10px;border-radius:4px;font-size:10px;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.borderColor='#f87171';this.style.color='#f87171'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">✕ Clear</button>
                        <button onclick="reqApplyJiraFilters()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:4px 10px;border-radius:4px;font-size:10px;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.borderColor='#3b82f6';this.style.color='#60a5fa'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">↻ Refresh</button>
                        <!-- Launch Jira button — inline on row 2 -->
                        <button id="reqJiraBoardBtn" onclick="reqOpenJiraBoard()" style="display:none;align-items:center;gap:5px;background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.4);color:#60a5fa;padding:5px 13px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.background='rgba(59,130,246,0.25)'" onmouseout="this.style.background='rgba(59,130,246,0.15)'">
                            🟦 Launch Jira ↗
                        </button>
                    </div>

                    <!-- Row 2 (ADO): ADO filters — TYPE | ASSIGNEE | STATUS | Clear | Reload | Launch ADO -->
                    <div id="reqAdoFilterWrap" style="display:none;align-items:center;gap:10px;padding-left:2px;justify-content:flex-end;">
                        <!-- Type filter -->
                        <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;">Type</label>
                        <select id="reqAdoTypeFilter" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:120px;" onchange="reqApplyAdoFilters()">
                            <option value="">All</option>
                            <option value="Epic">Epic</option>
                            <option value="Feature">Feature</option>
                            <option value="Product Backlog Item">Product Backlog Item</option>
                            <option value="User Story">User Story</option>
                            <option value="Task">Task</option>
                            <option value="Bug">Bug</option>
                            <option value="Test Case">Test Case</option>
                            <option value="Test Plan">Test Plan</option>
                            <option value="Test Suite">Test Suite</option>
                            <option value="Issue">Issue</option>
                        </select>
                        <!-- Assignee filter -->
                        <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;">Assignee</label>
                        <select id="reqAdoAssignedTo" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:120px;" onchange="reqApplyAdoFilters()">
                            <option value="">All</option>
                            <option value="__unassigned__">Unassigned</option>
                        </select>
                        <!-- Status filter -->
                        <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;">Status</label>
                        <select id="reqAdoStateFilter" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:100px;" onchange="reqApplyAdoFilters()">
                            <option value="">All</option>
                            <option value="New">New</option>
                            <option value="Active">Active</option>
                            <option value="Design">Design</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                            <option value="To Do">To Do</option>
                            <option value="Removed">Removed</option>
                        </select>
                        <button onclick="reqClearAdoFilters()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:4px 10px;border-radius:4px;font-size:10px;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.borderColor='#f87171';this.style.color='#f87171'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">✕ Clear</button>
                        <button onclick="reqLoadWorkItems('ADO','all')" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:4px 10px;border-radius:4px;font-size:10px;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.borderColor='#3b82f6';this.style.color='#60a5fa'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">↻ Reload</button>
                        <!-- Launch ADO button — inline on row 2 -->
                        <button id="reqAdoBoardBtn" onclick="reqOpenAdoBoard()" style="display:none;align-items:center;gap:5px;background:rgba(96,165,250,0.12);border:1px solid rgba(96,165,250,0.35);color:#60a5fa;padding:5px 13px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.background='rgba(96,165,250,0.22)'" onmouseout="this.style.background='rgba(96,165,250,0.12)'">
                            ☁️ Launch Azure DevOps ↗
                        </button>
                    </div>

                    <!-- reqBoardOpenWrap kept for JS compatibility (hidden, buttons moved inline above) -->
                    <div id="reqBoardOpenWrap" style="display:none;"></div>
                </div>

                <!-- Body: left panel + main content -->
                <div style="flex:1;display:flex;overflow:hidden;">

                    <!-- Left panel: folder tree + work items -->
                    <div style="width:260px;background:#0f1f35;border-right:1px solid #1a2f4a;display:flex;flex-direction:column;flex-shrink:0;overflow:hidden;">
                        <!-- Folders + Documents header with New Folder button -->
                        <div id="reqDocumentsHeader" style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px 8px 14px;border-bottom:1px solid #1a2f4a;flex-shrink:0;">
                            <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;">Documents</span>
                            <button onclick="reqNewFolder()" title="New Folder" style="display:flex;align-items:center;gap:4px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#10b981;padding:3px 9px;border-radius:4px;font-size:10px;font-weight:700;cursor:pointer;white-space:nowrap;transition:all 0.15s;" onmouseover="this.style.background='rgba(16,185,129,0.2)'" onmouseout="this.style.background='rgba(16,185,129,0.1)'">📁 New Folder</button>
                        </div>
                        <div id="reqDocList" style="flex:1;overflow-y:auto;padding:6px;min-height:80px;">
                            <div style="font-size:11px;color:#334155;padding:10px;text-align:center;">No documents yet.</div>
                        </div>
                        <!-- Work Items section (shown when tool selected) -->
                        <div id="reqWorkItemsSection" style="display:none;flex-direction:column;flex:1;overflow:hidden;border-top:2px solid #1a2f4a;">
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px 8px 14px;border-bottom:1px solid #1a2f4a;flex-shrink:0;">
                                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;" id="reqWorkItemsLabel">Work Items</span>
                                <span id="reqWorkItemCount" style="font-size:10px;background:#1a2f4a;color:#64748b;padding:1px 7px;border-radius:8px;font-weight:600;"></span>
                            </div>
                            <!-- Workspace / Project selector -->
                            <div id="reqWorkspaceWrap" style="display:none;flex-direction:column;gap:4px;padding:8px 10px;border-bottom:1px solid #1a2f4a;flex-shrink:0;">
                                <label style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#475569;">Workspace</label>
                                <select id="reqWorkspaceSelect" class="jira-view-select"
                                        style="font-size:11px;padding:5px 8px;width:100%;background:#0a1628;border:1px solid #2a3f5a;border-radius:5px;color:#cbd5e1;"
                                        onchange="reqOnWorkspaceChange(this.value)">
                                    <option value="">— Select Workspace —</option>
                                </select>
                            </div>
                            <div id="reqWorkItemList" style="flex:1;overflow-y:auto;padding:6px;">
                                <div style="font-size:11px;color:#334155;padding:10px;text-align:center;">Select a source above.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Main content area -->
                    <div id="reqMainContent" style="flex:1;overflow-y:auto;padding:28px 32px;">
                        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#475569;text-align:center;gap:12px;">
                            <div style="font-size:36px;">📄</div>
                            <div style="font-size:14px;color:#94a3b8;">Select a tool, upload a document, or create a folder to get started</div>
                            <div style="font-size:11px;color:#475569;">Supported: .docx · .pdf · .xlsx · .csv · .txt</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Requirements Board Modal (Jira only — ADO opens in new window) -->
            <div id="reqBoardModal" onclick="if(event.target===this)closeReqBoardModal()" style="display:none;position:fixed;inset:0;z-index:8500;background:rgba(5,14,26,0.9);backdrop-filter:blur(5px);align-items:flex-start;justify-content:center;padding:24px 20px;overflow-y:auto;">
                <div style="background:#0a1628;border:1px solid #1e3a5a;border-radius:12px;width:100%;max-width:1280px;max-height:calc(100vh - 48px);display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,0.6);overflow:hidden;">
                    <!-- Modal header -->
                    <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:14px 22px;display:flex;align-items:center;gap:12px;flex-shrink:0;flex-wrap:wrap;">
                        <span id="reqBoardModalTitle" style="font-size:14px;font-weight:700;color:white;">🟦 Jira Board</span>
                        <span id="reqBoardModalBadge" style="font-size:11px;color:#60a5fa;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);padding:3px 10px;border-radius:10px;"></span>
                        <!-- Project selector -->
                        <select id="reqBoardModalProjectSelect" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:150px;" onchange="reqBoardModalProjectChange(this.value)">
                            <option value="">Loading…</option>
                        </select>
                        <!-- View selector -->
                        <select id="reqBoardModalViewSelect" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:130px;" onchange="reqBoardModalViewChange(this.value)">
                            <option value="all">All Issues</option>
                            <option value="mine">My Issues</option>
                            <option value="inprogress">In Progress</option>
                            <option value="done">Done</option>
                            <option value="backlog">Backlog</option>
                            <option value="sprint">Active Sprint</option>
                        </select>
                        <button onclick="reqRefreshBoard()" class="jira-refresh-btn" style="padding:5px 10px;" title="Refresh">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        </button>
                        <span id="reqBoardUpdatedAt" style="font-size:11px;color:#475569;"></span>
                        <button onclick="closeReqBoardModal()" style="margin-left:auto;background:none;border:1px solid #2a3f5a;color:#64748b;width:30px;height:30px;border-radius:6px;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.2s;" onmouseover="this.style.borderColor='#3b82f6';this.style.color='white'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">✕</button>
                    </div>
                    <div id="reqBoardModalBody" style="flex:1;overflow-y:auto;padding:20px 24px;">
                        <div class="jira-state"><div class="icon">⏳</div><div class="msg">Loading board…</div></div>
                    </div>
                </div>
            </div>

            <!-- ADO Work Items Popup Modal (shown instead of new window) -->
            <div id="reqAdoModal" onclick="if(event.target===this)closeReqAdoModal()" style="display:none;position:fixed;inset:0;z-index:8500;background:rgba(5,14,26,0.92);backdrop-filter:blur(6px);align-items:flex-start;justify-content:center;padding:20px;overflow-y:auto;">
                <div style="background:#0a1628;border:1px solid #1e3a5a;border-radius:12px;width:100%;max-width:1300px;max-height:calc(100vh - 40px);display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,0.7);overflow:hidden;">
                    <!-- ADO Modal header -->
                    <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:13px 20px;display:flex;align-items:center;gap:10px;flex-shrink:0;flex-wrap:wrap;">
                        <span style="font-size:14px;font-weight:700;color:white;">☁️ Azure DevOps</span>
                        <span id="reqAdoModalBadge" style="font-size:11px;color:#60a5fa;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);padding:3px 10px;border-radius:10px;"></span>
                        <!-- Type -->
                        <div style="display:flex;align-items:center;gap:5px;">
                            <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.3px;">Type</label>
                            <select id="reqAdoModalType" class="jira-view-select" style="font-size:11px;padding:3px 8px;min-width:130px;" onchange="reqAdoModalFilter()">
                                <option value="">All</option>
                                <option value="Epic">Epic</option>
                                <option value="Feature">Feature</option>
                                <option value="Product Backlog Item">Product Backlog Item</option>
                                <option value="User Story">User Story</option>
                                <option value="Task">Task</option>
                                <option value="Bug">Bug</option>
                                <option value="Test Case">Test Case</option>
                                <option value="Test Plan">Test Plan</option>
                                <option value="Test Suite">Test Suite</option>
                                <option value="Issue">Issue</option>
                            </select>
                        </div>
                        <!-- Assignee -->
                        <div style="display:flex;align-items:center;gap:5px;">
                            <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.3px;">Assignee</label>
                            <select id="reqAdoModalAssignee" class="jira-view-select" style="font-size:11px;padding:3px 8px;min-width:140px;" onchange="reqAdoModalFilter()">
                                <option value="">All</option>
                                <option value="__unassigned__">Unassigned</option>
                            </select>
                        </div>
                        <!-- Status -->
                        <div style="display:flex;align-items:center;gap:5px;">
                            <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.3px;">Status</label>
                            <select id="reqAdoModalStatus" class="jira-view-select" style="font-size:11px;padding:3px 8px;min-width:110px;" onchange="reqAdoModalFilter()">
                                <option value="">All</option>
                                <option value="New">New</option>
                                <option value="Active">Active</option>
                                <option value="Design">Design</option>
                                <option value="To Do">To Do</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Closed">Closed</option>
                                <option value="Removed">Removed</option>
                            </select>
                        </div>
                        <button onclick="reqAdoClearModalFilters()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:3px 9px;border-radius:4px;font-size:10px;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.borderColor='#f87171';this.style.color='#f87171'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">✕ Clear</button>
                        <button onclick="reqLoadAdoModal()" class="jira-refresh-btn" style="padding:4px 10px;" title="Refresh">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        </button>
                        <span id="reqAdoModalUpdatedAt" style="font-size:10px;color:#475569;"></span>
                        <a id="reqAdoExternalLink" href="#" target="_blank" style="margin-left:4px;font-size:11px;color:#60a5fa;text-decoration:none;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.25);padding:3px 10px;border-radius:4px;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.background='rgba(59,130,246,0.2)'" onmouseout="this.style.background='rgba(59,130,246,0.1)'">Open in Azure DevOps ↗</a>
                        <button onclick="closeReqAdoModal()" style="margin-left:auto;background:none;border:1px solid #2a3f5a;color:#64748b;width:28px;height:28px;border-radius:6px;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.2s;" onmouseover="this.style.borderColor='#3b82f6';this.style.color='white'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">✕</button>
                    </div>
                    <div id="reqAdoModalBody" style="flex:1;overflow-y:auto;padding:20px 24px;">
                        <div class="jira-state"><div class="icon">⏳</div><div class="msg">Loading Azure DevOps work items…</div></div>
                    </div>
                </div>
            </div>

            <!-- Jira Work Items Popup Modal -->
            <div id="reqJiraModal" onclick="if(event.target===this)closeReqJiraModal()" style="display:none;position:fixed;inset:0;z-index:8500;background:rgba(5,14,26,0.92);backdrop-filter:blur(6px);align-items:flex-start;justify-content:center;padding:20px;overflow-y:auto;">
                <div style="background:#0a1628;border:1px solid #1e3a5a;border-radius:12px;width:100%;max-width:1300px;max-height:calc(100vh - 40px);display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,0.7);overflow:hidden;">
                    <!-- Jira Modal header -->
                    <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:13px 20px;display:flex;align-items:center;gap:10px;flex-shrink:0;flex-wrap:wrap;">
                        <span style="font-size:14px;font-weight:700;color:white;">🟦 Jira</span>
                        <span id="reqJiraModalBadge" style="font-size:11px;color:#3b82f6;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);padding:3px 10px;border-radius:10px;"></span>
                        <!-- Work Type -->
                        <div style="display:flex;align-items:center;gap:5px;">
                            <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.3px;">Type</label>
                            <select id="reqJiraModalType" class="jira-view-select" style="font-size:11px;padding:3px 8px;min-width:120px;" onchange="reqJiraModalFilter()">
                                <option value="">All</option>
                                <option value="Story">Story</option>
                                <option value="Task">Task</option>
                                <option value="Bug">Bug</option>
                                <option value="Epic">Epic</option>
                                <option value="Sub-task">Sub-task</option>
                            </select>
                        </div>
                        <!-- Assignee -->
                        <div style="display:flex;align-items:center;gap:5px;">
                            <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.3px;">Assignee</label>
                            <select id="reqJiraModalAssignee" class="jira-view-select" style="font-size:11px;padding:3px 8px;min-width:140px;" onchange="reqJiraModalFilter()">
                                <option value="">All</option>
                            </select>
                        </div>
                        <!-- Status -->
                        <div style="display:flex;align-items:center;gap:5px;">
                            <label style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.3px;">Status</label>
                            <select id="reqJiraModalStatus" class="jira-view-select" style="font-size:11px;padding:3px 8px;min-width:120px;" onchange="reqJiraModalFilter()">
                                <option value="">All</option>
                                <option value="To Do">To Do</option>
                                <option value="In Progress">In Progress</option>
                                <option value="In Review">In Review</option>
                                <option value="Done">Done</option>
                                <option value="Backlog">Backlog</option>
                                <option value="Sprint">Sprint</option>
                            </select>
                        </div>
                        <button onclick="reqJiraClearModalFilters()" style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:3px 9px;border-radius:4px;font-size:10px;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.borderColor='#f87171';this.style.color='#f87171'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">✕ Clear</button>
                        <button onclick="reqLoadJiraModal()" class="jira-refresh-btn" style="padding:4px 10px;" title="Refresh">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        </button>
                        <span id="reqJiraModalUpdatedAt" style="font-size:10px;color:#475569;"></span>
                        <a id="reqJiraExternalLink" href="#" target="_blank" style="margin-left:4px;font-size:11px;color:#3b82f6;text-decoration:none;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.25);padding:3px 10px;border-radius:4px;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.background='rgba(59,130,246,0.2)'" onmouseout="this.style.background='rgba(59,130,246,0.1)'">Open in Jira ↗</a>
                        <button onclick="closeReqJiraModal()" style="margin-left:auto;background:none;border:1px solid #2a3f5a;color:#64748b;width:28px;height:28px;border-radius:6px;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.2s;" onmouseover="this.style.borderColor='#3b82f6';this.style.color='white'" onmouseout="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">✕</button>
                    </div>
                    <div id="reqJiraModalBody" style="flex:1;overflow-y:auto;padding:20px 24px;">
                        <div class="jira-state"><div class="icon">⏳</div><div class="msg">Loading Jira issues…</div></div>
                    </div>
                </div>
            </div>

            <!-- ── Manual Test Cases Tab ── -->
            <div class="tab-content manualtests-content" id="manualtests">
                <!-- Left sidebar: ticket selector -->
                <div class="testdesign-sidebar">
                    <div class="testdesign-sidebar-header">
                        <div class="testdesign-sidebar-title" id="mtSidebarTitle">📋 Work Items</div>
                        <div class="testdesign-sidebar-hint" id="mtSidebarHint">Click a ticket from the board, or select one below to generate tests</div>
                        <!-- Local files section (shown when no TM tool selected) -->
                        <div id="mtLocalFilesSection" style="display:none;margin-top:8px;">
                            <div style="font-size:10px;color:#475569;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.4px;">Local Requirement Files</div>
                            <div id="mtLocalFileList" style="max-height:160px;overflow-y:auto;display:flex;flex-direction:column;gap:3px;"></div>
                        </div>
                        <!-- Remote TM section -->
                        <div id="mtRemoteSection" style="margin-top:8px;">
                            <select id="mtToolSelect" class="jira-view-select" style="font-size:11px;padding:4px 8px;width:100%;margin-bottom:6px;" onchange="mtOnToolChange(this.value)">
                                <option value="">— Select Tool —</option>
                                <option value="ADO">☁️ Azure DevOps</option>
                                <option value="Jira">🟦 Jira</option>
                                <option value="LocalHost">🖥️ Local Host</option>
                            </select>
                            <div id="mtProjectViewWrap" style="display:none;">
                                <select id="mtProjectSelect" class="jira-view-select" style="font-size:11px;padding:4px 8px;width:100%;margin-bottom:6px;" onchange="mtChangeProject(this.value)">
                                    <option value="">Loading projects…</option>
                                </select>
                                <div style="display:flex;gap:6px;align-items:center;">
                                    <select id="mtViewSelect" class="jira-view-select" style="font-size:11px;padding:4px 8px;min-width:0;flex:1;" onchange="mtChangeView(this.value)">
                                        <option value="all">All Issues</option>
                                        <option value="sprint">Active Sprint</option>
                                        <option value="backlog">Backlog</option>
                                        <option value="inprogress">In Progress</option>
                                        <option value="done">Done</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="testdesign-ticket-list" id="mtTicketList">
                        <div style="padding:16px;font-size:12px;color:#334155;text-align:center;">Loading…</div>
                    </div>
                </div>

                <!-- Right panel -->
                <div class="testdesign-main" id="mtMain">
                    <!-- Empty state -->
                    <div class="testdesign-empty" id="mtEmpty">
                        <div class="td-icon">📋</div>
                        <div class="td-msg">No ticket selected</div>
                        <div class="td-hint">Select a Jira ticket from the left panel<br>to view its details and generate test cases</div>
                    </div>

                    <!-- Active panel -->
                    <div id="mtPanel" style="display:none;flex:1;overflow-y:auto;flex-direction:column;">

                        <!-- Ticket details header -->
                        <div style="padding:20px 28px 0;border-bottom:1px solid #1a2f4a;padding-bottom:18px;flex-shrink:0;">
                            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;">
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:11px;color:#3b82f6;font-weight:700;margin-bottom:4px;" id="mtIssueKey"></div>
                                    <div style="font-size:18px;font-weight:600;color:white;line-height:1.3;" id="mtIssueSummary"></div>
                                    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;" id="mtIssueMeta"></div>
                                </div>
                                <button id="mtGenerateBtn" onclick="generateManualTestCases()"
                                    style="flex-shrink:0;background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;color:white;padding:10px 20px;border-radius:6px;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;white-space:nowrap;transition:all 0.2s;"
                                    onmouseover="if(!this.disabled)this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
                                    🧪 Generate Test Cases
                                </button>
                            </div>

                            <!-- Ticket description box (collapsible) -->
                            <div id="mtDescriptionWrap" style="margin-top:16px;">
                                <div onclick="mtToggleDescription()" style="cursor:pointer;user-select:none;display:flex;align-items:center;gap:6px;">
                                    <div class="testdesign-section-title" style="margin-bottom:0;flex:1;">📝 Acceptance Criteria / Description</div>
                                    <span id="mtDescToggle" style="color:#475569;font-size:11px;">▾</span>
                                </div>
                                <div id="mtDescriptionBox" style="margin-top:10px;">
                                    <div class="testdesign-criteria-box" id="mtDescription" style="max-height:140px;">–</div>
                                </div>
                            </div>

                            <!-- Source badge + error -->
                            <div id="mtSourceBadge" style="display:none;margin-top:10px;"></div>
                            <div id="mtError" style="display:none;margin-top:10px;font-size:12px;color:#f87171;background:rgba(248,113,113,0.08);border:1px solid rgba(248,113,113,0.2);border-radius:5px;padding:9px 12px;"></div>
                        </div>

                        <!-- Loading spinner -->
                        <div id="mtLoading" style="display:none;flex:1;align-items:center;justify-content:center;flex-direction:column;gap:10px;padding:40px;">
                            <div style="font-size:32px;">⏳</div>
                            <div style="font-size:13px;color:#64748b;">Generating test cases…</div>
                        </div>

                        <!-- Test cases output -->
                        <div id="mtResults" style="display:none;flex:1;overflow-y:auto;padding:20px 28px;flex-direction:column;gap:0;">

                            <!-- ── GENERATED TESTS (collapsible) ── -->
                            <div id="mtGeneratedSection">
                                <!-- Summary bar -->
                                <div onclick="mtToggleSection('mtGeneratedBody','mtGeneratedArrow')" style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;user-select:none;padding:8px 0;border-bottom:1px solid #1a2f4a;">
                                    <span style="font-size:14px;">🧪</span>
                                    <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#60a5fa;">Generated Tests</span>
                                    <span id="mtTotalBadge" style="font-size:10px;background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.25);padding:2px 9px;border-radius:10px;font-weight:600;"></span>
                                    <span id="mtGeneratedArrow" style="margin-left:auto;color:#475569;font-size:12px;">▾</span>
                                </div>
                                <div id="mtGeneratedBody" style="display:flex;flex-direction:column;width:100%;">
                                    <!-- Toolbar -->
                                    <div style="display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:10px;margin-bottom:12px;width:100%;">
                                        <div style="display:flex;align-items:center;gap:10px;">
                                            <label class="mt-select-all-wrap" title="Select / deselect all">
                                                <input type="checkbox" class="mt-select-all-cb" id="mtSelectAllCb" onchange="mtToggleSelectAll(this)" />
                                                <span id="mtSelectAllLabel">Select All</span>
                                            </label>
                                            <span id="mtPosBadge"  style="font-size:11px;color:#10b981;"></span>
                                            <span id="mtNegBadge"  style="font-size:11px;color:#f87171;"></span>
                                            <span id="mtEdgeBadge" style="font-size:11px;color:#a78bfa;"></span>
                                            <button id="mtSaveBtn" class="mt-save-btn" onclick="saveSelectedTestCases()" disabled>💾 Save to Specs</button>
                                            <button onclick="clearManualTestCases()" style="font-size:11px;background:none;border:1px solid #2a3f5a;color:#64748b;padding:4px 10px;border-radius:4px;cursor:pointer;" onmouseover="this.style.color='#e0e0e0'" onmouseout="this.style.color='#64748b'">Clear All</button>
                                        </div>
                                    </div>

                                    <!-- Positive section -->
                                    <div id="mtSectionPos" style="margin-bottom:20px;width:100%;min-width:0;">
                                        <div onclick="mtToggleSection('mtSectionPosBody','mtArrowPos')" style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;user-select:none;">
                                            <span style="font-size:15px;">✅</span>
                                            <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#10b981;">Positive</span>
                                            <span id="mtPosCount" style="font-size:10px;background:rgba(16,185,129,0.15);color:#10b981;padding:2px 7px;border-radius:10px;font-weight:600;"></span>
                                            <span id="mtArrowPos" style="margin-left:auto;color:#475569;font-size:12px;">▾</span>
                                        </div>
                                        <div id="mtSectionPosBody" style="display:flex;flex-direction:column;gap:8px;"></div>
                                    </div>

                                    <!-- Negative section -->
                                    <div id="mtSectionNeg" style="margin-bottom:20px;width:100%;min-width:0;">
                                        <div onclick="mtToggleSection('mtSectionNegBody','mtArrowNeg')" style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;user-select:none;">
                                            <span style="font-size:15px;">❌</span>
                                            <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#f87171;">Negative</span>
                                            <span id="mtNegCount" style="font-size:10px;background:rgba(248,113,113,0.15);color:#f87171;padding:2px 7px;border-radius:10px;font-weight:600;"></span>
                                            <span id="mtArrowNeg" style="margin-left:auto;color:#475569;font-size:12px;">▾</span>
                                        </div>
                                        <div id="mtSectionNegBody" style="display:flex;flex-direction:column;gap:8px;"></div>
                                    </div>

                                    <!-- Edge section -->
                                    <div id="mtSectionEdge" style="margin-bottom:20px;width:100%;min-width:0;">
                                        <div onclick="mtToggleSection('mtSectionEdgeBody','mtArrowEdge')" style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;user-select:none;">
                                            <span style="font-size:15px;">⚡</span>
                                            <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#a78bfa;">Edge / Boundary</span>
                                            <span id="mtEdgeCount" style="font-size:10px;background:rgba(167,139,250,0.15);color:#a78bfa;padding:2px 7px;border-radius:10px;font-weight:600;"></span>
                                            <span id="mtArrowEdge" style="margin-left:auto;color:#475569;font-size:12px;">▾</span>
                                        </div>
                                        <div id="mtSectionEdgeBody" style="display:flex;flex-direction:column;gap:8px;"></div>
                                    </div>
                                </div><!-- /mtGeneratedBody -->
                            </div><!-- /mtGeneratedSection -->

                        </div><!-- /mtResults -->

                    </div><!-- /mtPanel -->
                </div><!-- /mtMain -->
            </div><!-- /manualtests tab -->

            <!-- Toast notification container -->
            <div id="mtToast"></div>

            <!-- ── Defects Tab ── -->
            <div class="tab-content" id="defects" style="flex-direction:column;overflow:hidden;">
                <!-- Defects Toolbar -->
                <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:14px 28px;display:flex;align-items:center;gap:12px;flex-shrink:0;flex-wrap:wrap;">
                    <span style="font-size:14px;font-weight:600;color:white;">🐞 Defects Log</span>
                    <div style="flex:1;"></div>
                    <input type="text" id="defectFilterInput" placeholder="🔍 Search defects..." style="background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 12px;border-radius:4px;font-size:12px;width:200px;">
                    <select id="defectStatusFilter" style="background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 12px;border-radius:4px;font-size:12px;">
                        <option value="">All Status</option>
                        <option value="Open">Open</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Resolved">Resolved</option>
                        <option value="Closed">Closed</option>
                    </select>
                    <button onclick="openCreateDefectModal()" style="background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.4);color:#60a5fa;padding:8px 12px;border-radius:4px;font-size:12px;font-weight:600;cursor:pointer;">➕ Create Defect</button>
                    <button onclick="exportDefectsToXlsx()" style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);color:#4ade80;padding:8px 12px;border-radius:4px;font-size:12px;font-weight:600;cursor:pointer;">📥 Export XLSX</button>
                    <button onclick="refreshDefects()" style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.3);color:#a5b4fc;padding:8px 12px;border-radius:4px;font-size:12px;font-weight:600;cursor:pointer;">🔄 Refresh</button>
                </div>

                <!-- Create / Edit Defect Modal -->
                <div id="defectModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;" onclick="if(event.target===this)closeDefectModal()">
                    <div style="background:#0f1f35;border:1px solid #2a3f5a;border-radius:8px;padding:28px;width:540px;max-width:95vw;max-height:90vh;overflow-y:auto;">
                        <h3 id="defectModalTitle" style="margin:0 0 20px;color:#60a5fa;font-size:15px;">➕ Create Defect</h3>
                        <input type="hidden" id="defectModalId">
                        <div style="display:grid;gap:12px;">
                            <div>
                                <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Test Case Id *</label>
                                <input id="dm_testCaseName" type="text" placeholder="e.g. TC-001" style="width:100%;box-sizing:border-box;background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:4px;font-size:12px;">
                            </div>
                            <div>
                                <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Defect Description *</label>
                                <textarea id="dm_description" rows="2" placeholder="Describe the defect..." style="width:100%;box-sizing:border-box;background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:4px;font-size:12px;resize:vertical;"></textarea>
                            </div>
                            <div>
                                <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Expected Result</label>
                                <textarea id="dm_expectedResult" rows="2" placeholder="What was expected..." style="width:100%;box-sizing:border-box;background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:4px;font-size:12px;resize:vertical;"></textarea>
                            </div>
                            <div>
                                <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Actual Result</label>
                                <textarea id="dm_actualResult" rows="2" placeholder="What actually happened..." style="width:100%;box-sizing:border-box;background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:4px;font-size:12px;resize:vertical;"></textarea>
                            </div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                                <div>
                                    <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Severity</label>
                                    <select id="dm_severity" style="width:100%;background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:4px;font-size:12px;">
                                        <option value="High">High</option>
                                        <option value="Medium" selected>Medium</option>
                                        <option value="Low">Low</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Status</label>
                                    <select id="dm_status" style="width:100%;background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:4px;font-size:12px;">
                                        <option value="Open" selected>Open</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Resolved">Resolved</option>
                                        <option value="Closed">Closed</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Comments</label>
                                <input id="dm_comments" type="text" placeholder="Optional comments..." style="width:100%;box-sizing:border-box;background:#1a2f4a;border:1px solid #2a3f5a;color:#e0e0e0;padding:8px 10px;border-radius:4px;font-size:12px;">
                            </div>
                        </div>
                        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;">
                            <button onclick="closeDefectModal()" style="background:rgba(100,116,139,0.2);border:1px solid #334155;color:#94a3b8;padding:8px 18px;border-radius:4px;font-size:12px;font-weight:600;cursor:pointer;">Cancel</button>
                            <button onclick="saveDefectModal()" style="background:rgba(59,130,246,0.2);border:1px solid rgba(59,130,246,0.4);color:#60a5fa;padding:8px 18px;border-radius:4px;font-size:12px;font-weight:600;cursor:pointer;">Update</button>
                        </div>
                    </div>
                </div>

                <!-- Defects Table Container -->
                <div style="flex:1;overflow:auto;display:flex;flex-direction:column;">
                    <table id="defectsTable" style="width:100%;border-collapse:collapse;font-size:12px;">
                        <thead style="background:#1a2f4a;position:sticky;top:0;z-index:10;">
                            <tr style="border-bottom:2px solid #2a3f5a;">
                                <th style="padding:12px 8px;text-align:left;color:#60a5fa;font-weight:600;min-width:140px;">📅 Date</th>
                                <th style="padding:12px 8px;text-align:left;color:#60a5fa;font-weight:600;min-width:150px;">🧪 Test Case Id</th>
                                <th style="padding:12px 8px;text-align:left;color:#60a5fa;font-weight:600;min-width:180px;">🐛 Defect Description</th>
                                <th style="padding:12px 8px;text-align:left;color:#60a5fa;font-weight:600;min-width:180px;">✅ Expected Result</th>
                                <th style="padding:12px 8px;text-align:left;color:#60a5fa;font-weight:600;min-width:180px;">❌ Actual Result</th>
                                <th style="padding:12px 8px;text-align:left;color:#60a5fa;font-weight:600;min-width:100px;">⚠️ Severity</th>
                                <th style="padding:12px 8px;text-align:left;color:#60a5fa;font-weight:600;min-width:100px;">📊 Status</th>
                                <th style="padding:12px 8px;text-align:left;color:#60a5fa;font-weight:600;min-width:120px;">💬 Comments</th>
                                <th style="padding:12px 8px;text-align:center;color:#60a5fa;font-weight:600;min-width:80px;">⚙️ Actions</th>
                            </tr>
                        </thead>
                        <tbody id="defectsTableBody" style="background:#0a1628;">
                            <!-- Defects will be rendered here -->
                        </tbody>
                    </table>
                    <div id="defectsEmptyState" style="flex:1;display:flex;align-items:center;justify-content:center;color:#475569;font-size:14px;">
                        <div style="text-align:center;">
                            <div style="font-size:32px;margin-bottom:8px;">🐞</div>
                            <p>No defects logged yet</p>
                            <p style="font-size:11px;color:#64748b;">Run tests in the Execution tab to log defects</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Value Added Services Tab ── -->
            <div class="tab-content" id="vas" style="flex-direction:column;overflow:hidden;">

                <!-- Toolbar -->
                <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:14px 28px;display:flex;align-items:center;gap:16px;flex-shrink:0;flex-wrap:wrap;">
                    <span style="font-size:14px;font-weight:600;color:white;">⭐ Value Added Services</span>
                    <span style="font-size:11px;color:#64748b;margin-left:8px;">Click any service card to explore features</span>
                </div>

                <!-- Service Cards Grid -->
                <div style="flex:1;overflow-y:auto;padding:28px;">
                    <div id="vasCardsGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;"></div>

                    <!-- Expanded detail panel (shown on card click) -->
                    <div id="vasDetailPanel" style="display:none;margin-top:24px;background:#0f1f35;border:1px solid #1a2f4a;border-radius:12px;overflow:hidden;">
                        <div style="padding:20px 24px;border-bottom:1px solid #1a2f4a;display:flex;align-items:center;gap:14px;">
                            <div id="vasDetailIcon" style="font-size:32px;"></div>
                            <div style="flex:1;">
                                <div id="vasDetailName" style="font-size:16px;font-weight:700;color:white;margin-bottom:4px;"></div>
                                <div id="vasDetailDesc" style="font-size:12px;color:#94a3b8;line-height:1.6;"></div>
                            </div>
                            <span style="font-size:10px;background:rgba(245,158,11,0.15);color:#f59e0b;border:1px solid rgba(245,158,11,0.3);padding:3px 10px;border-radius:10px;font-weight:600;white-space:nowrap;">COMING SOON</span>
                            <button onclick="vasCloseDetail()" style="background:transparent;border:none;color:#64748b;font-size:18px;cursor:pointer;padding:4px 8px;margin-left:8px;line-height:1;" title="Close">✕</button>
                        </div>
                        <div style="padding:24px;">
                            <div style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:0.6px;margin-bottom:14px;">Key Features</div>
                            <div id="vasDetailFeatures" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Framework Migrator Full-Screen Modal ── -->
            <div id="migratorModal" onclick="if(event.target===this)closeMigratorModal()"
                 style="display:none;position:fixed;inset:0;z-index:9500;background:rgba(5,14,26,0.92);
                        backdrop-filter:blur(6px);flex-direction:column;align-items:center;justify-content:center;">
                <!-- Modal card -->
                <div style="background:#0a1628;border:1px solid #1e3a5a;border-radius:12px;
                            width:calc(100vw - 48px);max-width:1400px;height:calc(100vh - 48px);
                            display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,0.7);
                            overflow:hidden;animation:migratorIn 0.22s ease;">

                    <!-- Header bar -->
                    <div style="background:#0f1f35;border-bottom:1px solid #1a2f4a;padding:14px 24px;
                                display:flex;align-items:center;gap:14px;flex-shrink:0;">
                        <span style="font-size:22px;line-height:1;">🔄</span>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:white;">Framework Migrator</div>
                            <div style="font-size:11px;color:#64748b;">Convert Selenium / Cypress / TestNG scripts to Playwright automatically</div>
                        </div>
                        <!-- Status indicator -->
                        <div id="migratorStatusBadge"
                             style="margin-left:16px;font-size:10px;font-weight:600;padding:3px 10px;border-radius:10px;
                                    background:rgba(100,116,139,0.15);color:#64748b;border:1px solid rgba(100,116,139,0.3);">
                            ⏳ Connecting…
                        </div>
                        <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
                            <!-- Refresh iframe -->
                            <button onclick="reloadMigratorFrame()"
                                    title="Reload migrator"
                                    style="background:none;border:1px solid #2a3f5a;color:#64748b;padding:6px 12px;
                                           border-radius:5px;font-size:11px;cursor:pointer;transition:all 0.2s;
                                           display:flex;align-items:center;gap:5px;"
                                    onmouseenter="this.style.borderColor='#3b82f6';this.style.color='#3b82f6'"
                                    onmouseleave="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">
                                🔁 Reload
                            </button>
                            <!-- Open in new tab -->
                            <a id="migratorOpenLink" href="http://localhost:5174/app/" target="_blank" rel="noopener"
                               style="background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.3);
                                      color:#60a5fa;padding:6px 12px;border-radius:5px;font-size:11px;
                                      text-decoration:none;font-weight:600;transition:all 0.2s;"
                               onmouseenter="this.style.background='rgba(59,130,246,0.22)'"
                               onmouseleave="this.style.background='rgba(59,130,246,0.12)'">
                                ↗ Open in Tab
                            </a>
                            <!-- Close -->
                            <button onclick="closeMigratorModal()"
                                    style="background:none;border:1px solid #2a3f5a;color:#64748b;
                                           width:32px;height:32px;border-radius:6px;font-size:16px;cursor:pointer;
                                           display:flex;align-items:center;justify-content:center;transition:all 0.2s;"
                                    onmouseenter="this.style.borderColor='#f87171';this.style.color='#f87171'"
                                    onmouseleave="this.style.borderColor='#2a3f5a';this.style.color='#64748b'"
                                    title="Close">✕</button>
                        </div>
                    </div>

                    <!-- iframe area -->
                    <div style="flex:1;position:relative;overflow:hidden;">
                        <!-- Loading / error overlay -->
                        <div id="migratorOverlay"
                             style="position:absolute;inset:0;z-index:2;background:#050e1a;
                                    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
                            <div style="font-size:40px;">🔄</div>
                            <div id="migratorOverlayMsg" style="font-size:14px;color:#94a3b8;text-align:center;max-width:480px;line-height:1.7;">
                                Connecting to Framework Migrator…
                            </div>
                            <div id="migratorOverlayDetail" style="font-size:12px;color:#475569;text-align:center;max-width:520px;line-height:1.8;"></div>
                            <button id="migratorRetryBtn" onclick="migratorCheckAndLoad()"
                                    style="display:none;background:linear-gradient(135deg,#3b82f6,#2563eb);border:none;
                                           color:white;padding:9px 24px;border-radius:6px;font-size:13px;font-weight:600;
                                           cursor:pointer;margin-top:8px;">
                                🔁 Retry
                            </button>
                        </div>
                        <!-- The actual iframe -->
                        <iframe id="migratorFrame"
                                src="about:blank"
                                style="width:100%;height:100%;border:none;display:block;position:relative;z-index:1;"
