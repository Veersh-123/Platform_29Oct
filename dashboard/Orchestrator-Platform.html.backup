        delete document._observabilityEscHandler;
    }
}

// ── User Settings Functions ──────────────────────────────────────────────────

function openUserSettingsModal() {
    const modal = document.getElementById('userSettingsModal');
    if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        userLoadMcpCheckboxes();
        // Load saved settings
        const saved = JSON.parse(localStorage.getItem('userSettings') || '{}');
        if (saved.firstName) document.getElementById('userFirstName').value = saved.firstName;
        if (saved.lastName) document.getElementById('userLastName').value = saved.lastName;
        if (saved.role) document.getElementById('userRole').value = saved.role;
        if (saved.email) document.getElementById('userEmail').value = saved.email;
        if (saved.envUrl) document.getElementById('userEnvUrl').value = saved.envUrl;
        if (saved.browser) document.getElementById('userBrowser').value = saved.browser;
        if (saved.llmProvider) document.getElementById('userLlmProvider').value = saved.llmProvider;
        // Load current env config from server
        envLoadCurrentConfig();
    }
}

function closeUserSettingsModal() {
    const modal = document.getElementById('userSettingsModal');
    if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }
}

// ── Env Config Functions (.env read/write) ────────────────────────────────────

/** Load current .env values from server and populate form fields */
async function envLoadCurrentConfig() {
    try {
        const res  = await fetch(`${SERVER}/api/env/read`);
        if (!res.ok) return;
        const data = await res.json();

        const toolSel = document.getElementById('envToolType');
        if (toolSel) {
            toolSel.value = data.TestManagementTool || 'Jira';
            envOnToolChange(toolSel.value);
        }
        if (data.JIRA_BASE_URL) document.getElementById('envJiraUrl').value   = data.JIRA_BASE_URL;
        if (data.JIRA_EMAIL)    document.getElementById('envJiraEmail').value  = data.JIRA_EMAIL;
        if (data.JIRA_API_TOKEN && data.JIRA_API_TOKEN !== '') {
            document.getElementById('envJiraToken').placeholder = data.JIRA_API_TOKEN === '***set***'
                ? '(already set — paste to change)'
                : '';
        }
        if (data.ADO_ORG_URL)   document.getElementById('envAdoUrl').value     = data.ADO_ORG_URL;
        if (data.ADO_PROJECT)   document.getElementById('envAdoProject').value  = data.ADO_PROJECT;

        const llmSel = document.getElementById('envLlmProvider');
        if (llmSel && data.LLM_PROVIDER) {
            llmSel.value = data.LLM_PROVIDER;
            envOnLlmChange(data.LLM_PROVIDER);
        }
        if (data.AI_MODEL) document.getElementById('envLlmModel').value = data.AI_MODEL;
    } catch (_) { /* silent — server may not have endpoint yet */ }
}

/** Toggle Jira / ADO field visibility */
function envOnToolChange(val) {
    const jiraWrap = document.getElementById('envJiraFields');
    const adoWrap  = document.getElementById('envAdoFields');
    if (!jiraWrap || !adoWrap) return;
    if (val === 'ADO') {
        jiraWrap.style.display = 'none';
        adoWrap.style.display  = 'grid';
    } else {
        jiraWrap.style.display = 'contents';
        adoWrap.style.display  = 'none';
    }
}

/** Update model placeholder when LLM provider changes */
function envOnLlmChange(val) {
    const modelInput = document.getElementById('envLlmModel');
    if (!modelInput) return;
    const defaults = {
        openai:      'gpt-4o',
        anthropic:   'claude-3-5-sonnet-20241022',
        groq:        'llama-3.3-70b-versatile',
        deepseek:    'deepseek-chat',
        gemini:      'gemini-1.5-pro',
        openrouter:  'openai/gpt-4o',
    };
    modelInput.placeholder = defaults[val] || 'Enter model name';
}

/** Show/hide a secret field */
function envToggleSecret(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = '🙈';
    } else {
        input.type = 'password';
        btn.textContent = '👁';
    }
}

/** Display status message in the env config section */
function envShowStatus(msg, isError = false) {
    const el = document.getElementById('envConfigStatus');
    if (!el) return;
    el.textContent = msg;
    el.style.background  = isError ? 'rgba(248,113,113,0.1)' : 'rgba(16,185,129,0.1)';
    el.style.color        = isError ? '#f87171' : '#10b981';
    el.style.border       = isError ? '1px solid rgba(248,113,113,0.3)' : '1px solid rgba(16,185,129,0.3)';
    el.style.display      = 'block';
    setTimeout(() => { el.style.display = 'none'; }, 5000);
}

/** Save Test Management config to .env */
async function envSaveTestManagement() {
    const tool = document.getElementById('envToolType')?.value || 'Jira';
    const body = { TestManagementTool: tool };

    if (tool === 'ADO') {
        const url  = document.getElementById('envAdoUrl')?.value?.trim();
        const proj = document.getElementById('envAdoProject')?.value?.trim();
        const pat  = document.getElementById('envAdoPat')?.value?.trim();
        if (!url || !proj) { envShowStatus('❌ ADO Org URL and Project are required', true); return; }
        body.ADO_ORG_URL  = url;
        body.ADO_PROJECT  = proj;
        if (pat) body.ADO_PAT = pat;
    } else {
        const url   = document.getElementById('envJiraUrl')?.value?.trim();
        const email = document.getElementById('envJiraEmail')?.value?.trim();
        const token = document.getElementById('envJiraToken')?.value?.trim();
        if (!url || !email) { envShowStatus('❌ Jira URL and Email are required', true); return; }
        body.JIRA_BASE_URL = url;
        body.JIRA_EMAIL    = email;
        if (token) body.JIRA_API_TOKEN = token;
    }

    try {
        const res  = await fetch(`${SERVER}/api/env/update`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Save failed');
        envShowStatus(`✅ ${tool} config saved to .env — takes effect immediately`);
        // Reload jira config in the rest of the UI
        if (typeof initJiraConfig === 'function') initJiraConfig();
    } catch (e) {
        envShowStatus('❌ ' + e.message, true);
    }
}

/** Save LLM config to .env */
async function envSaveLlm() {
    const provider = document.getElementById('envLlmProvider')?.value?.trim();
    const model    = document.getElementById('envLlmModel')?.value?.trim();
    const apiKey   = document.getElementById('envLlmApiKey')?.value?.trim();

    if (!provider) { envShowStatus('❌ Please select an LLM provider', true); return; }

    // Map provider → correct env key names
    const providerKeyMap = {
        openai:     { keyName: 'OPENAI_API_KEY', modelName: 'OPENAI_MODEL' },
        anthropic:  { keyName: 'AI_API_KEY',     modelName: 'AI_MODEL'     },
        groq:       { keyName: 'GROQ_API_KEY',   modelName: 'GROQ_MODEL'   },
        deepseek:   { keyName: 'AI_API_KEY',     modelName: 'AI_MODEL'     },
        gemini:     { keyName: 'AI_API_KEY',     modelName: 'AI_MODEL'     },
        openrouter: { keyName: 'AI_API_KEY',     modelName: 'AI_MODEL'     },
    };
    const maps = providerKeyMap[provider] || { keyName: 'AI_API_KEY', modelName: 'AI_MODEL' };

    const body = { LLM_PROVIDER: provider, AI_PROVIDER: provider };
    if (model)  { body[maps.modelName] = model; body.AI_MODEL = model; }
    if (apiKey) { body[maps.keyName]   = apiKey; body.AI_API_KEY = apiKey; }

    try {
        const res  = await fetch(`${SERVER}/api/env/update`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Save failed');
        envShowStatus(`✅ LLM config (${provider}) saved to .env — takes effect immediately`);
        // Clear key field for security
        if (apiKey) document.getElementById('envLlmApiKey').value = '';
    } catch (e) {
        envShowStatus('❌ ' + e.message, true);
    }
}

function userLoadMcpCheckboxes() {
    const list = document.getElementById('mcpCheckboxList');
    if (!list) return;
    list.innerHTML = '';
    
    const mcpList = [
        { name: 'gherkin-coverage', label: 'Gherkin Coverage' },
        { name: 'selenium-playwright-migration', label: 'Selenium Migration' },
        { name: 'playwright', label: 'Playwright' },
        { name: 'playwright-ai-healer', label: 'AI Healer' },
        { name: 'mobile-automation', label: 'Mobile Automation' },
        { name: 'token-tracker', label: 'Token Tracker' },
    ];
    
    mcpList.forEach(mcp => {
        const label = document.createElement('label');
        label.style.cssText = 'display:flex;align-items:center;gap:8px;padding:8px;background:#050e1a;border:1px solid #1a2f4a;border-radius:6px;cursor:pointer;transition:all 0.2s;';
        label.onmouseenter = function() { this.style.borderColor = '#3b82f6'; };
        label.onmouseleave = function() { this.style.borderColor = '#1a2f4a'; };
        
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.value = mcp.name;
        checkbox.style.cssText = 'width:16px;height:16px;cursor:pointer;';
        
        const text = document.createElement('span');
        text.textContent = mcp.label;
        text.style.cssText = 'font-size:12px;color:#e2e8f0;flex:1;';
        
        label.appendChild(checkbox);
        label.appendChild(text);
        list.appendChild(label);
    });
}

function userUpdateProfile() {
    const firstName = document.getElementById('userFirstName').value;
    const lastName = document.getElementById('userLastName').value;
    const role = document.getElementById('userRole').value;
    const email = document.getElementById('userEmail').value;
    const newPassword = document.getElementById('userNewPassword').value;
    const confirmPassword = document.getElementById('userConfirmPassword').value;
    
    if (newPassword && newPassword !== confirmPassword) {
        showToast('Passwords do not match', 'error');
        return;
    }
    
    const settings = {
        firstName, lastName, role, email,
        lastUpdated: new Date().toISOString()
    };
    
    if (newPassword) {
        settings.passwordChanged = true;
    }
    
    localStorage.setItem('userSettings', JSON.stringify(settings));
    document.getElementById('userNewPassword').value = '';
    document.getElementById('userConfirmPassword').value = '';
    showToast('✅ Profile updated successfully', 'success');
}

function userConnectMcp() {
    const checkboxes = Array.from(document.querySelectorAll('#mcpCheckboxList input[type="checkbox"]:checked'));
    if (checkboxes.length === 0) {
        showToast('Please select at least one MCP', 'warn');
        return;
    }
    
    const selected = checkboxes.map(cb => cb.value);
    localStorage.setItem('selectedMcps', JSON.stringify(selected));
    showToast(`✅ Connected ${selected.length} MCP(s)`, 'success');
}

function userConnectLlm() {
    const provider = document.getElementById('userLlmProvider').value;
    const apiKey = document.getElementById('userLlmApiKey').value;
    
    if (!provider || !apiKey) {
        showToast('Please select a provider and enter API key', 'warn');
        return;
    }
    
    const llmConfig = {
        provider,
        apiKeySet: true,  // Don't store actual key
        connectedAt: new Date().toISOString()
    };
    
    localStorage.setItem('llmConfig', JSON.stringify(llmConfig));
    document.getElementById('userLlmApiKey').value = '';
    showToast(`✅ Connected to ${provider.toUpperCase()}`, 'success');
}

function userUpdateEnvironment() {
    const envUrl = document.getElementById('userEnvUrl').value;
    const browser = document.getElementById('userBrowser').value;
    
    if (!envUrl || !browser) {
        showToast('Please fill all fields', 'warn');
        return;
    }
    
    const settings = JSON.parse(localStorage.getItem('userSettings') || '{}');
    settings.envUrl = envUrl;
    settings.browser = browser;
    localStorage.setItem('userSettings', JSON.stringify(settings));
    
    showToast('✅ Environment settings updated', 'success');
}

function userBrowseMcpConfig() {
    showToast('📁 MCP config browser not yet available', 'info');
}

// Handle modal close on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const modal = document.getElementById('userSettingsModal');
        if (modal && modal.style.display === 'flex') {
            closeUserSettingsModal();
        }
    }
});


function reloadObservabilityFrame() {
    observabilitySetOverlay('loading');
    observabilityCheckAndLoad();
}

function observabilitySetOverlay(state, errorMsg) {
    const overlay  = document.getElementById('observabilityOverlay');
    const msgEl    = document.getElementById('observabilityOverlayMsg');
    const detailEl = document.getElementById('observabilityOverlayDetail');
    const retryBtn = document.getElementById('observabilityRetryBtn');
    const badge    = document.getElementById('observabilityStatusBadge');

    if (state === 'hidden') {
        overlay.style.display = 'none';
        badge.textContent = '✅ Connected';
        badge.style.background = 'rgba(16,185,129,0.15)';
        badge.style.color       = '#10b981';
        badge.style.border      = '1px solid rgba(16,185,129,0.35)';
        return;
    }

    overlay.style.display = 'flex';

    if (state === 'loading') {
        msgEl.textContent    = 'Connecting to Test Observability…';
        detailEl.textContent = '';
        retryBtn.style.display = 'none';
        badge.textContent = '⏳ Connecting…';
        badge.style.background = 'rgba(100,116,139,0.15)';
        badge.style.color       = '#64748b';
        badge.style.border      = '1px solid rgba(100,116,139,0.3)';
    } else if (state === 'error') {
        msgEl.textContent = '⚠️ Test Observability is not reachable';
        detailEl.innerHTML =
            `The Test Observability server runs as a separate local process.<br>
             Make sure it is started before opening this panel.<br><br>
             <strong style="color:#cbd5e1;">How to start it:</strong><br>
             <code style="background:#0f1f35;border:1px solid #1a2f4a;border-radius:4px;
                          padding:6px 12px;display:inline-block;margin-top:6px;color:#10b981;font-size:12px;">
               cd "failure-analysis-observability/test observability"<br>
               PORT=3001 node server.js
             </code><br><br>
             <span style="color:#64748b;">Expected URL: <a href="${OBSERVABILITY_URL}" target="_blank"
               style="color:#60a5fa;">${OBSERVABILITY_URL}</a></span>
             ${errorMsg ? `<br><span style="color:#f87171;font-size:11px;margin-top:4px;display:block;">${escHtml(errorMsg)}</span>` : ''}`;
        retryBtn.style.display = 'inline-block';
        badge.textContent = '❌ Offline';
        badge.style.background = 'rgba(248,113,113,0.15)';
        badge.style.color       = '#f87171';
        badge.style.border      = '1px solid rgba(248,113,113,0.3)';
    }
}

async function observabilityCheckAndLoad() {
    observabilitySetOverlay('loading');
    try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 6000);
        await fetch(OBSERVABILITY_URL, { mode: 'no-cors', signal: ctrl.signal });
        clearTimeout(timer);
        const frame = document.getElementById('observabilityFrame');
        if (!frame.src || frame.src === 'about:blank' || frame.src === window.location.href) {
            frame.src = OBSERVABILITY_URL;
        }
        frame.onload = () => observabilitySetOverlay('hidden');
        setTimeout(() => {
            if (document.getElementById('observabilityOverlay').style.display !== 'none') {
                observabilitySetOverlay('hidden');
            }
        }, 4000);
    } catch (err) {
        observabilitySetOverlay('error', err && err.message ? err.message : '');
    }
}

function vasCloseDetail() {
    if (_vasActiveKey) {
        const card = document.getElementById('vasCard-' + _vasActiveKey);
        if (card) { card.style.borderColor = '#1a2f4a'; card.style.boxShadow = 'none'; }
        _vasActiveKey = null;
    }
    document.getElementById('vasDetailPanel').style.display = 'none';
}

// ── Coverage Analyzer Modal ───────────────────────────────────────────────────
const COVERAGE_URL = (VAS_SERVICES['coverage-analyzer'] || {}).launchUrl || 'http://localhost:3000';

function openCoverageModal() {
    const modal = document.getElementById('coverageModal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    const openLink = document.getElementById('coverageOpenLink');
