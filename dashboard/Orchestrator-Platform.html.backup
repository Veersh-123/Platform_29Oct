                                           border-radius:5px;font-size:11px;cursor:pointer;transition:all 0.2s;
                                           display:flex;align-items:center;gap:5px;"
                                    onmouseenter="this.style.borderColor='#3b82f6';this.style.color='#3b82f6'"
                                    onmouseleave="this.style.borderColor='#2a3f5a';this.style.color='#64748b'">
                                🔁 Reload
                            </button>
                            <a id="coverageOpenLink" href="http://localhost:3000" target="_blank" rel="noopener"
                               style="background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.3);
                                      color:#60a5fa;padding:6px 12px;border-radius:5px;font-size:11px;
                                      text-decoration:none;font-weight:600;transition:all 0.2s;"
